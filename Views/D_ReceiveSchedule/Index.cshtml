@using mar_sumaken_web.Commons;
@model mar_sumaken_web.Models.D_ReceiveScheduleModel
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.CategoryTitle + " - " + Model.ViewTitle;
}

<div class="card shadow de-inspection d-receive-schedule m-4">
    <div class="card-header text-gray-800">
        @ViewData["Title"]
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-lg-8">
                <div class="card border-left-custom">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li>メッセージ内容</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group col-sm-12">
            <p id="div-error-message" class="mt-1 text-danger"></p>
        </div>

        @if (ViewData["ErrorMessage"] != null)
        {
            <span class="mt-1 text-danger">@ViewData["ErrorMessage"]</span>
        }

        <div class="mg-bot-20">
            
            <div class="col-16 d-flex justify-content-start align-items-center sp-tablet mb-3">
                <div class="row mt-10">
                    <div class="col-lg-12">
                        <form id="searchForm" class="form-inline cus-input-validation-error">
                            <div class="col-8 d-flex justify-content-start align-items-center mb-3  unset-pdl">
                                <span class="warehouse-name-drs">倉庫名</span>
                                <div class="selectItem unset-pdl">
                                    <select class="form-select" name="SelectedDepoID" asp-for="SelectedDepoID" asp-items="@Model.SearchDepoList"></select>
                                </div>
                            </div>
                            <div class="col-8 d-flex justify-content-start align-items-center mb-3 unset-pdl">
                                <span class="warehouse-name-drs">仕入先名</span>
                                <div class="selectItem unset-pdl">
                                    <select class="form-select" name="SelectedCompanyID" asp-for="SelectedCompanyID" asp-items="@Model.SearchCompanyList"></select>
                                </div>
                            </div>

                            <div class="col-16 d-flex justify-content-start align-items-center unset-pdl sp-cs-dpl">
                                <div class="d-flex justify-content-start align-items-center mb-3 unset-pdl">
                                    <span class="warehouse-name-drs">@Html.DisplayNameFor(Model => Model.SearchStartDate)</span>
                                    <input id="startDate" type="text" asp-for="SearchStartDate" class="form-control pickerDate"> 
                                    <lable class="m-1">～</lable> 
                                    <input id="endDate" type="text" asp-for="SearchEndDate" class="form-control pickerDate">
                                </div>
                                <div class="d-flex justify-content-start align-items-center mb-3 unset-pdl">
                                    <div class="form-check ml-5">
                                        <input class="form-check-input" asp-for="DiffenceCountCheck" type="checkbox">
                                        <label class="form-check-label ml-1" asp-for="DiffenceCountCheck">実績数不一致のみ</label>
                                    </div>
                                    <button type="submit" id="search-btn" class="btn btn-secondary btn-icon-split ml-3">
                                        <span class="icon text-white-50">
                                            <i class="fa-solid fa-magnifying-glass"></i>
                                        </span>
                                        <span class="text">検索</span>
                                    </button>
                                    <button class="btn btn-info btn-icon-split sp-mg-bt-10 ml-3">
                                        <span class="icon text-white-50">
                                            <i class="fa-solid fa-file-export"></i>
                                        </span>
                                        <span class="text">出力</span>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <div class="mt-3" id="div-table" style="display: none;">
            <table class="table table-sm stripe hover nowrap datatable-normal" id="table-datatable">
                <thead>
                    <tr>
                        <th></th>
                        <th>ID</th>
                        <th>仕入先名</th>
                        <th>入荷予定日</th>
                        <th>仕入先品番</th>
                        <th>ロット番号</th>
                        <th>予定箱数</th>
                        <th>予定数量</th>
                        <th>入庫箱数</th>
                        <th>入庫数量</th>
                        <th>登録日時</th>
                        <th>登録者</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    // 検索ボタン押下
    $('#search-btn').click(function () {
        $('#searchForm').submit(function (e) {
            DeleteErrorMessages();

            // ページの更新を禁止する
            e.preventDefault();
            // 送信イベントが他のハンドラーに伝播するのを防ぐ
            e.stopImmediatePropagation();

            // フォーム情報取得
            let url = window.location.origin + '@Url.Action("SearchData", "D_ReceiveSchedule")';
            let method = 'POST';
            var data = $(this).serialize();
            console.log('data', data)

            // Ajax call
            $.ajax({
                url: url,
                method: method,
                data: data
            }).done(function (response) {
                $("#table-datatable tbody").empty();
                $('#table-datatable').DataTable().destroy();
                $("#div-table").show();
                $("#table-datatable tbody").html(response);
                $("#table-datatable").DataTable({
                    "language": {           // 日本語表示
                        "url": "https://cdn.datatables.net/plug-ins/1.11.5/i18n/ja.json"
                    },
                    lengthChange: true,     // 表示件数
                    info: false,            // 総件数
                    scrollX: true,          // 横スクロール可
                    order: [[3, "asc"]],    // 仕入先品番昇順
                });
            }).fail(function (xhr, textStatus, errorThrown) {
                if (xhr.status === 404) {
                    var errorMessage = xhr.responseJSON.errorMessage;
                    $("#div-error-message").text(errorMessage);
                } else {
                    var errorMessage500 = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                    $("#div-error-message").text(errorMessage500);
                }
            });
        });
    });

    // エラーメッセージ削除
    function DeleteErrorMessages() {
        $('#div-error-message').text('');
        $('#edit-modal-error-message').text('');
        $('#delete-modal-error-message').text('');
        $('.text-danger').text('');
        $('input').removeClass('input-validation-error');
    }
</script>