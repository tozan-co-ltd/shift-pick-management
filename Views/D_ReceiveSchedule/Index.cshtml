@*@using X.PagedList*@
@* @model mar_sumaken_web.Models.D_ReceiveScheduleModel *@
@{
    ViewData["Title"] = "入荷予定照会";
}

<div class="card shadow de-inspection d-receive-schedule m-4">
    <div class="card-header text-gray-800">
        入庫 - 入荷予定照会
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-lg-8">
                <div class="card border-left-custom">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li>メッセージ内容</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group col-sm-12">
            <p id="import-res" class="mt-1"></p>
        </div>

        <div id="ErrorBlock" class="mb-3 ml-3 text-danger">
        </div>

        <div class="mg-bot-20">
            
            <div class="col-16 d-flex justify-content-start align-items-center sp-tablet mb-3">
                <div class="row mt-10">
                    <div class="col-lg-12">
                        <form id="form" name="form" class="form-inline cus-input-validation-error">
                            <div class="col-8 d-flex justify-content-start align-items-center mb-3  unset-pdl">
                                <span class="warehouse-name-drs">倉庫名</span>
                                <div class="selectItem">
                                    <select class="form-select" aria-label="Default select example ">
                                        <option selected>選択してください</option>
                                        <option value="1">選択1</option>
                                        <option value="2">選択2</option>
                                        <option value="3">選択3</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-8 d-flex justify-content-start align-items-center mb-3 unset-pdl">
                                <span class="warehouse-name-drs">仕入先名</span>
                                <div class="selectItem">
                                    <select class="form-select" aria-label="Default select example">
                                        <option selected>選択してください</option>
                                        <option value="1">選択1</option>
                                        <option value="2">選択2</option>
                                        <option value="3">選択3</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-16 d-flex justify-content-start align-items-center mb-3 unset-pdl sp-cs-dpl">
                                <div class="d-flex justify-content-start align-items-center mb-3 unset-pdl">
                                    <span class="warehouse-name-drs">入荷予定日</span>
                                    <input id="startDate" type="text" class="form-control"> <lable class="m-1">～</lable> <input id="endDate" type="text" class="form-control">
                               </div>
                                <div class="d-flex justify-content-start align-items-center mb-3 unset-pdl">
                                    <div class="custom-control custom-checkbox ml-3">
                                        <input type="checkbox" class="custom-control-input" id="customCheckBox1">
                                        <label class="custom-control-label" for="customCheckBox1">実績数不一致のみ</label>
                                    </div>
                                    <button type="submit" class="btn btn-secondary btn-icon-split ml-3 sp-cs">
                                        <span class="icon text-white-50">
                                            <i class="fa-solid fa-magnifying-glass"></i>
                                        </span>
                                        <span class="text">検索</span>
                                    </button>
                                    <button class="btn btn-info btn-icon-split sp-mg-bt-10 ml-3 sp-cs">
                                        <span class="icon text-white-50">
                                            <i class="fa-solid fa-file-export"></i>
                                        </span>
                                        <span class="text">出力</span>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <div class="tableContent mt-3">
            <table class="table row-border compact stripe hover nowrap order-column" id="userTbl">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>仕入先名</th>
                        <th>入荷予定日</th>
                        <th>仕入先品番</th>
                        <th>ロット番号</th>
                        <th>予定箱数</th>
                        <th>予定数量</th>
                        <th>入庫箱数</th>
                        <th>入庫数量</th>
                        <th>登録日時</th>
                        <th>登録者</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>
@* <input id="import_action_url" type="hidden" value="@Url.Action("ImportExcel", "ScheduledArrivalImport")" /> *@