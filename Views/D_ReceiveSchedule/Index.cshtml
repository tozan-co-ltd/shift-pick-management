@using mar_sumaken_web.Commons;
@model mar_sumaken_web.Models.D_ReceiveScheduleModel
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.CategoryTitle + " - " + Model.ViewTitle;
}

<div class="card shadow de-inspection d-receive-schedule m-4">
    <div class="card-header text-gray-800">
        @ViewData["Title"]
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-lg-8">
                <div class="card border-left-custom">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li>メッセージ内容</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group col-sm-12">
            <p id="div-error-message" class="mt-1 text-danger"></p>
        </div>

        @if (ViewData["ErrorMessage"] != null)
        {
            <span class="mt-1 text-danger">@ViewData["ErrorMessage"]</span>
        }

        <div class="mg-bot-20">
            
            <div class="col-16 d-flex justify-content-start align-items-center sp-tablet mb-3">
                <div class="row mt-10">
                    <div class="col-lg-12">
                        <form id="form" name="form" class="form-inline cus-input-validation-error">
                            <div class="col-8 d-flex justify-content-start align-items-center mb-3  unset-pdl">
                                <span class="warehouse-name-drs">倉庫名</span>
                                <div class="selectItem unset-pdl">
                                    <select class="form-select" name="SelectedDepoID" asp-for="SelectedDepoID" asp-items="@Model.SearchDepoList"></select>
                                </div>
                            </div>
                            <div class="col-8 d-flex justify-content-start align-items-center mb-3 unset-pdl">
                                <span class="warehouse-name-drs">仕入先名</span>
                                <div class="selectItem unset-pdl">
                                    <select class="form-select" name="SelectedCompanyID" asp-for="SelectedCompanyID" asp-items="@Model.SearchCompanyList"></select>
                                </div>
                            </div>

                            <div class="col-16 d-flex justify-content-start align-items-center unset-pdl sp-cs-dpl">
                                <div class="d-flex justify-content-start align-items-center mb-3 unset-pdl">
                                    <span class="warehouse-name-drs">@Html.DisplayNameFor(Model => Model.SearchStartDate)</span>
                                    <input id="startDate" type="text" asp-for="SearchStartDate" class="form-control pickerDate"> <lable class="m-1">～</lable> <input id="endDate" type="text" asp-for="SearchEndDate" class="form-control pickerDate">
                                </div>
                                <div class="d-flex justify-content-start align-items-center mb-3 unset-pdl">
                                    <div class="form-check ml-5">
                                        <input class="form-check-input" type="checkbox" value="" id="actual-num-discrepancy-only">
                                        <label class="form-check-label ml-1" for="actual-num-discrepancy-only">実績数不一致のみ</label>
                                    </div>
                                    <button type="submit" class="btn btn-secondary btn-icon-split ml-3">
                                        <span class="icon text-white-50">
                                            <i class="fa-solid fa-magnifying-glass"></i>
                                        </span>
                                        <span class="text">検索</span>
                                    </button>
                                    <button class="btn btn-info btn-icon-split sp-mg-bt-10 ml-3">
                                        <span class="icon text-white-50">
                                            <i class="fa-solid fa-file-export"></i>
                                        </span>
                                        <span class="text">出力</span>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <div class="mt-3" id="div-table" style="display: none;">
            <table class="table table-sm stripe hover nowrap datatable-normal">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>仕入先名</th>
                        <th>入荷予定日</th>
                        <th>仕入先品番</th>
                        <th>ロット番号</th>
                        <th>予定箱数</th>
                        <th>予定数量</th>
                        <th>入庫箱数</th>
                        <th>入庫数量</th>
                        <th>登録日時</th>
                        <th>登録者</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>