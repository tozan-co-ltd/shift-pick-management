@model mar_sumaken_web.Models.M_UserEditModel
@{
    ViewData["Title"] = "マスター情報 - ユーザーマスター - 修正";
}

<div class="card user-master shadow masterInfo m-4">

    <div class="card-header text-gray-800">
        @ViewData["Title"]
    </div>

    <div class="card-body">
        <div class="col-md-12 pl-3 pb-3">
            <form method="get" asp-controller="M_User" asp-action="Index">
                <button type="submit" class="btn btn-secondary btn-icon-split">
                    <span class="icon text-white-50">
                        <i class="fas fa-arrow-left-long"></i>
                    </span>
                    <span class="text">戻る</span>
                </button>
            </form>
        </div>

        <div class="form-group col-sm-12">
            <p id="import-res" class="mt-1"></p>
        </div>

        <div id="div-error-message" class="mb-3 ml-3 text-danger">
        </div>

        <div class="mg-bot-20">
            <div class="col-16 sp-tablet mb-3">
                <form class="col-md-12" id="mUserForm">
                    <div class="top-area">
                        <div class="col-12 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-2 column-1st">
                                <label>@Html.DisplayName("LoginID")</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-5 column-2nd">
                                <input type="hidden" asp-for="UserID" value="@Model.UserID" />
                                <input class="form-control" type="text" asp-for="LoginID" autocomplete="off" required readonly>
                                <small class="form-text text-muted w-100 p-1">4～12文字の半角英数字が使用できます。</small>
                                <span class="text-danger w-100" asp-validation-for="LoginID"></span>
                            </div>
                        </div>
                        <div class="col-12 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-2 column-1st">
                                <label>@Html.DisplayName("UserName")<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-5 column-2nd">
                                <input class="form-control" type="text" asp-for="UserName" autocomplete="off" required>
                                <span class="text-danger w-100" asp-validation-for="UserName"></span>
                            </div>
                        </div>
                        <div class="col-12 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-2 column-1st">
                                <label>@Html.DisplayName("Password")</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-5 column-2nd">
                                <input class="form-control" type="password" asp-for="Password" autocomplete="off" placeholder="変更する場合のみ入力">
                                <small class="form-text text-muted w-100 p-1">4～12文字の半角英数字が使用できます。</small>
                                <span class="text-danger w-100" asp-validation-for="Password"></span>
                            </div>
                        </div>
                        <div class="col-12 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-2 column-1st">
                                <label>@Html.DisplayName("AuthorizedKubun")<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-5 column-2nd">
                                <select class="form-select" asp-for="AuthorizedKubun" required>
                                    <option value="1" selected>管理者</option>
                                    <option value="2">作業者</option>
                                    <option value="3">作業者(解除要)</option>
                                </select>
                                <span class="text-danger w-100" asp-validation-for="AuthorizedKubun"></span>
                            </div>
                        </div>
                    </div>
                    <hr />
                    <div class="down-area">
                        <div class="col-12 input-group div-input-group">
                            <div class="col-12 col-md-6 d-flex flex-wrap pl-0">
                                <div class="col-12 col-sm-4 column-1st">
                                    <label>使用倉庫名<span style="color:red">*</span></label>
                                </div>
                                <div class="col-12 col-sm-8 column-2nd warehouse-checkbox">
                                    <input type="hidden" id="select-depo-count" value="@Model.DepoSelectList.Count">
                                    @for (var i = 0; i < Model.DepoSelectList.Count; i++)
                                    {
                                        <div class="form-check">
                                            <input type="hidden" asp-for="DepoSelectList[i].Value" value="@Model.DepoSelectList[i].Value" />
                                            <input type="hidden" asp-for="DepoSelectList[i].Name" value="@Model.DepoSelectList[i].Value"/>
                                            <input class="form-check-input checkbox" asp-for="DepoSelectList[i].IsSelected" id="select-depo-@i" type="checkbox">
                                            <label class="form-check-label" id="label-depo-name-@i" for="select-depo-@i">@Model.DepoSelectList[i].Name</label>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="col-12 col-md-6 input-group pl-0">
                                <div class="col-12 col-sm-4 column-1st">
                                    <label>メイン倉庫名<span style="color:red">*</span></label>
                                </div>
                                <div class="col-12 col-sm-8 column-2nd">
                                    <input type="hidden" id="origin-depo-id" value="@Model.DepoID">
                                    <select class="form-select" asp-for="DepoID" id="warehouse-select" required>
                                        <option value="0" selected>--使用倉庫名を選択してください--</option>
                                    </select>
                                    <span class="text-danger w-100" asp-validation-for="DepoID"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 input-group div-input-group mb-0">
                            <div class="col-12 col-md-6 input-group pl-0">
                                <div class="col-12 col-sm-4 column-1st">
                                    <label>使用ハンディメニュー名</label>
                                </div>
                                <div class="col-12 col-sm-8 column-2nd">
                                    @for (var i = 0; i < Model.HandyMenuSelectList.Count; i++)
                                    {
                                        <div class="form-check">
                                            <input type="hidden" asp-for="HandyMenuSelectList[i].Value" value="@Model.HandyMenuSelectList[i].Value" />
                                            <input type="hidden" asp-for="HandyMenuSelectList[i].Name" value="@Model.HandyMenuSelectList[i].Name" />
                                            <input class="form-check-input" asp-for="HandyMenuSelectList[i].IsSelected" type="checkbox">
                                            <label class="form-check-label" asp-for="HandyMenuSelectList[i].IsSelected">@Model.HandyMenuSelectList[i].Name</label>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 input-group div-input-group">
                            <div class="col-12 offset-0 offset-md-4">
                                <label>
                                    <small>作業者の場合は、使用するハンディメニューに<br />チェックを入れないとハンディで操作できません。</small>
                                </label>
                            </div>
                        </div>
                        <button class="btn btn-success btn-icon-split" style="min-width: 80px" onclick="OnEdit()">
                            <span class="text">更新</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script type="text/javascript">

    // ユーザーマスター更新
    function OnEdit() {
        $('#mUserForm').submit(function (event) {

            $("#div-error-message").text("");
            $('#import-res').text("");

            // フォーム情報を取得する
            var formData = $('#mUserForm').serializeArray();

            console.log(formData);

            // ページの更新を禁止する
            event.preventDefault();

            // Ajax call
            $.ajax({
                url: window.location.origin + '@Url.Action("Edit", "M_User")',
                method: "POST",
                data: formData
            })
                .done(function (response) {
                    $('#mUserForm')[0].reset();
                    // 完了モーダル表示
                    AlertMessage('', '完了', '更新が完了しました。', null, null);
                })
                .fail(function (xhr) {
                    if (xhr.status === 404) {
                        // データが見つからなかった場合
                        var errorMessage = xhr.responseJSON.errorMessage;
                        $("#div-error-message").hide();
                        $("#import-res").show();
                        $("#import-res").addClass('text-danger');
                        $("#import-res").text("エラー: " + errorMessage);
                    } else {
                        // その他のエラーの場合
                        $("#div-error-message").hide();
                        $("#import-res").show();
                        $("#import-res").addClass('text-danger');
                        $("#import-res").text("更新を失敗しました。");
                    }
                });
        });
    }

    // メイン倉庫区分の値を更新
    $(document).ready(function () {
        const depoSelectCount = $('#select-depo-count').val();
        const checkbox1 = document.getElementById('select-depo-0');
        const checkbox2 = document.getElementById('select-depo-1');
        const selectBox = document.getElementById('warehouse-select');

        var selectItems = ["--使用倉庫名を選択してください--"];
        for(var i = 0; i < depoSelectCount; i++) 
        {
            let depoName = $("#label-depo-name-" + i).text();
            selectItems.push(depoName);
        }

        // Listen change event
        checkbox1.addEventListener('change', updateSelectBox);
        checkbox2.addEventListener('change', updateSelectBox);
        updateSelectBox();

        // Assign Depo ID
        var originDepoId = $('#origin-depo-id').val();
        $('#warehouse-select').val(originDepoId);

        // Update select box
        function updateSelectBox() {
            const checkbox1Checked = checkbox1.checked;
            const checkbox2Checked = checkbox2.checked;

            // Remove all option
            selectBox.innerHTML = '';

            // Check checkbox selection
            if (!checkbox1Checked && !checkbox2Checked) {
                addOption(selectBox, 0, selectItems[0]);
            } else if (checkbox1Checked && !checkbox2Checked) {
                addOption(selectBox, 1, selectItems[1]);
            } else if (!checkbox1Checked && checkbox2Checked) {
                addOption(selectBox, 2, selectItems[2]);
            } else {
                addOption(selectBox, 1, selectItems[1]);
                addOption(selectBox, 2, selectItems[2]);
            }
        }

        // Add select option
        function addOption(selectBox, value, text) {
            const option = document.createElement("option");
            option.value = value;
            option.text = text;
            selectBox.add(option);
        }
    });

</script>

