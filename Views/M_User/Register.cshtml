@using ai_truck_load_measurement.Commons;
@model ai_truck_load_measurement.Models.M_UserModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.CategoryTitle + " - " + Model.ViewTitle + " - " + "登録";
}

<div class="card user-master shadow masterInfo m-4">

    <div class="card-header">
        @ViewData["Title"]
    </div>

    <div class="card-body">
        <div class="col-md-12 pb-3">
            <form method="get" asp-controller="M_User" asp-action="Index">
                <button type="submit" class="btn btn-secondary btn-icon-split">
                    <span class="icon text-white-50">
                        <i class="fas fa-arrow-left-long"></i>
                    </span>
                    <span class="text">戻る</span>
                </button>
            </form>
        </div>

        <div class="form-group col-sm-12 pl-3">
            <p id="div-error-message" class="mt-1 text-danger"></p>

            @if (ViewData["ErrorMessage"] != null)
            {
                <span class="mt-1 text-danger">@ViewData["ErrorMessage"]</span>
            }
        </div>

        <div class="mg-bot-20">
            <div class="col-16 sp-tablet mb-3">
                <form class="col-md-12" id="mUserForm" autocomplete="off">
                    <div class="top-area">
                        <div class="col-12 input-group div-input-group p-1">
                            <div class="col-12 col-sm-4 col-md-2 column-1st">
                                <label>@Html.DisplayName("LoginID")<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-5 column-2nd">
                                <input class="form-control" type="text" asp-for="LoginID" required>
                                <small class="form-text text-muted w-100 p-1">4～12文字の半角英数字が使用できます。</small>
                                <span class="text-danger w-100" asp-validation-for="LoginID"></span>
                            </div>
                        </div>
                        <div class="col-12 input-group div-input-group p-1">
                            <div class="col-12 col-sm-4 col-md-2 column-1st">
                                <label>@Html.DisplayName("UserName")<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-5 column-2nd">
                                <input class="form-control" type="text" asp-for="UserName" required>
                                <span class="text-danger w-100" asp-validation-for="UserName"></span>
                            </div>
                        </div>
                        <div class="col-12 input-group div-input-group p-1">
                            <div class="col-12 col-sm-4 col-md-2 column-1st">
                                <label>@Html.DisplayName("Password")<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-5 column-2nd">
                                <input class="form-control" type="password" asp-for="Password" autocomplete="new-password" required>
                                <small class="form-text text-muted w-100 p-1">4～12文字の半角英数字が使用できます。</small>
                                <span class="text-danger w-100" asp-validation-for="Password"></span>
                            </div>
                        </div>
                        <div class="col-12 input-group div-input-group p-1">
                            <div class="col-12 col-sm-4 col-md-2 column-1st">
                                <label>@Html.DisplayName("AuthorizedKubun")<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-5 column-2nd">
                                <select class="form-select" asp-for="AuthorizedKubun" required>
                                    <option value="1" selected>管理者</option>
                                    <option value="2">作業者</option>
                                    <option value="3">作業者(解除要)</option>
                                </select>
                                <span class="text-danger w-100" asp-validation-for="AuthorizedKubun"></span>
                            </div>
                        </div>
                    </div>
                    <hr />
                    <div class="down-area">
                        <div class="col-12 input-group div-input-group p-1">
                            <div class="col-12 col-md-6 d-flex flex-wrap pl-0">
                                <div class="col-12 col-sm-4 column-1st">
                                    <label>使用倉庫名<span style="color:red">*</span></label>
                                </div>
                                <div class="col-12 col-sm-8 column-2nd" id="checkbox-depo">
                                    @for (var i = 0; i < Model.DepoSelectList.Count; i++)
                                    {
                                        <div class="form-check">
                                            <input type="hidden" asp-for="DepoSelectList[i].Value" value="@Model.DepoSelectList[i].Value" />
                                            <input type="hidden" asp-for="DepoSelectList[i].Text" value="@Model.DepoSelectList[i].Value" />
                                            <input class="form-check-input checkbox" asp-for="DepoSelectList[i].Selected" id="@Model.DepoSelectList[i].Value" type="checkbox">
                                            <label class="form-check-label" for="@Model.DepoSelectList[i].Value">@Model.DepoSelectList[i].Text</label>
                                        </div>
                                    }
                                    <span class="text-danger w-100" id="error-message-checked-depo"></span>
                                </div>
                            </div>

                            <div class="col-12 col-md-6 input-group pl-0">
                                <div class="col-12 col-sm-4 column-1st">
                                    <label>メイン倉庫名<span style="color:red">*</span></label>
                                </div>
                                <div class="col-12 col-sm-8 column-2nd">
                                    <select class="form-select" name="SelectedMainDepoID" asp-for="MainDepoName" id="select-main-depo" required>
                                        <option value="0" selected>--使用倉庫名を選択してください--</option>
                                    </select>
                                    <span class="text-danger w-100" id="error-message-selected-depo"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 input-group div-input-group mb-0 p-1">
                            <div class="col-12 col-md-6 input-group pl-0">
                                <div class="col-12 col-sm-4 column-1st">
                                    <label>使用ハンディメニュー名</label>
                                </div>
                                <div class="col-12 col-sm-8 column-2nd">
                                    @for (var i = 0; i < Model.HandyMenuSelectList.Count; i++)
                                    {
                                        <div class="form-check">
                                            <input type="hidden" asp-for="HandyMenuSelectList[i].Value" value="@Model.HandyMenuSelectList[i].Value" />
                                            <input type="hidden" asp-for="HandyMenuSelectList[i].Text" value="@Model.HandyMenuSelectList[i].Text" />
                                            <input class="form-check-input" asp-for="HandyMenuSelectList[i].Selected" type="checkbox">
                                            <label class="form-check-label" asp-for="HandyMenuSelectList[i].Selected">@Model.HandyMenuSelectList[i].Text</label>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 input-group div-input-group">
                            <div class="col-12 offset-0 offset-md-4 column-1st">
                                <small class="form-text text-muted w-100 p-1">
                                    作業者の場合は、使用するハンディメニューに<br />チェックを入れないとハンディで操作できません。
                                </small>
                            </div>
                        </div>
                        <button class="btn btn-primary btn-icon-split" style="min-width: 80px" onclick="OnRegister()">
                            <span class="text">登録</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>

<script type="text/javascript">

    $(document).ready(function () {
        var checkList = @Html.Raw(Json.Serialize(Model.DepoSelectList));
        for (var i = 0; i < checkList.length; i++) {
            var item = "#select-depo-" + i;
            $(item).change(function (item) {
                CheckIsSelectedDepoProduct();
            });
        }
    });

    // 登録ボタン押下
    function OnRegister() {
        $('#mUserForm').submit(function (event) {
            $("#div-error-message").text("");

            // ページの更新を禁止する
            event.preventDefault();

            // 送信イベントが他のハンドラーに伝播するのを防ぐ
            event.stopImmediatePropagation();

            // 使用倉庫名が選択されていない場合はエラー
            if (!CheckIsCheckedDepo()) return;

            // メイン倉庫名が選択されていない場合はエラー
            if (!CheckIsSelectedMainDepo()) return;

            // フォーム情報取得
            let url = window.location.origin + '@Url.Action("Register", "M_User")';
            let method = 'POST';
            let formId = 'mUserForm';
            let data = $('#' + formId).serializeArray();

            // Ajax call
            $.ajax({
                url: url,
                method: method,
                data: data
            }).done(function (response) {
                $('#' + formId)[0].reset();
                // 完了モーダル表示
                AlertMessage('', '完了', '登録が完了しました。', null, null);
            }).fail(function (jqXHR, textStatus, errorThrown) {
                if (jqXHR.status === 404) {
                    // データが見つからなかった場合
                    var errorMessage = jqXHR.responseJSON.errorMessage;
                    $("#div-error-message").text(errorMessage);
                } else {
                    // その他のエラーの場合
                    var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                    $("#div-error-message").text(errorMessage);
                }
            });
        });
    }
    // 使用倉庫名・メイン倉庫名の制御
    $(document).ready(function () {
        // 初期状態で選択されているチェックボックスをセレクトボックスに反映する
        $('#checkbox-depo input[type="checkbox"]:checked').each(function () {
            let selectBox = $('#select-main-depo');
            let checkboxDepoId = $(this).attr('id');
            let checkboxLabel = $(this).next('label').text();

            // セレクトボックスにオプションを追加
            selectBox.append($('<option>', {
                value: checkboxDepoId,
                text: checkboxLabel
            }));
        });

        // チェックボックスが変更されたらセレクトボックスに反映する
        $('#checkbox-depo input[type="checkbox"]').change(function () {
            let selectBox = $('#select-main-depo');
            let checkboxDepoId = $(this).attr('id');
            let checkboxLabel = $(this).next('label').text();

            // チェックボックスがチェックされた場合
            if ($(this).is(':checked')) {
                // セレクトボックスにオプションを追加
                selectBox.append($('<option>', {
                    value: checkboxDepoId,
                    text: checkboxLabel
                }));
            } else { // チェックボックスがチェックされていない場合
                // セレクトボックスから対応するオプションを削除
                selectBox.find('option[value="' + checkboxDepoId + '"]').remove();
            }

            // オプションをチェックボックスのvalueの昇順に並び替える
            let options = selectBox.find('option');
            options.detach().sort(function (a, b) {
                return $(a).val() - $(b).val();
            });
            selectBox.append(options);
        });
    });

    // 使用倉庫名チェック
    function CheckIsCheckedDepo() {
        $('#error-message-checked-depo').text('');
        // 選択されているチェックボックスの数を数える
        let checkedCount = $('#checkbox-depo input[type="checkbox"]:checked').length;

        // 選択されているチェックボックスが0個の場合
        if (checkedCount === 0) {
            $('#error-message-checked-depo').text('使用倉庫名は必須項目です。');
            return false;
        }
        return true;
    }

    // メイン倉庫名チェック
    function CheckIsSelectedMainDepo() {
        $('#error-message-selected-depo').text('');
        let selectedMainDepoID = $("#select-main-depo option:selected").val();

        // 選択されているメイン倉庫名のIDが0の場合
        if (selectedMainDepoID == 0) {
            $('#error-message-selected-depo').text('メイン倉庫名は必須項目です。');
            return false;
        }
        return true;
    }
</script>

