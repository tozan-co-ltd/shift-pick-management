@using shift_pick_management.Commons;
@model shift_pick_management.Models.M_UserListViewModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = "利用者マスタ登録";
}
<div class="card shadow de-inspection masterInfo m-4">
    <div class="card-header">
        @ViewData["Title"]
    </div>

    <div class="card-body">

        <div class="form-group col-sm-12 pl-3">
            <p id="div-error-message" class="mt-1 text-danger"></p>

            @if (ViewData["ErrorMessage"] != null)
            {
                <span class="mt-1 text-danger">@ViewData["ErrorMessage"]</span>
            }
        </div>
        <div class="col-16 sp-tablet mb-3">
            <div class="sp-cs-dpl">
                <div class="d-flex justify-content-start  mb-3 unset-pdl">
                    <div class="d-flex nowrap mr-5 align-items-center">
                        <span class="warehouse-name-drs span-paragraph">利用者ID</span>
                        <input type="text" class="form-control input-form">
                    </div>
                    <div class="d-flex nowrap align-items-center">
                        <span class="warehouse-name-drs span-paragraph">アップロード</span>
                        <input class="form-control" type="file" required id="fileBox" multiple name="files">
                    </div>
                </div>
            </div>
            <div class="sp-cs-dpl">
                <div class="d-flex justify-content-start align-items-center mb-3 unset-pdl">
                    <div class="d-flex nowrap mr-5 align-items-center">
                        <span class="warehouse-name-drs span-paragraph">利用者名</span>
                        <input type="text" class="form-control input-form">
                    </div>
                    <div class="d-flex nowrap align-items-center">
                        <span class="warehouse-name-drs"></span>
                        <input type="radio" class=" mr-2" name="torikomi" id="parts" checked /><label for="parts" class="mr-2">部分取込</label>
                        <input type="radio" class=" mr-2" name="torikomi" id="torikomiAll" /><label for="torikomiAll" class="mr-2">全体取込</label>
                    </div>
                </div>
            </div>
            <div class="col-16 d-flex justify-content-start align-items-center unset-pdl sp-cs-dpl">
                <div class="d-flex justify-content-start align-items-center unset-pdl">
                    <span class="warehouse-name-drs span-paragraph">状況</span>
                    <div>
                        <label class="mr-5">
                            <input type="checkbox" class=" mr-2" name="situation" id="all" /><label for="all" class="mr-2">すべて</label>
                            <input type="checkbox" class=" mr-2" name="situation" id="preserve" /><label for="preserve" class="mr-2">利用中</label>
                            <input type="checkbox" class=" mr-2" name="situation" id="preserve" /><label for="preserve" class="mr-2">未ログイン</label>
                            <input type="checkbox" class=" mr-2" name="situation" id="entry" /><label for="entry" class="mr-2">停止</label>
                        </label>
                    </div>

                </div>
                <div class="input-group-append" style="margin-left:auto; ">
                    <a class="btn btn-secondary btn-icon-split mr-2" data-toggle="modal" data-target="#edit-modal" id="exportFile">
                        <span class="icon text-white-50">
                            <i class="fa-solid fa-square-plus"></i>
                        </span>
                        <span class="text">新規</span>
                    </a>
                    <a class="btn btn-secondary btn-icon-split">
                        <span class="icon text-white-50">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span>
                        <span class="text">表示</span>
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>
