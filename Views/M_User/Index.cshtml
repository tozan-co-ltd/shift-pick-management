@using mar_sumaken_web.Commons;
@model mar_sumaken_web.Models.M_UserModel
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.CategoryTitle + " - " + Model.ViewTitle;
}
<style type="text/css">
    .btn-register {
        min-width: 130px !important;
    }
</style>

<div class="card shadow de-inspection user-master masterInfo m-4">
    <div class="card-header text-gray-800">
        @ViewData["Title"]
    </div>
    <div class="card-body">
        <div class="form-group col-sm-12">
            <p id="import-res" class="mt-1"></p>
        </div>

        <div id="div-error-message" class="mb-3 ml-3 text-danger">
        </div>

        <div class="mg-bot-20">
            <div class="col-12 d-flex xs-block justify-content-start align-items-center p-0">
                <div class="input-group-append mr-2">
                    <a class="btn btn-primary btn-icon-split btn-register" asp-controller="M_User" asp-action="Register">
                        <span class="icon text-white-50">
                            <i class="fas fa-plus"></i>
                        </span>
                        <span class="text">新規作成</span>
                    </a>
                </div>
                <div class="input-group-append">
                    <a href="#" class="btn btn-info btn-icon-split" onclick="onExportFile('M_User')">
                        <span class="icon text-white-50">
                            <i class="fas fa-file-export"></i>
                        </span>
                        <span class="text">出力</span>
                    </a>
                </div>
            </div>
        </div>
        <div class="mt-3">
            <table class="table table-sm stripe hover nowrap datatable-normal">
                <thead>
                    <tr>
                        <th width="40"></th>
                        <th class="font-weight-bold">ID</th>
                        <th class="font-weight-bold">ログインID</th>
                        <th class="font-weight-bold">ユーザー名</th>
                        <th class="font-weight-bold">メイン倉庫名</th>
                        <th class="font-weight-bold">管理権限区分</th>
                        <th class="font-weight-bold">更新日時</th>
                        <th class="font-weight-bold">更新者</th>
                    </tr>
                </thead>
                <tbody>
                    @if (@Model != null && @Model.M_UserList != null && @Model.M_UserList.Count > 0)
                    {
                        @foreach (var item in @Model.M_UserList)
                        {
                            <tr>
                                <td>
                                    <button class="btn btn-secondary btn-icon-split" title="詳細"
                                            onclick="OnDetailClick('@item.UserID')" data-id="@item.UserID" data-toggle="modal" data-target="#userDetailModal">
                                        <i class="fa-solid fa-list"></i>
                                    </button>
                                    <a class="btn btn-success btn-icon-split ml-1 mr-1" title="編集" asp-controller="M_User" asp-action="Edit" asp-route-id="@item.UserID">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <button class="btn btn-danger btn-icon-split" title="削除"
                                            onclick="OnDeleteClick('@item.UserID')" data-id="@item.UserID" data-toggle="modal" data-target="#userDeleteModal">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </td>
                                <td>@item.UserID</td>
                                <td>@item.LoginID</td>
                                <td>@item.UserName</td>
                                <td>@item.DepoName</td>
                                <td>@item.AuthorizedKubunName</td>
                                <td>@item.UpdatedAt</td>
                                <td>@item.UpdatedBy</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- User Detail Modal-->
<div class="modal fade" id="userDetailModal" tabindex="-1" role="dialog" aria-labelledby="userDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="userDetailModalLabel">ユーザーマスター詳細</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="col-12">
                    <p class="mb-0">ログインID：<span id="detailLoginId"></span></p>
                    <p>ユーザー名：<span id="detailUserName"></span></p>
                    <p class="mb-1">使用倉庫名</p>
                    <div class="p-2">
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th class="text-left border-top-0 font-weight-bold" scope="col">倉庫コード</th>
                                    <th class="text-left border-top-0 font-weight-bold" scope="col">倉庫名</th>
                                </tr>
                            </thead>
                            <tbody id="depo-contatiner">
                            </tbody>
                        </table>
                    </div>
                    <p class="mb-1">使用ハンディメニュー名</p>
                    <div class="col-12 p-2">
                        <table class="col-6 table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th class="text-left border-top-0 font-weight-bold" scope="col">ハンディメニュー名</th>
                                </tr>
                            </thead>
                            <tbody id="menu-contatiner">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- User Delete Modal-->
<div class="modal fade" id="userDeleteModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="userDeleteModalLabel">削除</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="col-12 col-md-10">
                    <p id="import-res" class="mt-1"></p>
                </div>
                <div class="d-flex justify-content-center">
                    <div class="col-12 col-md-10">
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4 col-md-4">
                                <label>ID</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-7 mb-2">
                                <input class="form-control" id="deleteUserId" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4 col-md-4">
                                <label>ログインID</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-7 mb-2">
                                <input class="form-control" id="deleteLoginId" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4 col-md-4">
                                <label>ユーザー名</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-7 mb-2">
                                <input class="form-control" id="deleteUserName" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap justify-content-center p-2 p-md-3">
                            <button class="btn btn-danger btn-icon-split mb-2 mr-0 mr-sm-5" onclick="OnExecuteDelete()">
                                <span class="text" style="min-width:84px">削除</span>
                            </button>
                            <button class="btn btn-secondary btn-icon-split mb-2" data-dismiss="modal" aria-label="Close">
                                <span class="text">キャンセル</span>
                            </button>
                        </div>
                    </div>
                </div>
                
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

    // 詳細ボタン押下
    function OnDetailClick(userID) {
        // M_UserModel取得
        var data = @Html.Raw(Json.Serialize(Model));
        var userModel = data.m_UserList;
        console.log(userModel)

        userModel.forEach(function(item) {
            // ユーザーIDが一致する情報のみ取得
            if (item.userID == userID) {
                // ログインID
                $("#detailLoginId").text(item.loginID);

                // ユーザー名
                $("#detailUserName").text(item.userName);

                // 使用倉庫
                var depoList = item.m_DepoList;
                var listContainer = $("#depo-contatiner");
                listContainer.empty();
                if (depoList != null) {
                    depoList.forEach(function (depo) {
                        let th1 = "<th class='text-left' scope='row'>" + depo.depoCode + "</th>";
                        let th2 = "<td class='text-left'>" + depo.depoName + "</td>";
                        listContainer.append("<tr>" + th1 + th2 + "</tr>");
                    });
                }

                // 使用ハンディメニュー
                var menuList = item.m_HandyMenuList;
                var menuContainer = $("#menu-contatiner");
                menuContainer.empty();
                if (menuList != null) {
                    menuList.forEach(function (menu) {
                        menuContainer.append("<tr><td class='text-left'>" + menu.handyMenuName + "</td></tr>");
                    });
                }
            }
        });
    }

    // 削除ボタン押下
    function OnDeleteClick(userID) {
        // M_UserModel取得
        var data = @Html.Raw(Json.Serialize(Model));
        var userModel = data.m_UserList;

        userModel.forEach(function (item) {
            // ユーザーIDが一致する情報のみ取得
            if (item.userID == userID) {
                // ユーザーID
                $("#deleteUserId").val(item.userID);
                // ログインID
                $("#deleteLoginId").val(item.loginID);
                // ユーザー名
                $("#deleteUserName").val(item.userName);
            }
        });
    }

    // 削除
    function OnExecuteDelete() {
        $('#div-error-message').text("");
        $('#import-res').text("");

        // URL
        var currentUrl = window.location.origin + window.location.pathname;
        if (!currentUrl.endsWith("/")) {
            currentUrl += "/";
        }
        var deleteUrl = currentUrl + "Delete";

        // POSTするデータ
        var userId = document.getElementById('deleteUserId').value;
        formData = {
            "userId" : userId
        };
        
        // ajax
        $.ajax({
            url: deleteUrl,
            method: "POST",
            data: formData
        })
        .done(function (data) {
            // 完了モーダル表示
            $('#userDeleteModal').modal('hide');
            $('#userDeleteModal').hide();
            AlertMessage('', '完了', '削除が完了しました。', null, null);
        })
        .fail(function (xhr) {
            if (xhr.status === 404) {
                // データが見つからなかった場合
                var errorMessage = xhr.responseJSON.errorMessage;
                $("#div-error-message").hide();
                $("#import-res").show();
                $("#import-res").addClass('text-danger');
                $("#import-res").text("エラー: " + errorMessage);
            } else {
                // その他のエラーの場合
                $("#div-error-message").hide();
                $("#import-res").show();
                $("#import-res").addClass('text-danger');
                $("#import-res").text("データの取得に失敗しました。");
            }
        });
    }

</script>