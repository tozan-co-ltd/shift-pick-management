@using ai_truck_load_measurement.Commons;
@model ai_truck_load_measurement.Models.M_UserListViewModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.CategoryTitle + " - " + Model.ViewTitle;
}
<div class="card shadow de-inspection masterInfo m-4">
    <div class="card-header">
        @ViewData["Title"]
    </div>
    <div class="card-body">

        <div class="form-group col-sm-12 pl-3">
            <p id="div-error-message" class="mt-1 text-danger"></p>

            @if (ViewData["ErrorMessage"] != null)
            {
                <span class="mt-1 text-danger">@ViewData["ErrorMessage"]</span>
            }
        </div>

        <div class="row mb-3">
            <div class="col-lg-10">
                <div class="card border-left-custom">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li>メインデポに設定されたデポが各画面のデフォルト値として登録されます。</li>
                            <li>管理者権限が「管理者」のユーザーはマスターと荷量実績の荷量の相違を登録・編集できます。</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="mg-bot-20">
            <div class="col-12 d-flex xs-block justify-content-start align-items-center p-0">
                <div class="input-group-append mr-2">
                    <a class="btn btn-primary btn-icon-split btn-register" asp-controller="M_User" asp-action="Register">
                        <span class="icon text-white-50">
                            <i class="fas fa-plus"></i>
                        </span>
                        <span class="text">新規作成</span>
                    </a>
                </div>
                <div class="input-group-append">
                    <a href="#" class="btn btn-info btn-icon-split" onclick="onExportFile('M_User', '@Model.ViewTitle')">
                        <span class="icon text-white-50">
                            <i class="fas fa-file-export"></i>
                        </span>
                        <span class="text">Excel出力</span>
                    </a>
                </div>
            </div>
        </div>
        <div class="mt-3">
            <table class="table table-sm stripe hover nowrap datatable-normal table-center">
                <thead>
                    <tr align="center">
                        <th width="40"></th>
                        <th class="font-weight-bold">ユーザーID</th>
                        <th class="font-weight-bold">AD名</th>
                        <th class="font-weight-bold">メインデポ</th>
                        <th class="font-weight-bold">管理権限</th>
                        <th class="font-weight-bold">メール受け取り要否</th>
                        <th class="font-weight-bold">メールアドレス</th>
                        <th class="font-weight-bold">更新日時</th>
                        <th class="font-weight-bold">更新者</th>
                    </tr>
                </thead>
                <tbody>
                    @if (@Model.M_UserList != null)
                    {
                        @foreach (var item in @Model.M_UserList)
                        {
                            <tr>
                                <td>
                                    <a class="btn btn-success btn-icon-split ml-1 mr-1"
                                       onclick="OnEditClick('@item.UserID')" data-id="@item.UserID" data-toggle="modal" data-target="#edit-modal">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <button class="btn btn-danger btn-icon-split"
                                            onclick="OnDeleteClick('@item.UserID')" data-id="@item.UserID" data-toggle="modal" data-target="#delete-modal">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </td>
                                <td>@item.UserID</td>
                                <td>@item.ADName</td>
                                <td>@item.DepoName</td>
                                @if(item.AuthorizedKubun == 0)
                                {
                                    <td>なし</td>
                                }else if(item.AuthorizedKubun == 1)
                                {
                                    <td>管理者</td>
                                }
                                @if (item.IsRequiredMail)
                                {
                                    <td>受け取る</td>
                                }
                                else
                                {
                                    <td>受け取らない</td>
                                }
                                <td>@item.MailAddress</td>
                                <td>@item.UpdatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                <td>@item.UpdatedBy</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!--  Edit Modal-->
<div class="modal fade" id="edit-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="edit-modal-label">編集</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="col-12 col-md-12">
                    <p id="edit-modal-error-message" class="mt-1 text-danger"></p>
                </div>
                <div class="d-flex justify-content-center">
                    <form class="col-md-12" id="mUserForm">
                        <div class="col-14 input-group div-input-group">
                            <div class="col-14 input-group div-input-group">
                                <div class="col-12 col-sm-4 col-md-3 column-1st">
                                    <label>@Html.DisplayName("UserID")</label>
                                </div>
                                <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                    <input class="form-control" type="text" asp-for="UserID" autocomplete="off" readonly id="UserID">
                                </div>
                            </div>
                            <div class="col-12 col-sm-4 col-md-3 column-1st">
                                <label>@Html.DisplayName("ADName")<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <input class="form-control" type="text" asp-for="ADName" autocomplete="off" value="" required id="ADName">
                                <span class="text-danger w-100" asp-validation-for="ADName"></span>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st">
                                <label>@Html.DisplayName("DepoID")<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <select class="form-select" name="DepoID" asp-for="DepoID" asp-items="@Model.MDepoList" required id="DepoID"></select>
                                <span class="text-danger w-100" asp-validation-for="DepoID"></span>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st">
                                <label>@Html.DisplayName("AuthorizedKubun")<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <input type="radio" class="mr-2" asp-for="AuthorizedKubun" value="1" name="AuthorizedKubun" id="hasAuthorizedKubun">
                                <label for="hasAuthorizedKubun">権限あり</label>
                                <input type="radio" class="mr-2 ml-3" asp-for="AuthorizedKubun" value="0" name="AuthorizedKubun" id="notHasAuthorizedKubun" checked>
                                <label for="notHasAuthorizedKubun">権限なし</label>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st">
                                <label>@Html.DisplayName("IsRequiredMail")<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <input type="radio" class="mr-2" asp-for="IsRequiredMail" autocomplete="off" value="true" name="IsRequiredMail" id="isRequiredMail">
                                <label for="isRequiredMail">受け取る</label>
                                <input type="radio" class="mr-2 ml-3" asp-for="IsRequiredMail" autocomplete="off" value="false" name="IsRequiredMail" id="isNotRequiredMail" checked>
                                <label for="isNotRequiredMail">受け取らない</label>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st">
                                <label>@Html.DisplayName("MailAddress")</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <input class="form-control" type="text" asp-for="MailAddress" autocomplete="off" value="" id="MailAddress">
                                <span class="text-danger w-100" asp-validation-for="MailAddress"></span>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap justify-content-center p-2 p-md-3">
                            <button class="btn btn-secondary btn-icon-split mb-2 mr-0 mr-sm-5" data-dismiss="modal" aria-label="Close">
                                <span class="text">キャンセル</span>
                            </button>
                            <button class="btn btn-success btn-icon-split mb-2" onclick="OnExecuteEdit()">
                                <span class="text" style="min-width:84px">更新</span>
                            </button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

<!--  Delete Modal-->
<div class="modal fade" id="delete-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="delete-modal-label">削除</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body unset-pd">
                <div class="col-12 col-md-12">
                    <p id="delete-modal-error-message" class="mt-1 text-danger"></p>
                </div>
                <div class="d-flex justify-content-center">
                    <div class="col-12 col-md-12">
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4 col-md-4">
                                <label>ユーザーID</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 mb-2">
                                <input class="form-control" id="deleteUserID" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4 col-md-4">
                                <label>AD名</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 mb-2">
                                <input class="form-control" id="deleteADName" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4 col-md-4">
                                <label>メインデポ</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 mb-2">
                                <input class="form-control" id="deleteDepoName" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4 col-md-4">
                                <label>管理権限</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 mb-2">
                                <input class="form-control" id="deleteAuthorizedKubun" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4 col-md-4">
                                <label>メール受け取り要否</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 mb-2">
                                <input class="form-control" id="deleteIsRequiredMail" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4 col-md-4">
                                <label>メールアドレス</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 mb-2">
                                <input class="form-control" id="deleteMailAddress" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap justify-content-center p-2 p-md-3">
                            <button class="btn btn-secondary btn-icon-split mb-2 mr-0 mr-sm-5" data-dismiss="modal" aria-label="Close">
                                <span class="text">キャンセル</span>
                            </button>
                            <button class="btn btn-danger btn-icon-split mb-2" onclick="OnExecuteDelete()">
                                <span class="text" style="min-width:84px">削除</span>
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    // ロード時の処理
    $(document).ready(function () {
        // M_UserModel取得
        var userModel = @Html.Raw(Json.Serialize(Model));
        console.log(userModel);
    })

    // 編集ボタン押下
    function OnEditClick(userID) {
        DeleteErrorMessages();

        // M_UserModel取得
        var userModel = @Html.Raw(Json.Serialize(Model));
        var radio = document.getElementsByName("AuthorizedKubun");
        userModel.m_UserList.forEach(function (item) {
            if (item.userID == userID) {
                $("#UserID").val(item.userID);
                $("#ADName").val(item.adName);
                $("#DepoID").val(item.depoID);
                var authorizedKubun = item.authorizedKubun;
                AuthorizedKubunCheck(authorizedKubun);
                IsRequiredMailCheck(item.isRequiredMail);
                $("#MailAddress").val(item.mailAddress);
            }
        });
    }

    // 現在の管理区分にチェックを入れる
    function AuthorizedKubunCheck(authorizedKubun) {
        document.getElementsByName("AuthorizedKubun").forEach(function (item) {
            if (item.value == authorizedKubun)
                item.checked = true;
        });
    }

    // 現在のメール受け取り要否をチェックボックスに反映する
    function IsRequiredMailCheck(isRequired) {
        if (isRequired) {
            document.getElementById("isRequiredMail").checked = true;
        }
        else {
            document.getElementById("isNotRequiredMail").checked = true;
        }
    
    }

    // 更新
    function OnExecuteEdit() {
        $('#mUserForm').submit(function (event) {
            DeleteErrorMessages();

            // ページの更新を禁止する
            event.preventDefault();

            // 送信イベントが他のハンドラーに伝播するのを防ぐ
            event.stopImmediatePropagation();

            // フォーム情報取得
            let url = window.location.origin + '@Url.Action("Edit", "M_User")';
            let method = 'POST';
            let formId = 'mUserForm';
            let data = $('#' + formId).serializeArray();

            // Ajax call
            $.ajax({
                url: url,
                method: method,
                data: data
            }).done(function (response) {
                $('#edit-modal').hide();
                // 完了モーダル表示
                AlertMessage('', '完了', '登録が完了しました。', null, null);
            }).fail(function (jqXHR, textStatus, errorThrown) {
                var errorMessage = jqXHR.responseJSON.errorMessage;
                $("#edit-modal-error-message").text(errorMessage);
            });
        });
    }

    // 削除ボタン押下
    function OnDeleteClick(userID) {
        // M_UserModel取得
        var userModel = @Html.Raw(Json.Serialize(Model));
        userModel.m_UserList.forEach(function (item) {

            if (item.userID == userID) {
                $("#deleteUserID").val(item.userID);
                $("#deleteADName").val(item.adName);
                $("#deleteDepoName").val(item.depoName);
                var authorizedKubun = "";
                if (item.authorizedKubun == 0) {
                    authorizedKubun = "管理者";
                }else if(item.authorizedKubun == 1){
                    authorizedKubun = "なし";
                }
                $("#deleteAuthorizedKubun").val(authorizedKubun);
                if (item.isRequiredMail) {
                    $("#deleteIsRequiredMail").val("受け取る");
                }
                else{
                    $("#deleteIsRequiredMail").val("受け取らない");
                }
                $("#deleteMailAddress").val(item.mailAddress);
            }
        });
    }

    // 削除
    function OnExecuteDelete() {
        DeleteErrorMessages();

        // フォーム情報取得
        let url = window.location.origin + '@Url.Action("Delete", "M_User")';
        let method = 'POST';
        let data = { "userId": $('#deleteUserID').val() };
        console.log($('#deleteUserId').val);

        // Ajax call
        $.ajax({
            url: url,
            method: method,
            data: data
        }).done(function (response) {
            $('#delete-modal').hide();
            // 完了モーダル表示
            AlertMessage('', '完了', '登録が完了しました。', null, null);
        }).fail(function (jqXHR, textStatus, errorThrown) {
            var errorMessage = jqXHR.responseJSON.errorMessage;
            $("#delete-modal-error-message").text(errorMessage);
        });
    }
</script>