                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-md-4 column-1st label-input-model-pl">
                                <label>パスワード</label>
                            </div>
                            <div class="col-12  col-md-8 column-2nd">
                                <input class="form-control" type="text" autocomplete="off" value="" required>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-md-4 column-1st label-input-model-pl">
                                <label>利用者名</label>
                            </div>
                            <div class="col-12  col-md-8 column-2nd">
                                <input class="form-control" type="text" autocomplete="off" value="" required>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-md-4 column-1st label-input-model-pl">
                                <label>住所</label>
                            </div>
                            <div class="col-12  col-md-8 column-2nd">
                                <textarea class="form-control" type="text" autocomplete="off" value="" required></textarea>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-md-4 column-1st label-input-model-pl">
                                <label>電話番号</label>
                            </div>
                            <div class="col-12  col-md-8 column-2nd">
                                <input class="form-control" type="text" autocomplete="off" value="" required>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-md-4 column-1st label-input-model-pl">
                                <label>利用者名</label>
                            </div>
                            <div class="col-12  col-md-8 column-2nd">
