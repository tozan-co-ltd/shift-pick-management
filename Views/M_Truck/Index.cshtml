@using ai_truck_load_measurement.Commons;
@model ai_truck_load_measurement.Models.M_TruckModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.CategoryTitle + " - " + Model.ViewTitle;
}
<div class="card shadow de-inspection masterInfo m-4">
    <div class="card-header">
        @ViewData["Title"]
    </div>
    <div class="card-body">

        <div class="form-group col-sm-12 pl-3">
            <p id="div-error-message" class="mt-1 text-danger"></p>

            @if (ViewData["ErrorMessage"] != null)
            {
                <span class="mt-1 text-danger">@ViewData["ErrorMessage"]</span>
            }
        </div>

        <div class="mg-bot-20">
            <div class="col-12 d-flex xs-block justify-content-start align-items-center p-0">
                <div class="input-group-append mr-2">
                    <a class="btn btn-primary btn-icon-split btn-register" asp-controller="M_Truck" asp-action="Register">
                        <span class="icon text-white-50">
                            <i class="fas fa-plus"></i>
                        </span>
                        <span class="text">新規作成</span>
                    </a>
                </div>
                <div class="input-group-append">
                    <a href="#" class="btn btn-info btn-icon-split" onclick="onExportFile('M_Truck', '@Model.ViewTitle')">
                        <span class="icon text-white-50">
                            <i class="fas fa-file-export"></i>
                        </span>
                        <span class="text">出力</span>
                    </a>
                </div>
            </div>
        </div>
        <div class="mt-3">
            <table class="table table-sm stripe hover nowrap datatable-normal table-center">
                <thead>
                    <tr align="center">
                        <th width="40"></th>
                        <th class="font-weight-bold">車両ID</th>
                        <th class="font-weight-bold">車両番号</th>
                        <th class="font-weight-bold">識別番号</th>
                        <th class="font-weight-bold">更新日時</th>
                        <th class="font-weight-bold">更新者</th>
                    </tr>
                </thead>
                <tbody>
                    @if (@Model.M_TruckList != null)
                    {
                        @foreach (var item in @Model.M_TruckList)
                        {
                            <tr>
                                <td>
                                    <a class="btn btn-success btn-icon-split ml-1 mr-1"
                                       onclick="OnEditClick('@item.TruckID')" data-id="@item.TruckID" data-toggle="modal" data-target="#edit-modal">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <button class="btn btn-danger btn-icon-split"
                                            onclick="OnDeleteClick('@item.TruckID')" data-id="@item.TruckID" data-toggle="modal" data-target="#delete-modal">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </td>
                                <td>@item.TruckID</td>
                                <td>@item.TruckNumber</td>
                                <td>@item.IdentifyNumber</td>
                                <td>@item.UpdatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                <td>@item.UpdatedBy</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!--  Edit Modal-->
<div class="modal fade" id="edit-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="edit-modal-label">更新</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="col-12 col-md-12">
                    <p id="edit-modal-error-message" class="mt-1 text-danger"></p>
                </div>
                <div class="d-flex justify-content-center">
                    <form class="col-md-12" id="mTruckForm">
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl">
                                <label>@Html.DisplayName("TruckID")</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <input class="form-control" type="text" asp-for="TruckID" autocomplete="off" readonly>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl">
                                <label>@Html.DisplayName("TruckNumber")<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <input class="form-control" type="text" asp-for="TruckNumber" autocomplete="off" value="" required>
                                <small class="form-text text-muted w-100 p-1">4桁の半角数字で入力してください。</small>
                                <span class="text-danger w-100" asp-validation-for="TruckNumber"></span>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl">
                                <label>@Html.DisplayName("IdentifyNumber")<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <input class="form-control" type="text" asp-for="IdentifyNumber" autocomplete="off" value="" required>
                                <small class="form-text text-muted w-100 p-1">4桁の半角数字で入力してください。</small>
                                <span class="text-danger w-100" asp-validation-for="IdentifyNumber"></span>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap justify-content-center p-2 p-md-3">
                            <button class="btn btn-secondary btn-icon-split mb-2 mr-0 mr-sm-5" data-dismiss="modal" aria-label="Close">
                                <span class="text">キャンセル</span>
                            </button>
                            <button class="btn btn-success btn-icon-split mb-2" onclick="OnExecuteEdit()">
                                <span class="text" style="min-width:84px">更新</span>
                            </button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

<!--  Delete Modal-->
<div class="modal fade" id="delete-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="delete-modal-label">削除</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body unset-pd">
                <div class="col-12 col-md-12">
                    <p id="delete-modal-error-message" class="mt-1 text-danger"></p>
                </div>
                <div class="d-flex justify-content-center">
                    <div class="col-12 col-md-12">
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4 col-md-4">
                                <label>車両ID</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 mb-2">
                                <input class="form-control" id="deleteTruckId" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4 col-md-4">
                                <label>車両番号</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 mb-2">
                                <input class="form-control" id="deleteTruckNumber" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4 col-md-4">
                                <label>識別番号</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 mb-2">
                                <input class="form-control" id="deleteIdentifyNumber" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap justify-content-center p-2 p-md-3">
                            <button class="btn btn-secondary btn-icon-split mb-2 mr-0 mr-sm-5" data-dismiss="modal" aria-label="Close">
                                <span class="text">キャンセル</span>
                            </button>
                            <button class="btn btn-danger btn-icon-split mb-2" onclick="OnExecuteDelete()">
                                <span class="text" style="min-width:84px">削除</span>
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    // 編集ボタン押下
    function OnEditClick(truckID) {
        DeleteErrorMessages();

        // M_TruckModel取得
        var truckModel = @Html.Raw(Json.Serialize(Model));
        truckModel.m_TruckList.forEach(function (item) {
            if (item.truckID == truckID) {
                $("#TruckID").val(item.truckID);
                $("#TruckNumber").val(item.truckNumber);
                $("#IdentifyNumber").val(item.identifyNumber);
            }
        });
    }

    // 更新
    function OnExecuteEdit() {
        $('#mTruckForm').submit(function (event) {
            DeleteErrorMessages();

            // ページの更新を禁止する
            event.preventDefault();

            // 送信イベントが他のハンドラーに伝播するのを防ぐ
            event.stopImmediatePropagation();

            // フォーム情報取得
            let url = window.location.origin + '@Url.Action("Edit", "M_Truck")';
            let method = 'POST';
            let formId = 'mTruckForm';
            let data = $('#' + formId).serializeArray();

            // Ajax call
            $.ajax({
                url: url,
                method: method,
                data: data
            }).done(function (response) {
                $('#edit-modal').hide();
                // 完了モーダル表示
                AlertMessage('', '完了', '登録が完了しました。', null, null);
            }).fail(function (jqXHR, textStatus, errorThrown) {
                if (jqXHR.status === 404) {
                    var errorMessage = jqXHR.responseJSON.errorMessage;
                    $("#edit-modal-error-message").text(errorMessage);
                } else {
                    var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                    $("#edit-modal-error-message").text(errorMessage);
                }
            });
        });
    }

    // 削除ボタン押下
    function OnDeleteClick(truckID) {
        console.log("OnDeleteClick", truckID)
        // M_TruckModel取得
        var truckModel = @Html.Raw(Json.Serialize(Model));
        truckModel.m_TruckList.forEach(function (item) {

            if (item.truckID == truckID) {
                $("#deleteTruckId").val(item.truckID);
                $("#deleteTruckNumber").val(item.truckNumber);
                $("#deleteIdentifyNumber").val(item.identifyNumber);
            }
        });
    }

    // 削除
    function OnExecuteDelete() {
        DeleteErrorMessages();

        // フォーム情報取得
        let url = window.location.origin + '@Url.Action("Delete", "M_Truck")';
        let method = 'POST';
        let data = { "TruckId": $('#deleteTruckId').val() };

        // Ajax call
        $.ajax({
            url: url,
            method: method,
            data: data
        }).done(function (response) {
            $('#delete-modal').hide();
            // 完了モーダル表示
            AlertMessage('', '完了', '登録が完了しました。', null, null);
        }).fail(function (jqXHR, textStatus, errorThrown) {
            if (jqXHR.status === 404) {
                var errorMessage = jqXHR.responseJSON.errorMessage;
                $("#delete-modal-error-message").text(errorMessage);
            } else {
                var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                $("#delete-modal-error-message").text(errorMessage);
            }
        });
    }

    // エラーメッセージ削除
    function DeleteErrorMessages() {
        $('#div-error-message').text('');
        $('#edit-modal-error-message').text('');
        $('#delete-modal-error-message').text('');
        $('.text-danger').text('');
        $('input').removeClass('input-validation-error');
    }
</script>