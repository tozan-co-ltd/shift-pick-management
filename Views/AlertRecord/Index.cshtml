@using ai_truck_load_measurement.Commons;
@model ai_truck_load_measurement.Models.AlertRecordViewModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.CategoryTitle + " - " + Model.ViewTitle;
}

<div class="card shadow de-inspection masterInfo m-4">
    <div class="card-header">
        @ViewData["Title"]
    </div>

    <div class="card-body">

        <div class="row">
            <div class="col-lg-10">
                <div class="card border-left-custom">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li>最長90日の期間が検索できます。</li>
                            <li>便枝番とは、便が各拠点へ訪問した回数を示すために昼勤開始時間から順に割り当てた番号です。</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group col-sm-12 pl-3">
            <p id="div-error-message" class="mt-1 text-danger"></p>

            @if (ViewData["ErrorMessage"] != null)
            {
                <span class="mt-1 text-danger">@ViewData["ErrorMessage"]</span>
            }
        </div>
        <div class="col-16 d-flex justify-content-start align-items-center unset-pdl sp-cs-dpl">
            <div class="d-flex justify-content-start align-items-center mb-3 unset-pdl">
                <span class="warehouse-name-drs span-paragraph">デポ</span>
                <div>
                    <label class="mr-2"><input type="checkbox" class=" mr-2" id="allDepo" />すべて  [</label>
                    <label id="selectDepos"></label>]
                </div>
            </div>
        </div>

        <div class="col-16 d-flex justify-content-start align-items-center unset-pdl sp-cs-dpl">
            <div class="d-flex justify-content-start align-items-center unset-pdl">
                <span class="warehouse-name-drs span-paragraph">稼働日</span>
                <input type="text" id="startOfPeriod" class="form-control pickerDate startDate">
                <label class="m-1">～</label>
                <input type="text" id="endOfPeriod" class="form-control pickerDate endDate mr-3">
                <div class="input-group-append mr-3">
                    <a class="btn btn-secondary btn-icon-split" onclick="onSearchClick()">
                        <span class="icon text-white-50">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span>
                        <span class="text">検索</span>
                    </a>
                </div>
            </div>
        </div>

        <hr />

        <div class="mg-bot-20 mb-3">
            <div class="col-12 d-flex xs-block justify-content-start align-items-center p-0">
                <div class="input-group-append mr-1">
                    <a class="btn btn-info btn-icon-split" onclick="onExportFileAlert('AlertRecord', '@Model.ViewTitle')" id="exportFile">
                        <span class="icon text-white-50">
                            <i class="fas fa-file-export"></i>
                        </span>
                        <span class="text">Excel出力</span>
                    </a>
                </div>
                <div class="input-group-append mr-3">
                    <a class="btn btn-info btn-icon-split" onclick="onExportAllImages('AlertRecord')">
                        <span class="icon text-white-50">
                            <i class="fa-solid fa-circle-down"></i>
                        </span>
                        <span class="text">画像一括出力</span>
                    </a>
                </div>
            </div>
        </div>


        <div class="mt-3" id="alertRecordTable">
        </div>
    </div>
</div>

<!--  Detail Modal-->
<div class="modal fade" id="detail-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="loader-modal" id="loading-modal">
            <div class="three-quarter-spinner"></div>
        </div>
        <div class="modal-content trip-record-modal" id="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detail-modal-label"></h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="col-12 col-md-12">
                    <p id="edit-modal-error-message" class="mt-1 text-danger"></p>
                </div>
                <figure class="mb-2 modal-img"><img src="" id="modalImage" /></figure>
                <div id="tripRecord-buttons"></div>
                <table class="table table-sm p-2 modal-table">
                    <tbody id="tripRecord-contatiner">
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    // 画面ロード時
    $(document).ready(function () {
        model = @Html.Raw(Json.Serialize(Model));
        var today = new Date();
        var oneWeekAgo = new Date();
        oneWeekAgo.setDate(oneWeekAgo.getDate() - 7);
        $('#endOfPeriod').val(GetDayString(today));
        $('#startOfPeriod').val(GetDayString(oneWeekAgo));
        addDepos(model);
        depoCheckDisplay(model);
        tableDisplay();
        if(model.transitionAlertRecordID != 0){
            showTransitionAlertRecordModal(model);
        }
    });

    // ログイン画面からの遷移時処理
    function showTransitionAlertRecordModal(model){
        const modal = new bootstrap.Modal(document.getElementById('detail-modal'));
            modal.show();
            arrayTrs = [];
            model.alertRecordList.forEach(function(item){
                arrayTrs.push(String(item.alertRecordID));
            });
            EditAlertModal(model.transitionAlertRecordID, model.transitionIsArrived, "page");
    }

    // 「すべて」チェックボックス押下時
    $('input[id=allDepo]').change(function () {
        pushAllCheckBox();
    });

    // アラート履歴テーブルの表示
    function tableDisplay() {
        // チェックボックスの入力情報取得
        var checkedDepos = getCheckedDepos();


        // 期間の開始、終了日付の取得
        var startOfPeriod = GetDayString(new Date($('#startOfPeriod').val()));
        var endOfPeriod = GetDayString(new Date($('#endOfPeriod').val()));

        // フォーム情報取得
        let url = window.location.origin + '@Url.Action("SearchData", "AlertRecord")';
        let method = 'Post';
        let data = { startOfPeriod: startOfPeriod, endOfPeriod: endOfPeriod, checkedDepos: checkedDepos };

        // Ajax call
        $.ajax({
            url: url,
            method: method,
            data: data
        }).done(function (response) {

            $('#alertRecordTable').empty().html(response.searchedTripRecordHTML);
            tableLength = response.searchedTripRecordLength + 1;
            // 日本語表示
            const language_url = "https://cdn.datatables.net/plug-ins/1.11.5/i18n/ja.json";
            const dom_structure = "<'top d-flex align-items-center'li<'ml-auto'f>>rt<'bottom'p><'clear'>";

            // ID(2列目)昇順
            $("#tripTable").DataTable({
                "language": {
                    "url": language_url
                },
                lengthChange: true,     // 件数切替
                info: true,            // 総件数
                scrollX: true,          // 横スクロール可
                scrollCollapse: true,   // 縦スクロール表示
                order: [[1, "asc"]],    // ID昇順
                searchHighlight: true,  // 検索ハイライト
                
                "oLanguage": {
                    "sSearch": "フリーワード(全件)"
                },
                dom: dom_structure
            });
        }).fail(function (jqXHR, textStatus, errorThrown) {
            if (jqXHR.status === 404) {
                var errorMessage = jqXHR.responseJSON.errorMessage;
                $("#edit-modal-error-message").text(errorMessage);
            } else {
                var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                $("#edit-modal-error-message").text(errorMessage);
            }
        });
    }

    // 検索ボタン押下時
    function onSearchClick() {
        DeleteErrorMessages();
        if (isWithin90Days()) {
            tableDisplay();
        }
        else {
            var errorMessage = 'E1007: 検索できる期間は最長90日です。90日を超えないように選択してください。';
            $("#div-error-message").text(errorMessage);
        }
    }

    // Excel出力
    async function onExportFileAlert(page, gamenName) {
        event.preventDefault();
        $('#div-error-message').text("");

        // チェックボックスの入力情報取得
        var checkedDepos = getCheckedDepos();

        // 期間の開始、終了日付の取得
        var startOfPeriod = GetDayString(new Date($('#startOfPeriod').val()));
        var endOfPeriod = GetDayString(new Date($('#endOfPeriod').val()));

        // フォーム情報取得
        let data = {
            "gamenName": gamenName,
            "startOfPeriod": startOfPeriod,
            "endOfPeriod": endOfPeriod,
            checkedDepos: checkedDepos
        };

        // Excel出力共通処理
        onExportFileTripsCommon(page, data);

    }

    // 画像一括出力ボタン押下
    function onExportAllImages(page) {
        event.preventDefault();
        DeleteErrorMessages();
        if (isWithin90Days()) {
            // 期間の開始、終了日付の取得
            var startOfPeriod = GetDayString(new Date($('#startOfPeriod').val()));
            var endOfPeriod = GetDayString(new Date($('#endOfPeriod').val()));

            // デポ情報取得
            var checkedDepos = getCheckedDepos();

            let data = {
                download: "download",
                startOfPeriod: startOfPeriod,
                endOfPeriod: endOfPeriod,
                checkedDepos: checkedDepos
            };

            onExportAllImagesCommon(page, data);
        }
        else {
            var errorMessage = 'E1007: 検索できる期間は最長90日です。90日を超えないように選択してください。';
            $("#div-error-message").text(errorMessage);
        }
    }

    // 到着荷量画像ボタン押下
    function OnArrivalAlertImageClick(alertRecordID, button, page) {
        // デフォルトの操作を無効化
        event.preventDefault();

        // 配列の初期化
        arrayTrs = [];
        // 到着
        var isArrived = true;
        // テーブルに表示されている便実績のIDをリスト化
        trs = button.parentNode.parentNode.parentNode.childNodes;
        for (i = 0; i < trs.length - tableLength; i++) {
            arrayTrs.push(trs[i + tableLength].childNodes[1].textContent);
        }
        EditAlertModal(alertRecordID, isArrived, page);
    }

    // 出発荷量画像ボタン押下
    function OnDepartureAlertImageClick(alertRecordID, button, page) {
        // デフォルトの操作を無効化
        event.preventDefault();

        // 配列の初期化
        arrayTrs = [];
        // 出発
        var isArrived = false;
        // テーブルに表示されている便実績のIDをリスト化
        trs = button.parentNode.parentNode.parentNode.childNodes;
        for (i = 0; i < trs.length - tableLength; i++) {
            arrayTrs.push(trs[i + tableLength].childNodes[1].textContent);
        }
        EditAlertModal(alertRecordID, isArrived, page);
    }

    // アラート詳細モーダル作成
    function EditAlertModal(alertRecordID, isArrived, page) {
        // ローディング画像表示
        $("#modal-content").css('display', 'none');
        $("#loading-modal").css('display', 'inline-block');

        // alertRecordModel取得
        var alertRecordModel = model.alertRecordList;
        alertRecordModel.forEach(function (item) {
            if (item.alertRecordID == alertRecordID) {
                var loadRecord = model.loadRecordList.find(x => x.tripRecordID == item.tripRecordID);
                // フォーム情報取得
                let url = window.location.origin + '@Url.Action("GetModalItems", "AlertRecord")';
                let method = 'POST';
                let data = { loadRecord: loadRecord};

                // Ajax call
                $.ajax({
                    url: url,
                    method: method,
                    data: data
                }).done(function (response) {
                    var imagePath = "";
                    var arriveOrDepartureSchedule = "";
                    var arriveOrDepartureScheduleDate = "";
                    var arriveOrDepartureRecord = "";
                    var arriveOrDepartureRecordDate = "";
                    var lowerLoadStatus = "";
                    var loadStatus = "";
                    var downloadFileName = "";
                    var alertItems = "";
                    var workDayForFile = GetDayStringForFile(new Date(response.workDay));
                    var tripNameAndBranchSeq = response.tripName + "_" + response.tripBranchSeq;
                    var truckNumber = response.truckNumber;
                    if (truckNumber == "0") truckNumber = "-";
                    if (tripNameAndBranchSeq == "-_-") tripNameAndBranchSeq = "-";

                    // 到着か出発かで変わる要素の登録
                    if (isArrived) {
                        $('#detail-modal-label').text("到着荷量画像");
                        alertItems = conversionAlertItemsToHTML(item.arrivalAlertItems);
                        lowerLoadStatus = item.arrivalLowerLoadStatus;
                        loadStatus = response.arrivalLoadStatus;
                        imagePath = response.arrivalLoadImgPath;
                        arriveOrDepartureSchedule = "到着予定";
                        arriveOrDepartureScheduleDate = GetDateString(new Date(response.arrivalScheduledTime));
                        arriveOrDepartureRecord = "到着実績";
                        arriveOrDepartureRecordDate = GetDateString(new Date(response.arrivedAt));
                        downloadFileName = response.tripName + "_" + response.tripBranchSeq + "_" + workDayForFile + "_A_" + loadStatus + ".jpg";
                    }
                    else {
                        $('#detail-modal-label').text("出発荷量画像");
                        alertItems = conversionAlertItemsToHTML(item.departureAlertItems);
                        lowerLoadStatus = item.departureLowerLoadStatus;
                        loadStatus = response.departureLoadStatus;
                        imagePath = response.departureLoadImgPath;
                        arriveOrDepartureSchedule = "出発予定";
                        arriveOrDepartureScheduleDate = GetDateString(new Date(response.departureScheduledTime));
                        arriveOrDepartureRecord = "出発実績";
                        arriveOrDepartureRecordDate = GetDateString(new Date(response.departedAt));
                        downloadFileName = response.tripName + "_" + response.tripBranchSeq + "_" + workDayForFile + "_D_" + loadStatus + ".jpg";
                    }

                    // アラート該当項目の文字色変更
                    var loadAlert = "";
                    var timeAlert = "";
                    if(alertItems.includes("荷量"))
                        loadAlert = "class=\"text-danger\"";
                    if(alertItems.includes("時間"))
                        timeAlert = "class=\"text-danger\"";

                    $('#modalImage').attr("src", "data:image/jpeg;base64," + imagePath);

                    var workDay = GetDayString(new Date(response.workDay));

                    // 表示している行の上下の行の便実績ID取得
                    var alertRecordIDIndex = arrayTrs.indexOf(alertRecordID);
                    var previousAlertRecordID = arrayTrs[alertRecordIDIndex - 1];
                    var nextAlertRecordID = arrayTrs[alertRecordIDIndex + 1];


                    // ボタンの追加
                    var buttons = $("#tripRecord-buttons");
                    buttons.empty();
                    let div = "<div class=\"d-flex xs-block justify-content-start align-items-center p-0 mb-2 trip-record-buttons\">"
                        + "<div class=\"input-group-append mr-3\" >"
                        + " <a href=\"#\" class=\"btn btn-secondary btn-icon-split\" onclick = \"onOtherAlertModalClick('" + previousAlertRecordID + "','" + isArrived + "','" + page + "')\" >"
                        + "<span class=\"text\" >▲上へ</span>"
                        + "</a>"
                        + "</div>"
                        + "<div class=\"input-group-append mr-3\" >"
                        + " <a href=\"#\" class=\"btn btn-secondary btn-icon-split\" onclick = \"onOtherAlertModalClick('" + nextAlertRecordID + "','" + isArrived + "','" + page + "')\" >"
                        + "<span class=\"text\" >▼下へ</span>"
                        + "</a>"
                        + "</div>"
                        + "<div class=\"input-group-append mr-3 right-button\" >"
                        + " <a href=\"data:image/jpeg;base64," + imagePath + "\", download=\"" + downloadFileName + "\" class=\"btn btn-info btn-icon-split\"  >"
                        + "<span class=\"icon text-white-50\" >"
                        + "<i class=\"fa-solid fa-circle-down\" > </i>"
                        + "</span>"
                        + "<span class=\"text\" >画像出力</span>"
                        + "</a>"
                        + "</div>";
                    buttons.append(div);

                    // テーブルの追加
                    var container = $("#tripRecord-contatiner");
                    container.empty();
                    let tr = "<tr style=\"background-color: yellow\" class=\"text-danger\">"
                        + "<td>アラート項目</td>"
                        + "<td>" + alertItems + "</td>"
                        + "</tr><tr>"
                        + "<td>荷量下限</td>"
                        + "<td>" + lowerLoadStatus + "%</td>"
                        + "</tr><tr " + loadAlert + ">"
                        + "<td>荷量実績</td>"
                        + "<td>" + loadStatus + "%</td>"
                        + "</tr><tr>"
                        + "<td>便名称_便枝番</td>"
                        + "<td>" + tripNameAndBranchSeq + "</td>"
                        + "</tr><tr>"
                        + "<td>乗務員</td>"
                        + "<td>" + response.driverName + "</td>"
                        + "</tr><tr>"
                        + "<td>ステーション名</td>"
                        + "<td>" + response.stationName + "</td>"
                        + "</tr><tr>"
                        + "<td>車両番号</td>"
                        + "<td>" + truckNumber + "</td>"
                        + "</tr><tr>"
                        + "<td>識別番号</td>"
                        + "<td>" + response.identifyNumber + "</td>"
                        + "</tr><tr>"
                        + "<td>稼働日</td>"
                        + "<td>" + workDay + "</td>"
                        + "</tr><tr>"
                        + "<td>" + arriveOrDepartureSchedule + "</td>"
                        + "<td>" + arriveOrDepartureScheduleDate + "</td>"
                        + "</tr><tr " + timeAlert + ">"
                        + "<td>" + arriveOrDepartureRecord + "</td>"
                        + "<td>" + arriveOrDepartureRecordDate + "</td>"
                        + "</tr>";
                    container.append(tr);

                    // ローディング画像非表示
                    $("#modal-content").css('display', 'inline-block');
                    $("#loading-modal").css('display', 'none');
                }).fail(function (jqXHR, textStatus, errorThrown) {
                var errorMessage = jqXHR.responseJSON.errorMessage;
                $("#edit-modal-error-message").text(errorMessage);
                });
            }
            
        });
    }


    // モーダル内の「上へ」「下へ」ボタン押下時
    function onOtherAlertModalClick(otherTripRecordID, isArrived, page) {
        event.preventDefault();
        if (isArrived == "true") {
            isArrived = true;
        } else {
            isArrived = false;
        }
        if(otherTripRecordID != 'undefined')
            EditAlertModal(otherTripRecordID, isArrived, page);
    }


    function conversionAlertItemsToHTML(alertItems){
        var html = "";
        for(var i=0; i<alertItems.length; i++){
            if(i !=0)
                html += "<br>";
            html += alertItems[i];
        }
        if(html == "")
            html = "なし";
        return html;
    }

</script>