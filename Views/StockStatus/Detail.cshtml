@using mar_sumaken_web.Commons;
@model mar_sumaken_web.Models.StockStatusModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.CategoryTitle + " - " + Model.ViewTitle + " - " + "日別在庫照会";
}
<style>
    .scrollable-table {
        max-height: 300px;
        overflow-y: auto;
    }
</style>
<div class="card shadow de-inspection d-receive-schedule m-4">
    <div class="card-header">
        @ViewData["Title"]
    </div>
    <div class="card-body">
        <div class="col-md-12 pb-0 pl-0">
            <form method="get" asp-controller="StockStatus" asp-action="Index">
                <button type="submit" class="btn btn-secondary btn-icon-split">
                    <span class="icon text-white-50">
                        <i class="fas fa-arrow-left-long"></i>
                    </span>
                    <span class="text">戻る</span>
                </button>
            </form>
        </div>
        <div class="form-group col-sm-12 pl-3">
            <p id="div-error-message" class="mt-1 text-danger"></p>

            @if (ViewData["ErrorMessage"] != null)
            {
                <span class="mt-1 text-danger">@ViewData["ErrorMessage"]</span>
            }
        </div>

        <div class="mg-bot-20">
            <div class="col-16 sp-tablet mb-3">
                <div class="row mt-10">
                    <div class="col-lg-12">
                        <form id="searchForm" method="post" enctype="multipart/form-data" name="form" onsubmit="return false;">
                            <div class="col-16 d-flex justify-content-start align-items-center mb-3 unset-pdl">
                                <span class="warehouse-name-drs">倉庫名</span>
                                <div class="unset-pdl cs-w300">
                                    <input type="hidden" asp-for="DepoID" />
                                    <input class="form-control" asp-for="DepoName" readonly />
                                </div>
                            </div>
                            <div class="col-16 d-flex justify-content-start align-items-center mb-3 unset-pdl">
                                <span class="warehouse-name-drs">仕入先名</span>
                                <div class="unset-pdl cs-w300">
                                    <input type="hidden" asp-for="SupplierID" />
                                    <input class="form-control" asp-for="SupplierName" readonly />
                                </div>
                            </div>
                            <div class="col-16 d-flex justify-content-start align-items-center unset-pdl">
                                <span class="warehouse-name-drs">@Html.DisplayNameFor(Model => Model.DateSearchStart)</span>
                                <div class="col-16 d-flex justify-content-start align-items-center unset-pdl sp-cs-dpl">
                                    <div class="unset-pdl cs-w300">
                                        <input id="searchDate" type="text" asp-for="DateSearchStart" class="form-control" readonly>
                                    </div>
                                    <input type="hidden" asp-for="SupplierProductNumber" />
                                    <button class="btn btn-info btn-icon-split sp-mg-bt-10 ml-3 mg-btn-for-sp" id="export-file-btn">
                                        <span class="icon text-white-50">
                                            <i class="fa-solid fa-file-export"></i>
                                        </span>
                                        <span class="text">出力</span>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <div class="mt-3" id="div-table">
            <table class="table table-sm stripe hover nowrap">
                <thead>
                    <tr>
                        <th>仕入先品番</th>
                        <th>収容数</th>
                        <th>入庫箱数</th>
                        <th>入庫数</th>
                        <th>出庫箱数</th>
                        <th>出庫数</th>
                        <th>在庫箱数</th>
                        <th>在庫数</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@Model.SupplierProductNumber</td>
                        <td>@Utils.FormatNumber(Model.LotQuantity)</td>
                        <td>@Utils.FormatNumber(Model.StoreInNumberOfBoxes)</td>
                        <td>@Utils.FormatNumber(Model.StoreInQuantity)</td>
                        <td>@Utils.FormatNumber(Model.StoreOutNumberOfBoxes)</td>
                        <td>@Utils.FormatNumber(Model.StoreOutQuantity)</td>
                        <td>@Utils.FormatNumber(Model.StockRemainNumberOfBoxes)</td>
                        <td>@Utils.FormatNumber(Model.StockRemainQuantity)</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <!-- Detail List-->
        <div class="col-10 mt-4 pl-0 scrollable-table sticky_table" id="div-table">
            <table class="table table-container table-sm stripe hover nowrap table-fixed" id="table-datatable">
                <thead>
                    <tr>
                        <th class="text-nowrap border-top-0">日付</th>
                        <th class="text-nowrap border-top-0">入庫箱数</th>
                        <th class="text-nowrap border-top-0">入庫数</th>
                        <th class="text-nowrap border-top-0">出庫箱数</th>
                        <th class="text-nowrap border-top-0">出庫数</th>
                        <th class="text-nowrap border-top-0">在庫箱数</th>
                        <th class="text-nowrap border-top-0">在庫数</th>
                    </tr>
                </thead>
                <tbody>
                    @if (@Model != null && @Model.DetailList != null && @Model.DetailList.Count > 0)
                    {
                        @foreach (var item in Model.DetailList)
                        {
                             <tr>
                                <td class="text-nowrap">@item.WorkedDate</td>
                                <td class="text-nowrap">@Utils.FormatNumber(item.StoreInNumberOfBoxes)</td>
                                <td class="text-nowrap">@Utils.FormatNumber(item.StoreInQuantity)</td>
                                <td class="text-nowrap">@Utils.FormatNumber(item.StoreOutNumberOfBoxes)</td>
                                <td class="text-nowrap">@Utils.FormatNumber(item.StoreOutQuantity)</td>
                                <td class="text-nowrap">@Utils.FormatNumber(item.StockRemainNumberOfBoxes)</td>
                                <td class="text-nowrap">@Utils.FormatNumber(item.StockRemainQuantity)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <input type="hidden" id="viewTitle" value="@Model.ViewTitle" />
    </div>
</div>

<script>
    // 出力ボタン押下
    $('#export-file-btn').click(function (event) {
        DeleteErrorMessages();

        // ページの更新を禁止する
        event.preventDefault();

        // 送信イベントが他のハンドラーに伝播するのを防ぐ
        event.stopImmediatePropagation();

        var searchFormArr = $('#searchForm').serializeArray();

        // フォーム情報取得
        var exportFormData = new FormData();
        exportFormData.append("searchModel.DepoID", searchFormArr[0].value);
        exportFormData.append("searchModel.DepoName", searchFormArr[1].value);
        exportFormData.append("searchModel.CompanyID", searchFormArr[2].value);
        exportFormData.append("searchModel.CompanyName", searchFormArr[3].value);
        exportFormData.append("searchModel.SearchStartDate", searchFormArr[4].value);
        exportFormData.append("searchModel.SearchEndDate", searchFormArr[4].value);
        exportFormData.append("searchModel.SupplierProductNumber", searchFormArr[5].value);

        // 画面名取得
        exportFormData.append("gamenName", $("#viewTitle").val());

        // CSV出力
        onExportCsvByCondition("Detail", exportFormData);
    });

    // エラーメッセージ削除
    function DeleteErrorMessages() {
        $('#div-error-message').text('');
        $('#edit-modal-error-message').text('');
        $('#delete-modal-error-message').text('');
        $('.text-danger').text('');
        $('input').removeClass('input-validation-error');
    }
</script>