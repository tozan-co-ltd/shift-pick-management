@using mar_sumaken_web.Commons;
@model mar_sumaken_web.Models.StockStatusModel
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.ViewTitle;
}


<div class="card shadow de-inspection d-receive-schedule m-4">
    <div class="card-header text-gray-800">
        @ViewData["Title"]
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-lg-8">
                <div class="card border-left-custom">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li>入荷実績にロット番号の情報が存在する品番は、仕入先品番をクリックすると品番別ロット番号一覧が表示されます。</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group col-sm-12">
            <p id="import-res" class="mt-1"></p>
        </div>

        <div id="ErrorBlock" class="mb-3 ml-3 text-danger">
        </div>

        <div class="mg-bot-20">
            <div class="col-16 sp-tablet mb-3">
                <div class="row mt-10">
                    <div class="col-lg-12">
                        <form id="import-receive-schedule-upload-form" method="post" enctype="multipart/form-data" name="form" onsubmit="return false;">
                            <div class="col-16 d-flex justify-content-start align-items-center mb-3 unset-pdl">
                                <span class="warehouse-name-drs">倉庫名</span>
                                <div class="selectItem unset-pdl">
                                    <select class="form-select" name="DepoID" asp-for="SelectedDepoID" asp-items="@Model.SearchDepoList"></select>
                                </div>
                            </div>
                            <div class="col-16 d-flex justify-content-start align-items-center mb-3 unset-pdl">
                                <span class="warehouse-name-drs">仕入先名</span>
                                <div class="selectItem unset-pdl">
                                    <select class="form-select" name="DepoID" asp-for="SelectedCompanyID" asp-items="@Model.SearchCompanyList"></select>
                                </div>
                            </div>
                            <div class="col-16 d-flex justify-content-start align-items-center unset-pdl sp-cs-dpl">
                                <div class="col-16 d-flex justify-content-start align-items-center mb-3 unset-pdl">
                                    <span class="warehouse-name-drs">@Html.DisplayNameFor(Model => Model.DateSearchStart)</span>
                                    <input id="startDate" type="text" asp-for="DateSearchStart" class="form-control pickerDate">
                                </div>
                                <div class="col-16 d-flex justify-content-start align-items-center mb-3 unset-pdl">
                                    <button type="submit" class="btn btn-secondary btn-icon-split ml-3">
                                        <span class="icon text-white-50">
                                            <i class="fa-solid fa-magnifying-glass"></i>
                                        </span>
                                        <span class="text">検索</span>
                                    </button>
                                    <button class="btn btn-info btn-icon-split sp-mg-bt-10 ml-3">
                                        <span class="icon text-white-50">
                                            <i class="fa-solid fa-file-export"></i>
                                        </span>
                                        <span class="text">出力</span>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <div class="mt-3" id="div-table" style="display: none;">
            <table class="table table-sm stripe hover nowrap datatable-normal">
                <thead>
                    <tr>
                        <th></th>
                        <th>ID</th>
                        <th>仕入先名</th>
                        <th>入荷日</th>
                        <th>仕入先品番</th>
                        <th>キー</th>
                        <th>箱数</th>
                        <th>数量</th>
                        <th>登録日時</th>
                        <th>読取日時</th>
                        <th>登録者</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <button class="btn btn-secondary btn-icon-split">
                                <i class="fa-solid fa-list"></i>
                            </button>
                        </td>
                        <td>2024/02/01</td>
                        <td>A</td>
                        <td>B</td>
                        <td>B</td>
                        <td>B</td>
                        <td>B</td>
                        <td>B</td>
                        <td>B</td>
                        <td>B</td>
                        <td>B</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
@* <input id="import_action_url" type="hidden" value="@Url.Action("ImportExcel", "ScheduledArrivalImport")" /> *@