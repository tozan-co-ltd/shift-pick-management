</div>

<script>
    let model;

    $(document).ready(function () {
        model = @Html.Raw(Json.Serialize(Model));
        model.loadTransitionList = [];
        console.log(model); 
        var today = new Date();
        var oneWeekAgo = new Date();
        oneWeekAgo.setDate(oneWeekAgo.getDate() - 7);
        $('#endOfPeriod').val(GetDayString(today));
        $('#startOfPeriod').val(GetDayString(oneWeekAgo));
    })

    // 期間の開始日付変更時
    $('#startOfPeriod').change(function () {
        periodChange();
    });

    // 期間の終了日時変更時
    $('#endOfPeriod').change(function(){
        periodChange();
    })

    // 期間変更時
    function periodChange() {
        // 期間の開始、終了日付の取得
        var startOfPeriod = GetDayString(new Date($('#startOfPeriod').val()));
        var endOfPeriod = GetDayString(new Date($('#endOfPeriod').val()));

        // 便名称の選択肢を全削除
        var select = $('#tripName')[0];
        while (select.firstChild) {
            select.removeChild(select.firstChild);
        }

        // フォーム情報取得
        let url = window.location.origin + '@Url.Action("GetTripNameFromPeriod", "LoadTransition")';
        let method = 'Post';
        let data = { startOfPeriod: startOfPeriod, endOfPeriod: endOfPeriod };

        // Ajax call
        $.ajax({
            url: url,
            method: method,
            data: data
        }).done(function (response) {
            for (var i = 0; i < response.length; i++) {
                var option = document.createElement("option");
                if (response[i].text == null) {
                    option.text = "";
                }
                else {
                    option.text = response[i].text;
                }
                option.value = response[i].value;
                select.appendChild(option);
            }

        }).fail(function (jqXHR, textStatus, errorThrown) {
            if (jqXHR.status === 404) {
                var errorMessage = jqXHR.responseJSON.errorMessage;
                $("#div-error-message").text(errorMessage);
            } else {
                var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                $("#div-error-message").text(errorMessage);
            }
        });
    }

    // 便名称選択時
    $('[name=TripName]').change(function () {
        // 便名称取得
        var tripName = $('[name=TripName]').val();

        // 期間の開始、終了日付の取得
        var startOfPeriod = GetDayString(new Date($('#startOfPeriod').val()));
        var endOfPeriod = GetDayString(new Date($('#endOfPeriod').val()));

        // 便枝番の選択肢を全削除
        var select = $('#tripBranchSeq')[0];
        while (select.firstChild) {
            select.removeChild(select.firstChild);
        }

        // フォーム情報取得
        let url = window.location.origin + '@Url.Action("GetTripBranchSeqFromTripName", "LoadTransition")';
        let method = 'Post';
        let data = { tripName: tripName, startOfPeriod: startOfPeriod, endOfPeriod: endOfPeriod };

        // Ajax call
        $.ajax({
            url: url,
            method: method,
            data: data
        }).done(function (response) {
            for (var i = 0; i < response.length; i++) {
                var option = document.createElement("option");
                option.text = response[i];
                option.value = response[i];
                select.appendChild(option);
            }
            
        }).fail(function (jqXHR, textStatus, errorThrown) {
            if (jqXHR.status === 404) {
                var errorMessage = jqXHR.responseJSON.errorMessage;
                $("#div-error-message").text(errorMessage);
            } else {
                var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                $("#div-error-message").text(errorMessage);
            }
        });
    });

    // 選択された便の配列
    let arrayTrips = [];

    // 追加ボタン押下時
    function addTrips(){
        // 20件の便が選択されているとき
        if (20 <= arrayTrips.length) {
            var errorMessage = 'E1008: 選択できる稼働日は最大20日です。20日を超えないように選択してください。';
            return;
        }
        // 便名称と便枝番取得
        var tripName = $('[name=TripName]').val();
        var tripBranchSeq = $('[name=TripBranchSeq]').val();
        var selectedTrips = $('#selectedTrips')[0];

        // 入力されていない場合、エラー出力
        if(tripName == "" || tripBranchSeq == ""){
            return;
        }
        var selectedTripName = tripName + "_" + tripBranchSeq;

        // 重複チェック
        const tripNames = arrayTrips.map(d => d.selectedTripName);
        if (tripNames.includes(selectedTripName)) {
            return;
        }

        // 選択された便に追加
        arrayTrips.push({tripName, tripBranchSeq, selectedTripName});
        var selectedTripLabel = document.createElement("label");
        selectedTripLabel.innerText = selectedTripName;
        selectedTripLabel.innerHTML += "<a href=\"#\" class=\"labelDelete ml-1\" onclick=\"onLabelDeleteClick('" + selectedTripName + "')\" id=\"\">×</a>";
        selectedTripLabel.className += "mr-3";
        selectedTrips.appendChild(selectedTripLabel);
    }

    // 選択された便の×ボタン押下時
    function onLabelDeleteClick(selectedTripName){
        $('label').remove(':contains("' + selectedTripName + '")');
        const tripNames = arrayTrips.map(d => d.selectedTripName);
        var deleteIndex = tripNames.indexOf(selectedTripName);
        arrayTrips.splice(deleteIndex, 1);
    }

    // 検索ボタン押下時
    function onSearchClick() {
        // グラフとテーブルの表示
        $('#graphAndTable').css('display', 'block');

        // 初期表示は到着荷量
        $('input[value="arrival"]').prop('checked', true);
        $('#arrivalChart').css('display', 'block');
        $('#departureChart').css('display', 'none');

        // 期間の開始、終了日付の取得
        var startOfPeriod = GetDayString(new Date($('#startOfPeriod').val()));
        var endOfPeriod = GetDayString(new Date($('#endOfPeriod').val()));

        // グラフの初期化
        arrivalChart.data.datasets = [];
        departureChart.data.datasets = [];
        // グラフの表示期間設定
        arrivalChart.options.scales.xAxes[0].ticks.min = startOfPeriod;
        arrivalChart.options.scales.xAxes[0].ticks.max = endOfPeriod;
        departureChart.options.scales.xAxes[0].ticks.min = startOfPeriod;
        departureChart.options.scales.xAxes[0].ticks.max = endOfPeriod;

        // 追加された便、便枝番について
        for(var i=0; i < arrayTrips.length; i++){
            var tripName = arrayTrips[i].tripName;
            var tripBranchSeq = arrayTrips[i].tripBranchSeq

            // フォーム情報取得
            let url = window.location.origin + '@Url.Action("SearchTrips", "LoadTransition")';
            let method = 'Post';
            let data = { tripName: tripName, tripBranchSeq: tripBranchSeq, startOfPeriod: startOfPeriod, endOfPeriod: endOfPeriod };

            // Ajax call
            $.ajax({
                url: url,
                method: method,
                data: data,
                async: false
            }).done(function (response) {
                // 荷量クラスをパーセントとして取得
                var arrivalLoadStatuses = [];
                var departureLoadStatuses = [];
                response.forEach(function (item) {
                    if (item.arrivalLoadStatus != "") {
                        arrivalLoadStatuses.push({ x: item.workDay, y: item.arrivalLoadStatus });
                    }
                    if (item.departureLoadStatus != "") {
                        departureLoadStatuses.push({ x: item.workDay, y: item.departureLoadStatus });
                    }
                })

                // データセット作成、登録
                var arrivalDatasets = createChartDatasets(i);
                arrivalDatasets.data = arrivalLoadStatuses;
                arrivalDatasets.label = tripName + "_" + tripBranchSeq;
                arrivalChart.data.datasets.push(arrivalDatasets);

                var departureDatasets = createChartDatasets(i);
                departureDatasets.data = departureLoadStatuses;
                departureDatasets.label = tripName + "_" + tripBranchSeq;
                departureChart.data.datasets.push(departureDatasets);

            }).fail(function (jqXHR, textStatus, errorThrown) {
                if (jqXHR.status === 404) {
                    var errorMessage = jqXHR.responseJSON.errorMessage;
                    $("#div-error-message").text(errorMessage);
                } else {
                    var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                    $("#div-error-message").text(errorMessage);
                }
            });
        }
        // グラフの更新
        arrivalChart.update();
        departureChart.update();
    }

    // chartjs用のデータセット作成
    function createChartDatasets(dataNumber){
        var datasets = {
            label: '',
            borderColor: graphColors[dataNumber],
            fill: false,
            data: [],
            tension: 0,
            pointRadius: '5',
            backgroundColor: graphColors[dataNumber],
        }
        return datasets;
    }

    // グラフ凡例で用いるカラーコード
    const graphColors = [
        'rgba(255, 204, 204, 1)',
        'rgba(255, 229, 204, 1)',
        'rgba(255, 255, 204, 1)',
        'rgba(204, 255, 204, 1)',
        'rgba(204, 255, 229, 1)',
        'rgba(204, 255, 255, 1)',
        'rgba(204, 229, 255, 1)',
        'rgba(204, 204, 255, 1)',
        'rgba(229, 204, 255, 1)',
        'rgba(255, 204, 255, 1)',
        'rgba(153, 204, 153, 1)',
        'rgba(102, 153, 102, 1)',
        'rgba(102, 153, 204, 1)',
        'rgba(51, 102, 153, 1)',
        'rgba(128, 0, 128, 1)',
        'rgba(0, 0, 128, 1)',
        'rgba(180, 180, 180, 1)',
        'rgba(200, 200, 200, 1)',
        'rgba(220, 220, 220, 1)',
        'rgba(240, 240, 240, 1)'
    ]

    // ラジオボタン切り替え時
    $(function () {
        $('input[name="chartRadios"]:radio').change(function () {
            var radioval = $(this).val();
            if (radioval == "arrival") {
                $('#arrivalChart').css('display', 'block');
                $('#departureChart').css('display', 'none');
            }
            else{
                $('#departureChart').css('display', 'block');
                $('#arrivalChart').css('display', 'none');
            }
        })
    })

    // 日付の表示形式変換(yyyy/MM/dd)
    function GetDayString(date) {
        var day = date.toLocaleDateString("ja-JP", {
            year: "numeric", month: "2-digit",
            day: "2-digit"
        });
        return day;
    }

    // 便実績テーブル表示
    function tableDisplay() {
        // 期間の開始、終了日付の取得
        var startOfPeriod = GetDayString(new Date($('#startOfPeriod').val()));
        var endOfPeriod = GetDayString(new Date($('#endOfPeriod').val()));

        // フォーム情報取得
        let url = window.location.origin + '@Url.Action("SearchData", "LoadTransition")';
        let method = 'Post';
        let data = { startOfPeriod: startOfPeriod, endOfPeriod: endOfPeriod};

        // Ajax call
        $.ajax({
            url: url,
            method: method,
            data: data
        }).done(function (response) {
            var tableHTML = response.searchedTripRecordHTML;
            tableLength = response.searchedTripRecordLength + 1;
            $('#tripRecordTable').empty().html(tableHTML);
            // 日本語表示
            const language_url = "https://cdn.datatables.net/plug-ins/1.11.5/i18n/ja.json";

            // ID(2列目)昇順
            $("#tripRecordDataTable").DataTable({
                "language": {
                    "url": language_url
                },
                lengthChange: true,     // 件数切替
                info: false,            // 総件数
                scrollX: true,          // 横スクロール可
                scrollCollapse: true,   // 縦スクロール表示
                order: [[1, "asc"], [9, "asc"], [2, "asc"]],    // ID昇順
            });
        }).fail(function (jqXHR, textStatus, errorThrown) {
            if (jqXHR.status === 404) {
                var errorMessage = jqXHR.responseJSON.errorMessage;
                $("#edit-modal-error-message").text(errorMessage);
            } else {
                var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                $("#edit-modal-error-message").text(errorMessage);
            }
        });
    }

</script>
                                  