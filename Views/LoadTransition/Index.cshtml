                    <span class="warehouse-name-drs">便名称</span>
                    <select type="text" class="form-select " name="TripName" asp-for="TripName" asp-items="@Model.TripNameList" required id="tripName"></select>
                </div>
                <div class="d-flex justify-content-start align-items-center mb-3 unset-pdl mr-3">
                    <span class="warehouse-name-drs">便枝番</span>
                    <select type="text" class="form-select " id="tripBranchSeq" name="TripBranchSeq">
