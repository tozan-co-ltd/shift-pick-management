@using ai_truck_load_measurement.Commons;
@model ai_truck_load_measurement.Models.LoadTransitionModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.CategoryTitle + " - " + Model.ViewTitle;
}
<div class="card shadow de-inspection masterInfo m-4">
    <div class="card-header">
        @ViewData["Title"]
    </div>

    <div class="card-body">

        <div class="row">
            <div class="col-lg-10">
                <div class="card border-left-custom">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li>最長90日の期間が検索できます。</li>
                            <li>便枝番とは、便が各拠点へ訪問した回数を示すために昼勤開始時間から順に割り当てた番号です。</li>
                            <li>最大20件の便(便＋枝番)を選択できます。</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group col-sm-12 pl-3">
            <p id="div-error-message" class="mt-1 text-danger"></p>

            @if (ViewData["ErrorMessage"] != null)
            {
                <span class="mt-1 text-danger">@ViewData["ErrorMessage"]</span>
            }
        </div>

        <form id="loadTransitionForm">
            <div class="col-16 d-flex justify-content-start align-items-center unset-pdl sp-cs-dpl">
                <div class="d-flex justify-content-start align-items-center mb-3 unset-pdl">
                    <span class="warehouse-name-drs span-paragraph">デポ</span>
                    <div>
                        <label><input type="checkbox" class=" mr-2" id="allDepo" />すべて</label>
                        <br />
                        <div id="selectDepos"></div>
                    </div>
                </div>
            </div>
            <div class="col-16 d-flex justify-content-start align-items-center unset-pdl sp-cs-dpl">
                <div class="d-flex justify-content-start align-items-center mb-3 unset-pdl">
                    <span class="warehouse-name-drs span-paragraph">稼働日</span>
                    <input type="text" id="startOfPeriod" class="form-control pickerDate startDate">
                    <label class="m-1">～</label>
                    <input type="text" id="endOfPeriod" class="form-control pickerDate endDate">
                </div>
            </div>
            <div class="col-16 d-flex justify-content-start align-items-center unset-pdl sp-cs-dpl mb-3">
                <span class="warehouse-name-drs span-paragraph">便選択</span>
                <div class="dropdown-container  mr-3" id="dropdownContainer">
                    <button class="dropdown-button btn btn-primary btn-icon-split btn-register" id="dropdownButton">
                        <span class="icon text-white-50">
                            <i class="fas fa-plus"></i>
                        </span>
                        <span class="text">追加　　　</span>
                    </button>
                    <div class="dropdown-content" id="dropdownContent">
                        <div id="createToggleCheckBox">選択された稼働日にデータがありません</div>
                    </div>
                </div>
                <a href="#" class="btn btn-danger btn-icon-split btn-register mr-3" onclick="clearTrips()">
                    <span class="icon text-white-50">
                        <i class="fas fa-trash"></i>
                    </span>
                    <span class="text">一括クリア</span>
                </a>
                
            </div>
            <div class="col-16 d-flex justify-content-start align-items-center  unset-pdl mr-3 sp-cs-dpl" id="selectedTrips0" >
                <span class="warehouse-name-drs"></span>
            </div>
            <div class="col-16 d-flex justify-content-start align-items-center unset-pdl mr-3 sp-cs-dpl" id="selectedTrips1">
                <span class="warehouse-name-drs"></span>
            </div>
            <div class="col-16 d-flex justify-content-start align-items-center unset-pdl mr-3 sp-cs-dpl" id="selectedTrips2">
                <span class="warehouse-name-drs"></span>
            </div>
            <div class="col-16 d-flex justify-content-start align-items-center unset-pdl mr-3 sp-cs-dpl" id="selectedTrips3">
                <span class="warehouse-name-drs"></span>
            </div>
            
        </form>

        <div class="col-16 d-flex justify-content-start align-items-center mb-3 unset-pdl">
            <button type="submit" class="btn btn-secondary btn-icon-split" id="search-btn" onclick="onSearchClick('LoadTransition')">
                <span class="icon text-white-50">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </span>
                <span class="text">検索</span>
            </button>
        </div>

        <div class="graph-and-table" id="graphAndTable">
            <hr />
            <div class="col-16 d-flex align-items-center mb-3 unset-pdl">
                <div class="radio-group mr-3">
                    <div class="radio-area">
                        <input type="radio" id="arrivalChartButton" name="chartRadios" value="arrival" checked />
                        <label for="arrivalChartButton">到着荷量</label>
                    </div>
                    <div class="radio-area">
                        <input type="radio" id="departureChartButton" name="chartRadios" value="departure" />
                        <label for="departureChartButton">出発荷量</label>
                    </div>
                </div>
                <button class="btn btn-secondary print-btn mr-4" id="search-btn" onclick="window.print()" style="margin-left: auto;">
                    <span class="text"><i class="fa-solid fa-print"></i></span>
                </button>
            </div>
            

            <div class="print-area" id="print-area">
                <div class="chartjs-graph chartjs-arrival" id="arrivalChart">
                    <canvas id="binedabanChartArrival"></canvas>
                    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.3/Chart.bundle.min.js" integrity="sha512-vBmx0N/uQOXznm/Nbkp7h0P1RfLSj0HQrFSzV8m7rOGyj30fYAOKHYvCNez+yM8IrfnW0TCodDEjRqf6fodf/Q==" crossorigin="anonymous"></script>

                    <script>
                        var ctx = document.getElementById("binedabanChartArrival");
                        function adjustCanvasHeight() {
                            var canvas = document.getElementById("binedabanChartArrival");
                            var width = window.innerWidth;
                        }

                        window.addEventListener('resize', adjustCanvasHeight);

                        adjustCanvasHeight();

                        var arrivalChart = new Chart(ctx, {
                            type: 'line',
                            data: {
                                labels: [],
                                datasets: []
                            },
                            options: {
                                //凡例は表示
                                legend: {
                                    display: true
                                },
                                scales: {
                                    //X軸
                                    xAxes: [{
                                        //軸ラベル表示
                                        scaleLabel: {
                                            display: true,
                                            labelString: '稼働日',
                                            fontSize: 24
                                        },
                                        ticks: {
                                            fontSize: 20
                                        }
                                    }],
                                    //Y軸
                                    yAxes: [{
                                        //軸ラベル表示
                                        scaleLabel: {
                                            display: true,
                                            labelString: '到着荷量(%)',
                                            fontSize: 24
                                        },
                                        //Y軸の範囲を指定
                                        ticks: {
                                            min: 0.0,
                                            max: 100.0,
                                            fontSize: 20
                                        }
                                    }]
                                },
                                title:{
                                    display: true,
                                    text: '実績-荷量推移',
                                    fontSize: 30
                                }
                            }
                        });
                    </script>
                </div>
                <div class="chartjs-graph chartjs-departure" id="departureChart">
                    <canvas id="binedabanChartDeparture"></canvas>
                    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.3/Chart.bundle.min.js" integrity="sha512-vBmx0N/uQOXznm/Nbkp7h0P1RfLSj0HQrFSzV8m7rOGyj30fYAOKHYvCNez+yM8IrfnW0TCodDEjRqf6fodf/Q==" crossorigin="anonymous"></script>

                    <script>
                        var ctx = document.getElementById("binedabanChartDeparture");
                        function adjustCanvasHeight() {
                            var canvas = document.getElementById("binedabanChartDeparture");
                            var width = window.innerWidth;
                        }

                        window.addEventListener('resize', adjustCanvasHeight);

                        adjustCanvasHeight();

                        var departureChart = new Chart(ctx, {
                            type: 'line',
                            data: {
                                labels: [],
                                datasets: []
                            },
                            options: {
                                //凡例は表示
                                legend: {
                                    display: true
                                },
                                scales: {
                                    //X軸
                                    xAxes: [{
                                        //軸ラベル表示
                                        scaleLabel: {
                                            display: true,
                                            labelString: '稼働日',
                                            fontSize: 24
                                        },
                                        ticks: {
                                            fontSize:20
                                        }
                                    }],
                                    //Y軸
                                    yAxes: [{
                                        //軸ラベル表示
                                        scaleLabel: {
                                            display: true,
                                            labelString: '出発荷量(%)',
                                            fontSize: 24
                                        },
                                        //Y軸の範囲を指定
                                        ticks: {
                                            min: 0.0,
                                            max: 100.0,
                                            fontSize:20
                                        }
                                    }]
                                },
                                title: {
                                    display: true,
                                    text: '実績-荷量推移',
                                    fontSize: 30
                                }
                            }
                        });
                    </script>
                </div>
            </div>
            <hr />
            <div class="mg-bot-20 mt-3">
                <div class="col-12 d-flex xs-block justify-content-start align-items-center p-0">
                    <div class="input-group-append mr-1">
                        <a href="#" class="btn btn-info btn-icon-split" onclick="onExportFileTrips('LoadTransition', '@Model.ViewTitle')" id="exportFile">
                            <span class="icon text-white-50">
                                <i class="fas fa-file-export"></i>
                            </span>
                            <span class="text">Excel出力</span>
                        </a>
                    </div>
                    <div class="input-group-append mr-3">
                        <a href="#" class="btn btn-info btn-icon-split" onclick="onExportAllImages('LoadTransition')">
                            <span class="icon text-white-50">
                                <i class="fa-solid fa-circle-down"></i>
                            </span>
                            <span class="text">画像一括出力</span>
                        </a>
                    </div>
                </div>
            </div>
            <div class="mt-3" id="tripRecordTable"></div>
        </div>
    </div>
</div>

<!--  Detail Modal-->
<div class="modal fade" id="detail-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content trip-record-modal">
            <div class="modal-header">
                <h5 class="modal-title" id="detail-modal-label"></h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="col-12 col-md-12">
                    <p id="edit-modal-error-message" class="mt-1 text-danger"></p>
                </div>
                <figure class="mb-2 modal-img"><img src="" id="modalImage"/></figure>
                <div id="tripRecord-buttons"></div>
                <table class="table table-sm p-2 modal-table">
                    <tbody id="tripRecord-contatiner">
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    let userName = "";
    $(document).ready(function () {
        model = @Html.Raw(Json.Serialize(Model));
        userName = model.userName;
        var today = new Date();
        var oneWeekAgo = new Date();
        oneWeekAgo.setDate(oneWeekAgo.getDate() - 7);
        $('#endOfPeriod').val(GetDayString(today));
        $('#startOfPeriod').val(GetDayString(oneWeekAgo));
        // グラフ非表示
        $('#graphAndTable').css('display', 'none');
        addDepos(model);
        depoCheckDisplay(model);
        periodChange('LoadTransition');
    })

    // 期間の開始日付変更時
    $('#startOfPeriod').change(function () {
        periodChange('LoadTransition');
    });

    // 期間の終了日時変更時
    $('#endOfPeriod').change(function(){
        periodChange('LoadTransition');
    })


    // 検索ボタン押下時
    function onSearchClick(page) {
        DeleteErrorMessages();

        // 90日を超えるデータは検索不可
        if (!isWithin90Days()) {
            var errorMessage = 'E1007: 検索できる期間は最長90日です。90日を超えないように選択してください。';
            $("#div-error-message").text(errorMessage);
            return;
        }

        // グラフとテーブルの表示
        $('#graphAndTable').css('display', 'block');
        tableDisplay(page);

        // 初期表示は到着荷量
        $('input[value="arrival"]').prop('checked', true);
        $('#arrivalChart').css('display', 'block');
        $('#departureChart').css('display', 'none');

        // 期間の開始、終了日付の取得
        var startOfPeriod = GetDayString(new Date($('#startOfPeriod').val()));
        var endOfPeriod = GetDayString(new Date($('#endOfPeriod').val()));

        // 選択期間の日数を取得
        var startDate = new Date($('#startOfPeriod').val());
        var endDate = new Date($('#endOfPeriod').val());
        var diffMilliSec = endDate - startDate;
        var diffDays = parseInt(diffMilliSec / 1000 / 60 / 60 / 24);

        var selectedDates = [];
        var currentDate = startDate;

        for(var i=0; i<=diffDays; i++){
            var dateForChart = GetDayStringForChart(currentDate);
            selectedDates.push(dateForChart);
            currentDate.setDate(currentDate.getDate() + 1);
        }

        // グラフの初期化
        arrivalChart.data.datasets = [];
        departureChart.data.datasets = [];
        
        // グラフの表示期間設定
        arrivalChart.data.labels = selectedDates;
        departureChart.data.labels = selectedDates;

        // 追加された便、便枝番について
        for(var i=0; i < arrayTrips.length; i++){
            var tripName = arrayTrips[i].tripName;
            var tripBranchSeq = arrayTrips[i].tripBranchSeq

            // フォーム情報取得
            let url = window.location.origin + '@Url.Action("SearchTrips", "LoadTransition")';
            let method = 'Post';
            let data = { tripName: tripName, tripBranchSeq: tripBranchSeq, startOfPeriod: startOfPeriod, endOfPeriod: endOfPeriod };

            // Ajax call
            $.ajax({
                url: url,
                method: method,
                data: data,
                async: false
            }).done(function (response) {
                // 荷量クラスをパーセントとして取得
                var arrivalLoadStatuses = [];
                var departureLoadStatuses = [];

                selectedDates.forEach(function (day) {
                    if (response.find(item => GetDayStringForChart(new Date(item.workDay)) == day)) {
                        var arrivalLoadStatus = response.find(item => GetDayStringForChart(new Date(item.workDay)) == day).arrivalLoadStatus;
                        var departureLoadStatus = response.find(item => GetDayStringForChart(new Date(item.workDay)) == day).departureLoadStatus;
                        if (arrivalLoadStatus != "") {
                            arrivalLoadStatuses.push({ x: day, y: arrivalLoadStatus });
                        }
                        else {
                            arrivalLoadStatuses.push({ x: day, y: null });
                        }

                        if (departureLoadStatus != "") {
                            departureLoadStatuses.push({ x: day, y: departureLoadStatus });
                        }
                        else {
                            departureLoadStatuses.push({ x: day, y: null });
                        }
                    }
                    else {
                        arrivalLoadStatuses.push({ x: day, y: null });
                        departureLoadStatuses.push({ x: day, y: null });
                    }
                })

                // データセット作成、登録
                var chartColor = graphColors[i];
                var label = tripName + "_" + tripBranchSeq;
                createAndPushDatasets(arrivalChart, chartColor, arrivalLoadStatuses, label);
                createAndPushDatasets(departureChart, chartColor, departureLoadStatuses, label);

            }).fail(function (jqXHR, textStatus, errorThrown) {
                if (jqXHR.status === 404) {
                    var errorMessage = jqXHR.responseJSON.errorMessage;
                    $("#div-error-message").text(errorMessage);
                } else {
                    var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                    $("#div-error-message").text(errorMessage);
                }
            });
        }
        // グラフの更新
        arrivalChart.update();
        departureChart.update();
    }

    // chartjs用のデータセット作成
    function createChartDatasets(color){
        var datasets = {
            label: '',
            borderColor: color,
            fill: false,
            data: [],
            tension: 0,
            pointRadius: '5',
            backgroundColor: color,
            spanGaps: true,
        }
        return datasets;
    }

    // ラジオボタン切り替え時
    $(function () {
        $('input[name="chartRadios"]:radio').change(function () {
            // デフォルトの操作を無効化
            event.preventDefault();

            var radioval = $(this).val();
            if (radioval == "arrival") {
                $('#arrivalChart').css('display', 'block');
                $('#departureChart').css('display', 'none');
            }
            else{
                $('#departureChart').css('display', 'block');
                $('#arrivalChart').css('display', 'none');
            }
        })
    })

    // 便実績テーブル表示
    function tableDisplay(page) {
        // 期間の開始、終了日付の取得
        var startOfPeriod = GetDayString(new Date($('#startOfPeriod').val()));
        var endOfPeriod = GetDayString(new Date($('#endOfPeriod').val()));

        let data = {models: arrayTrips, startOfPeriod: startOfPeriod, endOfPeriod: endOfPeriod};

        tableDisplayCommon(page, data);

    }

    // 画像一括出力ボタン押下
    function onExportAllImages(page) {
        event.preventDefault();
        DeleteErrorMessages();
        if (isWithin90Days()) {

            // 期間の開始、終了日付の取得
            var startOfPeriod = GetDayString(new Date($('#startOfPeriod').val()));
            var endOfPeriod = GetDayString(new Date($('#endOfPeriod').val()));


            // デポ情報取得
            var checkedDepos = getCheckedDepos();

            // フォーム情報取得
            let data = { download: "download", 
                startOfPeriod: startOfPeriod, 
                endOfPeriod: endOfPeriod, 
                "arrayTrips": arrayTrips,
                checkedDepos: checkedDepos
            };

            onExportAllImagesCommon(page, data);
        }
        else {
            var errorMessage = 'E1007: 検索できる期間は最長90日です。90日を超えないように選択してください。';
            $("#div-error-message").text(errorMessage);
        }
    }

    // Excel出力
    async function onExportFileTrips(page, gamenName) {
        DeleteErrorMessages();
        if (isWithin90Days()) {

            // チェックボックスの入力情報取得
            var checkBox = false;
            $('input:checked').each(function () {
                checkBox = $(this).prop('checked');
            });

            // 期間の開始、終了日付の取得
            var startOfPeriod = GetDayString(new Date($('#startOfPeriod').val()));
            var endOfPeriod = GetDayString(new Date($('#endOfPeriod').val()));

            // デポ情報取得
            var checkedDepos = getCheckedDepos();

            // フォーム情報取得
            let data = {
                "gamenName": gamenName,
                "startofPeriod": startOfPeriod,
                "endOfPeriod": endOfPeriod,
                "isOnlyHasAmountDefference": checkBox,
                "arrayTrips": arrayTrips,
                checkedDepos: checkedDepos
            };

            // Excel出力共通処理
            onExportFileTripsCommon(page, data);
        }
        else {
            var errorMessage = 'E1007: 検索できる期間は最長90日です。90日を超えないように選択してください。';
            $("#div-error-message").text(errorMessage);
        }
    }

    const dropdownButton = document.getElementById('dropdownButton');
    const dropdownContainer = document.getElementById('dropdownContainer');
    const dropdownContent = document.getElementById('dropdownContent');

    // ドロップダウンの表示・非表示
    dropdownButton.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropdownContainer.classList.toggle('show');
    });

    // コンテンツ外をクリックした場合、プルダウンを閉じる
    document.addEventListener('click', (e) => {
        if (!dropdownContainer.contains(e.target)) {
            dropdownContainer.classList.remove('show');
        }
    });


    function allToggleOpen() {
        event.preventDefault();
        // 中項目のヘッダーをクリックで小項目を表示/非表示
        let mediumHeaders = dropdownContent.querySelectorAll('.medium-header');
        mediumHeaders.forEach(header => {
            const smallItems = header.nextElementSibling;
            const toggleIcon = header.querySelector('.toggle-icon');
            if (!smallItems.classList.contains('show')) {
                smallItems.classList.add('show');
                toggleIcon.classList.remove('collapsed');
            }
        });
    }

    function allToggleClose() {
        event.preventDefault();
        // 中項目のヘッダーをクリックで小項目を表示/非表示
        let mediumHeaders = dropdownContent.querySelectorAll('.medium-header');
        mediumHeaders.forEach(header => {
            const smallItems = header.nextElementSibling;
            const toggleIcon = header.querySelector('.toggle-icon');
            if (smallItems.classList.contains('show')) {
                smallItems.classList.remove('show');
                toggleIcon.classList.add('collapsed');
            }
        });
    }


    // デポの選択用チェックボックスを生成
    function addDepos(model) {
        var selectDepos = $("#selectDepos")[0];
        model.mDepoList.forEach(depo => {
            if (depo.value == null)
                return;
            var depoLabel = document.createElement("label");
            depoLabel.innerHTML += "<input type=\"checkbox\" class=\"mr-2\" name=\"depos\" id=\"depo" + depo.value + "\" value=\"" + depo.value + "\" />" + depo.text;
            depoLabel.className += "mr-3 ";
            selectDepos.appendChild(depoLabel);


        })
    }

    // 「すべて」チェックボックス押下時
    $('input[id=allDepo]').change(function () {
        var depos = $('input[name="depos"]');
        for (var i = 0; i < depos.length; i++) {
            if ($('input[id=allDepo]')[0].checked) {
                depos[i].checked = true;
            } else {
                depos[i].checked = false;
            }
        }
        periodChange('LoadTransition')
    });

    // 各デポチェックボックス押下時
    $(function () {
        $('input[name="depos"]').change(function () {
            var depos = $('input[name=depos]');
            for (var i = 0; i < depos.length; i++) {
                if (!depos[i].checked) {
                    $('input[id=allDepo]')[0].checked = false;
                    break;
                }
            }
            periodChange('LoadTransition')
        });
    })

    // 画面表示時にログインユーザーのメインデポにチェックを入れる
    function depoCheckDisplay(model) {
        console.log("start");
        var mainDepoID = model.mainDepoID;
        if (mainDepoID == 0)
            return;
        var depos = $('input[name=depos]');
        console.log(mainDepoID);
        console.log(depos);
        for (var i = 0; i < depos.length; i++) {
            if (depos[i].id == "depo" + mainDepoID) {
                depos[i].checked = true;
            }
        }
    }

    // 選択されたデポのIDリストを取得する
    function getCheckedDepos() {
        var depos = $('input[name=depos]');
        var checkedDepos = [];
        for (var i = 0; i < depos.length; i++) {
            if (depos[i].checked) {
                checkedDepos.push(depos[i].value);
            }
        }
        console.log(checkedDepos);
        return checkedDepos;
    }
</script>
                                  