@using ai_truck_load_measurement.Commons;
@model ai_truck_load_measurement.Models.LoadTransitionModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.CategoryTitle + " - " + Model.ViewTitle;
}
<style>

</style>
<div class="card shadow de-inspection masterInfo m-4">
    <div class="card-header">
        @ViewData["Title"]
    </div>

    <div class="card-body">

        <div class="row">
            <div class="col-lg-10">
                <div class="card border-left-custom">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li>最長90日の期間が検索できます。</li>
                            <li>便枝番とは、便が複数回SyncBaseを訪問する際の各回の呼称です。<br />
                                昼勤開始を起点とし1,2,3・・・と番号を割り当てます。</li>
                            <li>最大20件の便を選択できます。</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group col-sm-12 pl-3">
            <p id="div-error-message" class="mt-1 text-danger"></p>

            @if (ViewData["ErrorMessage"] != null)
            {
                <span class="mt-1 text-danger">@ViewData["ErrorMessage"]</span>
            }
        </div>

        <form id="loadTransitionForm">
            <div class="col-16 d-flex justify-content-start align-items-center unset-pdl sp-cs-dpl">
                <div class="d-flex justify-content-start align-items-center mb-3 unset-pdl">
                    <span class="warehouse-name-drs">期間</span>
                    <input type="text" id="startOfPeriod" class="form-control pickerDate startDate">
                    <label class="m-1">～</label>
                    <input type="text" id="endOfPeriod" class="form-control pickerDate endDate">
                </div>
            </div>
            <div class="col-16 d-flex justify-content-start align-items-center unset-pdl sp-cs-dpl">
                <div class="d-flex justify-content-start align-items-center mb-3 unset-pdl mr-3">
                    <span class="warehouse-name-drs">便名称</span>
                    <select type="text" class="form-select " name="TripName" asp-for="TripName" asp-items="@Model.TripNameList" required id="tripName"></select>
                </div>
                <div class="d-flex justify-content-start align-items-center mb-3 unset-pdl mr-3">
                    <span class="warehouse-name-drs">便枝番</span>
                    <select type="text" class="form-select " id="tripBranchSeq" name="TripBranchSeq">
                    </select>
                </div>
                <div class="mr-3">
                    <a href="#" class="btn btn-primary " onclick="addTrips()">
                        <span class="text">追加</span>
                    </a>
                </div>
            </div>
            <div class="col-16 d-flex justify-content-start align-items-center unset-pdl sp-cs-dpl">
                <div class="d-flex justify-content-start align-items-center mb-3 unset-pdl mr-3" id="selectedTrips">
                    <span class="warehouse-name-drs">選択された便</span>
                </div>
            </div>
        </form>

        <div class="col-16 d-flex justify-content-start align-items-center mb-3 unset-pdl">
            <button type="submit" class="btn btn-secondary btn-icon-split" id="search-btn">
                <span class="icon text-white-50">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </span>
                <span class="text">検索</span>
            </button>
        </div>
        
        <div class="chartjs-graph">
            <canvas id="binedabanChartArrival"></canvas>
            <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.3/Chart.bundle.min.js" integrity="sha512-vBmx0N/uQOXznm/Nbkp7h0P1RfLSj0HQrFSzV8m7rOGyj30fYAOKHYvCNez+yM8IrfnW0TCodDEjRqf6fodf/Q==" crossorigin="anonymous"></script>

            <script>
                var ctx = document.getElementById("binedabanChartArrival");
                function adjustCanvasHeight() {
                    var canvas = document.getElementById("binedabanChartArrival");
                    var width = window.innerWidth;
                    canvas.height = 60;
                }

                window.addEventListener('resize', adjustCanvasHeight);

                adjustCanvasHeight();

                var myScatterChart = new Chart(ctx, {
                    type: 'line',
                    data: {
                        //labels: ['15:24', '17:08'],
                        datasets: [{
                            label: '豊鉄大型常傭便3_1',
                            borderColor: 'Green',
                            fill: false,
                            data: [{ x: '2024-10-21T00:00:00', y: 5 }, { x: '2024-10-22T00:00:00', y: 55 }, { x: '2024-10-23T00:00:00', y: 45 }, { x: '2024-10-24T00:00:00', y: 25 }, { x: '2024-10-25T00:00:00', y: 65 }],
                            tension: 0,
                            pointRadius: '5',
                            backgroundColor: 'Green',

                        },
                        {
                            label: '豊鉄大型常傭便3_2',
                            borderColor: 'Red',
                            fill: false,
                            data: [{ x: '2024-10-21T00:00:00', y: 95 }, { x: '2024-10-22T00:00:00', y: 75 }, { x: '2024-10-23T00:00:00', y: 25 }, { x: '2024-10-24T00:00:00', y: 55 }, { x: '2024-10-25T00:00:00', y: 15 }],
                            tension: 0,
                            pointRadius: '5',
                            backgroundColor: 'Red',

                        }]
                    },
                    options: {
                        //凡例は表示
                        legend: {
                            display: true
                        },
                        scales: {
                            //X軸
                            xAxes: [{
                                //ここで軸を時間に設定する
                                type: 'time',
                                time: {
                                    unit: 'day',
                                }
                            }],
                            //Y軸
                            yAxes: [{
                                //軸ラベル表示
                                scaleLabel: {
                                    display: true,
                                    labelString: '到着荷量(%)',
                                    fontSize: 24
                                },
                                //Y軸の範囲を指定
                                ticks: {
                                    min: 0.0,
                                    max: 100.0
                                }
                            }]
                        }
                    }
                });
            </script>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        var model = @Html.Raw(Json.Serialize(Model));
        console.log(model); 
        var today = new Date();
        var oneWeekAgo = new Date();
        oneWeekAgo.setDate(oneWeekAgo.getDate() - 7);
        $('#endOfPeriod').val(GetDayString(today));
        $('#startOfPeriod').val(GetDayString(oneWeekAgo));
    })

    // 便名称選択時
    $('[name=TripName]').change(function () {
        var tripName = $('[name=TripName]').val();
        console.log(tripName);

        // 便枝番の選択肢を全削除
        var select = $('#tripBranchSeq')[0];
        while (select.firstChild) {
            select.removeChild(select.firstChild);
        }

        // フォーム情報取得
        let url = window.location.origin + '@Url.Action("GetTripBranchSeqFromTripName", "LoadTransition")';
        let method = 'Post';
        let data = { tripName: tripName };

        // Ajax call
        $.ajax({
            url: url,
            method: method,
            data: data
        }).done(function (response) {
            console.log(response);
            for (var i = 0; i < response.length; i++) {
                var option = document.createElement("option");
                option.text = response[i];
                option.value = response[i];
                select.appendChild(option);
            }
            
        }).fail(function (jqXHR, textStatus, errorThrown) {
            if (jqXHR.status === 404) {
                var errorMessage = jqXHR.responseJSON.errorMessage;
                $("#div-error-message").text(errorMessage);
            } else {
                var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                $("#div-error-message").text(errorMessage);
            }
        });
    });

    // 選択された便の配列
    let arrayTrips = [];

    // 追加ボタン押下時
    function addTrips(){
        // 20件の便が選択されているとき
        if (20 <= arrayTrips.length) {
            var errorMessage = 'E1008: 選択できる稼働日は最大20日です。20日を超えないように選択してください。';
            return;
        }
        // 便名称と便枝番取得
        var tripName = $('[name=TripName]').val();
        var tripBranchSeq = $('[name=TripBranchSeq]').val();
        var selectedTrips = $('#selectedTrips')[0];

        // 入力されていない場合、エラー出力
        if(tripName == "" || tripBranchSeq == ""){
            return;
        }
        var selectedTripName = tripName + "_" + tripBranchSeq;

        // 重複チェック

        // 選択された便に追加
        arrayTrips.push({tripName, tripBranchSeq});
        var selectedTripLabel = document.createElement("label");
        selectedTripLabel.innerText = selectedTripName;
        selectedTripLabel.className += "mr-3";
        selectedTrips.appendChild(selectedTripLabel);
        

        console.log(arrayTrips);
    }

    // 日付の表示形式変換(yyyy/MM/dd)
    function GetDayString(date) {
        var day = date.toLocaleDateString("ja-JP", {
            year: "numeric", month: "2-digit",
            day: "2-digit"
        });
        return day;
    }
</script>
                                  