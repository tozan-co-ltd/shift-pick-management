                                    tension: 0,
                                    pointRadius: '5',
                                    backgroundColor: 'Green',

                                },
                                {
                                    label: '豊鉄大型常傭便3_2',
                                    borderColor: 'Red',
                                    fill: false,
                                    data: [{ x: '2024-10-21T00:00:00', y: 95 }, { x: '2024-10-22T00:00:00', y: 75 }, { x: '2024-10-23T00:00:00', y: 25 }, { x: '2024-10-24T00:00:00', y: 55 }, { x: '2024-10-25T00:00:00', y: 15 }],
                                    tension: 0,
                                    pointRadius: '5',
                                    backgroundColor: 'Red',

                                }]
                            },
                            options: {
                                //凡例は表示
                                legend: {
                                    display: true
                                },
                                scales: {
                                    //X軸
                                    xAxes: [{
                                        //ここで軸を時間に設定する
                                        type: 'time',
                                        time: {
                                            unit: 'day',
                                        },
                                        ticks: {
                                            min: $('#startOfPeriod').val(),
                                            max: $('#endOfPeriod').val()
                                        }
                                    }],
                                    //Y軸
                                    yAxes: [{
                                        //軸ラベル表示
                                        scaleLabel: {
                                            display: true,
                                            labelString: '出発荷量(%)',
