@using mar_sumaken_web.Commons;
@model mar_sumaken_web.Models.D_ShipmentScheduleSearchModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.CategoryTitle + " - " + Model.ViewTitle;
}

<div class="card shadow de-inspection m-4">
    <div class="card-header">
        @ViewData["Title"]
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-lg-8">
                <div class="card border-left-custom">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li>「実績数不一致のみ」にチェックし検索すると、箱数≠出庫箱数のデータのみ表示されます。</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group col-sm-12 pl-3">
            <p id="div-error-message" class="mt-1 text-danger"></p>

            @if (ViewData["ErrorMessage"] != null)
            {
                <span class="mt-1 text-danger">@ViewData["ErrorMessage"]</span>
            }
        </div>

        <div class="mg-bot-20">
            <div class="col-16 sp-tablet mb-3">
                <div class="row mt-10">
                    <div class="col-lg-12">
                        <form id="searchForm" method="post">
                            <div class="col-16 d-flex justify-content-start align-items-center mb-3 col-11 unset-pdl">
                                <span class="warehouse-name-drs">倉庫名</span>
                                <div class="selectItem unset-pdl">
                                    <select class="form-select" asp-for="SelectedDepoID" asp-items="@Model.SearchDepoList"></select>
                                </div>
                            </div>
                            <div class="col-16 d-flex justify-content-start align-items-center mb-3 col-11 unset-pdl">
                                <span class="warehouse-name-drs">納入先名</span>
                                <div class="selectItem unset-pdl">
                                    <select class="form-select" asp-for="SelectedCompanyID" asp-items="@Model.SearchCompanyList"></select>
                                </div>
                            </div>
                            <div class="col-12 d-flex justify-content-start align-items-center mb-3 unset-pdl">
                                <span class="warehouse-name-drs">@Html.DisplayNameFor(Model => Model.SearchStartDate)</span>
                                <input type="text" asp-for="SearchStartDate" class="form-control pickerDate startDate"> 
                                <label class="m-1">～</label>
                                <input type="text" asp-for="SearchEndDate" class="form-control pickerDate endDate">
                            </div>

                            <div class="col-16 d-flex justify-content-start align-items-center align-items-custom">
                                <p class="warehouse-name-drs">便</p>
                                <div class="col-16 d-flex justify-content-start align-items-center sp-cs-dpl">
                                    <div class="col-16 d-flex justify-content-start align-items-center sp-cs-dpl-fix">
                                        @for (var i = 0; i < @Model.BinList.Count; i++)
                                        {
                                            <div class="form-check">
                                                <input type="hidden" asp-for="BinList[i].Value" value="@Model.BinList[i].Value" />
                                                <input type="hidden" asp-for="BinList[i].Text" value="@Model.BinList[i].Text" />
                                                <input class="form-check-input bin-checkbox" asp-for="BinList[i].Selected" id="bin-@i" data="@Model.BinList[i].Text" type="checkbox">
                                                <label class="form-check-label ml-1 mr-3" id="label-bin-@i">@Model.BinList[i].Text</label>
                                            </div>
                                        }
                                        <div class="form-check ml-5 diffence-count-check">
                                            <input class="form-check-input" asp-for="DifferenceCountCheck" type="checkbox">
                                            <label class="form-check-label ml-1" asp-for="DifferenceCountCheck">実績数不一致のみ</label>
                                        </div>
                                    </div>
                                    <div class="custom-control custom-checkbox col-16 d-flex justify-content-start align-items-center sp-cs-dpl">
                                        <button id="search-btn" type="submit" class="btn btn-secondary btn-icon-split ml-3">
                                            <span class="icon text-white-50">
                                                <i class="fa-solid fa-magnifying-glass"></i>
                                            </span>
                                            <span class="text">検索</span>
                                        </button>
                                        <button class="btn btn-info btn-icon-split sp-mg-bt-10 ml-3" id="export-file-btn">
                                            <span class="icon text-white-50">
                                                <i class="fa-solid fa-file-export"></i>
                                            </span>
                                            <span class="text">出力</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <div class="mt-3" id="div-table" style="display: none;">
            <table class="table table-sm stripe hover nowrap datatable-normal" id="table-datatable">
                <thead>
                    <tr>
                        <th></th>
                        <th>ID</th>
                        <th>納入先名</th>
                        <th>納入指示日</th>
                        <th>便</th>
                        <th>納入先品番</th>
                        <th>仕入先品番</th>
                        <th>収容数</th>
                        <th>箱数</th>
                        <th>納入指示数</th>
                        <th>出庫箱数</th>
                        <th>出庫数量</th>
                        <th>発注元</th>
                        <th>発注元工区</th>
                        <th>発注元名称</th>
                        <th>発注元工場名</th>
                        <th>出荷元</th>
                        <th>出荷元工区</th>
                        <th>出荷元名称</th>
                        <th>納入先</th>
                        <th>納入先工区</th>
                        <th>納入場所</th>
                        <th>納入先名称</th>
                        <th>納入先工場名</th>
                        <th>定期／不定期区分名称</th>
                        <th>発行日</th>
                        <th>納入指示時刻</th>
                        <th>輸送識別</th>
                        <th>納品書番号</th>
                        <th>ページ数</th>
                        <th>行No</th>
                        <th>背番号</th>
                        <th>品名</th>
                        <th>枝番</th>
                        <th>更新日時</th>
                        <th>更新者</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
        <input type="hidden" id="viewTitle" value="@Model.ViewTitle" />
        <input type="hidden" id="categoryTitle" value="@Model.CategoryTitle" />
    </div>
</div>

<!--  Delete Modal-->
<div class="modal fade" id="delete-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="delete-modal-label">削除</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body unset-pd">
                <div class="col-12 col-md-12">
                    <p id="delete-modal-error-message" class="mt-1 text-danger"></p>
                </div>
                <div class="d-flex justify-content-center">
                    <div class="col-12 col-md-12">
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4">
                                <label>@Html.DisplayName("ShipmentScheduleID")</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 mb-2">
                                <input class="form-control" id="deleteShipmentScheduleId" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4">
                                <label>@Html.DisplayName("DeliveryName")</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 mb-2">
                                <input class="form-control" id="deleteDeliveryName" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4">
                                <label>@Html.DisplayNameFor(model => model.DeliveryDate)</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 mb-2">
                                <input class="form-control" id="deleteDeliveryDate" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4">
                                <label>@Html.DisplayNameFor(model => model.DeliveryTimeClass)</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 mb-2">
                                <input class="form-control" id="deleteDeliveryTimeClass" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4">
                                <label>@Html.DisplayNameFor(model => model.DeliveryProductNumber)</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 mb-2">
                                <input class="form-control" id="deleteDeliveryProductNumber" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4">
                                <label>@Html.DisplayNameFor(model => model.SupplierProductNumber)</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 mb-2">
                                <input class="form-control" id="deleteSupplierProductNumber" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4">
                                <label>@Html.DisplayNameFor(model => model.LotQuantity)</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 mb-2">
                                <input class="form-control" id="deleteLotQuantity" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4">
                                <label>@Html.DisplayNameFor(model => model.NumberOfBoxes)</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 mb-2">
                                <input class="form-control" id="deleteNumberOfBoxes" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4">
                                <label>@Html.DisplayNameFor(model => model.Quantity)</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 mb-2">
                                <input class="form-control" id="deleteQuantity" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap justify-content-center p-2 p-md-3">
                            <button class="btn btn-danger btn-icon-split mb-2 mr-0 mr-sm-5" onclick="OnExecuteDelete()">
                                <span class="text" style="min-width:84px">削除</span>
                            </button>
                            <button class="btn btn-secondary btn-icon-split mb-2" data-dismiss="modal" aria-label="Close">
                                <span class="text">キャンセル</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // 検索ボタン押下
    $('#search-btn').click(function () {
        $('#searchForm').submit(function (e) {
            DeleteErrorMessages();

            // ページの更新を禁止する
            e.preventDefault();
            // 送信イベントが他のハンドラーに伝播するのを防ぐ
            e.stopImmediatePropagation();

            // フォーム情報取得
            let url = window.location.origin + '@Url.Action("SearchData", "D_ShipmentSchedule")';
            let method = 'POST';
            var data = $(this).serialize();

            // Ajax call
            $.ajax({
                url: url,
                method: method,
                data: data
            }).done(function (response) {
                var loginUrl = '@Url.Action("", "Login", new { param = "autologout" })';
                // 異なるログインを検出し
                HasOtherLogin(response, loginUrl, 5); // 5: 仕入先品番昇順
            }).fail(function (xhr, textStatus, errorThrown) {
                if (xhr.status === 404) {
                    var errorMessage = xhr.responseJSON.errorMessage;
                    $("#div-error-message").text(errorMessage);
                } else {
                    var errorMessage500 = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                    $("#div-error-message").text(errorMessage500);
                }
            });
        });
    });

    // 詳細ボタン押下
    function OnDetailClick(trTag) {

        var row = trTag.parentNode.parentNode;
        var shipmentScheduleId = row.getElementsByClassName("ShipmentScheduleID")[0].textContent;
        var depoId = row.getElementsByClassName("DepoID")[0].value;
        var companyId = row.getElementsByClassName("CompanyID")[0].value;
        var categoryTitle = document.getElementById("categoryTitle").value;
        var startDate = document.getElementById("SearchStartDate").value;
        var endDate = document.getElementById("SearchEndDate").value;
        var differenceCountCheck = document.getElementById("DifferenceCountCheck").checked;
        
        var selectedValues = GetSelectedValues();
        var url = window.location.origin + '@Url.Action("Index", "D_Shipment")';
        url += '?shipmentScheduleId=' + shipmentScheduleId;
        url += '&categoryTitle=' + categoryTitle;
        url += '&depoId=' + depoId;
        url += '&companyId=' + companyId;
        url += '&startDate=' + startDate;
        url += '&endDate=' + endDate;
        url += '&binListStr=' + selectedValues.join(',');
        url += '&differenceCountCheck=' + differenceCountCheck;

        window.location.href = url;
    }

    // 削除ボタン押下
    function OnDeleteClick(trTag) {
        DeleteErrorMessages();

        var row = trTag.parentNode.parentNode;
        $("#deleteShipmentScheduleId").val(row.getElementsByClassName("ShipmentScheduleID")[0].textContent);
        $("#deleteDeliveryName").val(row.getElementsByClassName("DeliveryName")[0].textContent);
        $("#deleteDeliveryDate").val(row.getElementsByClassName("DeliveryDate")[0].textContent);
        $("#deleteDeliveryTimeClass").val(row.getElementsByClassName("DeliveryTimeClass")[0].textContent);
        $("#deleteDeliveryProductNumber").val(row.getElementsByClassName("DeliveryProductNumber")[0].textContent);
        $("#deleteSupplierProductNumber").val(row.getElementsByClassName("SupplierProductNumber")[0].textContent);
        $("#deleteLotQuantity").val(row.getElementsByClassName("LotQuantity")[0].textContent);
        $("#deleteNumberOfBoxes").val(row.getElementsByClassName("NumberOfBoxes")[0].textContent);
        $("#deleteQuantity").val(row.getElementsByClassName("Quantity")[0].textContent);
    }

    // 削除
    function OnExecuteDelete() {
        DeleteErrorMessages();

        // フォーム情報取得
        let url = window.location.origin + '@Url.Action("Delete", "D_ShipmentSchedule")';
        let method = 'POST';
        var data = { "id": $("#deleteShipmentScheduleId").val() };

        // Ajax call
        $.ajax({
            url: url,
            method: method,
            data: data
        }).done(async function (data) {
            $('#delete-modal').removeClass('show');
            $('#delete-modal').hide();
            // 完了モーダル表示
            AlertMessage('', '完了', '登録完了しました。', null, null, true);
            await WaitSeconds();
            // 再検索
            $('#search-btn').click();
            $('.btn-danger-shipment-schedule').click();
        }).fail(function (xhr, textStatus, errorThrown) {
            if (xhr.status === 404) {
                var errorMessage = xhr.responseJSON.errorMessage;
                $("#delete-modal-error-message").text(errorMessage);
            } else {
                var errorMessage500 = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                $("#delete-modal-error-message").text(errorMessage500);
            }
        });
    }

    // 出力ボタン押下
    $('#export-file-btn').click(function (event) {
        DeleteErrorMessages();

        // ページの更新を禁止する
        event.preventDefault();

        // 送信イベントが他のハンドラーに伝播するのを防ぐ
        event.stopImmediatePropagation();

        var searchFormArr = $('#searchForm').serializeArray();

        // フォーム情報取得
        var exportFormData = new FormData();
        exportFormData.append("searchModel.DepoID", searchFormArr[0].value);
        exportFormData.append("searchModel.DepoName", $('#SelectedDepoID option:selected').text().replace(/ /g, ""));
        exportFormData.append("searchModel.CompanyID", searchFormArr[1].value);
        exportFormData.append("searchModel.CompanyName", $('#SelectedCompanyID option:selected').text().replace(/ /g, ""));
        exportFormData.append("searchModel.SearchStartDate", searchFormArr[2].value);
        exportFormData.append("searchModel.SearchEndDate", searchFormArr[3].value);

        // 便
        var binList = GetSelectedValues();
        for (var i = 0; i < binList.length; i++) {
            exportFormData.append("searchModel.BinList[" + i + "]", binList[i]);
        }

        // 実績数不一致のみ
        var checkFlg = $("#DiffenceCountCheck").is(":checked");
        exportFormData.append("searchModel.DiffenceCountCheck", checkFlg);

        // 画面名取得
        exportFormData.append("gamenName", $("#viewTitle").val());

        // CSV出力
        onExportCsvByCondition("D_ShipmentSchedule", exportFormData);
    });

    function GetSelectedValues() {
        var selectedValues = [];
        var checkboxes = document.querySelectorAll('.bin-checkbox');

        checkboxes.forEach(function (checkbox) {
            if (checkbox.checked) {
                var customData = checkbox.getAttribute('data');
                selectedValues.push(parseInt(customData));
            }
        });

        return selectedValues;
    }

    // エラーメッセージ削除
    function DeleteErrorMessages() {
        $('#div-error-message').text('');
        $('#edit-modal-error-message').text('');
        $('#delete-modal-error-message').text('');
        $('.text-danger').text('');
        $('input').removeClass('input-validation-error');
    }
</script>