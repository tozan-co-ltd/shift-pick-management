@using mar_sumaken_web.Commons;
@model mar_sumaken_web.Models.D_ShipmentScheduleModel.D_ShipmentSchedule
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.ViewTitle;
}

<div class="card shadow de-inspection m-4">
    <div class="card-header text-gray-800">
        出庫 - @ViewData["Title"]
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-lg-8">
                <div class="card border-left-custom">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li>メッセージ内容</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group col-sm-12">
            <p id="import-res" class="mt-1"></p>
        </div>

        <div id="div-error-message" class="mb-3 ml-3 text-danger">
        </div>

        <div class="mg-bot-20">
            <div class="col-16 sp-tablet mb-3">
                <div class="row mt-10">
                    <div class="col-lg-12">
                        <form id="import-receive-schedule-upload-form" method="post">
                            <div class="col-16 d-flex justify-content-start align-items-center mb-3 col-11 unset-pdl">
                                <span class="warehouse-name-drs">倉庫名</span>
                                <div class="selectItem unset-pdl">
                                    <select class="form-select" name="DepoID" asp-for="SelectedDepoID" asp-items="@Model.SearchDepoList"></select>
                                </div>
                            </div>
                            <div class="col-16 d-flex justify-content-start align-items-center mb-3 col-11 unset-pdl">
                                <span class="warehouse-name-drs">納入先名</span>
                                <div class="selectItem unset-pdl">
                                    <select class="form-select" name="DepoID" asp-for="SelectedCompanyID" asp-items="@Model.SearchCompanyList"></select>
                                </div>
                            </div>
                            <div class="col-12 d-flex justify-content-start align-items-center mb-3 unset-pdl">
                                <span class="warehouse-name-drs">納入指示日</span>
                                <input id="startDate" type="text" class="form-control pickerDate"> <lable class="m-1">～</lable> <input id="endDate" type="text" class="form-control pickerDate">
                            </div>

                            <div class="col-16 d-flex justify-content-start align-items-center mb-3">
                                <p class="warehouse-name-drs">便</p>
                                <div class="col-16 d-flex justify-content-start align-items-center sp-cs-dpl">
                                    <div class="col-16 d-flex justify-content-start align-items-center sp-cs-dpl">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" value="" id="bin1">
                                            <label class="form-check-label ml-1 mr-3" for="bin1">1</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" value="" id="bin2">
                                            <label class="form-check-label ml-1 mr-3" for="bin2">2</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" value="" id="bin3">
                                            <label class="form-check-label ml-1 mr-3" for="bin3">3</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" value="" id="bin4">
                                            <label class="form-check-label ml-1 mr-3" for="bin4">4</label>
                                        </div>
                                        <div class="form-check ml-5">
                                            <input class="form-check-input" type="checkbox" value="" id="actual-num-discrepancy-only">
                                            <label class="form-check-label ml-1" for="actual-num-discrepancy-only">実績数不一致のみ</label>
                                        </div>
                                    </div>

                                    <div class="custom-control custom-checkbox col-16 d-flex justify-content-start align-items-center sp-cs-dpl">
                                        <button type="submit" class="btn btn-secondary btn-icon-split ml-3">
                                            <span class="icon text-white-50">
                                                <i class="fa-solid fa-magnifying-glass"></i>
                                            </span>
                                            <span class="text">検索</span>
                                        </button>
                                        <button class="btn btn-info btn-icon-split sp-mg-bt-10 ml-3">
                                            <span class="icon text-white-50">
                                                <i class="fa-solid fa-file-export"></i>
                                            </span>
                                            <span class="text">出力</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <div class="mt-3">
            <table class="table table-sm stripe hover nowrap datatable-normal">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>納入先名</th>
                        <th>出荷指示日</th>
                        <th>便</th>
                        <th>納入先品番</th>
                        <th>仕入先品番</th>
                        <th>収容数</th>
                        <th>箱数</th>
                        <th>納入指数量</th>
                        <th>出庫箱数</th>
                        <th>出庫数量</th>
                        <th>発注元</th>
                        <th>発注元工区</th>
                        <th>発注元名称</th>
                        <th>発注元工場名</th>
                        <th>出荷元</th>
                        <th>出荷元工区</th>
                        <th>出荷元名称</th>
                        <th>納入先</th>
                        <th>納入先工区</th>
                        <th>納入場所</th>
                        <th>納入先名称</th>
                        <th>納入先工場名</th>
                        <th>更新日時</th>
                        <th>更新者</th>
                    </tr>
                </thead>
                <tbody>
                    @if (@Model != null && @Model.D_ShipmentScheduleList != null && @Model.D_ShipmentScheduleList.Count > 0)
                    {
                        @foreach (var item in @Model.D_ShipmentScheduleList)
                        {
                            <tr>
                                <td>
                                    <button class="btn btn-secondary btn-icon-split"
                                            onclick="OnDetailClick('@item.UserID')" data-id="@item.UserID" data-toggle="modal" data-target="#userDetailModal">
                                        <i class="fa-solid fa-list"></i>
                                    </button>
                                    <button class="btn btn-danger btn-icon-split"
                                            onclick="OnDeleteClick('@item.UserID')" data-id="@item.UserID" data-toggle="modal" data-target="#userDeleteModal">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </td>
                                <td>@item.ShipmentScheduleID</td>
                                <td>@item.OrdererCode</td>
                                <td>@item.OrdererFactoryKubun</td>
                                <td>@item.OrdererName</td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td>@item.UpdatedAt</td>
                                <td>@item.UpdatedBy</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@* <input id="import_action_url" type="hidden" value="@Url.Action("ImportExcel", "ScheduledArrivalImport")" /> *@