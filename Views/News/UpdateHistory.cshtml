@using ai_truck_load_measurement.Commons;
@model ai_truck_load_measurement.Models.NewsListViewModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = "更新履歴";
}
<div class="card shadow de-inspection m-4">
    <div class="card-header d-flex">
        <label style="text-align: center">@ViewData["Title"]</label>
        @if (Model.AuthorizedKubun == 2)
        {
            <button class="btn btn-primary print-btn mr-4" id="search-btn" style="margin-left: auto;" data-toggle="modal" data-target="#insert-modal" onclick="OnInsertClick()">
                <span class="text">追加</span>
            </button>
        }
    </div>
    <div class="card-body">

        @if (Model.NewsList.Count > 0)
        {
            <div class="news-container news-list mb-3">

                @foreach (var item in Model.NewsList)
                {
                    <dl class="item" style="margin-bottom: 0rem;">
                        <dd style="margin-bottom: 0rem;">
                            <div>
                                <p class="date" style="display: flex; align-items: center;">@item.NewsDate.ToString("yyyy/MM/dd")</p>
                                <p class="category @("news-categoryid-" + item.CategoryClass)" style="display: flex; align-items: center;"><span>@item.CategoryStatus</span></p>
                                <p class="title" id="@("news-" + item.NewsID)" style="display: flex; align-items: center;"></p>
                                @if (Model.AuthorizedKubun == 2)
                                {
                                    <span class="ml-2" style="display: flex; align-items: center;">
                                        <button class="btn btn-primary" onclick="OnEditClick(@item.NewsID)" data-toggle="modal" data-target="#edit-modal" style="white-space: nowrap;">編集</button>
                                    </span>
                                }
                            </div>
                        </dd>
                    </dl>
                }
            </div>
        }
    </div>
</div>


<!--  Insert Modal-->
<div class="modal fade" id="insert-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="insert-modal-label">登録</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="col-12 col-md-12">
                    <p id="insert-modal-error-message" class="mt-1 text-danger"></p>
                </div>
                <div class="d-flex justify-content-center">
                    <form class="col-md-12" id="newsForm">
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl">
                                <label>@Html.DisplayNameFor(model => model.CategoryClass)<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <select class="form-select" name="CategoryClass" asp-for="CategoryClass" required id="CategoryClass">
                                    <option value="0">アップデート</option>
                                </select>
                                <span class="text-danger w-100" asp-validation-for="CategoryClass"></span>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl">
                                <label>@Html.DisplayName("NewsContent")<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <textarea class="form-control" asp-for="NewsContent" autocomplete="off" value="" required></textarea>
                                <small class="form-text text-muted w-100 p-1">最大300文字</small>
                                <span class="text-danger w-100" asp-validation-for="NewsContent"></span>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl modalLabel">
                                <label><a>@Html.DisplayName("NewsDate")<span style="color:red">*</span></a></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <input class="form-control pickerDate" style="max-width: 1000px;" type="text" asp-for="NewsDate" autocomplete="off" value="2025-05-28" required>
                                <small class="form-text text-muted w-100 p-1">YYYY/MM/DDで入力してください。</small>
                                <span class="text-danger w-100" asp-validation-for="NewsDate"></span>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap justify-content-center p-2 p-md-3">
                            <button class="btn btn-secondary btn-icon-split mb-2 mr-0 mr-sm-5" data-dismiss="modal" aria-label="Close">
                                <span class="text">キャンセル</span>
                            </button>
                            <button class="btn btn-success btn-icon-split mb-2" onclick="OnExecuteInsert()">
                                <span class="text" style="min-width:84px">登録</span>
                            </button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

<!--  Edit Modal-->
<div class="modal fade" id="edit-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="edit-modal-label">更新</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="col-12 col-md-12">
                    <p id="edit-modal-error-message" class="mt-1 text-danger"></p>
                </div>
                <div class="d-flex justify-content-center">
                    <form class="col-md-12" id="newsFormEdit">
                        <input type="hidden" asp-for="NewsID" id="NewsIDEdit" />
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl">
                                <label>@Html.DisplayNameFor(model => model.CategoryClass)<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <select class="form-select" name="CategoryClass" asp-for="CategoryClass" required id="CategoryClassEdit">
                                    <option value="0" selected>アップデート</option>
                                </select>
                                <span class="text-danger w-100" asp-validation-for="CategoryClass"></span>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl">
                                <label>@Html.DisplayName("NewsContent")<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <textarea class="form-control" asp-for="NewsContent" autocomplete="off" value="" required id="NewsContentEdit"></textarea>
                                <small class="form-text text-muted w-100 p-1">最大300文字</small>
                                <span class="text-danger w-100" asp-validation-for="NewsContent"></span>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl modalLabel">
                                <label><a>@Html.DisplayName("NewsDate")<span style="color:red">*</span></a></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <input class="form-control pickerDate" style="max-width: 1000px;" type="text" asp-for="NewsDate" autocomplete="off" value="" required id="NewsDateEdit">
                                <small class="form-text text-muted w-100 p-1">YYYY/MM/DDで入力してください。</small>
                                <span class="text-danger w-100" asp-validation-for="NewsDate"></span>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap justify-content-center p-2 p-md-3">
                            <button class="btn btn-secondary btn-icon-split mb-2 mr-0 mr-sm-5" data-dismiss="modal" aria-label="Close">
                                <span class="text">キャンセル</span>
                            </button>
                            <button class="btn btn-success btn-icon-split mb-2" onclick="OnExecuteEdit()">
                                <span class="text" style="min-width:84px">更新</span>
                            </button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    // 画面読み込み時
    $(document).ready(function () {
        model = @Html.Raw(Json.Serialize(Model));
        model.newsList.forEach(function(news){
            $("#news-" + news.newsID)[0].innerHTML = news.newsContent;
        });
    })

    // 登録ボタン押下時
    function OnInsertClick(){

        var today = new Date();
        $('#NewsDate').val(GetDayString(today));
    }

    // 登録
    function OnExecuteInsert() {
        $('#newsForm').submit(function (event) {
            DeleteErrorMessages();

            // ページの更新を禁止する
            event.preventDefault();

            // 送信イベントが他のハンドラーに伝播するのを防ぐ
            event.stopImmediatePropagation();

            // フォーム情報取得
            let url = window.location.origin + '@Url.Action("Register", "News")';
            let method = 'POST';
            let formId = 'newsForm';
            let data = $('#' + formId).serializeArray();

            // Ajax call
            $.ajax({
                url: url,
                method: method,
                data: data
            }).done(function (response) {
                $('#insert-modal').hide();
                // 完了モーダル表示
                AlertMessage('', '完了', '登録が完了しました。', null, null);
            }).fail(function (jqXHR, textStatus, errorThrown) {
                if (jqXHR.status === 404) {
                    var errorMessage = jqXHR.responseJSON.errorMessage;
                    $("#insert-modal-error-message").text(errorMessage);
                } else {
                    var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                    $("#insert-modal-error-message").text(errorMessage);
                }
            });
        });
    }

    $(function() {
        $('.news-container').paginathing({//親要素のclassを記述
            perPage: 30,//1ページあたりの表示件数
            prevText:'前へ',//1つ前のページへ移動するボタンのテキスト
            nextText:'次へ',//1つ次のページへ移動するボタンのテキスト
            prevNext: false,
            activeClass: 'navi-active',//現在のページ番号に任意のclassを付与できます
            firstLast: false,
        })
    });

    // 編集ボタン押下時
    function OnEditClick(targetID){
        // ボタンを押した行のデータ取得
        var model =  @Html.Raw(Json.Serialize(Model));
        var news = model.newsList.find(({newsID}) => newsID == targetID);
        var newsDate = GetDayString(new Date(news.newsDate));
        var newsContent = news.newsContent.replace(/<br \/>/g, "\r\n");
        $('#NewsIDEdit').val(news.newsID);
        $('#CategoryClassEdit').val(news.categoryClass);
        $('#NewsContentEdit').val(newsContent);
        $('#NewsDateEdit').val(newsDate);
    }

    // 更新
    function OnExecuteEdit() {
        $('#newsFormEdit').submit(function (event) {
            DeleteErrorMessages();

            // ページの更新を禁止する
            event.preventDefault();

            // 送信イベントが他のハンドラーに伝播するのを防ぐ
            event.stopImmediatePropagation();

            // フォーム情報取得
            let url = window.location.origin + '@Url.Action("Edit", "News")';
            let method = 'POST';
            let formId = 'newsFormEdit';
            let data = $('#' + formId).serializeArray();

            // Ajax call
            $.ajax({
                url: url,
                method: method,
                data: data
            }).done(function (response) {
                $('#edit-modal').hide();
                // 完了モーダル表示
                AlertMessage('', '完了', '登録が完了しました。', null, null);
            }).fail(function (jqXHR, textStatus, errorThrown) {
                if (jqXHR.status === 404) {
                    var errorMessage = jqXHR.responseJSON.errorMessage;
                    $("#edit-modal-error-message").text(errorMessage);
                } else {
                    var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                    $("#edit-modal-error-message").text(errorMessage);
                }
            });
        });
    }


</script>