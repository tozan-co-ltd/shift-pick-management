@using ai_truck_load_measurement.Commons;
@model ai_truck_load_measurement.Models.NewsListViewModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.ViewTitle;
}
<div class="card shadow de-inspection m-4">
    <div class="card-header d-flex">
        <label style="text-align: center">@ViewData["Title"]</label>
        <button class="btn btn-primary print-btn mr-4" id="search-btn" style="margin-left: auto;" data-toggle="modal" data-target="#insert-modal" onclick="OnInsertClick()">
            <span class="text">追加</span>
        </button>
    </div>
    <div class="card-body">

        @if(Model.NewsList.Count > 0)
        {
            <ul class="news-list">

                @foreach(var item in Model.NewsList)
                {
                    <li class="item">
                        <a href="News/Detail?newsID=@item.NewsID" >
                            <p class="date">@item.CreatedAt.ToString("yyyy/MM/dd")</p>
                            <p class="category"><span>@item.CategoryStatus</span></p>
                            <p class="title">@item.NewsSubject</p>
                        </a>
                    </li>
                }
            </ul>
        }
    </div>
</div>

<!--  Edit Modal-->
<div class="modal fade" id="insert-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="insert-modal-label">登録</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="col-12 col-md-12">
                    <p id="insert-modal-error-message" class="mt-1 text-danger"></p>
                </div>
                <div class="d-flex justify-content-center">
                    <form class="col-md-12" id="newsForm">
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl">
                                <label>@Html.DisplayName("NewsSubject")<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <input class="form-control" type="text" asp-for="NewsSubject" autocomplete="off">
                                <span class="text-danger w-100" asp-validation-for="NewsSubject"></span>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl">
                                <label>@Html.DisplayNameFor(model => model.CategoryClass)<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <select class="form-select" name="CategoryClass" asp-for="CategoryClass" required id="CategoryClass">
                                    <option value="" selected disabled id="firstSelect">選択してください</option>
                                    <option value="0">アップデート</option>
                                    <option value="1">メンテナンス</option>
                                    <option value="2">障害・不具合</option>
                                    <option value="3">操作案内</option>
                                </select>
                                <span class="text-danger w-100" asp-validation-for="CategoryClass"></span>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl">
                                <label>@Html.DisplayName("NewsContent")<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <textarea class="form-control"  asp-for="NewsContent" autocomplete="off" value="" required></textarea>
                                <span class="text-danger w-100" asp-validation-for="NewsContent"></span>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap justify-content-center p-2 p-md-3">
                            <button class="btn btn-secondary btn-icon-split mb-2 mr-0 mr-sm-5" data-dismiss="modal" aria-label="Close">
                                <span class="text">キャンセル</span>
                            </button>
                            <button class="btn btn-success btn-icon-split mb-2" onclick="OnExecuteInsert()">
                                <span class="text" style="min-width:84px">登録</span>
                            </button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>
<script type="text/javascript">

    // 登録ボタン押下時
    function OnInsertClick(){
        document.getElementById('firstSelect').selected = true;
    }

    // 登録
    function OnExecuteInsert() {
        $('#newsForm').submit(function (event) {
            DeleteErrorMessages();

            // ページの更新を禁止する
            event.preventDefault();

            // 送信イベントが他のハンドラーに伝播するのを防ぐ
            event.stopImmediatePropagation();

            // フォーム情報取得
            let url = window.location.origin + '@Url.Action("Register", "News")';
            let method = 'POST';
            let formId = 'newsForm';
            let data = $('#' + formId).serializeArray();

            // Ajax call
            $.ajax({
                url: url,
                method: method,
                data: data
            }).done(function (response) {
                $('#insert-modal').hide();
                // 完了モーダル表示
                AlertMessage('', '完了', '登録が完了しました。', null, null);
            }).fail(function (jqXHR, textStatus, errorThrown) {
                if (jqXHR.status === 404) {
                    var errorMessage = jqXHR.responseJSON.errorMessage;
                    $("#insert-modal-error-message").text(errorMessage);
                } else {
                    var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                    $("#insert-modal-error-message").text(errorMessage);
                }
            });
        });
    }

</script>