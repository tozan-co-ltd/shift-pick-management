@using ai_truck_load_measurement.Commons;
@model ai_truck_load_measurement.Models.NewsListViewModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.ViewTitle;
}
            
<div class="card shadow de-inspection m-4">
    <div class="card-header d-flex">
        <label style="text-align: center">@ViewData["Title"]</label>
    </div>
    <div class="card-body">
        <div class="news-category"><label style="color:#999">@Model.NewsList[0].CreatedAt.ToString("yyyy/MM/dd")</label>　 <span>@Model.NewsList[0].CategoryStatus</span></div>
        <br />
        <p class="title h3" style="font-weight:bold">@Model.NewsList[0].NewsSubject</p>
        <br />
        <div id="content">
            
        </div>
        <br /><br />
        <div class="input-group-append mr-4">
            <a class="btn btn-secondary btn-icon-split" asp-controller="News" asp-action="Index">
                <span class="icon text-white-50">
                    <i class="fas fa-arrow-left-long"></i>
                </span>
                <span class="text">戻る</span>
            </a>
        </div>
    </div>
</div>

<script type="text/javascript">
    // ロード時の処理
    $(document).ready(function () {
        // NewsModel取得
        var newsModel = @Html.Raw(Json.Serialize(Model));
        console.log(newsModel);
        document.getElementById('content').innerHTML = newsModel.newsList[0].newsContent;
    });
</script>