@using ai_truck_load_measurement.Commons;
@model ai_truck_load_measurement.Models.T_TripRecordModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.CategoryTitle + " - " + Model.ViewTitle;
}
<div class="card shadow de-inspection masterInfo m-4">
    <div class="card-header">
        @ViewData["Title"]
    </div>

    <div class="card-body">

        <div class="form-group col-sm-12 pl-3">
            <p id="div-error-message" class="mt-1 text-danger"></p>

            @if (ViewData["ErrorMessage"] != null)
            {
                <span class="mt-1 text-danger">@ViewData["ErrorMessage"]</span>
            }
        </div>

        <div class="col-16 d-flex justify-content-start align-items-center unset-pdl sp-cs-dpl">
            <div class="d-flex justify-content-start align-items-center mb-3 unset-pdl">
                <span class="warehouse-name-drs">期間</span>
                <input type="date" id="startOfPeriod" class="form-control pickerDate startDate">
                <label class="m-1">～</label>
                <input type="date" id="endOfPeriod" class="form-control pickerDate endDate">
            </div>
        </div>

        <div class="mb-3">
            <label>荷量の相違ありのみ表示<input type="checkbox" class="ml-3" id="m_tripCheckBox" /></label>
        </div>

        <div class="mg-bot-20">
            <div class="col-12 d-flex xs-block justify-content-start align-items-center p-0">
                <div class="input-group-append mr-3">
                    <a href="#" class="btn btn-secondary btn-icon-split" onclick="onRegisterClick('M_Trip', 0)">
                        <span class="icon text-white-50">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span>
                        <span class="text">検索</span>
                    </a>
                </div>
                <div class="input-group-append mr-3">
                    <a href="#" class="btn btn-info btn-icon-split" onclick="onExportFileTrips('M_Trip', '@Model.ViewTitle')">
                        <span class="icon text-white-50">
                            <i class="fas fa-file-export"></i>
                        </span>
                        <span class="text">Excel出力</span>
                    </a>
                </div>
                <div class="input-group-append mr-3">
                    <a href="#" class="btn btn-info btn-icon-split" onclick="onExportFileTrips('M_Trip', '@Model.ViewTitle')">
                        <span class="icon text-white-50">
                            <i class="fa-solid fa-circle-down"></i>
                        </span>
                        <span class="text">画像一括出力</span>
                    </a>
                </div>
            </div>
        </div>
        <div class="mt-3">
            <table class="table table-sm stripe hover nowrap datatable-normal table-center">
                <thead>
                    <tr align="center">
                        <th class="font-weight-bold">便名称</th>
                        <th class="font-weight-bold">便枝番</th>
                        <th class="font-weight-bold">乗務員</th>
                        <th class="font-weight-bold">ステーションID</th>
                        <th class="font-weight-bold">車両ID</th>
                        <th class="font-weight-bold">識別番号</th>
                        <th class="font-weight-bold">到着予定時間</th>
                        <th class="font-weight-bold">出発予定時間</th>
                        <th class="font-weight-bold">作業日</th>
                        <th class="font-weight-bold">到着日時</th>
                        <th class="font-weight-bold">出発日時</th>
                        <th class="font-weight-bold">到着荷量</th>
                        <th class="font-weight-bold">出発荷量</th>
                        <th class="font-weight-bold">到着荷量画像</th>
                        <th class="font-weight-bold">出発荷量画像</th>
                    </tr>
                </thead>
                <tbody>
                    @if (@Model.TripRecordList != null)
                    {
                        @foreach (var item in @Model.TripRecordList)
                        {
                            <tr>
                                <td>@item.TripName</td>
                                <td>@item.TripBranchSeq</td>
                                <td>@item.DriverName</td>
                                <td>@item.StationID</td>
                                <td>@item.TruckNumber</td>
                                <td>@item.IdentifyNumber</td>
                                <td>@item.ArrivalScheduledTime.ToString("HH:mm")</td>
                                <td>@item.DepartureScheduledTime.ToString("HH:mm")</td>
                                <td>@item.WorkDay.ToString("yyyy/MM/dd")</td>
                                <td>@item.ArrivedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                <td>@item.DeparturedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                <td>@item.ArrivalLoadStatus</td>
                                <td>@item.DepartureLoadStatus</td>
                                <td>
                                    <a class="btn btn-success btn-icon-split ml-1 mr-1"
                                       onclick="OnArrivalLoadImageClick('@item.TripRecordID')" data-id="@item.TripRecordID" data-toggle="modal" data-target="#detail-modal">
                                        <i class="fa-solid fa-truck"></i>
                                    </a>
                                </td>
                                <td>
                                    <a class="btn btn-success btn-icon-split ml-1 mr-1"
                                       onclick="OnDepartureLoadImageClick('@item.TripRecordID')" data-id="@item.TripRecordID" data-toggle="modal" data-target="#detail-modal">
                                        <i class="fa-solid fa-truck"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!--  Detail Modal-->
<div class="modal fade" id="detail-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detail-modal-label"></h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="col-12 col-md-12">
                    <p id="edit-modal-error-message" class="mt-1 text-danger"></p>
                </div>
                <figure><img src="" id="modalImage"/></figure>
                <table class="table table-sm p-2">
                    <tbody id="tripRecord-contatiner">
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        var model = @Html.Raw(Json.Serialize(Model));
        var today = new Date();
        var oneWeekAgo = new Date();
        oneWeekAgo.setDate(oneWeekAgo.getDate() - 7);
        console.log("test");
        var todayString = getInputDateString(today);
        var oneWeekAgoString = getInputDateString(oneWeekAgo);
        $('#endOfPeriod').val(todayString);
        $('#startOfPeriod').val(oneWeekAgoString);
    });

    function getInputDateString(days) {
        date = new Date(days)
        var yyyy = date.getFullYear();
        var MM = ("0" + (date.getMonth() + 1)).slice(-2);
        var dd = ("0" + date.getDate()).slice(-2);
        
        return yyyy + '-' + MM + '-' + dd;
    }

    // 詳細ボタン押下
    function OnArrivalLoadImageClick(tripRecordID) {
        var isArrived = true;
        EditModal(tripRecordID, isArrived);
    }

    function OnDepartureLoadImageClick(tripRecordID){
        var isArrived = false;
        EditModal(tripRecordID, isArrived);
    }

    function EditModal(tripRecordID, isArrived) {
        // M_supplierKanbanModel取得
        var data = @Html.Raw(Json.Serialize(Model));
        var tripRecordModel = data.tripRecordList;
        tripRecordModel.forEach(function (item) {
            if (item.tripRecordID == tripRecordID) {
                var imagePath = "";
                var arriveOrDeparture = "";
                var arriveOrDepartureDate = "";
                if (isArrived) {
                    $('#detail-modal-label').text("到着荷量画像");
                    imagePath = item.arrivalLoadImgPath;
                    arriveOrDeparture = "到着時間";
                    arriveOrDepartureDate = GetDateString(new Date(item.arrivedAt));
                }
                else{
                    $('#detail-modal-label').text("出発荷量画像");
                    imagePath = item.departureLoadImgPath;
                    arriveOrDeparture = "出発時間";
                    arriveOrDepartureDate = GetDateString(new Date(item.departuredAt));
                }

                $('#modalImage').attr("src", "data:image/jpeg;base64," + imagePath);

                var workDay = GetDayString(new Date(item.workDay));


                // 桁数・開始位置
                var container = $("#tripRecord-contatiner");
                container.empty();
                let tr = "<tr>"
                    + "<td>荷量</td>"
                    + "<td>" + item.arrivalLoadStatus + "</td>"
                    + "</tr><tr>"
                    + "<td>便名称_便枝番</td>"
                    + "<td>" + item.tripName + "_" + item.tripBranchSeq + "</td>"
                    + "</tr><tr>"
                    + "<td>乗務員</td>"
                    + "<td>" + item.driverName + "</td>"
                    + "</tr><tr>"
                    + "<td>ステーションID</td>"
                    + "<td>" + item.stationID + "</td>"
                    + "</tr><tr>"
                    + "<td>車両番号</td>"
                    + "<td>" + item.truckNumber + "</td>"
                    + "</tr><tr>"
                    + "<td>識別番号</td>"
                    + "<td>" + item.identifyNumber + "</td>"
                    + "</tr><tr>"
                    + "<td>稼働日</td>"
                    + "<td>" + workDay + "</td>"
                    + "</tr><tr>"
                    + "<td>"+ arriveOrDeparture +"</td>"
                    + "<td>" + arriveOrDepartureDate + "</td>"
                    + "</tr>";
                container.append(tr);

            }
        });
    }

    // 時刻の表示形式変換(HH:mm)
    function GetTimeString(date) {
        var hour = date.getHours();
        if (hour < 10) {
            hour = "0" + hour;
        }
        var minute = date.getMinutes();
        if (minute < 10) {
            minute = "0" + minute;
        }
        return hour + ":" + minute;
    }

    function GetDayString(date){
        var day = date.toLocaleDateString("ja-JP", {
            year: "numeric", month: "2-digit",
            day: "2-digit"
        });
        return day;
    }

    // 日付の表示形式変換(yyyy/MM/dd hh:mm)
    function GetDateString(date) {
        var day = GetDayString(date);
        var time = GetTimeString(date);
        return day + " " + time;
    }
</script>