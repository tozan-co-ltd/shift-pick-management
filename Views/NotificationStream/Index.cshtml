<div class="ml-4 mr-4 mb-4 d-flex">
    <span>新規を押すと新規登録画面へ、選択を押すと変更画面へ移動します。</span>
</div>
<script type="text/javascript">
    let userName = "";
    // 画面ロード時
    $(document).ready(function () {
        model = @Html.Raw(Json.Serialize(Model));
        userName = model.userName;
        tableLength = model.tripRecordList.length + 1;
        var today = new Date();
        var oneWeekAgo = new Date();
        oneWeekAgo.setDate(oneWeekAgo.getDate() - 7);
        $('#endOfPeriod').val(GetDayString(today));
        $('#startOfPeriod').val(GetDayString(oneWeekAgo));
        addDepos(model);
        depoCheckDisplay(model);
        tableDisplay('LoadOutput');
    });


    // チェックボックス押下時
    $('input[name="searchCondition"]').change(function () {
        DeleteErrorMessages();
        if (isWithin90Days()) {
            tableDisplay('LoadOutput');
        }
        else {
            var errorMessage = 'E1007: 検索できる期間は最長90日です。90日を超えないように選択してください。';
            $("#div-error-message").text(errorMessage);
        }
    });


    // 検索ボタン押下時
    function onSearchClick(page) {
        DeleteErrorMessages();
        if (isWithin90Days()) {
            // ロード中表示
            document.querySelector("#loading").style.display = "inline-block";
            tableDisplay(page);
        }
        else {
            var errorMessage = 'E1007: 検索できる期間は最長90日です。90日を超えないように選択してください。';
            $("#div-error-message").text(errorMessage);
        }
    }

    // 便実績テーブル表示
    function tableDisplay(page) {
        // チェックボックスの入力情報取得
        var isOnlyHasAmountDefference = $('#isOnlyHasAmountDefference')[0].checked;
        var hasTripName = $('#hasTripName')[0].checked;
        var hasIdentifyNumber = $('#hasIdentifyNumber')[0].checked;


        // 期間の開始、終了日付の取得
        var startOfPeriod = GetDayString(new Date($('#startOfPeriod').val()));
        var endOfPeriod = GetDayString(new Date($('#endOfPeriod').val()));

        // デポ情報取得
        var checkedDepos = getCheckedDepos();

        // テーブル表示用データ作成
        let data = { startOfPeriod: startOfPeriod,
            endOfPeriod: endOfPeriod,
            isOnlyHasAmountDefference: isOnlyHasAmountDefference,
            hasTripName: hasTripName,
            hasIdentifyNumber: hasIdentifyNumber,
            checkedDepos: checkedDepos
        };

        tableDisplayCommon(page, data);
    }

    // Excel出力
    async function onExportFileTrips(page, gamenName) {
        DeleteErrorMessages();
        if (isWithin90Days()) {

            // チェックボックスの入力情報取得
            var isOnlyHasAmountDefference = $('#isOnlyHasAmountDefference')[0].checked;
            var hasTripName = $('#hasTripName')[0].checked;
            var hasIdentifyNumber = $('#hasIdentifyNumber')[0].checked;

            // 期間の開始、終了日付の取得
            var startOfPeriod = GetDayString(new Date($('#startOfPeriod').val()));
            var endOfPeriod = GetDayString(new Date($('#endOfPeriod').val()));

            // デポ情報取得
            var checkedDepos = getCheckedDepos();

            // フォーム情報取得
            let data = {
                "gamenName": gamenName,
                "startofPeriod": startOfPeriod,
                "endOfPeriod": endOfPeriod,
                "isOnlyHasAmountDefference": isOnlyHasAmountDefference,
                hasTripName: hasTripName,
                hasIdentifyNumber: hasIdentifyNumber,
                checkedDepos: checkedDepos
            };

            // Excel出力共通処理
            onExportFileTripsCommon(page, data);
        }
        else {
            var errorMessage = 'E1007: 検索できる期間は最長90日です。90日を超えないように選択してください。';
            $("#div-error-message").text(errorMessage);
        }
    }


