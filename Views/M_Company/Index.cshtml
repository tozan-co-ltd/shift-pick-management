@using mar_sumaken_web.Commons;
@model mar_sumaken_web.Models.M_CompanyModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.CategoryTitle + " - " + Model.ViewTitle;
}
<style type="text/css">
    .btn-register {
        min-width: 130px !important;
    }
</style>

<div class="card shadow de-inspection masterInfo m-4">
    <div class="card-header text-gray-800">
        @ViewData["Title"]
    </div>
    <div class="card-body">

        <div class="form-group col-sm-12 pl-3">
            <p id="div-error-message" class="mt-1 text-danger"></p>

            @if (ViewData["ErrorMessage"] != null)
            {
                <span class="mt-1 text-danger">@ViewData["ErrorMessage"]</span>
            }
        </div>

        <div class="mg-bot-20">
            <div class="col-12 d-flex xs-block justify-content-start align-items-center p-0">
                <div class="input-group-append mr-2">
                    <a class="btn btn-primary btn-icon-split btn-register" asp-controller="M_Company" asp-action="Register">
                        <span class="icon text-white-50">
                            <i class="fas fa-plus"></i>
                        </span>
                        <span class="text">新規作成</span>
                    </a>
                </div>
                <div class="input-group-append">
                    <a href="#" class="btn btn-info btn-icon-split" onclick="onExportFile('M_Company', '@Model.ViewTitle')">
                        <span class="icon text-white-50">
                            <i class="fas fa-file-export"></i>
                        </span>
                        <span class="text">出力</span>
                    </a>
                </div>
            </div>
        </div>
        <div class="mt-3">
            <table class="table table-sm stripe hover nowrap datatable-normal">
                <thead>
                    <tr>
                        <th width="40"></th>
                        <th class="font-weight-bold">ID</th>
                        <th class="font-weight-bold">会社コード</th>
                        <th class="font-weight-bold">会社区分</th>
                        <th class="font-weight-bold">会社名</th>
                        <th class="font-weight-bold">取引先名</th>
                        <th class="font-weight-bold">更新日時</th>
                        <th class="font-weight-bold">更新者</th>
                    </tr>
                </thead>
                <tbody>
                    @if (@Model != null && @Model.M_CompanyList != null && @Model.M_CompanyList.Count > 0)
                    {
                        @foreach (var item in @Model.M_CompanyList)
                        {
                            <tr>
                                <td>
                                    <a class="btn btn-success btn-icon-split ml-1 mr-1"
                                    onclick="OnEditClick('@item.CompanyID')" data-id="@item.CompanyID" data-toggle="modal" data-target="#edit-modal">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <button class="btn btn-danger btn-icon-split"
                                    onclick="OnDeleteClick('@item.CompanyID')" data-id="@item.CompanyID" data-toggle="modal" data-target="#delete-modal">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </td>
                                <td>@item.CompanyID</td>
                                <td>@item.CompanyCode</td>
                                <td>@item.CompanyKubunName</td>
                                <td>@item.CompanyName</td>
                                <td>@item.ClientName</td>
                                <td>@item.UpdatedAt</td>
                                <td>@item.UpdatedBy</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!--  Edit Modal-->
<div class="modal fade" id="edit-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="edit-modal-label">修正</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="col-12 col-md-10">
                    <p id="edit-modal-error-message" class="mt-1 text-danger"></p>
                </div>
                <div class="d-flex justify-content-center">
                    <form class="col-md-12" id="mCompanyForm">
                        <div class="col-12 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st">
                                <label>@Html.DisplayName("CompanyID")</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 column-2nd">
                                <input class="form-control" type="text" asp-for="CompanyID" autocomplete="off" readonly>
                            </div>
                        </div>
                        <div class="col-12 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st">
                                <label>@Html.DisplayName("CompanyCode")<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 column-2nd">
                                <input class="form-control" type="text" asp-for="CompanyCode" autocomplete="off" value="" required>
                                <small class="form-text text-muted w-100 p-1">1～10文字の数字が使用できます。</small>
                                <span class="text-danger w-100" asp-validation-for="CompanyCode"></span>
                            </div>
                        </div>
                        <div class="col-12 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st">
                                <label>@Html.DisplayName("CompanyKubun")<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 column-2nd">
                                <select class="form-select" asp-for="CompanyKubun" required>
                                    @for (var i = 0; i < Model.KubunSelectList.Count; i++)
                                    {
                                        <option value="@Model.KubunSelectList[i].Value" selected>@Model.KubunSelectList[i].Text</option>
                                    }
                                </select>
                                <span class="text-danger w-100" asp-validation-for="CompanyKubun"></span>
                            </div>
                        </div>
                        <div class="col-12 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st">
                                <label>@Html.DisplayName("CompanyName")<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 column-2nd">
                                <input class="form-control" type="text" asp-for="CompanyName" autocomplete="off" required>
                                <span class="text-danger w-100" asp-validation-for="CompanyName"></span>
                            </div>
                        </div>
                        <div class="col-12 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st">
                                <label>@Html.DisplayName("ClientName")</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 column-2nd">
                                <input class="form-control" type="text" asp-for="ClientName" autocomplete="off">
                                <span class="text-danger w-100" asp-validation-for="ClientName"></span>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap justify-content-center p-2 p-md-3">
                            <button class="btn btn-success btn-icon-split mb-2 mr-0 mr-sm-5" onclick="OnExecuteEdit()">
                                <span class="text" style="min-width:84px">更新</span>
                            </button>
                            <button class="btn btn-secondary btn-icon-split mb-2" data-dismiss="modal" aria-label="Close">
                                <span class="text">キャンセル</span>
                            </button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

<!--  Delete Modal-->
<div class="modal fade" id="delete-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="delete-modal-label">削除</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="col-12 col-md-10">
                    <p id="delete-modal-error-message" class="mt-1"></p>
                </div>
                <div class="d-flex justify-content-center">
                    <div class="col-12 col-md-10">
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4 col-md-4">
                                <label>ID</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-7 mb-2">
                                <input class="form-control" id="deleteCompanyId" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4 col-md-4">
                                <label>会社コード</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-7 mb-2">
                                <input class="form-control" id="deleteCompanyCode" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4 col-md-4">
                                <label>会社区分</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-7 mb-2">
                                <input class="form-control" id="deleteCompanyKubun" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4 col-md-4">
                                <label>会社名</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-7 mb-2">
                                <input class="form-control" id="deleteCompanyName" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4 col-md-4">
                                <label>取引先名</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-7 mb-2">
                                <input class="form-control" id="deleteClientName" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap justify-content-center p-2 p-md-3">
                            <button class="btn btn-danger btn-icon-split mb-2 mr-0 mr-sm-5" onclick="OnExecuteDelete()">
                                <span class="text" style="min-width:84px">削除</span>
                            </button>
                            <button class="btn btn-secondary btn-icon-split mb-2" data-dismiss="modal" aria-label="Close">
                                <span class="text">キャンセル</span>
                            </button>
                        </div>
                    </div>
                </div>
                
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    // 編集ボタン押下
    function OnEditClick(companyID) {
        DeleteErrorMessages();

        // M_CompanyModel取得
        var companyModel = @Html.Raw(Json.Serialize(Model));
        companyModel.m_CompanyList.forEach(function (item) {
            if (item.companyID == companyID) {
                $("#CompanyID").val(item.companyID);
                $("#CompanyCode").val(item.companyCode);
                $("#CompanyKubun").val(item.companyKubun);
                $("#CompanyName").val(item.companyName);
                $("#ClientName").val(item.clientName);
            }
        });
    }

    // 更新
    function OnExecuteEdit() {
        $('#mCompanyForm').submit(function (event) {
            DeleteErrorMessages();

            // ページの更新を禁止する
            event.preventDefault();

            // 送信イベントが他のハンドラーに伝播するのを防ぐ
            event.stopImmediatePropagation();

            // フォーム情報取得
            let url = window.location.origin + '@Url.Action("Edit", "M_Company")';
            let method = 'POST';
            var data = $('#mCompanyForm').serializeArray();

            // Ajax call
            $.ajax({
                url: url,
                method: method,
                data: data
            }).done(async function (data) {
                $('#edit-modal').hide();
                // 完了モーダル表示
                AlertMessage('', '完了', '登録完了しました。', null, null);
            }).fail(function (xhr, textStatus, errorThrown) {
                if (xhr.status === 404) {
                    var errorMessage = xhr.responseJSON.errorMessage;
                    $("#edit-modal-error-message").text(errorMessage);
                } else {
                    var errorMessage500 = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                    $("#edit-modal-error-message").text(errorMessage500);
                }
            });
        });
    }

    // 削除ボタン押下
    function OnDeleteClick(companyID) {
        // M_CompanyModel取得
        var companyModel = @Html.Raw(Json.Serialize(Model));
        companyModel.m_CompanyList.forEach(function (item) {

            if (item.companyID == companyID) {
                $("#deleteCompanyId").val(item.companyID);
                $("#deleteCompanyCode").val(item.companyCode);
                $("#deleteCompanyKubun").val(item.companyKubunName);
                $("#deleteCompanyName").val(item.companyName);
                $("#deleteClientName").val(item.clientName);
            }
        });
    }

    // 削除
    function OnExecuteDelete() {
        DeleteErrorMessages();

        // フォーム情報取得
        let url = window.location.origin + '@Url.Action("Delete", "M_Company")';
        let method = 'POST';
        var data = { "companyId": $("#deleteCompanyId").val() };

        // Ajax call
        $.ajax({
            url: url,
            method: method,
            data: data
        }).done(async function (data) {
            $('#delete-modal').removeClass('show');
            $('#delete-modal').hide();
            // 完了モーダル表示
            AlertMessage('', '完了', '登録完了しました。', null, null);
        }).fail(function (xhr, textStatus, errorThrown) {
            if (xhr.status === 404) {
                var errorMessage = xhr.responseJSON.errorMessage;
                $("#delete-modal-error-message").text(errorMessage);
            } else {
                var errorMessage500 = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                $("#delete-modal-error-message").text(errorMessage500);
            }
        });
    }

    // エラーメッセージ削除
    function DeleteErrorMessages() {
        $('#div-error-message').text('');
        $('#edit-modal-error-message').text('');
        $('#delete-modal-error-message').text('');
        $('.text-danger').text('');
        $('input').removeClass('input-validation-error');
    }

</script>