@using mar_sumaken_web.Commons;
@model mar_sumaken_web.Models.M_CompanyModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.CategoryTitle + " - " + Model.ViewTitle + " - " + "登録";
}

<div class="card shadow masterInfo m-4">

    <div class="card-header text-gray-800">
        @ViewData["Title"]
    </div>

    <div class="card-body">
        <div class="col-md-12 pb-3">
            <form method="get" asp-controller="M_Company" asp-action="Index">
                <button type="submit" class="btn btn-secondary btn-icon-split">
                    <span class="icon text-white-50">
                        <i class="fas fa-arrow-left-long"></i>
                    </span>
                    <span class="text">戻る</span>
                </button>
            </form>
        </div>

        <div class="form-group col-sm-12 pl-3">
            <p id="div-error-message" class="mt-1 text-danger"></p>

            @if (ViewData["ErrorMessage"] != null)
            {
                <span class="mt-1 text-danger">@ViewData["ErrorMessage"]</span>
            }
        </div>

        <div class="mg-bot-20">
            <div class="col-16 sp-tablet mb-3">
                <form class="col-md-12" method="post" enctype="multipart/form-data" name="form" id="mCompanyForm">
                    <div class="col-12 input-group div-input-group">
                        <div class="col-12 col-sm-4 col-md-2 column-1st">
                            <label>@Html.DisplayName("CompanyCode")<span style="color:red">*</span></label>
                        </div>
                        <div class="col-12 col-sm-8 col-md-5 column-2nd">
                            <input class="form-control" type="text" asp-for="CompanyCode" autocomplete="off" value="" required>
                            <small class="form-text text-muted w-100 p-1">1～10文字の数字が使用できます。</small>
                            <span class="text-danger w-100" asp-validation-for="CompanyCode"></span>
                        </div>
                    </div>
                    <div class="col-12 input-group div-input-group">
                        <div class="col-12 col-sm-4 col-md-2 column-1st">
                            <label>@Html.DisplayName("CompanyKubun")<span style="color:red">*</span></label>
                        </div>
                        <div class="col-12 col-sm-8 col-md-5 column-2nd">
                            <select class="form-select" asp-for="CompanyKubun" required>
                                @for (var i = 0; i < Model.KubunSelectList.Count; i++)
                                {
                                    <option value="@Model.KubunSelectList[i].Value" selected>@Model.KubunSelectList[i].Text</option>
                                }
                            </select>
                            <span class="text-danger w-100" asp-validation-for="CompanyKubun"></span>
                        </div>
                    </div>
                    <div class="col-12 input-group div-input-group">
                        <div class="col-12 col-sm-4 col-md-2 column-1st">
                            <label>@Html.DisplayName("CompanyName")<span style="color:red">*</span></label>
                        </div>
                        <div class="col-12 col-sm-8 col-md-5 column-2nd">
                            <input class="form-control" type="text" asp-for="CompanyName" autocomplete="off" required>
                            <span class="text-danger w-100" asp-validation-for="CompanyName"></span>
                        </div>
                    </div>
                    <div class="col-12 input-group div-input-group">
                        <div class="col-12 col-sm-4 col-md-2 column-1st">
                            <label>@Html.DisplayName("ClientName")</label>
                        </div>
                        <div class="col-12 col-sm-8 col-md-5 column-2nd">
                            <input class="form-control" type="text" asp-for="ClientName" autocomplete="off">
                            <span class="text-danger w-100" asp-validation-for="ClientName"></span>
                        </div>
                    </div>

                    <button class="btn btn-primary btn-icon-split" style="min-width: 80px" onclick="OnRegister()">
                        <span class="text">登録</span>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    // 登録ボタン押下
    function OnRegister() {
        $('#mCompanyForm').submit(function (event) {
            $("#div-error-message").text("");

            // ページの更新を禁止する
            event.preventDefault();

            // 送信イベントが他のハンドラーに伝播するのを防ぐ
            event.stopImmediatePropagation();

            // フォーム情報取得
            let url = window.location.origin + '@Url.Action("Register", "M_Company")';
            let method = 'POST';
            let formId = 'mCompanyForm';
            let data = $('#' + formId).serializeArray();

            // Ajax call
            $.ajax({
                url: url,
                method: method,
                data: data
            }).done(function (response) {
                $('#' + formId)[0].reset();
                // 完了モーダル表示
                AlertMessage('', '完了', '登録が完了しました。', null, null);
            }).fail(function (jqXHR, textStatus, errorThrown) {
                if (jqXHR.status === 404) {
                    // データが見つからなかった場合
                    var errorMessage = jqXHR.responseJSON.errorMessage;
                    $("#div-error-message").text(errorMessage);
                } else {
                    // その他のエラーの場合
                    var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                    $("#div-error-message").text(errorMessage);
                }
            });
        });
    }

</script>

