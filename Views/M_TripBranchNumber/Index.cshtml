@using ai_truck_load_measurement.Commons;
@model ai_truck_load_measurement.Models.M_TripBranchNumberModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = "マスター - 便マスター - 便枝番マスター";
}
<div class="card shadow de-inspection masterInfo m-4">
    <div class="card-header">
        @ViewData["Title"]
    </div>

    <div class="card-body">

        <div class="row">
            <div class="col-lg-10">
                <div class="card border-left-custom">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li>適用期間内の便枝番が初期表示されます。</li>
                            <li>"枝連番を表示"にチェックを入れると基準日時時点の連番が表示されます。</li>
                            <li>適用開始日時は、適用開始日の前日の夜勤が終了する予定日時を入力してください。</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group col-sm-12 pl-3">
            <p id="div-error-message" class="mt-1 text-danger"></p>

            @if (ViewData["ErrorMessage"] != null)
            {
                <span class="mt-1 text-danger">@ViewData["ErrorMessage"]</span>
            }
        </div>

        <div class="h2">
            <label>便名称：@Model.TripName</label>
        </div>

        <div class="mg-bot-20 mb-3">
            <div class="col-12 d-flex xs-block justify-content-start align-items-center p-0">
                <div class="input-group-append">
                    <div class="mr-3">
                        <label>基準日時<input type="datetime-local" id="referenceDate" class="ml-3" style="background-color: white" /></label>
                    </div>
                </div>
            </div>
        </div>

        <div class="mg-bot-20 mb-3">
            <div class="col-12 d-flex xs-block justify-content-start align-items-center p-0">
                <div class="input-group-append mr-3">
                    <label><input type="checkbox" id="isBeforeApplicablePeriod" value="beforeApplicablePeriod" /> 全てのデータを表示</label>
                </div>
            </div>
        </div>

        <div class="mg-bot-20">
            <div class="col-12 d-flex xs-block justify-content-start align-items-center p-0">
                <div class="input-group-append mr-3">
                    <a class="btn btn-secondary btn-icon-split" asp-controller="M_Trip" asp-action="Index" asp-route-isChecked="@Model.IsCheckedBeforeApplicablePeriod">
                        <span class="icon text-white-50">
                            <i class="fas fa-arrow-left-long"></i>
                        </span>
                        <span class="text">戻る</span>
                    </a>
                </div>
                <div class="input-group-append mr-3">
                    <a href="#" class="btn btn-primary btn-icon-split btn-register" onclick="onRegisterClick('M_TripBranchNumber', @Model.TripID, '@Model.TripName')">
                        <span class="icon text-white-50">
                            <i class="fas fa-plus"></i>
                        </span>
                        <span class="text">新規作成</span>
                    </a>
                </div>
            </div>
        </div>
        <div id="m_tripBranchNumberTable">
        </div>
    </div>
</div>

<!--  Edit Modal-->
<div class="modal fade" id="edit-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="edit-modal-label">編集</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="col-12 col-md-12">
                    <p id="edit-modal-error-message" class="mt-1 text-danger"></p>
                </div>
                <div class="d-flex justify-content-center">
                    <form class="col-md-12" id="mTripBranchNumberForm">
                        <input type="hidden" asp-for="TripBranchNumberID" value="@Model.TripBranchNumberID" />
                        <input type="hidden" asp-for="TripID" value="@Model.TripID" />
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl">
                                <label>@Html.DisplayName("TripName")</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <input class="form-control" type="text" asp-for="TripName" autocomplete="off" value="" readonly >
                                <span class="text-danger w-100" asp-validation-for="TripName"></span>
                            </div>
                        </div>
                        <br />
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl modalLabel">
                                <label><a>@Html.DisplayName("Tag")</a></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <input class="form-control" type="text" asp-for="Tag" autocomplete="off" value="" required>
                                <span class="text-danger w-100" asp-validation-for="Tag"></span>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl modalLabel">
                                <label><a>@Html.DisplayName("RegistArrivalScheduledTime")<span style="color:red">*</span></a></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <input class="form-control" type="text" asp-for="RegistArrivalScheduledTime" autocomplete="off" value="" required>
                                <small class="form-text text-muted w-100 p-1">hh:mmで入力してください。</small>
                                <span class="text-danger w-100" asp-validation-for="RegistArrivalScheduledTime"></span>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl modalLabel">
                                <label><a>@Html.DisplayName("RegistDepartureScheduledTime")<span style="color:red">*</span></a></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <input class="form-control" type="text" asp-for="RegistDepartureScheduledTime" autocomplete="off" value="" required>
                                <small class="form-text text-muted w-100 p-1">hh:mmで入力してください。</small>
                                <span class="text-danger w-100" asp-validation-for="RegistDepartureScheduledTime"></span>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl modalLabel">
                                <label><a>@Html.DisplayName("ApplicableStartDateTime")<span style="color:red">*</span></a></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <input class="form-control" type="text" asp-for="ApplicableStartDateTime" autocomplete="off" value="" required>
                                <small class="form-text text-muted w-100 p-1">YYYY/MM/DD hh:mmで入力してください。</small>
                                <span class="text-danger w-100" asp-validation-for="ApplicableStartDateTime"></span>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl modalLabel">
                                <label><a>@Html.DisplayName("ApplicableEndDateTime")<span style="color:red">*</span></a></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <input class="form-control" type="text" asp-for="ApplicableEndDateTime" autocomplete="off" value="" required>
                                <small class="form-text text-muted w-100 p-1">YYYY/MM/DD hh:mmで入力してください。</small>
                                <span class="text-danger w-100" asp-validation-for="ApplicableEndDateTime"></span>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap justify-content-center p-2 p-md-3">
                            <button class="btn btn-secondary btn-icon-split mb-2 mr-0 mr-sm-5" data-dismiss="modal" aria-label="Close">
                                <span class="text">キャンセル</span>
                            </button>
                            <button class="btn btn-success btn-icon-split mb-2" onclick="OnExecuteEdit()">
                                <span class="text" style="min-width:84px">更新</span>
                            </button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

<script>
    // let model;
    // 画面ロード時
    $(document).ready(function () {
        // 今日の日付を取得
        var today = new Date();
        today.setDate(today.getDate());
        var yyyy = today.getFullYear();
        var MM = ("0" + (today.getMonth() + 1)).slice(-2);
        var dd = ("0" + today.getDate()).slice(-2);
        var hh = ("0" + today.getHours()).slice(-2);
        var mm = ("0" + today.getMinutes()).slice(-2);;

        $('#referenceDate').val(yyyy + '-' + MM + '-' + dd + "T" + hh + ":" + mm);

        model = @Html.Raw(Json.Serialize(Model));
        $('#isBeforeApplicablePeriod').prop('checked', model.isCheckedBeforeApplicablePeriod);
        if(model.isCheckedBeforeApplicablePeriod){
            $('#referenceDate').attr('readonly', true);
            $('#referenceDate').css({ 'background-color': 'lightgray' });
        }
        // テーブル表示
        tableDisplay();
    });

    // 便テーブルの表示
    function tableDisplay() {
        // チェックボックスの入力情報取得
        var isBeforeApplicablePeriod = $('#isBeforeApplicablePeriod')[0].checked;

        var tripId = model.tripID;
        var referenceDate = $('#referenceDate').val();

        // フォーム情報取得
        let url = window.location.origin + '@Url.Action("SearchData", "M_TripBranchNumber")';
        let method = 'Post';
        let data = { tripId: tripId, isBeforeApplicablePeriod: isBeforeApplicablePeriod, refferenceDate: referenceDate };

        // Ajax call
        $.ajax({
            url: url,
            method: method,
            data: data
        }).done(function (response) {

            $('#m_tripBranchNumberTable').empty().html(response);
            // 日本語表示
            const language_url = "https://cdn.datatables.net/plug-ins/1.11.5/i18n/ja.json";
            const dom_structure = "<'top d-flex align-items-center'li<'ml-auto'f>>rt<'bottom'p><'clear'>";

            // ID(2列目)昇順
            $("#tripTable").DataTable({
                "language": {
                    "url": language_url,
                    searchPlaceholder: "フリーワード(全件)"
                },
                lengthChange: true,     // 件数切替
                info: true,            // 総件数
                scrollX: true,          // 横スクロール可
                scrollCollapse: true,   // 縦スクロール表示
                order: [[1, "asc"]],    // ID昇順
                searchHighlight: true,  // 検索ハイライト
                columnDefs: [
                    { targets: 0, sortable: false },    // インデックス0列(アイコン列)のソート禁止
                    { targets: 3, className: "dt-body-left"}, // タグ列左寄せ
                ],
                "oLanguage": {
                    "sSearch": ""
                },
                dom: dom_structure
            });
        }).fail(function (jqXHR, textStatus, errorThrown) {
            if (jqXHR.status === 404) {
                var errorMessage = jqXHR.responseJSON.errorMessage;
                $("#div-error-message").text(errorMessage);
            } else {
                var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                $("#div-error-message").text(errorMessage);
            }
        });

    }

    // 新規登録ボタン押下時
    function onRegisterClick(page, tripID, tripName) {
        event.preventDefault();
        // チェックボックスの入力情報取得
        var checkBox = $('#isBeforeApplicablePeriod').prop('checked');
        location.href = "" + page + "/Register?isChecked=" + checkBox + "&id=" + tripID + "&tripName=" + tripName;
    }


    // 編集ボタン押下
    function OnEditClick(tripBranchNumberID) {
        DeleteErrorMessages();

        // M_TripModel取得
        model.m_TripBranchNumberList.forEach(function (item) {
            var arrivalScheduledTime = GetTimeString(new Date(item.arrivalScheduledTime));
            var departureScheduledTime = GetTimeString(new Date(item.departureScheduledTime));
            var applicableStartDateTime = GetDateString(new Date(item.applicableStartDateTime));
            var applicableEndDateTime = GetDateString(new Date(item.applicableEndDateTime));
            if (item.tripBranchNumberID == tripBranchNumberID) {
                $("#TripBranchNumberID").val(item.tripBranchNumberID);
                $("#TripID").val(model.tripID);
                $("#TripName").val(model.tripName);
                $("#Tag").val(item.tag);
                $("#RegistArrivalScheduledTime").val(arrivalScheduledTime);
                $("#RegistDepartureScheduledTime").val(departureScheduledTime);
                $("#ApplicableStartDateTime").val(applicableStartDateTime);
                $("#ApplicableEndDateTime").val(applicableEndDateTime);
            }
        });
    }
    // 更新ボタン押下
    function OnExecuteEdit() {
        $('#mTripBranchNumberForm').submit(function (event) {
            DeleteErrorMessages();

            // ページの更新を禁止する
            event.preventDefault();

            // 送信イベントが他のハンドラーに伝播するのを防ぐ
            event.stopImmediatePropagation();

            // フォーム情報取得
            let url = window.location.origin + '@Url.Action("Edit", "M_TripBranchNumber")';
            let method = 'POST';
            let formId = 'mTripBranchNumberForm';
            let data = $('#' + formId).serializeArray();

            // Ajax call
            $.ajax({
                url: url,
                method: method,
                data: data
            }).done(function (response) {
                $('#edit-modal').hide();
                // 完了モーダル表示
                AlertMessage('', '完了', '登録が完了しました。', null, null);
            }).fail(function (jqXHR, textStatus, errorThrown) {
                if (jqXHR.status === 404) {
                    var errorMessage = jqXHR.responseJSON.errorMessage;
                    $("#edit-modal-error-message").text(errorMessage);
                } else {
                    var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                    $("#edit-modal-error-message").text(errorMessage);
                }
            });
        });
    }

    // 基準日時変更時
    $('input[type=datetime-local]').change(function () {
        tableDisplay();
    });

    $('input[type=checkbox]').change(function () {
        // チェックボックスの入力情報取得
        var isBeforeApplicablePeriod = $('#isBeforeApplicablePeriod')[0].checked;
        // デフォルトの操作を無効化
        event.preventDefault();
        if (isBeforeApplicablePeriod) {
            $('#referenceDate').attr('readonly', true);
            $('#referenceDate').css({ 'background-color': 'lightgray' });
        }
        else {
            $('#referenceDate').attr('readonly', false);
            $('#referenceDate').css({ 'background-color': '#ffffff' });
        }
        // テーブル表示
        tableDisplay();
    })
</script>