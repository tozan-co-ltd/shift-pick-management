@using mar_sumaken_web.Commons;
@model mar_sumaken_web.Models.M_ProductModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.CategoryTitle + " - " + Model.ViewTitle;
}

<div class="card shadow de-inspection masterInfo m-4">
    <div class="card-header text-gray-800">
        @ViewData["Title"]
    </div>
    <div class="card-body">

        <div class="form-group col-sm-12">
            <p id="div-error-message" class="mt-1 text-danger"></p>
        </div>

        @if (ViewData["ErrorMessage"] != null)
        {
            <span class="mt-1 text-danger">@ViewData["ErrorMessage"]</span>
        }

        <div class="mg-bot-20">
            <div class="col-12 d-flex xs-block justify-content-start align-items-center p-0">
                <div class="input-group-append mr-2">
                    <a class="btn btn-primary btn-icon-split" asp-controller="M_Product" asp-action="Register">
                        <span class="icon text-white-50">
                            <i class="fas fa-plus"></i>
                        </span>
                        <span class="text">新規作成</span>
                    </a>
                </div>
                <div class="input-group-append">
                    <a href="#" class="btn btn-info btn-icon-split" onclick="onExportFile('M_Product')">
                        <span class="icon text-white-50">
                            <i class="fas fa-file-export"></i>
                        </span>
                        <span class="text">出力</span>
                    </a>
                </div>
            </div>
        </div>
        <div class="mt-3">
            <table class="table table-sm stripe hover nowrap datatable-normal">
                <thead>
                    <tr>
                        <th width="40"></th>
                        <th class="font-weight-bold">ID</th>
                        <th class="font-weight-bold">仕入先名</th>
                        <th class="font-weight-bold">仕入先品番</th>
                        <th class="font-weight-bold">納入先名</th>
                        <th class="font-weight-bold">納入先品番</th>
                        <th class="font-weight-bold">品名</th>
                        <th class="font-weight-bold">収容数</th>
                        <th class="font-weight-bold">使用倉庫名</th>
                        <th class="font-weight-bold">更新日時</th>
                        <th class="font-weight-bold">更新者</th>
                    </tr>
                </thead>
                <tbody>
                    @if (@Model != null && @Model.MProductList?.Count > 0)
                    {
                        @foreach (var item in @Model.MProductList)
                        {
                            <tr>
                                <td>
                                    <a class="btn btn-success btn-icon-split ml-1 mr-1"
                                    onclick="OnEditClick('@item.ProductID')" data-id="@item.ProductID" data-toggle="modal" data-target="#edit-modal">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <button class="btn btn-danger btn-icon-split"
                                    onclick="OnDeleteClick('@item.ProductID')" data-id="@item.ProductID" data-toggle="modal" data-target="#delete-modal">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </td>
                                <td>@item.ProductID</td>
                                <td>@item.SupplierName</td>
                                <td>@item.SupplierProductNumber</td>
                                <td>@item.DeliveryName</td>
                                <td>@item.DeliveryProductNumber</td>
                                <td>@item.ProductName</td>
                                <td>@item.LotQuantity</td>
                                <td>@item.RDepoProductNames</td>
                                <td>@item.UpdatedAt</td>
                                <td>@item.UpdatedBy</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!--  Edit Modal-->
<div class="modal fade" id="edit-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="edit-modalLabel">修正</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="col-12 col-md-10">
                    <p id="edit-modal-error-message" class="mt-1 text-danger"></p>
                </div>
                <div class="d-flex justify-content-center">
                    <form class="col-md-12" id="mProductForm">
                        <div class="col-12 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st">
                                <label>@Html.DisplayName("ProductID")</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 column-2nd">
                                <input class="form-control" type="text" asp-for="ProductID" autocomplete="off" readonly>
                            </div>
                        </div>
                        <div class="col-12 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st">
                                <label>@Html.DisplayName("SupplierName")<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 column-2nd">
                                <select class="form-select" asp-for="SupplierID" required>
                                    @for (var i = 0; i < Model.SuplierSelectList.Count; i++)
                                    {
                                        <option value="@Model.SuplierSelectList[i].Value">@Model.SuplierSelectList[i].Text</option>
                                    }
                                </select>
                                <span class="text-danger w-100" asp-validation-for="SupplierID"></span>
                            </div>
                        </div>
                        <div class="col-12 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st">
                                <label>@Html.DisplayName("SupplierProductNumber")<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 column-2nd">
                                <input class="form-control" type="text" asp-for="SupplierProductNumber" autocomplete="off" required>
                                <span class="text-danger w-100" asp-validation-for="SupplierProductNumber"></span>
                            </div>
                        </div>
                        <div class="col-12 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st">
                                <label>@Html.DisplayName("DeliveryName")<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 column-2nd">
                                <select class="form-select" asp-for="DeliveryID" required>
                                    @for (var i = 0; i < Model.DeliverySelectList.Count; i++)
                                    {
                                        <option value="@Model.DeliverySelectList[i].Value">@Model.DeliverySelectList[i].Text</option>
                                    }
                                </select>
                                <span class="text-danger w-100" asp-validation-for="DeliveryID"></span>
                            </div>
                        </div>
                        <div class="col-12 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st">
                                <label>@Html.DisplayName("DeliveryProductNumber")<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 column-2nd">
                                <input class="form-control" type="text" asp-for="DeliveryProductNumber" autocomplete="off" required>
                                <span class="text-danger w-100" asp-validation-for="DeliveryProductNumber"></span>
                            </div>
                        </div>
                        <div class="col-12 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st">
                                <label>@Html.DisplayName("ProductName")<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 column-2nd">
                                <input class="form-control" type="text" asp-for="ProductName" autocomplete="off" required>
                                <span class="text-danger w-100" asp-validation-for="ProductName"></span>
                            </div>
                        </div>
                        <div class="col-12 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st">
                                <label>@Html.DisplayName("LotQuantity")<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 column-2nd">
                                <input class="form-control" type="text" asp-for="LotQuantity" value="" autocomplete="off" required>
                                <span class="text-danger w-100" asp-validation-for="LotQuantity"></span>
                            </div>
                        </div>
                        <div class="col-12 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st">
                                <label>@Html.DisplayName("RDepoProductsRegister")<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 column-2nd warehouse-checkbox">
                                @for (var i = 0; i < @Model.RDepoProductsRegister.Count; i++)
                                {
                                    <div class="form-check">
                                        <input type="hidden" id="select-depo-value-@i" asp-for="RDepoProductsRegister[i].Value" value="@Model.RDepoProductsRegister[i].Value" />
                                        <input type="hidden" id="select-depo-text-@i" asp-for="RDepoProductsRegister[i].Text" value="@Model.RDepoProductsRegister[i].Value" />
                                        <input class="form-check-input checkbox" asp-for="RDepoProductsRegister[i].Selected" id="select-depo-@i" type="checkbox">
                                        <label class="form-check-label" id="label-depo-name-@i">@Model.RDepoProductsRegister[i].Text</label>
                                    </div>
                                }
                                <span class="text-danger w-100" id="depoProductErrorMsg"></span>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap justify-content-center p-2 p-md-3">
                            <button class="btn btn-success btn-icon-split mb-2 mr-0 mr-sm-5" onclick="OnExecuteEdit()">
                                <span class="text" style="min-width:84px">更新</span>
                            </button>
                            <button class="btn btn-secondary btn-icon-split mb-2" data-dismiss="modal" aria-label="Close">
                                <span class="text">キャンセル</span>
                            </button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

<!--  Delete Modal-->
<div class="modal fade" id="delete-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="delete-modalLabel">削除</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="col-12 col-md-10">
                    <p id="delete-modal-error-message" class="mt-1 text-danger"></p>
                </div>
                <div class="d-flex justify-content-center">
                    <div class="col-12 col-md-10">
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4">
                                <label>ID</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 mb-2">
                                <input class="form-control" id="deleteProductId" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4">
                                <label>仕入先名</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 mb-2">
                                <input class="form-control" id="deleteSupplierName" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4">
                                <label>仕入先品番</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 mb-2">
                                <input class="form-control" id="deleteSupplierProductNumber" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4">
                                <label>納入先名</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 mb-2">
                                <input class="form-control" id="deleteDeliveryName" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4">
                                <label>納入先品番</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 mb-2">
                                <input class="form-control" id="deleteDeliveryProductNumber" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4">
                                <label>品名</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 mb-2">
                                <input class="form-control" id="deleteProductName" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4">
                                <label>収容数</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-8 mb-2">
                                <input class="form-control" id="deleteLotQuantity" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap justify-content-center p-2 p-md-3">
                            <button class="btn btn-danger btn-icon-split mb-2 mr-0 mr-sm-5" onclick="OnExecuteDelete()">
                                <span class="text" style="min-width:84px">削除</span>
                            </button>
                            <button class="btn btn-secondary btn-icon-split mb-2" data-dismiss="modal" aria-label="Close">
                                <span class="text">キャンセル</span>
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    // 編集ボタン押下
    function OnEditClick(productID) {
        DeleteErrorMessages();

        // M_ProductModel取得
        var productModel = @Html.Raw(Json.Serialize(Model));

        productModel.mProductList.forEach(function (item) {
            if (item.productID == productID) {
                $("#ProductID").val(item.productID);
                $("#SupplierID").val(item.supplierID);
                $("#SupplierProductNumber").val(item.supplierProductNumber);
                $("#DeliveryProductNumber").val(item.deliveryProductNumber);
                $("#ProductName").val(item.productName);
                $("#LotQuantity").val(item.lotQuantity);

                // チェックボックス表示
                for (var i = 0; i < productModel.rDepoProductsRegister.length; i++) {
                    $("#select-depo-" + i).prop("checked", false);
                }
                item.rDepoProducts.forEach(function (depoItem) {
                    for (var i = 0; i < productModel.rDepoProductsRegister.length; i++) {
                        if (productModel.rDepoProductsRegister[i].value == depoItem.depoID) {
                            $("#select-depo-" + i).prop("checked", true);
                        }
                    }
                });
            }
        });
    }

    // 更新
    function OnExecuteEdit() {
        $('#mProductForm').submit(function (event) {
            DeleteErrorMessages();

            // フォーム情報を取得
            var formData = $('#mProductForm').serializeArray();

            // 使用倉庫名チェック
            CheckIsSelectedDepoProduct();

            // ページの更新を禁止する
            event.preventDefault();

            // 送信イベントが他のハンドラーに伝播するのを防ぐ
            event.stopImmediatePropagation();

            // Ajax
            $.ajax({
                url: window.location.origin + '@Url.Action("Edit", "M_Product")',
                method: "POST",
                data: formData
            })
            .done(function (response) {
                $('#edit-modal').hide();
                // 完了モーダル表示
                AlertMessage('', '完了', '登録完了しました。', null, null);
            })
            .fail(function (xhr, textStatus, errorThrown) {
                if (xhr.status === 404) {
                    var errorMessage = xhr.responseJSON.errorMessage;
                    $("#edit-modal-error-message").text(errorMessage);
                } else {
                    var errorMessage500 = "サーバーに接続できませんでした。" + '<br> ' + 'HttpRequest : ' + xhr.status + '<br> ' + 'textStatus : ' + textStatus;
                    $("#edit-modal-error-message").text(errorMessage500);
                }
            });
        });
    }

    // 削除ボタン押下
    function OnDeleteClick(productID) {
        DeleteErrorMessages();

        // M_ProductModel取得
        var productModel = @Html.Raw(Json.Serialize(Model));

        productModel.mProductList.forEach(function (item) {
            if (item.productID == productID) {
                $("#deleteProductId").val(item.productID);
                $("#deleteSupplierName").val(item.supplierName);
                $("#deleteSupplierProductNumber").val(item.supplierProductNumber);
                $("#deleteDeliveryName").val(item.deliveryName);
                $("#deleteDeliveryProductNumber").val(item.deliveryProductNumber);
                $("#deleteProductName").val(item.productName);
                $("#deleteLotQuantity").val(item.lotQuantity);
            }
        });
    }

    // 削除
    function OnExecuteDelete() {
        DeleteErrorMessages();

        // POSTするデータ
        var productId = document.getElementById('deleteProductId').value;
        formData = {
            "productId": productId
        };

        // ajax
        $.ajax({
            url: window.location.origin + '@Url.Action("Delete", "M_Product")',
            method: "POST",
            data: formData
        })
        .done(function (data) {
            // 完了モーダル表示
            $('#delete-modal').hide();
            AlertMessage('', '完了', '登録完了しました。', null, null);
        })
        .fail(function (xhr, textStatus, errorThrown) {
            if (xhr.status === 404) {
                var errorMessage = xhr.responseJSON.errorMessage;
                $("#delete-modal-error-message").text(errorMessage);
            } else {
                var errorMessage500 = "サーバーに接続できませんでした。" + '<br> ' + 'HttpRequest : ' + xhr.status + '<br> ' + 'textStatus : ' + textStatus;
                $("#delete-modal-error-message").text(errorMessage500);
            }
        });
    }

    // 使用倉庫名空欄チェック
    $(document).ready(function () {
        var checkList = @Html.Raw(Json.Serialize(Model.RDepoProductsRegister));
        for (var i = 0; i < checkList.length; i++) {
            var item = "#select-depo-" + i;
            $(item).change(function (item) {
                CheckIsSelectedDepoProduct();
            });
        }
    });
    function CheckIsSelectedDepoProduct() {
        $('#depoProductErrorMsg').text('');

        var checkList = @Html.Raw(Json.Serialize(Model.RDepoProductsRegister));
        var hasSelectedItem = false;
        
        for (var i = 0; i < checkList.length; i++) {
            var item = "#select-depo-" + i;
            if ($(item).is(":checked")) {
                hasSelectedItem = true;
            }
        }
        if (!hasSelectedItem) {
            $('#depoProductErrorMsg').text('使用倉庫名は必須項目です。');
        }
    }

    // エラーメッセージ削除
    function DeleteErrorMessages() {
        $('#div-error-message').text('');
        $('#edit-modal-error-message').text('');
        $('#delete-modal-error-message').text('');
        $('#depoProductErrorMsg').text('');
        $('.text-danger').text('');
        $('input').removeClass('input-validation-error');
    }

</script>