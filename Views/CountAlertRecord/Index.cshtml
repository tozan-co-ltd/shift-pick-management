@using ai_truck_load_measurement.Commons;
@model ai_truck_load_measurement.Models.AlertRecordViewModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.CategoryTitle + " - " + Model.ViewTitle;
}

<div class="card shadow de-inspection masterInfo m-4">
    <div class="card-header">
        @ViewData["Title"]
    </div>

    <div class="card-body">

        <div class="row">
            <div class="col-lg-10">
                <div class="card border-left-custom">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li>通知マスターで設定した条件に合致した便が表示されます。</li>
                            <li>アラート項目列にはアラート通知に合致した項目が記録されています。</li>
                            <li>アラート通知「到着時間(早or遅)」「出発時間(早or遅)」は到着・出発実績が予定より「60分～90分早い」or「20分～30分遅い」場合に発します。</li>
                            <li>到着荷量(下限)・出発荷量(下限)は通知マスターで設定した下限値を下回った場合に記録されます。</li>
                            <li>最長90日の期間が検索できます。</li>
                            <li>便枝番とは、便が各拠点へ訪問した回数を示すために昼勤開始時間から順に割り当てた番号です。</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group col-sm-12 pl-3">
            <p id="div-error-message" class="mt-1 text-danger"></p>

            @if (ViewData["ErrorMessage"] != null)
            {
                <span class="mt-1 text-danger">@ViewData["ErrorMessage"]</span>
            }
        </div>
        <form id="CountAlertRecordForm">
            <div class="span-paragraph mb-3">
                <div class="col-16 d-flex justify-content-start align-items-center unset-pdl sp-cs-dpl">
                    <div class="d-flex justify-content-start align-items-center unset-pdl">
                        <span class="warehouse-name-drs ">デポ</span>
                        <div style="font-weight: normal">
                            <label class="mr-2"><input type="checkbox" class=" mr-2" id="allDepo" />すべて  [</label>
                            <label id="selectDepos"></label>]
                        </div>
                    </div>
                </div>
            </div>
            <div class="span-paragraph mb-3">
                <div class="col-16 d-flex justify-content-start align-items-center unset-pdl sp-cs-dpl">
                    <div class="d-flex justify-content-start align-items-center unset-pdl">
                        <span class="warehouse-name-drs">稼働日</span>
                        <input type="text" id="startOfPeriod" class="form-control pickerDate startDate">
                        <label class="m-1">～</label>
                        <input type="text" id="endOfPeriod" class="form-control pickerDate endDate">
                    </div>
                </div>
            </div>
            <div class="span-paragraph mb-3">
                <div class="col-16 d-flex justify-content-start align-items-center unset-pdl sp-cs-dpl">
                    <div class="d-flex justify-content-start align-items-center unset-pdl">
                        <span class="warehouse-name-drs ">便選択</span>
                        <div class="dropdown-container  mr-3" id="dropdownContainer">
                            <button class="dropdown-button btn btn-primary btn-icon-split btn-register" id="dropdownButton">
                                <span class="icon text-white-50">
                                    <i class="fas fa-plus"></i>
                                </span>
                                <span class="text">追加　　　</span>
                            </button>
                            <div class="dropdown-content" id="dropdownContent">
                                <div id="createToggleCheckBox">選択された稼働日にデータがありません</div>
                            </div>
                        </div>
                        <a href="#" class="btn btn-danger btn-icon-split btn-register mr-3" onclick="clearTrips()" id="clearTrips" style="visibility: hidden">
                            <span class="icon text-white-50">
                                <i class="fas fa-trash"></i>
                            </span>
                            <span class="text">一括クリア</span>
                        </a>
                    </div>

                </div>
                <div class="col-16 d-flex justify-content-start align-items-center  unset-pdl mr-3 sp-cs-dpl">
                    <div class="d-flex justify-content-start align-items-center unset-pdl" id="selectedTrips0">
                        <span class="warehouse-name-drs"></span>
                    </div>
                </div>
                <div class="col-16 d-flex justify-content-start align-items-center unset-pdl mr-3 sp-cs-dpl">
                    <div class="d-flex justify-content-start align-items-center unset-pdl" id="selectedTrips1">
                        <span class="warehouse-name-drs"></span>
                    </div>
                </div>
                <div class="col-16 d-flex justify-content-start align-items-center unset-pdl mr-3 sp-cs-dpl">
                    <div class="d-flex justify-content-start align-items-center unset-pdl" id="selectedTrips2">
                        <span class="warehouse-name-drs"></span>
                    </div>
                </div>
                <div class="col-16 d-flex justify-content-start align-items-center unset-pdl mr-3 sp-cs-dpl">
                    <div class="d-flex justify-content-start align-items-center unset-pdl" id="selectedTrips3">
                        <span class="warehouse-name-drs"></span>
                    </div>
                </div>
            </div>
        </form>

        <div class="col-16 d-flex justify-content-start align-items-center mb-3 unset-pdl">
            <button type="submit" class="btn btn-secondary btn-icon-split" id="search-btn" onclick="onSearchClick('CountAlertRecord')">
                <span class="icon text-white-50">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </span>
                <span class="text">検索　　　</span>
            </button>
        </div>

        <hr />

        <div class="mg-bot-20 mb-3">
            <div class="col-12 d-flex xs-block justify-content-start align-items-center p-0">
                <div class="input-group-append mr-1">
                    <a class="btn btn-info btn-icon-split" onclick="onExportFileAlert('CountAlertRecord', '@Model.ViewTitle')" id="exportFile">
                        <span class="icon text-white-50">
                            <i class="fas fa-file-export"></i>
                        </span>
                        <span class="text">Excel出力</span>
                    </a>
                </div>
            </div>
        </div>


        <div class="mt-3" id="tripRecordTable">
        </div>
    </div>
</div>

<script type="text/javascript">
    // 画面ロード時
    $(document).ready(function () {
        model = @Html.Raw(Json.Serialize(Model));
        var today = new Date();
        var oneWeekAgo = new Date();
        oneWeekAgo.setDate(oneWeekAgo.getDate() - 7);
        $('#endOfPeriod').val(GetDayString(today));
        $('#startOfPeriod').val(GetDayString(oneWeekAgo));
        addDepos(model);
        depoCheckDisplay(model);
        periodChange();
    });

    // 「すべて」チェックボックス押下時
    $('input[id=allDepo]').change(function () {
        pushAllCheckBox();
        periodChange();
    });


    // 各デポチェックボックス押下時
    $(function () {
        $('input[name="depos"]').change(function () {
            pushDepoCheckBox();
        periodChange();
        });
    })

    // アラート履歴テーブルの表示
    function tableDisplay() {
        // チェックボックスの入力情報取得
        var checkedDepos = getCheckedDepos();


        // 期間の開始、終了日付の取得
        var startOfPeriod = GetDayString(new Date($('#startOfPeriod').val()));
        var endOfPeriod = GetDayString(new Date($('#endOfPeriod').val()));

        // フォーム情報取得
        let url = window.location.origin + '@Url.Action("SearchData", "CountAlertRecord")';
        let method = 'Post';
        let data = {selectedTrips: arrayTrips, startOfPeriod: startOfPeriod, endOfPeriod: endOfPeriod, checkedDepos: checkedDepos};

        // Ajax call
        $.ajax({
            url: url,
            method: method,
            data: data
        }).done(function (response) {
            console.log(response.searchedTripRecordHTML);
            $('#tripRecordTable').empty().html(response.searchedTripRecordHTML);
            tableLength = response.searchedTripRecordLength + 1;
            // 日本語表示
            const language_url = "https://cdn.datatables.net/plug-ins/1.11.5/i18n/ja.json";
            const dom_structure = "<'top d-flex align-items-center'li<'ml-auto'f>>rt<'bottom'p><'clear'>";

            // ID(2列目)昇順
            $("#tripTable").DataTable({
                "language": {
                    "url": language_url
                },
                lengthChange: true,     // 件数切替
                info: true,            // 総件数
                scrollX: true,          // 横スクロール可
                scrollCollapse: true,   // 縦スクロール表示
                order: [[0, "asc"]],    // ID降順
                searchHighlight: true,  // 検索ハイライト

                "oLanguage": {
                    "sSearch": "フリーワード(全件)"
                },
                dom: dom_structure
            });
        }).fail(function (jqXHR, textStatus, errorThrown) {
            if (jqXHR.status === 404) {
                var errorMessage = jqXHR.responseJSON.errorMessage;
                $("#edit-modal-error-message").text(errorMessage);
            } else {
                var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                $("#edit-modal-error-message").text(errorMessage);
            }
        });
    }

    // 検索ボタン押下時
    function onSearchClick() {
        DeleteErrorMessages();
        // 選択された便が0件の場合
        if(arrayTrips.length == 0){
            var errorMessage = 'E1017: 便を選択してください。';
            $("#div-error-message").text(errorMessage);
            return;
        }


        if (isWithin90Days()) {
            tableDisplay();
        }
        else {
            var errorMessage = 'E1007: 検索できる期間は最長90日です。90日を超えないように選択してください。';
            $("#div-error-message").text(errorMessage);
        }
    }

    // Excel出力
    async function onExportFileAlert(page, gamenName) {
        event.preventDefault();
        $('#div-error-message').text("");

        // チェックボックスの入力情報取得
        var checkedDepos = getCheckedDepos();

        // 期間の開始、終了日付の取得
        var startOfPeriod = GetDayString(new Date($('#startOfPeriod').val()));
        var endOfPeriod = GetDayString(new Date($('#endOfPeriod').val()));

        // フォーム情報取得
        let data = {
            "gamenName": gamenName,
            "startOfPeriod": startOfPeriod,
            "endOfPeriod": endOfPeriod,
            "selectedTrips": arrayTrips,
            checkedDepos: checkedDepos
        };

        // Excel出力共通処理
        onExportFileTripsCommon(page, data);

    }


     // ドロップダウンの表示・非表示
    dropdownButton.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropdownContainer.classList.toggle('show');
    });

    // コンテンツ外をクリックした場合、プルダウンを閉じる
    document.addEventListener('click', (e) => {
        if (!dropdownContainer.contains(e.target)) {
            dropdownContainer.classList.remove('show');
        }
    });

    // 期間の開始日付変更時
    $('#startOfPeriod').change(function () {
        periodChange();
    });

    // 期間の終了日時変更時
    $('#endOfPeriod').change(function () {
        periodChange();
    })

     function allToggleOpen() {
        event.preventDefault();
        // 中項目のヘッダーをクリックで小項目を表示/非表示
        let mediumHeaders = dropdownContent.querySelectorAll('.medium-header');
        mediumHeaders.forEach(header => {
            const smallItems = header.nextElementSibling;
            const toggleIcon = header.querySelector('.toggle-icon');
            if (!smallItems.classList.contains('show')) {
                smallItems.classList.add('show');
                toggleIcon.classList.remove('collapsed');
            }
        });
    }

    function allToggleClose() {
        event.preventDefault();
        // 中項目のヘッダーをクリックで小項目を表示/非表示
        let mediumHeaders = dropdownContent.querySelectorAll('.medium-header');
        mediumHeaders.forEach(header => {
            const smallItems = header.nextElementSibling;
            const toggleIcon = header.querySelector('.toggle-icon');
            if (smallItems.classList.contains('show')) {
                smallItems.classList.remove('show');
                toggleIcon.classList.add('collapsed');
            }
        });
    }

</script>
