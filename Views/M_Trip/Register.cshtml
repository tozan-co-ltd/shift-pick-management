@using ai_truck_load_measurement.Commons;
@model ai_truck_load_measurement.Models.M_TripModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.CategoryTitle + " - " + Model.ViewTitle + " - " + "登録";
}

<div class="card shadow masterInfo m-4">

    <div class="card-header">
        @ViewData["Title"]
    </div>

    <div class="card-body">
        <div class="form-group col-sm-12 pl-3">
            <p id="div-error-message" class="mt-1 text-danger"></p>

            @if (ViewData["ErrorMessage"] != null)
            {
                <span class="mt-1 text-danger">@ViewData["ErrorMessage"]</span>
            }
        </div>
        <div class="row">
            <div class="col-lg-7 mb-2">
                <div class="card border-left-custom">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li>適用開始日時は、適用開始日の前日の夜勤が終了する予定日時を入力してください。</li>
                            <li>同じ便名称の便マスターを登録する際は、適用開始/終了日時の範囲がかぶらないようにしてください。</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="mg-bot-20">
            <div class="col-16 sp-tablet mb-3">
                <form class="col-md-12" method="post" enctype="multipart/form-data" name="form" id="mTripForm">
                    <div class="col-12 input-group div-input-group">
                        <div class="col-12 col-sm-4 col-md-2 column-1st">
                            <label>@Html.DisplayName("TripName")<span style="color:red">*</span></label>
                        </div>
                        <div class="col-12 col-sm-8 col-md-5 column-2nd">
                            <input class="form-control" type="text" asp-for="TripName" autocomplete="off"  required>
                            <span class="text-danger w-100" asp-validation-for="TripName"></span>
                        </div>
                    </div>
                    <div class="col-12 input-group div-input-group">
                        <div class="col-12 col-sm-4 col-md-2 column-1st">
                            <label>@Html.DisplayName("DriverName")<span style="color:red">*</span></label>
                        </div>
                        <div class="col-12 col-sm-8 col-md-5 column-2nd">
                            <input class="form-control" type="text" asp-for="DriverName" autocomplete="off"  required>
                            <span class="text-danger w-100" asp-validation-for="DriverName"></span>
                        </div>
                    </div>
                    <div class="col-12 input-group div-input-group  selectbox">
                        <div class="col-12 col-sm-4 col-md-2 column-1st">
                            <label>@Html.DisplayNameFor(model => model.TruckNumber)<span style="color:red">*</span></label>
                        </div>
                        <div class="col-12 col-sm-8 col-md-5 column-2nd">
                            <select class="form-control" name="TruckID" asp-for="TruckID" asp-items="@Model.TruckSelectList" required></select>
                            <span class="text-danger w-100" asp-validation-for="TruckID"></span>
                        </div>
                    </div>
                    <div class="col-12 input-group div-input-group">
                        <div class="col-12 col-sm-4 col-md-2 column-1st">
                            <label>@Html.DisplayName("IdentifyNumber")<span style="color:red">*</span></label>
                        </div>
                        <div class="col-12 col-sm-8 col-md-5 column-2nd">
                            <input class="form-control" type="text" asp-for="IdentifyNumber" autocomplete="off"  id="identifyNumber" readonly>
                            <span class="text-danger w-100" asp-validation-for="IdentifyNumber"></span>
                        </div>
                    </div>
                    <div class="col-12 input-group div-input-group">
                        <div class="col-12 col-sm-4 col-md-2 column-1st">
                            <label>@Html.DisplayName("DayShiftStartTime")<span style="color:red">*</span></label>
                        </div>
                        <div class="col-12 col-sm-8 col-md-5 column-2nd">
                            <input class="form-control" type="text" asp-for="DayShiftStartTime" autocomplete="off" id="DayShiftStartTime" required>
                            <small class="form-text text-muted w-100 p-1">hh:mmで入力してください</small>
                            <span class="text-danger w-100" asp-validation-for="DayShiftStartTime"></span>
                        </div>
                    </div>
                    <div class="col-12 input-group div-input-group">
                        <div class="col-12 col-sm-4 col-md-2 column-1st">
                            <label>@Html.DisplayName("ApplicableStartDateTime")<span style="color:red">*</span></label>
                        </div>
                        <div class="col-12 col-sm-8 col-md-5 column-2nd">
                            <input class="form-control" type="datetime-local" asp-for="ApplicableStartDateTime" autocomplete="off" id="ApplicableStartDateTime" required>
                            <small class="form-text text-muted w-100 p-1">YYYY/MM/DD hh:mmで入力してください</small>
                            <span class="text-danger w-100" asp-validation-for="ApplicableStartDateTime"></span>
                        </div>
                    </div>
                    <div class="col-12 input-group div-input-group">
                        <div class="col-12 col-sm-4 col-md-2 column-1st">
                            <label>@Html.DisplayName("ApplicableEndDateTime")<span style="color:red">*</span></label>
                        </div>
                        <div class="col-12 col-sm-8 col-md-5 column-2nd">
                            <input class="form-control" type="datetime-local" asp-for="ApplicableEndDateTime" autocomplete="off" id="ApplicableEndDateTime" required>
                            <small class="form-text text-muted w-100 p-1">YYYY/MM/DD hh:mmで入力してください</small>
                            <span class="text-danger w-100" asp-validation-for="ApplicableEndDateTime"></span>
                        </div>
                    </div>
                    <div class="col-12 d-flex xs-block justify-content-start align-items-center p-0">
                        <div class="input-group-append mr-4">
                            <a class="btn btn-secondary btn-icon-split" asp-controller="M_Trip" asp-action="Index">
                                <span class="icon text-white-50">
                                    <i class="fas fa-arrow-left-long"></i>
                                </span>
                                <span class="text">戻る</span>
                            </a>
                        </div>
                        <div class="input-group-append">
                            <button class="btn btn-primary btn-icon-split" style="min-width: 80px" onclick="OnRegister()">
                                <span class="text">登録</span>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    // ロード時の処理
    $(document).ready(function(){
        // M_TripModel取得
        var tripModel = @Html.Raw(Json.Serialize(Model));
        getIdentifyNumber(tripModel.truckID);
        console.log(tripModel);
        if (tripModel.truckID == 0) {
            $('#DayShiftStartTime').val("");
            $('#ApplicableStartDateTime').val("");
            $('#ApplicableEndDateTime').val("");
        }
        else {
            var startTime = new Date(tripModel.dayShiftStartTime);
            var startTimeHHmm = GetTimeString(startTime);
            $('#DayShiftStartTime').val(startTimeHHmm);
        }
    })

    // 時刻の表示形式変換(HH:mm)
    function GetTimeString(date) {
        var hour = date.getHours();
        if (hour < 10) {
            hour = "0" + hour;
        }
        var minute = date.getMinutes();
        if (minute < 10) {
            minute = "0" + minute;
        }
        return hour + ":" + minute;
    }

    // 識別番号取得、反映処理
    function getIdentifyNumber(truckID) {

        if (truckID == 0) {
            truckID = 1;
        }

        // フォーム情報取得
        let url = window.location.origin + '@Url.Action("GetIdentifyNumberFromTruckID", "M_Trip")';
        let method = 'POST';
        let data = { truckID: truckID };

        // Ajax call
        $.ajax({
            url: url,
            method: method,
            data: data
        }).done(function (response) {
            $('#identifyNumber').val(response);
            console.log(response);
        }).fail(function (jqXHR, textStatus, errorThrown) {
            if (jqXHR.status === 404) {
                var errorMessage = jqXHR.responseJSON.errorMessage;
                $("#edit-modal-error-message").text(errorMessage);
            } else {
                var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                $("#edit-modal-error-message").text(errorMessage);
            }
        });
    }

    // 登録ボタン押下
    function OnRegister() {

        var form = $("#mTripForm");



        form.submit(function (event) {

            $("#div-error-message").text("");

            // ページの更新を禁止する
            event.preventDefault();

            // 送信イベントが他のハンドラーに伝播するのを防ぐ
            event.stopImmediatePropagation();

            // フォーム情報取得
            let url = window.location.origin + '@Url.Action("Register", "M_Trip")';
            let method = 'POST';
            let formId = 'mTripForm';
            let data = form.serializeArray();

            // Ajax call
            $.ajax({
                url: url,
                method: method,
                data: data
            }).done(function (response) {
                $('#' + formId)[0].reset();
                // 完了モーダル表示
                AlertMessage('', '完了', '登録が完了しました。', null, null);
            }).fail(function (jqXHR, textStatus, errorThrown) {
                console.log(jqXHR);
                if (jqXHR.status === 404) {
                    // データが見つからなかった場合
                    var errorMessage = jqXHR.responseJSON.errorMessage;
                    $("#div-error-message").text(errorMessage);
                } else {
                    // その他のエラーの場合
                    var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                    $("#div-error-message").text(errorMessage);
                }
            });
        });
    }

    // 車両番号選択時の処理
    $('[name=TruckID]').change(function () {
        var truckID = $('[name=TruckID]').val();
        console.log(truckID);
        getIdentifyNumber(truckID);
    });
</script>