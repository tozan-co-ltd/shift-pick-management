@using shift_pick_management.Commons;
@model shift_pick_management.Models.M_TripViewModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.CategoryTitle + " - " + Model.ViewTitle;
}
<div class="card shadow de-inspection masterInfo m-4">
    <div class="card-header">
        @ViewData["Title"]
    </div>

    <div class="card-body">

        <div class="row">
            <div class="col-lg-10">
                <div class="card border-left-custom">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li>新しい適用期間の作成時は <i class="fa-regular fa-copy"></i> をクリックしてください。</li>
                            <li>適用期間内の便が初期表示されます。</li>
                            <li>基準日時時点の便マスターに便枝番マスターが紐づいたデータが出力されます。</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group col-sm-12 pl-3">
            <p id="div-error-message" class="mt-1 text-danger"></p>

            @if (ViewData["ErrorMessage"] != null)
            {
                <span class="mt-1 text-danger">@ViewData["ErrorMessage"]</span>
            }
        </div>

        <div class="col-16 d-flex justify-content-start align-items-center unset-pdl sp-cs-dpl">
            <div class="d-flex justify-content-start align-items-center mb-3 unset-pdl">
                <span class="warehouse-name-drs span-paragraph">デポ</span>
                <div>
                    <label class="mr-2"><input type="checkbox" class=" mr-2" id="allDepo" />すべて  [</label>
                    <label id="selectDepos"></label>]
                </div>
            </div>
        </div>

        <div class="col-16 d-flex justify-content-start align-items-center unset-pdl sp-cs-dpl">
            <div class="d-flex justify-content-start align-items-center mb-3 unset-pdl">
                <span class="warehouse-name-drs span-paragraph">オプション</span>
                <div>
                    <label><input type="checkbox" id="isBeforeApplicablePeriod" /> 適用終了日時を過ぎた便も表示</label>
                </div>
            </div>
        </div>

        <div class="mg-bot-20">
            <div class="col-12 d-flex xs-block justify-content-start align-items-center p-0">
                <div class="input-group-append mr-3">
                    <a href="#" class="btn btn-primary btn-icon-split btn-register" onclick="onRegisterClick('M_Trip', 0)">
                        <span class="icon text-white-50">
                            <i class="fas fa-plus"></i>
                        </span>
                        <span class="text">新規作成</span>
                    </a>
                </div>
                <div class="d-flex xs-block justify-content-start align-items-center excel-date">
                    <div class="mr-3">
                        <label>基準日時 <input type="datetime-local" id="referenceDate" /></label>
                    </div>
                    <div class="input-group-append mr-0">
                        <a href="#" class="btn btn-info btn-icon-split" onclick="onExportFileTrips('M_Trip', '@Model.ViewTitle')">
                            <span class="icon text-white-50">
                                <i class="fas fa-file-export"></i>
                            </span>
                            <span class="text">Excel出力</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div id="m_tripTable">
        </div>
    </div>
</div>


<!--  Edit Modal-->
<div class="modal fade" id="edit-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="edit-modal-label">編集</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="col-12 col-md-12">
                    <p id="edit-modal-error-message" class="mt-1 text-danger"></p>
                </div>
                <div class="d-flex justify-content-center">
                    <form class="col-md-12" id="mTripForm">
                        <input type="hidden" asp-for="TripHistoryID" value="@Model.TripHistoryID" />
                        <input type="hidden" asp-for="TripID" value="@Model.TripID" />
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl">
                                <label>@Html.DisplayName("TripName")<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <input class="form-control" type="text" asp-for="TripName" autocomplete="off" value="" required>
                                <span class="text-danger w-100" asp-validation-for="TripName"></span>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl">
                                <label>@Html.DisplayName("DriverName")<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <input class="form-control" type="text" asp-for="DriverName" autocomplete="off" value="" required>
                                <span class="text-danger w-100" asp-validation-for="DriverName"></span>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl">
                                <label>@Html.DisplayNameFor(model => model.TruckNumber)<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <select class="form-select" name="TruckID" asp-for="TruckID" asp-items="@Model.MTruckList" required id="TruckID"></select>
                                <span class="text-danger w-100" asp-validation-for="DriverName"></span>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl">
                                <label>@Html.DisplayName("IdentifyNumber")<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <input class="form-control" type="text" asp-for="IdentifyNumber" autocomplete="off" value="" id="identifyNumber" required readonly>
                                <span class="text-danger w-100" asp-validation-for="IdentifyNumber"></span>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl modalLabel">
                                <label><a>@Html.DisplayName("RegistDayShiftStartTime")<span style="color:red">*</span></a></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <input class="form-control" type="text" asp-for="RegistDayShiftStartTime" autocomplete="off" value="" required>
                                <small class="form-text text-muted w-100 p-1">hh:mmで入力してください。</small>
                                <span class="text-danger w-100" asp-validation-for="RegistDayShiftStartTime"></span>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl">
                                <label>@Html.DisplayNameFor(model => model.DepoName)<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <select class="form-select" name="DepoID" asp-for="DepoID" asp-items="@Model.MDepoList" required id="DepoID"></select>
                                <span class="text-danger w-100" asp-validation-for="DepoName"></span>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl modalLabel">
                                <label><a>@Html.DisplayName("ApplicableStartDateTime")<span style="color:red">*</span></a></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <input class="form-control" type="text" asp-for="ApplicableStartDateTime" autocomplete="off" value="" required>
                                <small class="form-text text-muted w-100 p-1">YYYY/MM/DD hh:mmで入力してください。</small>
                                <span class="text-danger w-100" asp-validation-for="ApplicableStartDateTime"></span>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl modalLabel">
                                <label><a>@Html.DisplayName("ApplicableEndDateTime")<span style="color:red">*</span></a></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <input class="form-control" type="text" asp-for="ApplicableEndDateTime" autocomplete="off" value="" required>
                                <small class="form-text text-muted w-100 p-1">YYYY/MM/DD hh:mmで入力してください。</small>
                                <span class="text-danger w-100" asp-validation-for="ApplicableEndDateTime"></span>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap justify-content-center p-2 p-md-3">
                            <button class="btn btn-secondary btn-icon-split mb-2 mr-0 mr-sm-5" data-dismiss="modal" aria-label="Close">
                                <span class="text">キャンセル</span>
                            </button>
                            <button class="btn btn-success btn-icon-split mb-2" onclick="OnExecuteEdit()">
                                <span class="text" style="min-width:84px">更新</span>
                            </button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    // 画面ロード時
    $(document).ready(function () {
        // 今日の日付を取得
        var today = new Date();
        today.setDate(today.getDate());
        var yyyy = today.getFullYear();
        var MM = ("0" + (today.getMonth() + 1)).slice(-2);
        var dd = ("0" + today.getDate()).slice(-2);
        var hh = ("0" + today.getHours()).slice(-2);
        var mm = ("0" + today.getMinutes()).slice(-2);;

        $('#referenceDate').val(yyyy+'-'+MM+'-'+dd+"T"+hh+":"+mm);

        // 適用終了日時を過ぎた便を表示するチェックボックスの値を取得
        var trip_model = @Html.Raw(Json.Serialize(Model));
        $('input[id="isBeforeApplicablePeriod"]').prop('checked', trip_model.isCheckedBeforeApplicablePeriod);
        // デポチェックボックス追加
        addDepos(trip_model);
        depoCheckDisplay(trip_model);
        // テーブル表示
        tableDisplay();
    });
    
    // 新規登録、新しい適用期間の作成ボタン押下時
    function onRegisterClick(page, tripHistoryID) {
        event.preventDefault();
        // チェックボックスの入力情報取得
        var checkBox = $('input[id="isBeforeApplicablePeriod"]')[0].checked;

        location.href = "" + page + "/Register?isChecked=" + checkBox + "&id=" + tripHistoryID;
    }

    // csv出力
    async function onExportFileTrips(page, gamenName) {
        event.preventDefault();
        $('#div-error-message').text("");

        // チェックボックスの入力情報取得
        var isBeforeApplicablePeriod = $('input[id="isBeforeApplicablePeriod"]')[0].checked;
        var checkedDepos = getCheckedDepos();

        // 基準日時取得
        var referenceDate = $('#referenceDate').val();

        // フォーム情報取得
        let data = {
            "gamenName": gamenName,
            "isBeforeApplicablePeriod": isBeforeApplicablePeriod,
            "referenceDate": referenceDate,
            checkedDepos: checkedDepos
        };

        // Excel出力共通処理
        onExportFileTripsCommon(page, data);

    }

    // 編集ボタン押下
    function OnEditClick(tripHistoryID) {
        DeleteErrorMessages();

        // M_TripModel取得
        var tripModel = @Html.Raw(Json.Serialize(Model));
        tripModel.m_TripList.forEach(function (item) {
            var dayShiftStartTime = GetTimeString(new Date(item.dayShiftStartTime));
            var applicableStartDateTime = GetDateString(new Date(item.applicableStartDateTime));
            var applicableEndDateTime = GetDateString(new Date(item.applicableEndDateTime));
            if (item.tripHistoryID == tripHistoryID) {
                $("#TripHistoryID").val(item.tripHistoryID);
                $("#TripID").val(item.tripID);
                $("#TripName").val(item.tripName);
                $("#DriverName").val(item.driverName);
                $("#TruckID").val(item.truckID);
                getIdentifyNumber(item.truckID);
                $("#DepoID").val(item.depoID);
                $("#RegistDayShiftStartTime").val(dayShiftStartTime);
                $("#ApplicableStartDateTime").val(applicableStartDateTime);
                $("#ApplicableEndDateTime").val(applicableEndDateTime);
            }
        });
    }

    // 識別番号取得、反映処理
    function getIdentifyNumber(truckID) {

        // フォーム情報取得
        let url = window.location.origin + '@Url.Action("GetIdentifyNumberFromTruckID", "M_Trip")';
        let method = 'POST';
        let data = { truckID: truckID };

        // Ajax call
        $.ajax({
            url: url,
            method: method,
            data: data
        }).done(function (response) {
            $('#identifyNumber').val(response);
        }).fail(function (jqXHR, textStatus, errorThrown) {
            if (jqXHR.status === 404) {
                var errorMessage = jqXHR.responseJSON.errorMessage;
                $("#edit-modal-error-message").text(errorMessage);
            } else {
                var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                $("#edit-modal-error-message").text(errorMessage);
            }
        });
    }

    // 更新
    function OnExecuteEdit() {
        $('#mTripForm').submit(function (event) {
            DeleteErrorMessages();

            // ページの更新を禁止する
            event.preventDefault();

            // 送信イベントが他のハンドラーに伝播するのを防ぐ
            event.stopImmediatePropagation();

            // フォーム情報取得
            let url = window.location.origin + '@Url.Action("Edit", "M_Trip")';
            let method = 'POST';
            let formId = 'mTripForm';
            let data = $('#' + formId).serializeArray();

            // Ajax call
            $.ajax({
                url: url,
                method: method,
                data: data
            }).done(function (response) {
                $('#edit-modal').hide();
                // 完了モーダル表示
                AlertMessage('', '完了', '登録が完了しました。', null, null);
            }).fail(function (jqXHR, textStatus, errorThrown) {
                if (jqXHR.status === 404) {
                    var errorMessage = jqXHR.responseJSON.errorMessage;
                    $("#edit-modal-error-message").text(errorMessage);
                } else {
                    var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                    $("#edit-modal-error-message").text(errorMessage);
                }
            });
        });
    }

    // チェックボックス押下時
    $('input[id="isBeforeApplicablePeriod"]').change(function () {
        tableDisplay();
    });

    // 便テーブルの表示
    function tableDisplay() {
        // チェックボックスの入力情報取得
        var isBeforeApplicablePeriod = $('input[id="isBeforeApplicablePeriod"]')[0].checked;
        var checkedDepos = getCheckedDepos();

        // フォーム情報取得
        let url = window.location.origin + '@Url.Action("SearchData", "M_Trip")';
        let method = 'Post';
        let data = { isBeforeApplicablePeriod: isBeforeApplicablePeriod, checkedDepos: checkedDepos };

        // Ajax call
        $.ajax({
            url: url,
            method: method,
            data: data
        }).done(function (response) {
            
            $('#m_tripTable').empty().html(response);
            // 日本語表示
            const language_url = "https://cdn.datatables.net/plug-ins/1.11.5/i18n/ja.json";
            const dom_structure = "<'top d-flex align-items-center'li<'ml-auto'f>>rt<'bottom'p><'clear'>";

            // ID(2列目)昇順
            $("#tripTable").DataTable({
                "language": {
                    "url": language_url
                },
                lengthChange: true,     // 件数切替
                info: true,            // 総件数
                scrollX: true,          // 横スクロール可
                scrollCollapse: true,   // 縦スクロール表示
                order: [[1, "asc"]],    // ID昇順
                searchHighlight: true,  // 検索ハイライト
                columnDefs: [
                    { targets: 0, sortable: false },    // インデックス0列(アイコン列)のソート禁止
                    { targets: 2, className: "dt-body-left"},
                ],
                "oLanguage": {
                    "sSearch": "フリーワード(全件)"
                },
                dom: dom_structure
            });
        }).fail(function (jqXHR, textStatus, errorThrown) {
            if (jqXHR.status === 404) {
                var errorMessage = jqXHR.responseJSON.errorMessage;
                $("#edit-modal-error-message").text(errorMessage);
            } else {
                var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                $("#edit-modal-error-message").text(errorMessage);
            }
        });

    }

    // 車両番号選択時の処理
    $('[name=TruckID]').change(function () {
        var truckID = $('[name=TruckID]').val();

        getIdentifyNumber(truckID);
    });


    // 「すべて」チェックボックス押下時
    $('input[id=allDepo]').change(function () {
        pushAllCheckBox();
        tableDisplay();
    });

    // 各デポチェックボックス押下時
    $(function () {
        $('input[name="depos"]').change(function () {
            pushDepoCheckBox();
            tableDisplay();
        });
    })


</script>