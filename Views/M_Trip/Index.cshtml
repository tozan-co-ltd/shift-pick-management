@using ai_truck_load_measurement.Commons;
@model ai_truck_load_measurement.Models.M_TripModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.CategoryTitle + " - " + Model.ViewTitle;
}
<div class="card shadow de-inspection masterInfo m-4">
    <div class="card-header">
        @ViewData["Title"]
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-lg-10">
                <div class="card border-left-custom">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li>新しい適用期間の作成時は <i class="fa-regular fa-copy"></i> をクリックしてください。</li>
                            <li>適用期間内の便が初期表示されます。</li>
                            <li>基準日時時点の便マスターに便枝番マスターが紐づいたデータが出力されます。</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group col-sm-12 pl-3">
            <p id="div-error-message" class="mt-1 text-danger"></p>

            @if (ViewData["ErrorMessage"] != null)
            {
                <span class="mt-1 text-danger">@ViewData["ErrorMessage"]</span>
            }
        </div>

        <div class="mb-3">
            <label><input type="checkbox" id="m_tripCheckBox"/> 適用終了日時を過ぎた便も表示する</label>
        </div>

        <div class="mg-bot-20">
            <div class="col-12 d-flex xs-block justify-content-start align-items-center p-0">
                <div class="input-group-append mr-2">
                    <a class="btn btn-primary btn-icon-split btn-register" asp-controller="M_Trip" asp-action="Register">
                        <span class="icon text-white-50">
                            <i class="fas fa-plus"></i>
                        </span>
                        <span class="text">新規作成</span>
                    </a>
                </div>
                <div class="input-group-append">
                    <a href="#" class="btn btn-info btn-icon-split" onclick="onExportFile('M_Trip', '@Model.ViewTitle')">
                        <span class="icon text-white-50">
                            <i class="fas fa-file-export"></i>
                        </span>
                        <span class="text">Excel出力</span>
                    </a>
                </div>
            </div>
        </div>
        <div class="mt-3">
            <table class="table table-sm stripe hover nowrap datatable-normal table-center">
                <thead>
                    <tr align="center">
                        <th width="40"></th>
                        <th class="font-weight-bold">便ID</th>
                        <th class="font-weight-bold">便名称</th>
                        <th class="font-weight-bold">乗務員</th>
                        <th class="font-weight-bold">車両番号</th>
                        <th class="font-weight-bold">識別番号</th>
                        <th class="font-weight-bold">昼勤開始時間</th>
                        <th class="font-weight-bold">適用開始日時</th>
                        <th class="font-weight-bold">適用終了日時</th>
                        <th class="font-weight-bold">更新日時</th>
                        <th class="font-weight-bold">更新者</th>
                    </tr>
                </thead>
                <tbody id="m_tripTableBody">
                    @if (@Model.M_TripList != null)
                    {
                        @foreach (var item in @Model.M_TripList)
                        {
                            <tr>
                                <td>
                                    <a class="btn btn-success btn-icon-split ml-1 mr-1"
                                       onclick="OnEditClick('@item.TripHistoryID')" data-id="@item.TripHistoryID" data-toggle="modal" data-target="#edit-modal">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                </td>
                                <td>@item.TripID</td>
                                <td>@item.TripName</td>
                                <td>@item.DriverName</td>
                                <td>@item.TruckNumber</td>
                                <td>@item.IdentifyNumber</td>
                                <td>@item.DayShiftStartTime.ToString("HH:mm")</td>
                                <td>@item.ApplicableStartDateTime.ToString("yyyy/MM/dd HH:mm")</td>
                                <td>@item.ApplicableEndDateTime.ToString("yyyy/MM/dd HH:mm")</td>
                                <td>@item.UpdatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                <td>@item.UpdatedBy</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


<!--  Edit Modal-->
<div class="modal fade" id="edit-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="edit-modal-label">編集</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="col-12 col-md-12">
                    <p id="edit-modal-error-message" class="mt-1 text-danger"></p>
                </div>
                <div class="d-flex justify-content-center">
                    <form class="col-md-12" id="mTripForm">
                        <input type="hidden" asp-for="TripHistoryID" value="@Model.TripHistoryID" />
                        <input type="hidden" asp-for="TripID" value="@Model.TripID" />
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl">
                                <label>@Html.DisplayName("TripName")</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <input class="form-control" type="text" asp-for="TripName" autocomplete="off" value="" required>
                                <span class="text-danger w-100" asp-validation-for="TripName"></span>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl">
                                <label>@Html.DisplayName("DriverName")<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <input class="form-control" type="text" asp-for="DriverName" autocomplete="off" value="" required>
                                <span class="text-danger w-100" asp-validation-for="DriverName"></span>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl">
                                <label>@Html.DisplayNameFor(model => model.TruckNumber)<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <select class="form-control" name="SelectedTruckID" asp-for="SelectedTruckID" asp-items="@Model.MTruckList" required id="selectedTruckID"></select>
                                <span class="text-danger w-100" asp-validation-for="DriverName"></span>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl">
                                <label>@Html.DisplayName("DayShiftStartTime")<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <input class="form-control" type="text" asp-for="DayShiftStartTime" autocomplete="off" value="" required>
                                <small class="form-text text-muted w-100 p-1">hh:mmで入力してください。</small>
                                <span class="text-danger w-100" asp-validation-for="DayShiftStartTime"></span>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl">
                                <label>@Html.DisplayName("ApplicableStartDateTime")<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <input class="form-control" type="text" asp-for="ApplicableStartDateTime" autocomplete="off" value="" required>
                                <small class="form-text text-muted w-100 p-1">YYYY/MM/DD hh:mmで入力してください。</small>
                                <span class="text-danger w-100" asp-validation-for="ApplicableStartDateTime"></span>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl">
                                <label>@Html.DisplayName("ApplicableEndDateTime")<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-9 column-2nd">
                                <input class="form-control" type="text" asp-for="ApplicableEndDateTime" autocomplete="off" value="" required>
                                <small class="form-text text-muted w-100 p-1">YYYY/MM/DD hh:mmで入力してください。</small>
                                <span class="text-danger w-100" asp-validation-for="ApplicableEndDateTime"></span>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap justify-content-center p-2 p-md-3">
                            <button class="btn btn-secondary btn-icon-split mb-2 mr-0 mr-sm-5" data-dismiss="modal" aria-label="Close">
                                <span class="text">キャンセル</span>
                            </button>
                            <button class="btn btn-success btn-icon-split mb-2" onclick="OnExecuteEdit()">
                                <span class="text" style="min-width:84px">更新</span>
                            </button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    // 編集ボタン押下
    function OnEditClick(tripHistoryID) {
        DeleteErrorMessages();

        // M_TripModel取得
        var tripModel = @Html.Raw(Json.Serialize(Model));
        console.log(tripModel)
        tripModel.m_TripList.forEach(function (item) {
            var dayShiftStartTime = GetTimeString(new Date(item.dayShiftStartTime));
            var applicableStartDateTime = GetDateString(new Date(item.applicableStartDateTime));
            var applicableEndDateTime = GetDateString(new Date(item.applicableEndDateTime));
            if (item.tripHistoryID == tripHistoryID) {
                $("#TripHistoryID").val(item.tripHistoryID);
                $("#TripID").val(item.tripID);
                $("#TripName").val(item.tripName);
                $("#DriverName").val(item.driverName);
                $("#SelectedTruckID").val(item.mTruckList);
                $("#DayShiftStartTime").val(dayShiftStartTime);
                $("#ApplicableStartDateTime").val(applicableStartDateTime);
                $("#ApplicableEndDateTime").val(applicableEndDateTime);
            }
        });
    }

    // 時刻の表示形式変換(HH:mm)
    function GetTimeString(date){
        var hour = date.getHours();
        if (hour < 10) {
            hour = "0" + hour;
        }
        var minute = date.getMinutes();
        if (minute < 10) {
            minute = "0" + minute;
        }
        return hour + ":" + minute;
    }

    // 日付の表示形式変換(yyyy/MM/dd hh:mm)
    function GetDateString(date) {
        var day = date.toLocaleDateString("ja-JP", {
            year: "numeric", month: "2-digit",
            day: "2-digit"
        });
        var time = GetTimeString(date);
        return day + " " + time;
    }

    // 更新
    function OnExecuteEdit() {
        $('#mTripForm').submit(function (event) {
            DeleteErrorMessages();

            // ページの更新を禁止する
            event.preventDefault();

            // 送信イベントが他のハンドラーに伝播するのを防ぐ
            event.stopImmediatePropagation();

            // フォーム情報取得
            let url = window.location.origin + '@Url.Action("Edit", "M_Trip")';
            let method = 'POST';
            let formId = 'mTripForm';
            let data = $('#' + formId).serializeArray();

            // Ajax call
            $.ajax({
                url: url,
                method: method,
                data: data
            }).done(function (response) {
                $('#edit-modal').hide();
                // 完了モーダル表示
                AlertMessage('', '完了', '登録が完了しました。', null, null);
            }).fail(function (jqXHR, textStatus, errorThrown) {
                if (jqXHR.status === 404) {
                    var errorMessage = jqXHR.responseJSON.errorMessage;
                    $("#edit-modal-error-message").text(errorMessage);
                } else {
                    var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                    $("#edit-modal-error-message").text(errorMessage);
                }
            });
        });
    }

    // チェックボックス押下時
    $('input').change(function () {

        // チェックボックスの入力情報取得
        var checkBox = false;
        $('input:checked').each(function () {
            checkBox = $(this).prop('checked');
        })


        // フォーム情報取得
        let url = window.location.origin + '@Url.Action("SearchData", "M_Trip")';
        let method = 'Post';
        let data = { beforePeriod: checkBox };

        // Ajax call
        $.ajax({
            url: url,
            method: method,
            data: data
        }).done(function (response) {
            console.log(response);
            $('#m_tripTableBody').empty().html(response);
        }).fail(function (jqXHR, textStatus, errorThrown) {
            if (jqXHR.status === 404) {
                var errorMessage = jqXHR.responseJSON.errorMessage;
                $("#edit-modal-error-message").text(errorMessage);
            } else {
                var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                $("#edit-modal-error-message").text(errorMessage);
            }
        });
    })


    // エラーメッセージ削除
    function DeleteErrorMessages() {
        $('#div-error-message').text('');
        $('#edit-modal-error-message').text('');
        $('#delete-modal-error-message').text('');
        $('.text-danger').text('');
        $('input').removeClass('input-validation-error');
    }
</script>