                    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.3/Chart.bundle.min.js" integrity="sha512-vBmx0N/uQOXznm/Nbkp7h0P1RfLSj0HQrFSzV8m7rOGyj30fYAOKHYvCNez+yM8IrfnW0TCodDEjRqf6fodf/Q==" crossorigin="anonymous"></script>
                    <script src='https://cdnjs.cloudflare.com/ajax/libs/chartjs-plugin-annotation/0.5.7/chartjs-plugin-annotation.min.js'></script>
                    <script src="https://cdn.jsdelivr.net/npm/hammerjs@2.0.8"></script>
                    <script src="https://cdnjs.cloudflare.com/ajax/libs/chartjs-plugin-zoom/0.7.7/chartjs-plugin-zoom.min.js" integrity="sha512-8E9fPF4pjWxI0dpprpn4WYeciAMo2kh6xN0COFxvTfurMttjZzih/sBp+Fxu49Zr6IUSp4sqWY6KLecnqOCwxA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
                   
                    <script>
                        var ctx = document.getElementById("binedabanChartArrival");
                        function adjustCanvasHeight() {
                            var canvas = document.getElementById("binedabanChartArrival");
                            var width = window.innerWidth;
                        }

                        window.addEventListener('resize', adjustCanvasHeight);

                        adjustCanvasHeight();

                        var arrivalChart = new Chart(ctx, chartSetting('到着'));

                        // chart.jsの設定
                        function chartSetting(axisLabel) {
                            if (axisLabel == null)
                               axisLabel = "";
                            var setting = {
                                type: 'scatter',
                                data: {
                                    labels: [],
                                    datasets: []
                                },
                                options: {
                                    //凡例は表示
                                    legend: {
                                        display: true,
                                        onClick: function (t, legendItem) {
                                            var index = legendItem.datasetIndex;
                                            legendHideOrShow(arrivalChart, index);
                                            legendHideOrShow(departureChart, index);
                                            legendHideOrShow(allChart, index);
                                            legendHideOrShow(clearChart, index);
                                        }
                                    },
                                    scales: {
                                        //X軸
                                        xAxes: [{
                                            id: 'x軸',
                                            //軸ラベル表示
                                            scaleLabel: {
                                                display: true,
                                                labelString: axisLabel + '時間',
                                                fontSize: 24
                                            },
                                            ticks: {
                                                fontSize: 20,
                                                min: new Date('1900/01/01 00:00:00').getTime(),
                                                max: new Date('1900/01/01 23:59:00').getTime()
                                            },
                                            type: 'time',
                                            time: {
                                                parser: 'HH:mm',
                                                unit: 'hour',
                                                stepSize: 1,
                                                displayFormats: {
                                                    'hour': 'HH:mm'
                                                }
                                            },
                                        }],
                                        //Y軸
                                        yAxes: [{
                                            id: 'y軸',
                                            //軸ラベル表示
                                            scaleLabel: {
                                                display: true,
                                                labelString: axisLabel + '荷量(%)',
                                                fontSize: 24
                                            },
                                            //Y軸の範囲を指定
                                            ticks: {
                                                min: 0.0,
                                                max: 100.0,
                                                fontSize: 20
                                            }
                                        }]
                                    },
                                    annotation: {
                                        annotations: []
                                    },
                                    title: {
                                        display: true,
                                        text: '',
                                        fontSize: 30
                                    },
                                    onClick: function (e, item) {
                                        chartClick(e, item);
                                    },
                                    plugins: {
                                        // ズーム設定
                                        zoom: {
                                            pan: {
                                                enabled: true,
                                                mode: "x",
                                                rangeMax: {
                                                    x: new Date('1900/01/01 23:59:00').getTime(),
                                                    y: 100.0
                                                },
                                                rangeMin: {
                                                    x: new Date('1900/01/01 00:00:00').getTime(),
                                                    y: 0.0
                                                }
                                            },
                                            zoom: {
                                                enabled: true,
                                                mode: 'x',
                                                rangeMax: {
                                                    x: new Date('1900/01/01 23:59:00').getTime(),
                                                    y: 100.0
                                                },
                                                rangeMin: {
                                                    x: new Date('1900/01/01 00:00:00').getTime(),
                                                    y: 0.0
                                                },
                                                speed: 0.5
                                            }
                                        }
                                    },
                                    tooltips: {
                                        // ツールチップのテキスト設定
                                        callbacks: {
                                            label: function (tooltipItem, data) {
                                                return [data.datasets[tooltipItem.datasetIndex].label + " " + GetTimeString(new Date(tooltipItem.xLabel)) + ' : ' + Math.round(tooltipItem.yLabel) + '%']
                                            }
                                        }
                                    }
                                }
                            }
                            return setting;
                        }

                        // チャート押下時のイベント
                        function chartClick(e, item){
                            var tooltip = document.getElementById("tooltip");
                            // 分布の点をクリックした場合
                            if (item[0] != null) {
                                // クリックした点のデータ取得
                                var index = item[0]._datasetIndex;
                                var dataLabelRGB = arrivalChart.data.datasets[index].backgroundColor;
                                var dataLabel = rgbaToHex(dataLabelRGB);
                                // カラーピッカー作成
                                var colorPickerHTML = '<input type=\"color\" value=\"' + dataLabel + '\" id=\"color-picker\" list=\"chart-pick\"/>';
                                colorPickerHTML += '<datalist id=\"chart-pick\">'
                                graphColors.forEach(function (color) {
                                    var colorHex = rgbaToHex(color);
                                    colorPickerHTML += '<option value=\"' + colorHex + '\"/>';
                                });
                                colorPickerHTML += '</datalist>'
                                tooltip.innerHTML = colorPickerHTML;
                                // クリックイベント作成
                                var colorPicker = document.querySelector("#color-picker");
                                colorPicker.addEventListener("change", { index: index, legendItem: item, handleEvent: updateBGColorAll }, false);
                                // カラーピッカーの位置設定
                                var rect = e.target.getBoundingClientRect();
                                var left = e.x - rect.left;
                                var top = e.pageY - 100;
                                tooltip.style.display = 'block';
                                tooltip.style.left = left + "px";
                                tooltip.style.top = top + "px";

                            // それ以外をクリックした場合
                            } else {
                                $('#color-picker').css('display', 'none');
                            }
                        }

                        // rgbaから16進数に変換
                        function rgbaToHex(rgba) {
                            if (/^rgba\((\d{1,3}),\s*(\d{1,3}),\s*(\d{1,3}),\s*(\d*(\.\d+)?)\)$/.test(rgba)) {
                                var a = parseFloat(rgba.replace(/^rgba?\(|\s+|\)$/g, '').split(',')[3]);
                                var r = parseInt(rgba.replace(/^rgba?\(|\s+|\)$/g, '').split(',')[0]);
                                var g = parseInt(rgba.replace(/^rgba?\(|\s+|\)$/g, '').split(',')[1]);
                                var b = parseInt(rgba.replace(/^rgba?\(|\s+|\)$/g, '').split(',')[2]);
                                if (a < 1) {
                                }
                                r = Math.round(r * a);
                                g = Math.round(g * a);
                                b = Math.round(b * a);
                                var hex = "#" + ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1);
                                return hex;
                            } else {
                                return rgba;
                            }
                        }

                        // 全部のグラフの色を変更する
                        function updateBGColorAll(event) {
                            var color = event.target.value
                            updateBGColor(arrivalChart, color, this.index);
                            updateBGColor(departureChart, color, this.index);
                            updateBGColor(allChart, color, this.index);
                            updateBGColor(clearChart, color, this.index);
                            // カラーピッカー非表示
                            $('#color-picker').innerHTML = "";
                        }

                        // グラフの色を変更する
                        function updateBGColor(targetChart, color, index){
                            targetChart.data.datasets[index].backgroundColor = color;
                            targetChart.data.datasets[index].borderColor = color;
                            targetChart.update();
                        }

                        function legendHideOrShow(chart, index){
                            var meta = chart.getDatasetMeta(index);
                            meta.hidden = null === meta.hidden ? !chart.data.datasets[index].hidden : null,
                                chart.update();
                        }

                    </script>
                </div>
                <div class="chartjs-graph chartjs-departure" id="departureChart">
                    <canvas id="binedabanChartDeparture"></canvas>
                    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.3/Chart.bundle.min.js" integrity="sha512-vBmx0N/uQOXznm/Nbkp7h0P1RfLSj0HQrFSzV8m7rOGyj30fYAOKHYvCNez+yM8IrfnW0TCodDEjRqf6fodf/Q==" crossorigin="anonymous"></script>
                    <script src='https://cdnjs.cloudflare.com/ajax/libs/chartjs-plugin-annotation/0.5.7/chartjs-plugin-annotation.min.js'></script>
                    <script src="https://cdn.jsdelivr.net/npm/hammerjs@2.0.8"></script>
                    <script src="https://cdnjs.cloudflare.com/ajax/libs/chartjs-plugin-zoom/0.7.7/chartjs-plugin-zoom.min.js" integrity="sha512-8E9fPF4pjWxI0dpprpn4WYeciAMo2kh6xN0COFxvTfurMttjZzih/sBp+Fxu49Zr6IUSp4sqWY6KLecnqOCwxA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
                    <script>
                        var ctx = document.getElementById("binedabanChartDeparture");
                        function adjustCanvasHeight() {
                            var canvas = document.getElementById("binedabanChartDeparture");
                            var width = window.innerWidth;
                        }

