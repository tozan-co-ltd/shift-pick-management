</div>

<script>
    let userName = "";
    $(document).ready(function () {
        model = @Html.Raw(Json.Serialize(Model));
        userName = model.userName;
        $('#graphAndTable').css('display', 'none');
        addDepos(model);
        depoCheckDisplay(model);
    })

    // 稼働日の日付変更時
    $('#workDay').change(function () {
        // 稼働日の取得
        var workDay = new Date($('#workDay').val());
        var workDayString = GetDayString(workDay);
        addWorkDays(workDayString);
        periodChangeOperationLecord();
    });

    // 選択された稼働日の配列
    let arrayWorkDays = [];

    // 稼働日変更時
    function periodChangeOperationLecord() {

        // 便名称取得
        var tripName = $('[name=TripName]').val();

        $('#workDay').css('width', '8em');

        // 便名称の選択肢を全削除
        var select = $('#tripName')[0];
        while (select.firstChild) {
            select.removeChild(select.firstChild);
        }

        // デポ情報取得
        var checkedDepos = getCheckedDepos();

        // フォーム情報取得
        let url = window.location.origin + '@Url.Action("GetTripNameFromWorkDay", "LoadOperationRecord")';
        let method = 'Post';
        let data = { workDays: arrayWorkDays, checkedDepos: checkedDepos};

        // Ajax call
        $.ajax({
            url: url,
            method: method,
            data: data
        }).done(function (response) {
            for (var i = 0; i < response.length; i++) {
                // セレクトボックスの選択肢生成
                var option = document.createElement("option");
                if (response[i].text == null) {
                    option.text = "";
                }
                else {
                    option.text = response[i].text;
                }
                option.value = response[i].value;

                // 更新前に選択していた便名称が存在する場合、選択済みに設定
                if (tripName == option.value) {
                    option.selected = true;
                }
                // セレクトボックスに追加
                select.appendChild(option);
            }
            

        }).fail(function (jqXHR, textStatus, errorThrown) {
            if (jqXHR.status === 404) {
                var errorMessage = jqXHR.responseJSON.errorMessage;
                $("#div-error-message").text(errorMessage);
            } else {
                var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                $("#div-error-message").text(errorMessage);
            }
        });
    }

    

    // 稼働日選択時
    function addWorkDays(workDay) {
        DeleteErrorMessages();
        // 20件の稼働日が選択されているとき
        if (20 <= arrayWorkDays.length) {
            var errorMessage = 'E1008: 選択できる稼働日は最大20件です。20件を超えないように選択してください。';
            $("#div-error-message").text(errorMessage);
            return;
        }

        if(workDay == 'Invalid Date'){
            var errorMessage = 'E5555: 稼働日には正しい日付を入力してください。'
            $("#div-error-message").text(errorMessage);
            return;
        }

        // 1行目の場合、項目追加
        if (arrayWorkDays.length == 0){
            document.getElementById("clearTrips").style.visibility = 'visible';
            document.getElementById("selectedWorkDays0").innerHTML = "<span class=\"mt-3 warehouse-name-drs\">選択された稼働日</span>";
        }
       
        // 重複チェック
        if (arrayWorkDays.find(x => x == workDay)) {
            return;
        }

        // 選択された稼働日を追加する行を設定
        var selectedWorkDaysNumber = Math.floor(arrayWorkDays.length / 5);
        var selectedWorkDays = $('#selectedWorkDays' + selectedWorkDaysNumber)[0];

        // 選択された稼働日に追加
        arrayWorkDays.push(workDay);
        pushLabelToSelectedWorkDays(selectedWorkDays, workDay);
    }

    // 選択された便ラベルを作成、指定した親要素の子として登録
    function pushLabelToSelectedWorkDays(selectedWorkDays, workDay) {
        var selectedWorkDayLabel = document.createElement("label");
        selectedWorkDayLabel.innerText = workDay;
        selectedWorkDayLabel.innerHTML += "<a href=\"#\" class=\"label-delete ml-1\" onclick=\"onDayLabelDeleteClick('" + workDay + "')\" id=\"\">×</a>";
        selectedWorkDayLabel.className += "mr-2 mt-3 selected-trip-label";
        selectedWorkDayLabel.style.backgroundColor = "rgba(200, 200, 200, 0.6)";
        selectedWorkDayLabel.style.padding = "0.5em";
        selectedWorkDayLabel.style.borderRadius = "5px";
        selectedWorkDayLabel.style.fontWeight = "normal";
        selectedWorkDays.appendChild(selectedWorkDayLabel);
    }

    // 選択された便の×ボタン押下時
    function onDayLabelDeleteClick(workDayString) {
        // ラベル全削除
        $('.selected-trip-label').remove();

        // 配列から削除
        var deleteIndex = arrayWorkDays.indexOf(workDayString);
        arrayWorkDays.splice(deleteIndex, 1);

        // 選択された便が1つも無くなった場合
        if (arrayWorkDays.length == 0) {
            document.getElementById("selectedWorkDays0").innerHTML = "";
            document.getElementById("clearTrips").style.visibility = 'hidden';
            return;
        }

        // 選択された便の再表示
        for (var i = 0; i < arrayWorkDays.length; i++) {
            // 選択された便を追加する行を設定
            var selectedWorkDaysNumber = Math.floor(i / 5);
            var selectedWorkDays = $('#selectedWorkDays' + selectedWorkDaysNumber)[0];

            var selectedWorkDayName = arrayWorkDays[i];
            pushLabelToSelectedWorkDays(selectedWorkDays, selectedWorkDayName);
        }

        // セレクトリスト更新
        periodChangeOperationLecord();
    }

    // 昼勤開始時間の縦線ID用変数
    let labelAppearedTime = 0;

    // 検索ボタン押下時
    function onSearchClick(page) {
        DeleteErrorMessages();

        // 便名称取得
        var tripName = $('[name=TripName]').val();

        // 便が選択されていない場合
        if(tripName == null){
            var errorMessage = 'E1017: 便を選択してください。';
            $("#div-error-message").text(errorMessage);
            return;
        }

        // 稼働日が選択されていない場合
        if(arrayTrips.length == 0){
            var errorMessage = 'E1017: 稼働日を選択してください。';
            $("#div-error-message").text(errorMessage);
            return;
        }

        // グラフとテーブルの表示
        $('#graphAndTable').css('display', 'block');
        tableDisplay(page);

        // 初期表示は到着荷量
        $('input[value="arrival"]').prop('checked', true);
        $('input[value="departure"]').prop('checked', false);
        $('#arrivalChart').css('display', 'block');
        $('#departureChart').css('display', 'none');
        $('#allChart').css('display', 'none');
        $('#clearChart').css('display', 'none');

        // ズームのリセット
        arrivalChart.resetZoom();
        departureChart.resetZoom();
        allChart.resetZoom();
        clearChart.resetZoom();

        // 昼勤開始時間保存用
        var dayShiftStartTime = "";

        // グラフの初期化
        arrivalChart.data.datasets = [];
        departureChart.data.datasets = [];
        allChart.data.datasets = [];
        clearChart.data.datasets = [];

        arrivalChart.options.annotation.annotations = [];
        departureChart.options.annotation.annotations = [];
        allChart.options.annotation.annotations = [];
        clearChart.options.annotation.annotations = [];

        // 追加された便、便枝番について
        for (var i = 0; i < arrayWorkDays.length; i++) {
            var workDay = arrayWorkDays[i];

            // フォーム情報取得
            let url = window.location.origin + '@Url.Action("SearchTrips", "LoadOperationRecord")';
            let method = 'Post';
            let data = { workDay: workDay, tripName: tripName };

            // Ajax call
            $.ajax({
                url: url,
                method: method,
                data: data,
                async: false
            }).done(function (response) {
                // 荷量クラスをパーセントとして保存する用の配列
                var arrivalLoadStatuses = [];
                var departureLoadStatuses = [];
                var allLoadStatuses = [];

                // 荷量クラスをパーセントとして保存
                response.forEach(function (loadRecord) {
                    var arrivalLoadStatus = loadRecord.arrivalLoadStatus;
                    var departureLoadStatus = loadRecord.departureLoadStatus;
                    if (arrivalLoadStatus != "") {
                        var arrivedAt = new Date("1900-01-01T" + GetTimeString(new Date(loadRecord.arrivedAt)) + ":00");
                        arrivalLoadStatuses.push({ x: arrivedAt, y: arrivalLoadStatus });
                        allLoadStatuses.push({ x: arrivedAt, y: arrivalLoadStatus });
                    }

                    if (departureLoadStatus != "") {
                        var departedAt = new Date("1900-01-01T" + GetTimeString(new Date(loadRecord.departedAt)) + ":00");
                        departureLoadStatuses.push({ x: departedAt, y: departureLoadStatus });
                        allLoadStatuses.push({ x: departedAt, y: departureLoadStatus })
                    }

                    dayShiftStartTime = new Date("1900-01-01T" + GetTimeString(new Date(loadRecord.dayShiftStartTime)) + ":00");
                    // 出発、到着予定時間を取得
                    var arrivalScheduledTime = new Date("1900-01-01T" + GetTimeString(new Date(loadRecord.arrivalScheduledTime)) + ":00");
                    var departureScheduledTime = new Date("1900-01-01T" + GetTimeString(new Date(loadRecord.departureScheduledTime)) + ":00");

                    // 到着、出発予定時刻で囲った範囲を登録
                    var scheduleBox = createScheduleBox(arrivalScheduledTime, departureScheduledTime);
                    // 範囲の重複チェック
                    var duplicated = false;
                    arrivalChart.options.annotation.annotations.forEach(function (item) {
                        if(item.id == scheduleBox.id){
                            duplicated = true;
                        }
                    });
                    if (!duplicated) {
                        arrivalChart.options.annotation.annotations.push(scheduleBox);
                        departureChart.options.annotation.annotations.push(scheduleBox);
                        allChart.options.annotation.annotations.push(scheduleBox);
                        clearChart.options.annotation.annotations.push(scheduleBox);
                    }
                })


                // // 各チャートのデータセット作成、登録
                var chartColor = graphColors[i];
                var label = GetDayString(new Date(workDay));
                
                createAndPushDatasets(arrivalChart, chartColor, arrivalLoadStatuses, label);
                createAndPushDatasets(departureChart, chartColor, departureLoadStatuses, label);
                createAndPushDatasets(allChart, chartColor, allLoadStatuses, label);
                createAndPushDatasets(clearChart, chartColor, null, label);
               

            }).fail(function (jqXHR, textStatus, errorThrown) {
                if (jqXHR.status === 404) {
                    var errorMessage = jqXHR.responseJSON.errorMessage;
                    $("#div-error-message").text(errorMessage);
                } else {
                    var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                    $("#div-error-message").text(errorMessage);
                }
            });
        } 

        // 昼勤開始時間の線描画用データ作成
        var annotationLine = createChartAnnotation(dayShiftStartTime, labelAppearedTime);
        labelAppearedTime++;


        // 各chartjsの線、タイトルの設定とアップデート
        setChart(arrivalChart, annotationLine, tripName);
        setChart(departureChart, annotationLine, tripName);
        setChart(allChart, annotationLine, tripName);
        setChart(clearChart, annotationLine, tripName);
    }

    // chartjs用のデータセット作成
    function createChartDatasets(chartColor) {
        var datasets = {
            label: '',
            borderColor: chartColor,
            fill: false,
            data: [],
            tension: 0,
            pointRadius: '5',
            backgroundColor: chartColor,
            spanGaps: true,
        }
        return datasets;
    }


    let scheduleBoxID = 0;

    function createScheduleBox(arrivalScheduledTime, departureScheduledTime){
        var annotationBox = {
            type: 'box', // 矩形を指定
            drawTime: 'afterDatasetsDraw',
            id: arrivalScheduledTime + departureScheduledTime, // 矩形のid名を指定（他と区別するため）
            xScaleID: 'x軸', // 基準とするx軸のid名
            yScaleID: 'y軸',// 基準とするy軸のid名
            xMin: arrivalScheduledTime, // 基準とするx軸の値（始点）
            xMax: departureScheduledTime, // 基準とするx軸の値（終点）
            yMin: 0, // 基準とするy軸の値（始点）
            yMax: 100, // 基準とするy軸の値（終点）
            backgroundColor: 'rgba(100,100,180,.2)',
            borderWidth: 0,
            borderColor: 'rgba(180,100,180,0)'
        }
        scheduleBoxID++;
        return annotationBox;
    }

    // chartjs用の線描画用データ作成
    function createChartAnnotation(dayShiftStartTime, labelAppearedTime){
        var annotationLine = {
            type: 'line', // 線分を指定
            drawTime: 'afterDatasetsDraw',
            id: labelAppearedTime.toString(), // 線のid名を指定（他の線と区別するため）
            mode: 'vertical', // 垂直を指定
            scaleID: 'x軸', // 基準とする軸のid名
            value: dayShiftStartTime, // 引きたい線の数値（始点）
            borderColor: 'black', // 線の色
            borderWidth: 3, // 線の幅（太さ）
            // borderDash: [2, 2],
            // borderDashOffset: 1,
        };
        return annotationLine;
    }

    // chartjsの線、タイトルの設定とアップデート
    function setChart(targetChart, annotationLine, tripName) {
        targetChart.options.annotation.annotations.push(annotationLine);
        targetChart.options.title.text = tripName;
        targetChart.update();
    }

    // チェックボックス切り替え時
    $(function () {
        $('input[name="chartCheckBoxes"]:checkBox').change(function () {
            // デフォルトの操作を無効化
            event.preventDefault();

            // カラーピッカーを非表示に
            $('#color-picker').innerHTML = "";

            var checkBoxVal = "";
            // 入力があるチェックボックス取得
            $('input[name="chartCheckBoxes"]:checked').each(function () {
                var r = $(this).val();
                checkBoxVal += r;
            })

            // 入力内容によって表示させるグラフを切り替える
            if (checkBoxVal == "arrival") {
                $('#arrivalChart').css('display', 'block');
                $('#departureChart').css('display', 'none');
                $('#allChart').css('display', 'none');
                $('#clearChart').css('display', 'none');
            }
            else if (checkBoxVal == "departure") {
                $('#departureChart').css('display', 'block');
                $('#arrivalChart').css('display', 'none');
                $('#allChart').css('display', 'none');
                $('#clearChart').css('display', 'none');
            }
            else if(checkBoxVal == "arrivaldeparture"){
                $('#arrivalChart').css('display', 'none');
                $('#departureChart').css('display', 'none');
                $('#allChart').css('display', 'block');
                $('#clearChart').css('display', 'none');
            }
            else{
                $('#arrivalChart').css('display', 'none');
                $('#departureChart').css('display', 'none');
                $('#allChart').css('display', 'none');
                $('#clearChart').css('display', 'block');
            }
        })
    })

    // 便実績テーブル表示
    function tableDisplay(page) {
        // 便名称取得
        var tripName = $('[name=TripName]').val();

        let data = { workDays: arrayWorkDays, tripName: tripName };

        tableDisplayCommon(page, data);

    }

    // 画像一括出力ボタン押下
    function onExportAllImages(page) {
        event.preventDefault();
        DeleteErrorMessages();

        // 便名称取得
        var tripName = $('[name=TripName]').val();


        // デポ情報取得
        var checkedDepos = getCheckedDepos();

        // フォーム情報取得
        let data = {
            download: "download",
            workDays: arrayWorkDays,
            selectedTripName: tripName,
            checkedDepos: checkedDepos
        };

        onExportAllImagesCommon(page, data);
    }

    // Excel出力
    async function onExportFileTrips(page, gamenName) {
        DeleteErrorMessages();

        // 便名称取得
        var tripName = $('[name=TripName]').val();

        // デポ情報取得
        var checkedDepos = getCheckedDepos();

        // フォーム情報取得
        let data = {
            "gamenName": gamenName,
            workDays: arrayWorkDays,
            tripName: tripName,
            checkedDepos: checkedDepos
        };

        // Excel出力共通処理
        onExportFileTripsCommon(page, data);
    }

    // 「すべて」チェックボックス押下時
    $('input[id=allDepo]').change(function () {
        pushAllCheckBox();
        periodChangeOperationLecord()
    });

    // 各デポチェックボックス押下時
    $(function () {
        $('input[name="depos"]').change(function () {
            pushDepoCheckBox();
            periodChangeOperationLecord()
        });
    })

</script>
