                        // rgbaから16進数に変換
                        function rgbaToHex(rgba) {
                            if (/^rgba\((\d{1,3}),\s*(\d{1,3}),\s*(\d{1,3}),\s*(\d*(\.\d+)?)\)$/.test(rgba)) {
                                var a = parseFloat(rgba.replace(/^rgba?\(|\s+|\)$/g, '').split(',')[3]);
                                var r = parseInt(rgba.replace(/^rgba?\(|\s+|\)$/g, '').split(',')[0]);
                                var g = parseInt(rgba.replace(/^rgba?\(|\s+|\)$/g, '').split(',')[1]);
                                var b = parseInt(rgba.replace(/^rgba?\(|\s+|\)$/g, '').split(',')[2]);
                                if (a < 1) {
                                }
                                r = Math.round(r * a);
                                g = Math.round(g * a);
                                b = Math.round(b * a);
                                var hex = "#" + ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1);
                                return hex;
                            } else {
                                return rgba;
                            }
                        }

                        // 全部のグラフの色を変更する
