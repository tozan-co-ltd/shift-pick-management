<div class="card shadow de-inspection m-4">
    <div class="card-header">
        管理者マスター
    </div>
    <div class="card-body">
        <p>@Model.UserName　こんにちは！</p>

        @if (Model.Registered)
        {
            <div class="alert alert-success">
                <strong>登録済み</strong>
                @if (Model.RegisteredAt.HasValue)
                {
                    <div>時間: @Model.RegisteredAt</div>
                }
            </div>
        }
        else
        {
            <div>
                <p>@(string.IsNullOrEmpty(Model.Message) ? "管理者情報を入力して登録してください。" : Model.Message)</p>
                <form asp-action="Register" method="post">
                    <div class="form-group">
                        <label>管理者名</label>
                        <input name="ManagerName" class="form-control" />
                    </div>
                    <input type="hidden" name="UserName" value="@Model.UserName" />
                    <button type="submit" class="btn btn-primary">登録</button>
                </form>
            </div>
        }
    </div>
</div>
