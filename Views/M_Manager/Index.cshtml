<!--  Edit Modal-->
<div class="modal fade" id="edit-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="edit-modal-label">編集</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="col-12 col-md-12">
                    <p id="edit-modal-error-message" class="mt-1 text-danger"></p>
                </div>
                <div class="d-flex justify-content-center">
                    <form class="col-md-12" id="mTripForm">
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl">
                                <label>ユーザーID</label>
                            </div>
                            <div class="col-12 col-sm-6 col-md-6 column-2nd">
                                <input class="form-control" type="text"  autocomplete="off" value="" required>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl">
                                <label>パスワード</label>
                            </div>
                            <div class="col-12 col-sm-6 col-md-6 column-2nd">
                                <input class="form-control" type="text"  autocomplete="off" value="" required>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl">
                                <label>名前</label>
                            </div>
                            <div class="col-12 col-sm-6 col-md-6 column-2nd">
                                <input class="form-control" type="text" autocomplete="off" value="" required>
                            </div>
                        </div>
                        <div class="col-14 input-group div-input-group">
                            <div class="col-12 col-sm-4 col-md-3 column-1st label-input-model-pl">
                                <label>利用停止</label>
                            </div>
                            <div class="col-12 col-sm-6 col-md-6 column-2nd">
