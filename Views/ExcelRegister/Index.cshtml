@using shift_pick_management.Commons;
@model shift_pick_management.Models.ExcelRegisterModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = "空きエクセル登録";
}
<div class="card shadow de-inspection masterInfo m-4">
    <div class="card-header">
        @ViewData["Title"]
    </div>

    <div class="card-body">

        <div class="form-group col-sm-12 pl-3">
            <p id="div-error-message" class="mt-1 text-danger"></p>

            @if (ViewData["ErrorMessage"] != null)
            {
                <span class="mt-1 text-danger">@ViewData["ErrorMessage"]</span>
            }
        </div>
        <div class="col-12 input-group div-input-group justify-content-start">
            <div class="col-12 col-sm-8 col-md-5 column-1st">
                <input class="form-control" type="file" required id="fileBox" multiple name="files">
            </div>
            <div style="margin-left:auto">
                <a class="btn btn-secondary btn-icon-split" onclick="onExportFileTrips('LoadOutput', '@Model.ViewTitle')" id="exportFile">
                    <span class="text">アップロード</span>
                </a>
            </div>
        </div>
    </div>
</div>
<div class="card shadow de-inspection masterInfo m-4">
    <div class="card-body">

        <div class="mt-3">
            <table class="table table-sm stripe hover nowrap datatable-normal table-center">
                <thead>
                    <tr align="center">
                        <th class="font-weight-bold">取り込み日時</th>
                        <th class="font-weight-bold">ユーザー名</th>
                        <th class="font-weight-bold">ファイル名</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>YYYY/MM/DD hh:mm</td>
