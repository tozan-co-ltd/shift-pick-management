@model shift_pick_management.Models.ExcelRegisterModel
<div class="card shadow de-inspection m-4">
    <div class="card-header">
        空きエクセル登録
    </div>
    <div class="card-body">
        <p>@Model.UserName　こんにちは！</p>

        @if (Model.Registered)
        {
            <div class="alert alert-success">
                <strong>登録済み</strong>
                @if (Model.RegisteredAt.HasValue)
                {
                    <div>時間: @Model.RegisteredAt</div>
                }
            </div>
        }
        else
        {
            <div>
                <p>@(string.IsNullOrEmpty(Model.Message) ? "ファイル選択してください。" : Model.Message)</p>
                <form asp-action="Register" method="post" enctype="multipart/form-data">
                    <div class="form-group">
                        <label asp-for="FileName">File</label>
                        <input asp-for="FileName" class="form-control" />
                    </div>
                    <input type="hidden" asp-for="UserName" />
                    <button type="submit" class="btn btn-primary">登録</button>
                </form>
            </div>
        }
    </div>
</div>
