@using mar_sumaken_web.Commons;
@model mar_sumaken_web.Models.D_FileImportModel
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.ViewTitle;
}

<div class="card shadow de-inspection m-4">
    <div class="card-header text-gray-800">
        出庫 - @ViewData["Title"]
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-lg-10">
                <div class="card border-left-custom">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li>ファイル形式が「.csv」のみ取込できます。</li>
                            <li>品番マスターに登録されている品番の行のみ取り込まれます。登録されていない品番の行はスキップします。</li>
                            <li>納入指示日、便、納品書番号、品番が同一のデータは上書きされます。</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group col-sm-12">
            <p id="import-res" class="mt-1"></p>
        </div>

        <div id="div-error-message" class="mb-3 ml-3 text-danger">
        </div>

        <div class="mg-bot-20">
            <div class="col-16 sp-tablet mb-3">
                <div class="row mt-10">
                    <div class="col-lg-12">
                        <form id="import-receive-schedule-upload-form" method="post">
                            <div class="col-16 d-flex justify-content-start align-items-center mb-3 col-11 unset-pdl">
                                <span class="warehouse-name-drs">倉庫名</span>
                                <div class="selectItem unset-pdl">
                                    <select class="form-select" name="DepoID" asp-for="SelectedDepoID" asp-items="@Model.SearchDepoList"></select>
                                </div>
                            </div>
                            <div class="col-16 d-flex justify-content-start align-items-center mb-3 col-11 unset-pdl">
                                <span class="warehouse-name-drs">納入先名</span>
                                <div class="selectItem unset-pdl">
                                    <select class="form-select" name="DepoID" asp-for="SelectedCompanyID" asp-items="@Model.SearchCompanyList"></select>
                                </div>
                            </div>
                            <div class="d-flex justify-content-start align-items-center upload-part sp-tablet">
                                <div class="col-6 mg-right-20 file-input pd-0-sp sp-mg-bt-10 unset-pdl">
                                    <div class="input-group">
                                        <label class="input-group-btn my-0">
                                            <span class="btn btn-secondary btn-icon-split btn-pd20" id="browse">
                                                ファイル選択
                                                <input class="excel-input" name="FileUpload" type="file" accept=".xlsx" multiple>
                                            </span>
                                        </label>
                                        <input type="text" class="form-control rounded-0" readonly placeholder="CSVファイルを選択してください">
                                    </div>
                                </div>
                                <div class="input-group-append sp-mg-bt-10">
                                    <button id="file-upload" class="btn btn-primary btn-icon-split" onclick="onUploadFile('import-receive-schedule-upload-form')">
                                        <span class="icon text-white-50">
                                            <i class="fa-solid fa-file-export"></i>
                                        </span>
                                        <span class="text">取込</span>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <p>
            取込履歴(直近1ヶ月)
        </p>
        <div class="mt-3">
            <table class="table table-sm stripe hover nowrap datatable-normal">
                <thead>
                    <tr>
                        <th>取込日時</th>
                        <th>取込ファイル名</th>
                        <th>登録者</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>2024/02/01</td>
                        <td>納入指示_400095060_P_20240118_1_Y3470_07075.csv</td>
                        <td>山田太郎</td>
                    </tr>
                    <tr>
                        <td>2024/02/01</td>
                        <td>納入指示_400095060_P_20240118_1_Y3470_07075.csv</td>
                        <td>山田太郎</td>
                    </tr>
                    <tr>
                        <td>2024/02/01</td>
                        <td>納入指示_400095060_P_20240118_1_Y3470_07075.csv</td>
                        <td>山田太郎</td>
                    </tr>
                    <tr>
                        <td>2024/02/01</td>
                        <td>納入指示_400095060_P_20240118_1_Y3470_07075.csv</td>
                        <td>山田太郎</td>
                    </tr>
                    <tr>
                        <td>2024/02/01</td>
                        <td>納入指示_400095060_P_20240118_1_Y3470_07075.csv</td>
                        <td>山田太郎</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
