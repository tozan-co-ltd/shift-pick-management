@using shift_pick_management.Commons;
@model shift_pick_management.Models.M_PrefectureModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = "都道府県マスタ";

    // 8地方区分(都道府県コード順)
    var areaList = new List<(string AreaID, string AreaName, string[] Prefectures)>
    {
        ("area_hokkaido", "北海道", new[] { "北海道" }),
        ("area_tohoku", "東北", new[] { "青森", "岩手", "宮城", "秋田", "山形", "福島" }),
        ("area_kanto", "関東", new[] { "茨城", "栃木", "群馬", "埼玉", "千葉", "東京", "神奈川" }),
        ("area_chubu", "中部", new[] { "新潟", "富山", "石川", "福井", "山梨", "長野", "岐阜", "静岡", "愛知" }),
        ("area_kinki", "近畿", new[] { "三重", "滋賀", "京都", "大阪", "兵庫", "奈良", "和歌山" }),
        ("area_chugoku", "中国", new[] { "鳥取", "島根", "岡山", "広島", "山口" }),
        ("area_shikoku", "四国", new[] { "徳島", "香川", "愛媛", "高知" }),
        ("area_kyushu", "九州 / 沖縄", new[] { "福岡", "佐賀", "長崎", "熊本", "大分", "宮崎", "鹿児島", "沖縄" }),
    };
}
<div class="card shadow de-inspection masterInfo m-4">
    <div class="card-header">
        @ViewData["Title"]
    </div>

    <div class="card-body">

        @if (Model.Registered)
        {
            <div class="alert alert-success">
                @(Model.SelectedPrefectures.Count)件の都道府県を登録しました。(@Model.RegisteredAt?.ToString("yyyy/MM/dd HH:mm:ss"))
            </div>
        }

        <form asp-controller="M_Prefecture" asp-action="Register" method="post">
            @foreach (var area in areaList)
            {
                <div class="area-block d-flex">
                    <div class="area-header">
                        <label>
                            <input type="checkbox" class="area-check" data-area="@area.AreaID">
                            <span class="area-title">@area.AreaName</span>
                        </label>
                    </div>
                    <div class="pref-list">
                        @foreach (var pref in area.Prefectures)
                        {
                            <label><input type="checkbox" class="pref-check" data-area="@area.AreaID" name="SelectedPrefectures" value="@pref" checked="@Model.SelectedPrefectures.Contains(pref)"> @pref</label>
                        }
                    </div>
                </div>
            }

            <div class="text-right">
                <button type="submit" class="btn btn-secondary pref-submit">確定</button>
            </div>
        </form>
    </div>

</div>

<script type="text/javascript">

    // 都道府県のチェック状態からエリアチェックを更新
    function syncAreaCheck(areaName) {
        const prefs = document.querySelectorAll(`.pref-check[data-area="${areaName}"]`);
        const areaCheck = document.querySelector(`.area-check[data-area="${areaName}"]`);

        const total = prefs.length;
        const checkedCount = Array.from(prefs).filter(p => p.checked).length;

        // 全チェック → ON、一部チェック → 中間表示、全部OFF → OFF
        areaCheck.checked = checkedCount === total;
        areaCheck.indeterminate = checkedCount > 0 && checkedCount < total;
    }

    // エリアチェックボックス押下時
    document.querySelectorAll('.area-check').forEach(area => {
        area.addEventListener('change', function () {
            const areaName = this.dataset.area;
            const checked = this.checked;

            // 同じエリアの都道府県チェックをすべて連動
            document.querySelectorAll(`.pref-check[data-area="${areaName}"]`)
                .forEach(pref => pref.checked = checked);
        });
    });

    // 都道府県チェックをクリックしたらエリアチェックを更新
    document.querySelectorAll('.pref-check').forEach(pref => {
        pref.addEventListener('change', function () {
            syncAreaCheck(this.dataset.area);
        });
    });

    // 初期表示(登録後の再表示)時にエリアチェックを合わせる
    document.querySelectorAll('.area-check').forEach(area => syncAreaCheck(area.dataset.area));

</script>
