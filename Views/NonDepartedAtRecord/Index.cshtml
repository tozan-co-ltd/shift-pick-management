@using ai_truck_load_measurement.Commons;
@model ai_truck_load_measurement.Models.NonDepartedAtRecordViewModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.CategoryTitle + " - " + Model.ViewTitle;
}
<div class="card shadow de-inspection masterInfo m-4">
    <div class="card-header">
        @ViewData["Title"]
    </div>

    <div class="card-body">

        <div class="row">
            <div class="col-lg-10">
                <div class="card border-left-custom">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li>期間内の出発実績が登録されていないデータの件数を表示します。</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group col-sm-12 pl-3">
            <p id="div-error-message" class="mt-1 text-danger"></p>

            @if (ViewData["ErrorMessage"] != null)
            {
                <span class="mt-1 text-danger">@ViewData["ErrorMessage"]</span>
            }
        </div>
        <div class="col-16 d-flex justify-content-start align-items-center unset-pdl sp-cs-dpl">
            <div class="d-flex justify-content-start align-items-center mb-3 unset-pdl">
                <span class="warehouse-name-drs span-paragraph">デポ</span>
                <div>
                    <label class="mr-2"><input type="checkbox" class=" mr-2" id="allDepo" />すべて  [</label>
                    <label id="selectDepos"></label>]
                </div>
            </div>
        </div>

        <div class="col-16 d-flex justify-content-start align-items-center unset-pdl sp-cs-dpl">
            <div class="d-flex justify-content-start align-items-center unset-pdl">
                <span class="warehouse-name-drs span-paragraph">期間</span>
                <input type="text" id="startOfPeriod" class="form-control pickerDate startDate">
                <label class="m-1">～</label>
                <input type="text" id="endOfPeriod" class="form-control pickerDate endDate mr-3">
                <div class="input-group-append mr-3">
                    <a class="btn btn-secondary btn-icon-split" onclick="onSearchClick()">
                        <span class="icon text-white-50">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span>
                        <span class="text">検索</span>
                    </a>
                </div>
                <span class="loader" style="display:inline-block; vertical-align: middle;" role="status" id="loading"></span>
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>

        <hr />

        <div class="mg-bot-20 mb-3">
            <div class="col-12 d-flex xs-block justify-content-start align-items-center p-0">
                <div class="input-group-append mr-1">
                    <a class="btn btn-info btn-icon-split" onclick="onExportFileTrips('NonDepartedAtRecord', '@Model.ViewTitle')" id="exportFile">
                        <span class="icon text-white-50">
                            <i class="fas fa-file-export"></i>
                        </span>
                        <span class="text">Excel出力</span>
                    </a>
                </div>
            </div> 
        </div>


        <div class="mt-3" id="tripRecordTable">
        </div>

        <div class="mt-3 departed-at-is-null-table" id="departedAtIsNullTable"></div>
    </div>
</div>
<script type="text/javascript">

    let userName = "";
    // 画面ロード時
    $(document).ready(function () {
        model = @Html.Raw(Json.Serialize(Model));
        userName = model.userName;
        var today = new Date();
        var oneWeekAgo = new Date();
        oneWeekAgo.setDate(oneWeekAgo.getDate() - 7);
        $('#endOfPeriod').val(GetDayString(today));
        $('#startOfPeriod').val(GetDayString(oneWeekAgo));
        addDepos(model);
        $('input[id=allDepo]')[0].checked = true;
        pushAllCheckBox();
        tableDisplay();
    });
    // 便実績テーブル表示
    function tableDisplay() {

        // 期間の開始、終了日付の取得
        var startOfPeriod = GetDayString(new Date($('#startOfPeriod').val()));
        var endOfPeriod = GetDayString(new Date($('#endOfPeriod').val()));

        // デポ情報取得
        var checkedDepos = getCheckedDepos();

        // テーブル表示用データ作成
        let data = { 
            startOfPeriod: startOfPeriod,
            endOfPeriod: endOfPeriod,
            checkedDepos: checkedDepos
        };
          // フォーム情報取得
        let url = window.location.href + '/SearchData';
        let method = 'Post';

        // Ajax call
        $.ajax({
            url: url,
            method: method,
            data: data
        }).done(function (response) {
            console.log(response);
            $("#departedAtIsNullTable").empty().html(response);
            
            // 日本語表示
            const language_url = "https://cdn.datatables.net/plug-ins/1.11.5/i18n/ja.json";
            const dom_structure = "<'top d-flex align-items-center'li<'ml-auto'f>>rt<'bottom'p><'clear'>";

            // ID(2列目)昇順
            $("#tripRecordDataTable").DataTable({
                "language": {
                    "url": language_url,
                    searchPlaceholder: "フリーワード(全件)"
                },
                lengthChange: true,     // 件数切替
                info: true,            // 総件数
                scrollX: true,          // 横スクロール可
                scrollCollapse: true,   // 縦スクロール表示
                searchHighlight: true,  // 検索ハイライト
                "oLanguage": {
                    "sSearch": ""
                },
                dom: dom_structure,
                pageLength: 100,
                fixedColumns: {
                    leftColumns: 3,
                },
            });
            var table = $("#tripRecordDataTable").DataTable();
            table.on('draw', function () {
                var body = $(table.table().body());

                body.unhighlight();
                body.highlight(table.search());
            });


            if (document.querySelector("#loading") != null)
                document.querySelector("#loading").style.display = "none";
        }).fail(function (jqXHR, textStatus, errorThrown) {
            var errorMessage = jqXHR.responseJSON.errorMessage;
            $("#edit-modal-error-message").text(errorMessage);
        });
    }
     // 検索ボタン押下時
    function onSearchClick() {
        DeleteErrorMessages();
        // ロード中表示
        document.querySelector("#loading").style.display = "inline-block";
        tableDisplay();
    }
     // 「すべて」チェックボックス押下時
    $('input[id=allDepo]').change(function () {
        pushAllCheckBox();
    });

    // 各デポチェックボックス押下時
    $(function () {
        $('input[name="depos"]').change(function () {
            pushDepoCheckBox();
        });
    })

     // Excel出力
    async function onExportFileTrips(page, gamenName) {
        DeleteErrorMessages();

        // 期間の開始、終了日付の取得
        var startOfPeriod = GetDayString(new Date($('#startOfPeriod').val()));
        var endOfPeriod = GetDayString(new Date($('#endOfPeriod').val()));

        // デポ情報取得
        var checkedDepos = getCheckedDepos();

        // フォーム情報取得
        let data = {
            "gamenName": gamenName,
            checkedDepos: checkedDepos,
            startOfPeriod: startOfPeriod,
            endOfPeriod: endOfPeriod,
            checkedDepos: checkedDepos
        };

        // Excel出力共通処理
        onExportFileTripsCommon(page, data);
    }
</script>