@using ai_truck_load_measurement.Commons;
@model ai_truck_load_measurement.Models.LoadProgressModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.CategoryTitle + " - " + Model.ViewTitle;
}
<div class="card shadow de-inspection masterInfo m-4">
    <div class="card-header">
        @ViewData["Title"]
    </div>
    <div id="ErrorBlock" class="mb-3 text-danger text-center"></div>

    <div id="timeline-chart" class="scroll-inner"></div>
    <div id="container"></div>
</div>

<script>
    $(document).ready(function () {
        model = @Html.Raw(Json.Serialize(Model));
        console.log(model);
        let today = GetDateString(new Date());
        let data = {depoId: model.selectedDepo.depoID, loadDate: today}
        $.ajax({
                type: 'GET',
                data: data,
                dataType: 'JSON',
                url: '@Url.Action("GetLoadProgressJson", "LoadProgress")'
        }).done(function (response) {
            if(response.res == "OK")
                loadProgressDataSets(response.data)
            else{
                $("#ErrorBlock").text(response.error)
            }
        });
    });

    function loadProgressDataSets(datasets){

        var width = $(window).width() - 60, height = 90;
        var padding = { top: 0, right: 10, bottom: 10, left: 65 }
        var barHeight = 135;

        // 日時を時刻に変換
        $.each(datasets, function (index, data) {
            $.each(data.value, function (index, data) {
                data.from = moment(data.from);
                data.to = moment(data.to);
            })
        })

        // d3.jsで描画
        $.each(datasets, function (index, data) {
            var dataset = data.value;
            var date = new Date();
            var dateFormat = date.getFullYear() + "/" + (date.getMonth() + 1) + "/" + date.getDate();
            var timelineStartTime = moment(moment(dateFormat).startOf('day'));
            var timelineEndTime = moment(moment(moment(dateFormat))).add(1, 'days').startOf('day');

            var svg = d3.select('#timeline-chart')
                .append('svg')
                .attr('width', width)
                .attr('height', height)

            // x軸(時間軸)
            var xScale = d3.scaleTime()
                .domain([timelineStartTime, timelineEndTime])
                .range([padding.left, width - padding.right])
            var chartHeight = height - padding.top - padding.bottom;

            var xAxis = d3.axisBottom(xScale)
                .ticks(14)
                .tickSize(chartHeight)      // 軸のメモリの長さ
                .tickFormat(d3.timeFormat('%H:%M'))
            var gX = svg.append('g')
                .call(xAxis)

            // y軸(ラベル)
            var dateDispFormat = data.key
            var chartCenterY = padding.top + chartHeight / 2
            svg.append('text')
                .text(dateDispFormat)
                .attr('x', 10)
                .attr('y', chartCenterY)
                .attr('dy', '0.5rem')

            // データの描画
            const scheduleG = svg.selectAll()
                .data(dataset)
                .enter()
                .append('g')        // 要素のグループ化

            let yRect = 1;
            let yText = 0;

            // 短形の描画
            scheduleG.append('rect')
                .attr('x', function (d) {
                    return xScale(d['from'])
                })
                .attr('y', yRect)
                .attr('width', function (d) {
                    return xScale(d['to']) - xScale(d['from'])
                })
                .attr('height', function (d) {
                    // 現在時刻
                    if (d.shipping_lane_status_name == '現在時刻') {
                        return barHeight
                    // 昼勤開始時間
                    } else if(d.shipping_lane_status_name == '昼勤開始時間'){
                        return barHeight * 2
                    // 運行便
                    } else {
                        return barHeight / 1.8
                    }
                })
                .attr('fill', function (d) {
                    var color = '';
                   
                    // 現在時刻             赤 #ff0000
                    if (d.shipping_lane_status_name == '現在時刻')
                        color = '#ff0000';
                    // 休憩時間             灰 #cccccc
                    else if (d.shipping_lane_status_name == '休憩時間')
                        color = '#cccccc';
                    // 作業者セット中       橙 #ffcc00
                    else if (d.shipping_lane_status_name == '作業者セット中')
                        color = '#ffcc00';
                    // 作業者セット完了     黄 #ffff66
                    else if (d.shipping_lane_status_name == '作業者セット完了')
                        color = '#ffff66';
                    // 積込み作業中         青 #0099ff
                    else if (d.shipping_lane_status_name == '昼勤開始時間')
                        color = '#0099ff';
                    // 積込み完了           緑 #33cc00
                    else if (d.shipping_lane_status_name == '積込み完了')
                        color = '#33cc00';
                    // 未着手               黒 #808080
                    else if (d.shipping_lane_status_name == '未着手')
                        color = '#808080';
                    // 出発後　　　　　　　 灰 #cccccc
                    else if (d.shipping_lane_status_name == '出発後')
                        color = '#cccccc';
                    // 到着前　　　　　　　 薄いブルー #aaffff
                    else if (d.shipping_lane_status_name == '到着前')
                        color = '#aaffff';
                    // 停車中               メインカラー #ec52ac
                    else if (d.shipping_lane_status_name == '停車中')
                        color = '#ec52ac';
                    // 紐付け有かつ出発済   緑 #33cc00
                    else if (d.shipping_lane_status_name == '紐付け有出発済')
                        color = '#33cc00';
                    // 紐づけ無かつ出発済   薄い緑 #cee6c1
                    else if (d.shipping_lane_status_name == '紐付け無出発済')
                        color = '#cee6c1';
                    // 紐付け有かつ停車中   メインカラー #ec52ac
                    else if (d.shipping_lane_status_name == '紐付け有停車中')
                        color = '#ec52ac';
                    // 紐づけ無かつ停車中   黄 #ffff66
                    else if (d.shipping_lane_status_name == '紐付け無停車中')
                        color = '#ffff66';
                    return color
                })
                // 遅延表示(赤枠)
                .attr('stroke', function (d) {
                    var stroke = '';
                    var curentDateTime = new Date();
                    var shippingEndTime = new Date(d.shipping_end_scheduled_time);
                    // 出荷レーン状況名が「作業者セット中」かつ出荷終了時間が現在時刻より前の場合は赤枠を表示
                    if (d.shipping_lane_status_name == '作業者セット中' && curentDateTime > shippingEndTime) {
                        stroke = "#ff0000";
                    }
                    return stroke
                })
                .attr("stroke-width", 3)
                .attr('opacity', 0.7)
                .attr('class', function(d){
                    if(d.schedule_or_record == 'record')
                        return 'trip_record'
                    else
                        return ''
                })
                .attr('id', function(d){
                     if(d.schedule_or_record == 'record')
                        return d.trip_record_id
                    else
                        return ''
                })
            // 運行便名の描画
            scheduleG.append('text')
                .attr('transform', 'translate(5, 1)')   // SVGの表示領域
                .attr('x', function (d) {
                    return xScale(d['from'])            // x座標(親要素からの相対位置)
                })
                .attr('y', yText)                       // y座標(親要素からの相対位置)
                .text(function (d) {
                    // 現在時刻・休憩時間の場合は、便名表示なし
                    if (d.shipping_lane_status_name == '現在時刻' || d.shipping_lane_status_name == '休憩時間') {
                        return ''
                        // 運行便の場合は、便名表示あり
                    } else if (d.routeName != undefined && d.routeSeq != undefined) {
                        return d.routeName + "_" + d.routeSeq
                    } else if(d.routeName != undefined){
                        console.log(d.shipping_lane_status_name);
                        return d.routeName
                    }
                })
                .attr('font-size', '9px')               // 文字サイズ
                .attr('writing-mode', 'tb')             // 縦書き
                .attr('dominant-baseline', 'central')   // テキスト中央揃え
                .attr('fill', '#000000')                // テキスト色
        });
    }

    // 便実績クリック時
    $(function () {
      $(document).on('click', '.trip_record', function (event) {
        console.log(event.target);
        // trip_record_id をもとに便実績情報を取得
        model = @Html.Raw(Json.Serialize(Model));
        var id = event.target.id;
        var trip = model.loadRecords.find(item => item.tripRecordID == id);

       // 表示用の要素を初期化
        while(container.firstChild){
            container.removeChild(container.firstChild);
        }

        const item = createItem(event.pageX-50 , event.pageY-90, trip);
        console.log(item);
        container.appendChild(item);
        // 便実績情報を基にボタンを作成
      });
    });

    $(function (){
        document.body.onclick = function ( event ) {
            console.log(event.target.id);
            if(event.target.id == ""){
                while(container.firstChild){
                    container.removeChild(container.firstChild);
                }
            }
        }
    })

    // アイテムを作成する関数
    function createItem(x, y, trip) {
      console.log("引数" + y);
      const item = document.createElement('div');
      item.classList.add('item');
      item.style.left = x + 'px';
      item.style.top = y + 'px';
      item.style.position = 'absolute'; // 絶対座標で配置
      item.style.backgroundColor = 'black';
      item.style.color = 'white';
      item.innerHTML = trip.tripName + "<br />" 
      + "到着予定時間: " + GetTimeString(new Date(trip.arrivalScheduledTime)) + "<br />"
      + "出発予定時間: " + GetTimeString(new Date(trip.departureScheduledTime)) + "<br /><br />"
      + "到着実績: " + GetTimeString(new Date(trip.arrivedAt)) + "<br />"
      + "出発実績: " + GetTimeString(new Date(trip.departedAt)) + "<br />"
      + "<a class=\"btn btn-success btn-icon-split ml-1 mr-1\""
      + "onclick=\"OnArrivalLoadImageClick('" + trip.tripRecordID + "', this, '{page}')\" data-id=\"" + trip.TripRecordID + "\" data-toggle=\"modal\" data-target=\"#detail-modal\">"
      + "<i class=\"fa-solid fa-truck\"></i></a>"
      + "<a class=\"btn btn-success btn-icon-split ml-1 mr-1\""
      + "onclick=\"OnDepartureLoadImageClick('" + trip.tripRecordID + "', this, '{page}')\" data-id=\"" + trip.TripRecordID + "\" data-toggle=\"modal\" data-target=\"#detail-modal\">"
      + "<i class=\"fa-solid fa-truck\"></i></a>";
      // アイテムの内容
      // これでアイテム内の情報は大体だせるようにはなったけど、問題は出す位置よな
      item.style.border = '2px solid #000000'
      return item;
    }

    // 表示する要素
    const container = document.getElementById('container'); // 例：idがcontainerの要素

    // クリックイベントリスナーを追加
    // container.addEventListener('click', (event) => {
    //   const x = event.clientX; // マウスカーソルのX座標　取りたいのはマウスじゃなくて画面のx座標なんだよなぁ　みつを
    //   const y = event.clientY; // マウスカーソルのY座標

    //   const item = createItem(x, y);
    //   container.appendChild(item);
    // });
</script>