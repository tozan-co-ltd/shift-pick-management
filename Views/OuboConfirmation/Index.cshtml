@using shift_pick_management.Commons;
@model shift_pick_management.Models.OuboConfirmationModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.ViewTitle;
}
<div class="card shadow de-inspection masterInfo m-4">
    <div class="card-header">
        @ViewData["Title"]
    </div>

    <div class="card-body">
        <div class="form-group col-sm-12 pl-3">
            <p id="div-error-message" class="mt-1 text-danger"></p>

            @if (ViewData["ErrorMessage"] != null)
            {
                <span class="mt-1 text-danger">@ViewData["ErrorMessage"]</span>
            }
        </div>

        <div class="mg-bot-20">
            <div class="col-16 sp-tablet mb-3">
                <div class="col-16 align-items-center unset-pdl sp-cs-dpl">
                    <div class="d-flex justify-content-start align-items-center mb-3 unset-pdl">
                        <span class="warehouse-name-drs span-paragraph">就業日付期間</span>
                        <input type="text" id="startOfPeriod" class="form-control pickerDate startDate">
                        <label class="m-1">～</label>
                        <input type="text" id="endOfPeriod" class="form-control pickerDate endDate mr-3">
                        <div class="input-group-append mr-3">
                            <a class="btn btn-secondary btn-icon-split" data-toggle="modal" data-target="#prefecture-modal">
                                <span class="text">都道府県選択</span>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-16 align-items-center unset-pdl sp-cs-dpl">
                    <div class="d-flex justify-content-start align-items-center mb-3 unset-pdl">
                        <span class="warehouse-name-drs span-paragraph">利用者ID</span>
                        <input type="text" class="form-control input-form">
                    </div>
                </div>
                <div class="col-16 align-items-center unset-pdl sp-cs-dpl">
                    <div class="d-flex justify-content-start align-items-center mb-3 unset-pdl">
                        <span class="warehouse-name-drs span-paragraph">名前</span>
                        <input type="text" class="form-control input-form">
                    </div>
                </div>
                <div class="col-16 d-flex justify-content-start align-items-center unset-pdl sp-cs-dpl">
                    <div class="d-flex justify-content-start align-items-center unset-pdl">
                        <span class="warehouse-name-drs span-paragraph">状況</span>
                        <div>
                            <label class="mr-5">
                                <input type="checkbox" class=" mr-2" name="situation" id="all" /><label for="all" class="mr-2">すべて</label>
                                <input type="checkbox" class=" mr-2" name="situation" id="preserve" /><label for="preserve" class="mr-2">予約</label>
                                <input type="checkbox" class=" mr-2" name="situation" id="entry" /><label for="entry" class="mr-2">エント</label>
                                <input type="checkbox" class=" mr-2" name="situation" id="confirm" /><label for="confirm" class="mr-2">確定</label>
                                <input type="checkbox" class=" mr-2" name="situation" id="ng" /><label for="ng" class="mr-2">NG</label>
                                <input type="checkbox" class=" mr-2" name="situation" id="hoshou" /><label for="hoshou" class="mr-2">補償</label>
                            </label>
                        </div>

                    </div>
                    <div class="input-group-append" style="margin-left:auto; max-width: 500px;">
                        <a class="btn btn-secondary btn-icon-split mr-2" onclick="onExportFileTrips('LoadOutput', '@Model.ViewTitle')" id="exportFile">
                            <span class="icon text-white-50">
                                <i class="fas fa-file-export"></i>
                            </span>
                            <span class="text">出力</span>
                        </a>
                        <a class="btn btn-secondary btn-icon-split" onclick="onSearchClick('LoadOutput')">
                            <span class="icon text-white-50">
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </span>
                            <span class="text">表示</span>
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
