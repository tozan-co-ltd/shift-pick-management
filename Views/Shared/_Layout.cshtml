@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@using System.Security.Claims
@using shift_pick_management.Commons;
@{
    var Model = new WebMenuModel();
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.ViewTitle;
}

<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Shift Pick (湘南プラス)</title>

    <!-- ▼ファビコン -->
    <link rel="icon" type="image/jpeg" href="~/images/ShounanPlus_Shift_Pick_AppIcon.jpg" asp-append-version="true">
    <link rel="apple-touch-icon" href="~/images/ShounanPlus_Shift_Pick_AppIcon.jpg" asp-append-version="true">

    <!-- ▼CSSファイル読み込み -->
    <!--Bootstrap admin template (Bootstrap 5.2 含む。site.css が --bs-border-color-translucent 等を参照)-->
    <link rel="stylesheet" href="~/lib/startbootstrap-sb-admin-gh-pages/css/styles.css" />
    <!-- font-awesome -->
    <link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <!-- datetimepicker-->
    <link href="~/css/datetimepicker.css" rel="stylesheet" />
    <!-- multidatespicker-->
    <link href="~/css/jquery-ui.multidatespicker.css" rel="stylesheet" />
    <!-- bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- sb-admin-2 -->
    <link href="~/css/sb-admin-2.css?@DateTime.Now" rel="stylesheet">
    <!-- dataTables-->
    <link rel="stylesheet" type="text/css" href="~/lib/datatables/jquery.dataTables.min.css">
    <!-- FixedColumns CSS -->
    <link rel="stylesheet" type="text/css" href="~/lib/datatables/fixedColumns.dataTables.min.css">
    <!-- 内部ファイル -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- 画面枠(サイドバー・トップバー) -->
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <!-- 日本語表示 -->
    <link rel="stylesheet" type="application/json" href="~/lib/datatables/Japanese.json">
    <!-- jquery-->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

</head>
@{
    /* 開発環境はナビゲーションバーを紫色に変更 */
    var wrapperClass = "";
    var navBarText = "Shift Pick (湘南プラス)";
#if DEBUG
    wrapperClass = "navbar-dark-test";
    navBarText = "テスト環境";
#endif
    var currentController = ViewContext.RouteData.Values["controller"].ToString();
}
<body id="page-top">

    <!-- Page Wrapper -->
    <div id="wrapper">

        <!-- Sidebar -->
        <ul class="navbar-nav bg-gradient-imagecolor sidebar sidebar-dark accordion" id="accordionSidebar">

            <div id="statemainicon">
                <!-- Sidebar - Brand -->
                <a id="home-title" class="sidebar-brand d-flex align-items-center justify-content-center" title="Home" asp-controller="OuboConfirmation" asp-action="Index">
                    <div class="sidebar-brand-icon">
                        <img src="~/images/ShounanPlus_Shift_Pick_AppIcon.jpg" asp-append-version="true" id="main-icon" />
                    </div>
                    <div class="sidebar-brand-text mx-3">@navBarText</div>
                </a>
            </div>

            <!-- Divider -->
            <hr class="sidebar-divider">

            @foreach (var category in Model.WebMenuCategoryList())
            {
                var categoryMenuList = Model.GetWebMenuCategoryList(category);
                var categoryName = categoryMenuList.M_WebMenuCategoryModel.CategoryName;
                var categoryID = categoryMenuList.M_WebMenuCategoryModel.CategoryID;
                var menuList = categoryMenuList.WebMenuList;
                if (menuList.Count != 0 && !(categoryID >= 4 && (Model.AuthorizedKubun != "1" && Model.AuthorizedKubun != "2")))
                {
                    <li class="nav-item">
                        <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapse@(categoryID)"
                           aria-expanded="true" aria-controls="collapse@(categoryID)">
                            <i class="icon-category @("icon-categoryid-" + categoryID)"></i>
                            <span>@(categoryName)</span>
                        </a>
                        <div id="collapse@(categoryID)" class="collapse" aria-labelledby="headingTwo" data-parent="#accordionSidebar">
                            <div class="bg-white py-2 collapse-inner rounded">
                                @foreach (var obj in menuList)
                                {
                                    <a class="collapse-item collapse-item-imagecolor @(obj.Controller == currentController ? "active" : "")" asp-area="" asp-controller="@obj.Controller" asp-action="@obj.Action">@obj.MenuName</a>
                                }
                            </div>
                        </div>
                    </li>
                }
            }

            <!-- Divider -->
            <hr class="sidebar-divider d-none d-md-block">

            <!-- Sidebar Toggler (Sidebar) -->
            <div class="text-center d-none d-md-inline">
                <button class="rounded-circle border-0" id="sidebarToggle"></button>
            </div>

        </ul>
        <!-- End of Sidebar -->
        <!-- Content Wrapper -->
        <div id="content-wrapper" class="d-flex flex-column">
            <div id="fadeLayer"></div>
            <!-- Main Content -->
            <div id="content">

                <!-- Topbar -->
                <nav class="navbar navbar-expand navbar-dark topbar static-top shadow @wrapperClass">

                    <!-- Sidebar Toggle (Topbar) -->
                    <button id="sidebarToggleTop" class="btn btn-link text-white d-md-none rounded-circle mr-3">
                        <i class="fa fa-bars"></i>
                    </button>

                    <!-- Topbar Navbar -->
                    <ul class="navbar-nav ml-auto">
                        <!-- Nav Item - User Information -->
                        <li class="nav-item dropdown no-arrow">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button"
                               data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <span class="mr-2 d-none d-lg-inline text-white small">@(User.Identity.IsAuthenticated ? User.FindFirst("UserName").Value : null)</span>
                                <i class="fas fa-user-circle fa-lg mr-2 text-white"></i>
                            </a>
                            <!-- Dropdown - User Information -->
                            <div class="dropdown-menu dropdown-menu-right shadow animated--grow-in"
                                 aria-labelledby="userDropdown">
                                <a class="dropdown-item text-center logout" href="#" data-toggle="modal" data-target="#logoutModal">
                                    <i class="fas fa-sign-out-alt fa-fw mr-2"></i>
                                    ログアウト
                                </a>
                            </div>
                        </li>
                    </ul>

                </nav>
                <!-- End of Topbar -->
                <!-- Begin Page Content -->
                <div id="index-page-area" class="container-fluid">
                    @RenderBody()
                </div>
            </div>
            <!-- End of Main Content -->
        </div>
        <!-- End of Content Wrapper -->
    </div>
    <!-- End of Page Wrapper -->


    <!-- Logout Modal-->
    <div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="logoutModalLabel"
         aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="logoutModalLabel">確認</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">ログアウトします。よろしいですか？</div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">キャンセル</button>
                    <a class="btn btn-accent" asp-area="" asp-controller="Login" asp-action="Logout">ログアウト</a>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>

    <!--Bootstrap admin template (SB Admin 2)-->
    <script src="~/js/sb-admin-2.js" asp-append-version="true"></script>

    <!--jQueryの動的validation-->
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <!--datepicker↓-->
    <script src="~/lib/jquery-detetimepicker/datetimepicker.js"></script>

    <!--multidatespicker↓-->
    <script src="~/lib/jquery-detetimepicker/jquery-ui.multidatespicker.js"></script>
    <script type="text/javascript" src="https://code.jquery.com/ui/1.12.0/jquery-ui.min.js"></script>

    <!--dataTables↓-->
    <script type="text/javascript" src="~/lib/datatables/datatables.min.js"></script>
    <script type="text/javascript" src="~/lib/datatables/jquery.dataTables.min.js"></script>
    <script type="text/javascript" src="~/lib/datatables/dataTables.fixedColumns.min.js"></script>
    <script type="text/javascript" src="~/lib/jquery-highlight/jquery.highlight.js"></script>
    <script type="text/javascript" src="~/lib/datatables/dataTables.searchHighlight.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.0/FileSaver.min.js"></script>

    <!--jquery.cookie.js-->
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery-cookie/1.4.1/jquery.cookie.min.js"></script>

    <!--paginating-->
    <script src="js/paginathing.min.js"></script>

    <!--d3.js-->
    <script src="https://d3js.org/d3.v5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.20.1/moment.min.js" type="text/javascript"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @* @await RenderSectionAsync("Scripts", required: false) *@
</body>
</html>


