<!DOCTYPE html>
<html lang="ja">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - スマホDE検品</title>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">

    <!-- ▼ファビコン -->
    <link rel="shortcut icon" type="image/png" href="~/images\webicon.png">
    <link rel="apple-touch-icon" sizes="180x180" href="~/images\webicon.png">

    <!-- ▼CSSファイル読み込み -->
    <link href="~/lib/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
          rel="stylesheet">
    <!-- 内部ファイル -->
    <link href="~/css/sb-admin-2.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body>
    <style>
        body,
        #wrapper {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .wrapper-bg-for-test {
            background-color: #F9C8E0; /* 開発環境は薄紫色 */
        }

        body {
            margin: 0;
            padding: 0;
            text-rendering: optimizeLegibility;
            font-kerning: normal;
            font-variant-ligatures: common-ligatures;
            font-feature-settings: "kern", "liga", "clig", "calt";
        }

        .main-content {
            display: flex;
            justify-content: center;
            margin: 0 auto;
            margin-top: 100px;
            padding: 0;
            border-radius: 20px;
            background-color: #ffffff;
            width: 400px;
            box-shadow: 0 2px 10px rgba(0, 0, 0, .4);
            overflow: hidden;
        }
    </style>

    @{
        /* 開発環境は背景を薄紫色に変更 */
        var wrapperClass = ViewData["IsDevelopment"];
        if (wrapperClass != null)
        {
            wrapperClass = "wrapper-bg-for-test";
        }
    }

    <div id="wrapper" class="@wrapperClass">
        <main>
            <div id="main-inner">
                @RenderBody()
            </div>
        </main>
    </div>
</body>
</html>