<!DOCTYPE html>
<html lang="ja">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - スマホDE検品</title>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">

    <!-- ▼ファビコン -->
    <link rel="shortcut icon" type="image/png" href="~/images\icon_app.png">
    <link rel="apple-touch-icon" sizes="180x180" href="~/images\icon_app.png">

    <!-- ▼CSSファイル読み込み -->
    <link href="~/lib/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
          rel="stylesheet">
    <!-- 内部ファイル -->
    <link href="~/css/sb-admin-2.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body>
    <style>
        body,
        #wrapper {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        footer {
            margin-top: auto;
            color: #9E9E9E;
        }

        .footer-inner {
            display: flex;
            justify-content: center;
        }

        body {
            margin: 0;
            padding: 0;
            background-color: var(--base-color-bg);
            text-rendering: optimizeLegibility;
            font-kerning: normal;
            font-variant-ligatures: common-ligatures;
            font-feature-settings: "kern", "liga", "clig", "calt";
        }

        .main-content {
            display: flex;
            justify-content: center;
            margin: 0 auto;
            margin-top: 100px;
            padding: 0;
            border-radius: 20px;
            background-color: #ffffff;
            width: 400px;
            box-shadow: 0 2px 10px rgba(0, 0, 0, .4);
            overflow: hidden;
        }

        .login-area {
            width: 280px;
            margin: 0;
            padding: 15px;
            color: #424242;
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
            text-align: center;
        }

        .system_logo img {
            max-width: 150px;
            max-height: 150px;
            background: #ffffff;
        }

        .system_title {
            font-size: large;
            font-weight: bolder;
            margin-bottom: 15px;
            color: var(--base-color-main);
        }

        .login-form {
            font-size: smaller;
            padding: 10px;
        }

        .text-danger {
            color: #F44336;
        }

        .tozan-logo img {
            width: 100%;
            display: block;
            margin: 10px auto;
        }

        .login-text {
            width: 100%;
            height: 40px;
            border: 1px solid #9E9E9E;
            border-radius: 15px;
            font-size: 14px;
            margin-bottom: 5px;
            -moz-box-sizing: border-box;
            -webkit-box-sizing: border-box;
            box-sizing: border-box;
        }

        .login-btn {
            width: 70%;
            height: 40px;
            border-radius: 40px;
            border: none;
            font-size: large;
            color: #ffffff;
            background-color: var(--base-color-accent);
            margin: 20px 0;
            cursor: pointer;
        }

        .login-title {
            margin-bottom: 40px;
        }

        .input-icon-with {
            position: relative;
        }

            .input-icon-with input {
                margin: 8px 0;
                padding: 0.3em;
                transition: 0.3s;
                outline: none;
            }

                .input-icon-with input:focus {
                    border-color: var(--base-color-main);
                }

            .input-icon-with input {
                padding-left: 40px;
            }

            .input-icon-with span {
                position: absolute;
                top: 8px;
                left: 0;
                padding: 9px 8px;
                transition: 0.3s;
                color: #aaaaaa;
            }

            .input-icon-with input:focus + span {
                color: var(--base-color-main);
            }

        .info-area {
            width: 50%;
            margin: 0;
            padding-top: 60px;
            color: #424242;
            background: rgb(92, 107, 192);
            background: linear-gradient(110deg, rgba(92, 107, 192, 1) 0%, rgba(79, 195, 247, 1) 100%);
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
            text-align: center;
        }

        .contact {
            display: inline-block;
            margin-top: 100px;
            padding: 10px;
            text-decoration: none;
            font-size: x-large;
            border-radius: 30px;
            box-shadow: 0 2px 10px rgba(0, 0, 0, .4);
            background: #FF5722;
        }

            .contact:visited,
            .contact:link {
                color: #ffffff;
            }

        @@media screen and (max-width: 480px) {
            .system_name {
                margin-bottom: 50px;
            }

            body {
                background: #ffffff;
            }

            .main-content {
                flex-wrap: wrap;
                margin-top: 0;
                width: 100%;
                color: #424242;
                background-color: #ffffff;
                box-shadow: none;
                border-radius: 0;
                -webkit-user-select: none;
                -moz-user-select: none;
                -ms-user-select: none;
                user-select: none;
            }

            .login-area,
            .info-area {
                width: 100%;
            }

            .info-area {
                padding-top: 10px;
            }

            .inner {
                max-width: 400px;
                margin: 0 auto;
            }

            .contact {
                margin-top: 30px;
            }
        }

        #no-ie {
            padding: 10px 20px;
            background: #FFAB40;
            display: none;
        }
    </style>

    <div id="wrapper">
        <main>
            <div id="main-inner">
                @RenderBody()
            </div>
        </main>
    </div>
</body>
</html>
