﻿@using shift_pick_management.Commons;
@model shift_pick_management.Models.LoadRecordViewModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.CategoryTitle + " - " + Model.ViewTitle;
}
<style>
    
</style>

<div class="card shadow de-inspection masterInfo m-4">
    <div class="card-header">
        @ViewData["Title"]
    </div>

    <div class="card-body">

        <div class="row">
            <div class="col-lg-10">
                <div class="card border-left-custom">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li>最長90日の期間が検索できます。</li>
                            <li>最大20件の便(便_枝番)を選択できます。</li>
                            <li>
                                便枝番とは、便が各拠点へ訪問した回数を示すために昼勤開始時間から順に割り当てた番号です。
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group col-sm-12 pl-3">
            <p id="div-error-message" class="mt-1 text-danger"></p>

            @if (ViewData["ErrorMessage"] != null)
            {
                <span class="mt-1 text-danger">@ViewData["ErrorMessage"]</span>
            }
        </div>

        <form id="LoadDistributionForm">
            <div class="span-paragraph mb-3">
                <div class="col-16 d-flex justify-content-start align-items-center unset-pdl sp-cs-dpl">
                    <div class="d-flex justify-content-start align-items-center unset-pdl">
                        <span class="warehouse-name-drs ">デポ</span>
                        <div style="font-weight: normal">
                            <label class="mr-2"><input type="checkbox" class=" mr-2" id="allDepo" />すべて  [</label>
                            <label id="selectDepos"></label>]
                        </div>
                    </div>
                </div>
            </div>
            <div class="span-paragraph mb-3">
                <div class="col-16 d-flex justify-content-start align-items-center unset-pdl sp-cs-dpl">
                    <div class="d-flex justify-content-start align-items-center unset-pdl">
                        <span class="warehouse-name-drs">期間</span>
                        <input type="text" id="startOfPeriod" class="form-control pickerDate startDate">
                        <label class="m-1">～</label>
                        <input type="text" id="endOfPeriod" class="form-control pickerDate endDate">
                    </div>
                    </div>
                </div>
            <div class="span-paragraph mb-3">
                <div class="col-16 d-flex justify-content-start align-items-center unset-pdl sp-cs-dpl">
                    <div class="d-flex justify-content-start align-items-center unset-pdl">
                        <span class="warehouse-name-drs ">便選択</span>
                        <div class="dropdown-container  mr-3" id="dropdownContainer">
                            <button class="dropdown-button btn btn-primary btn-icon-split btn-register" id="dropdownButton">
                                <span class="icon text-white-50">
                                    <i class="fas fa-plus"></i>
                                </span>
                                <span class="text">追加　　　</span>
                            </button>
                            <div class="dropdown-content" id="dropdownContent">
                                <div id="createToggleCheckBox">選択された稼働日にデータがありません</div>
                            </div>
                        </div>
                        <a href="#" class="btn btn-danger btn-icon-split btn-register mr-3" onclick="clearTrips()" id="clearTrips" style="visibility: hidden">
                            <span class="icon text-white-50">
                                <i class="fas fa-trash"></i>
                            </span>
                            <span class="text">一括クリア</span>
                        </a>
                    </div>

                </div>
                <div class="col-16 d-flex justify-content-start align-items-center  unset-pdl mr-3 sp-cs-dpl" >
                    <div class="d-flex justify-content-start align-items-center unset-pdl" id="selectedTrips0">
                        <span class="warehouse-name-drs"></span>
                    </div>
                </div>
                <div class="col-16 d-flex justify-content-start align-items-center unset-pdl mr-3 sp-cs-dpl">
                    <div class="d-flex justify-content-start align-items-center unset-pdl" id="selectedTrips1">
                        <span class="warehouse-name-drs"></span>
                    </div>
                </div>
                <div class="col-16 d-flex justify-content-start align-items-center unset-pdl mr-3 sp-cs-dpl" >
                    <div class="d-flex justify-content-start align-items-center unset-pdl" id="selectedTrips2">
                        <span class="warehouse-name-drs"></span>
                    </div>
                </div>
                <div class="col-16 d-flex justify-content-start align-items-center unset-pdl mr-3 sp-cs-dpl" >
                    <div class="d-flex justify-content-start align-items-center unset-pdl" id="selectedTrips3">
                        <span class="warehouse-name-drs"></span>
                    </div>
                </div>
            </div>
            
            <div class="span-paragraph mb-3">
                <div class="col-16 d-flex justify-content-start align-items-center unset-pdl sp-cs-dpl">
                    <div class="d-flex justify-content-start align-items-center unset-pdl">
                        <span class="warehouse-name-drs">荷量範囲</span>
                        <select type="text" id="minLoadStatus" class="form-select" name="minLoadStatus" style="width: 100px">
                            <option value="2" selected>0%</option>
                            <option value="3">1%</option>
                            <option value="4">11%</option>
                            <option value="5">21%</option>
                            <option value="6">31%</option>
                            <option value="7">41%</option>
                            <option value="8">51%</option>
                            <option value="9">61%</option>
                            <option value="10">71%</option>
                            <option value="11">81%</option>
                            <option value="12">91%</option>
                        </select>
                        <label class="m-1">～</label>
                        <select type="text" id="maxLoadStatus" class="form-select" name="maxLoadStatus" style="width: 100px">
                            <option value="2">0%</option>
                            <option value="3">10%</option>
                            <option value="4">20%</option>
                            <option value="5">30%</option>
                            <option value="6">40%</option>
                            <option value="7">50%</option>
                            <option value="8">60%</option>
                            <option value="9">70%</option>
                            <option value="10">80%</option>
                            <option value="11">90%</option>
                            <option value="12" selected>100%</option>
                        </select>
                    </div>
                </div>
            </div>
        </form>

        <div class="col-16 d-flex justify-content-start align-items-center mb-3 unset-pdl">
            <button type="submit" class="btn btn-secondary btn-icon-split" id="search-btn" onclick="onSearchClick('LoadDistribution')">
                <span class="icon text-white-50">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </span>
                <span class="text">検索　　　</span>
            </button>
        </div>

        <div class="graph-and-table" id="graphAndTable">
            <hr />
            <div class="col-16 d-flex align-items-center mb-3 unset-pdl">
                <div class="radio-group mr-3">
                    <div class="radio-area">
                        <input type="radio" id="arrivalChartButton" name="chartRadios" value="arrival" checked />
                        <label for="arrivalChartButton">到着荷量</label>
                    </div>
                    <div class="radio-area">
                        <input type="radio" id="departureChartButton" name="chartRadios" value="departure" />
                        <label for="departureChartButton">出発荷量</label>
                    </div>
                </div>
                <button class="btn btn-secondary print-btn mr-4" id="search-btn" onclick="window.print()" style="margin-left: auto;">
                    <span class="text"><i class="fa-solid fa-print"></i></span>
                </button>
            </div>

            <div class="print-area" id="print-area">
                <div class="chartjs-graph chartjs-arrival" id="arrivalChart">
                    <canvas id="binedabanChartArrival"></canvas>
                    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.3/Chart.bundle.min.js" integrity="sha512-vBmx0N/uQOXznm/Nbkp7h0P1RfLSj0HQrFSzV8m7rOGyj30fYAOKHYvCNez+yM8IrfnW0TCodDEjRqf6fodf/Q==" crossorigin="anonymous"></script>

                    <script>
                        var ctx = document.getElementById("binedabanChartArrival");
                        function adjustCanvasHeight() {
                            var canvas = document.getElementById("binedabanChartArrival");
                            var width = window.innerWidth;
                        }

                        window.addEventListener('resize', adjustCanvasHeight);

                        adjustCanvasHeight();

                        var arrivalChart = new Chart(ctx, {
                            type: 'bar',
                            data: {
                                labels: [],
                                datasets: []
                            },
                            options: {
                                //凡例は表示
                                legend: {
                                    display: true
                                },
                                scales: {
                                    //X軸
                                    xAxes: [{
                                        //軸ラベル表示
                                        scaleLabel: {
                                            display: true,
                                            labelString: '到着荷量(%)',
                                            fontSize: 24
                                        },
                                        ticks: {
                                            fontSize: 20
                                        }
                                    }],
                                    //Y軸
                                    yAxes: [{
                                        //軸ラベル表示
                                        scaleLabel: {
                                            display: true,
                                            labelString: '回数',
                                            fontSize: 24
                                        },
                                        //Y軸の範囲を指定
                                        ticks: {
                                            min: 0.0,
                                            stepSize: 1.0,
                                            fontSize: 20
                                        }
                                    }]
                                },
                                title: {
                                    display: true,
                                    text: '荷量分布',
                                    fontSize: 30
                                }
                            }
                        });
                    </script>
                </div>
                <div class="chartjs-graph chartjs-departure" id="departureChart">
                    <canvas id="binedabanChartDeparture"></canvas>
                    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.3/Chart.bundle.min.js" integrity="sha512-vBmx0N/uQOXznm/Nbkp7h0P1RfLSj0HQrFSzV8m7rOGyj30fYAOKHYvCNez+yM8IrfnW0TCodDEjRqf6fodf/Q==" crossorigin="anonymous"></script>

                    <script>
                        var ctx = document.getElementById("binedabanChartDeparture");
                        function adjustCanvasHeight() {
                            var canvas = document.getElementById("binedabanChartDeparture");
                            var width = window.innerWidth;
                        }

                        window.addEventListener('resize', adjustCanvasHeight);

                        adjustCanvasHeight();

                        var departureChart = new Chart(ctx, {
                            type: 'bar',
                            data: {
                                labels: [],
                                datasets: []
                            },
                            options: {
                                //凡例は表示
                                legend: {
                                    display: true
                                },
                                scales: {
                                    //X軸
                                    xAxes: [{
                                        //軸ラベル表示
                                        scaleLabel: {
                                            display: true,
                                            labelString: '出発荷量(%)',
                                            fontSize: 24
                                        },
                                        ticks: {
                                            fontSize: 20
                                        }
                                    }],
                                    //Y軸
                                    yAxes: [{
                                        //軸ラベル表示
                                        scaleLabel: {
                                            display: true,
                                            labelString: '回数',
                                            fontSize: 24
                                        },
                                        //Y軸の範囲を指定
                                        ticks: {
                                            min: 0.0,
                                            stepSize: 1.0,
                                            fontSize: 20
                                        }
                                    }]
                                },
                                title: {
                                    display: true,
                                    text: '荷量分布',
                                    fontSize: 30
                                }
                            }
                        });
                    </script>
                </div>
            </div>
            <hr />
            <div class="mg-bot-20 mt-3">
                <div class="col-12 d-flex xs-block justify-content-start align-items-center p-0">
                    <div class="input-group-append mr-1">
                        <a href="#" class="btn btn-info btn-icon-split" onclick="onExportFileTrips('LoadDistribution', '@Model.ViewTitle')" id="exportFile">
                            <span class="icon text-white-50">
                                <i class="fas fa-file-export"></i>
                            </span>
                            <span class="text">Excel出力</span>
                        </a>
                    </div>
                    <div class="input-group-append mr-3">
                        <a href="#" class="btn btn-info btn-icon-split" onclick="onExportAllImages('LoadDistribution')">
                            <span class="icon text-white-50">
                                <i class="fa-solid fa-circle-down"></i>
                            </span>
                            <span class="text">画像一括出力</span>
                        </a>
                    </div>
                </div>
            </div>
            <div class="mt-3" id="tripRecordTable"></div>
        </div>
    </div>
</div>

<!--  Detail Modal-->
<div class="modal fade" id="detail-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="spinner-box" id="loading-modal">
            <div class="three-quarter-spinner"></div>
        </div>
        <div class="modal-content trip-record-modal" id="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detail-modal-label"></h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="col-12 col-md-12">
                    <p id="edit-modal-error-message" class="mt-1 text-danger"></p>
                </div>
                <figure class="mb-2 modal-img"><img src="" id="modalImage" /></figure>
                <div id="tripRecord-buttons"></div>
                <table class="table table-sm p-2 modal-table">
                    <tbody id="tripRecord-contatiner">
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>

    const aryMax = function (a, b) { return Math.max(a, b); }
    const aryMin = function (a, b) { return Math.min(a, b); }

    let userName = "";
    $(document).ready(function () {
        model = @Html.Raw(Json.Serialize(Model));
        userName = model.userName;
        var today = new Date();
        var oneWeekAgo = new Date();
        oneWeekAgo.setDate(oneWeekAgo.getDate() - 7);
        $('#endOfPeriod').val(GetDayString(today));
        $('#startOfPeriod').val(GetDayString(oneWeekAgo));
        // グラフ非表示
        $('#graphAndTable').css('display', 'none');
        addDepos(model);
        depoCheckDisplay(model);
        periodChange('LoadDistribution');
    })

    // 期間の開始日付変更時
    $('#startOfPeriod').change(function () {
        periodChange('LoadDistribution');
    });

    // 期間の終了日時変更時
    $('#endOfPeriod').change(function () {
        periodChange('LoadDistribution');
    })

    // 検索ボタン押下時
    function onSearchClick(page) {
        event.preventDefault();
        DeleteErrorMessages();

        // 90日を超えるデータは検索不可
        if (!isWithin90Days()) {
            var errorMessage = 'E1007: 検索できる期間は最長90日です。90日を超えないように選択してください。';
            $("#div-error-message").text(errorMessage);
            return;
        }
        
        // 選択された便が0件の場合
        if(arrayTrips.length == 0){
            var errorMessage = 'E1017: 便を選択してください。';
            $("#div-error-message").text(errorMessage);
            return;
        }

        // グラフとテーブルの表示
        $('#graphAndTable').css('display', 'block');
        tableDisplay(page);

        // 初期表示は到着荷量
        $('input[value="arrival"]').prop('checked', true);
        $('#arrivalChart').css('display', 'block');
        $('#departureChart').css('display', 'none');

        // 期間の開始、終了日付の取得
        var startOfPeriod = GetDayString(new Date($('#startOfPeriod').val()));
        var endOfPeriod = GetDayString(new Date($('#endOfPeriod').val()));

        // 選択された荷量範囲を取得
        var minLoadClass = parseInt($('[name=minLoadStatus]').val());
        var maxLoadClass = parseInt($('[name=maxLoadStatus]').val());

        // グラフの初期化
        arrivalChart.data.datasets = [];
        departureChart.data.datasets = [];

        // グラフの表示期間設定
        var selectedStatuses = [];
        for (var i = minLoadClass; i <= maxLoadClass; i++) {
            if (i == 2) {
                selectedStatuses.push("0");
            }
            else {
                var loadStatusMin = (i - 3) * 10 + 1;
                var loadStatusMax = (i - 2) * 10;
                var loadStatus = loadStatusMin + "～" + loadStatusMax;
                selectedStatuses.push(loadStatus);
            }
        }
        arrivalChart.data.labels = selectedStatuses;
        departureChart.data.labels = selectedStatuses;

        // グラフの上部余白用
        var allArrivalDatasCount = [];
        var allDepartureDatasCount = [];

        // 選択された便、便枝番について
        for (var i = 0; i < arrayTrips.length; i++) {
            var tripName = arrayTrips[i].tripName;
            var tripBranchSeq = arrayTrips[i].tripBranchSeq

            // フォーム情報取得
            let url = window.location.origin + '@Url.Action("SearchDistributions", "LoadDistribution")';
            let method = 'Post';
            let data = { tripName: tripName, tripBranchSeq: tripBranchSeq, startOfPeriod: startOfPeriod, endOfPeriod: endOfPeriod, minLoadClass: minLoadClass, maxLoadClass: maxLoadClass };

            // Ajax call
            $.ajax({
                url: url,
                method: method,
                data: data,
                async: false
            }).done(function (response) {
                var arrivalLoadClasses = response.arrivalLoadClasses;
                var departureLoadClasses = response.departureLoadClasses;
                var arrivalLoadDatas = [];
                var departureLoadDatas = [];

                // 荷量クラスごとに配列に登録
                for (var j = minLoadClass; j <= maxLoadClass; j++) {
                    // 到着荷量の場合
                    if (arrivalLoadClasses.find(item => item.arrivalLoadClass == j)) {
                        var arrivalLoadClassCount = arrivalLoadClasses.find(item => item.arrivalLoadClass == j).arrivalLoadClassCount;
                        arrivalLoadDatas.push(arrivalLoadClassCount);
                        allArrivalDatasCount.push(arrivalLoadClassCount);
                    }
                    else {
                        arrivalLoadDatas.push("");
                    }
                    // 出発荷量の場合
                    if (departureLoadClasses.find(item => item.departureLoadClass == j)) {
                        var departureLoadClassCount = departureLoadClasses.find(item => item.departureLoadClass == j).departureLoadClassCount;
                        departureLoadDatas.push(departureLoadClassCount);
                        allDepartureDatasCount.push(departureLoadClassCount);
                    }
                    else {
                        departureLoadDatas.push("");
                    }
                }

                // データセット作成、登録
                var chartColor = graphColors[i];
                var label = tripName + "_" + tripBranchSeq;
                createAndPushDatasets(arrivalChart, chartColor, arrivalLoadDatas, label);
                createAndPushDatasets(departureChart, chartColor, departureLoadDatas, label);

            }).fail(function (jqXHR, textStatus, errorThrown) {
                if (jqXHR.status === 404) {
                    var errorMessage = jqXHR.responseJSON.errorMessage;
                    $("#div-error-message").text(errorMessage);
                } else {
                    var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                    $("#div-error-message").text(errorMessage);
                }
            });
        }
        // グラフの上部に余白作成
        if (allArrivalDatasCount.length > 0) {
            var maxCountArrivalData = allArrivalDatasCount.reduce(aryMax);
            arrivalChart.options.scales.yAxes[0].ticks.max = maxCountArrivalData + 1;
        }
        if (allDepartureDatasCount.length > 0) {
            var maxCountDepartureData = allDepartureDatasCount.reduce(aryMax);
            departureChart.options.scales.yAxes[0].ticks.max = maxCountDepartureData + 1;
        }

        // グラフの更新
        arrivalChart.update();
        departureChart.update();
    }

    // chartjs用のデータセット作成
    function createChartDatasets(color) {
        var datasets = {
            label: '',
            borderColor: color,
            data: [],
            backgroundColor: color,
        }
        return datasets;
    }

    // ラジオボタン切り替え時
    $(function () {
        $('input[name="chartRadios"]:radio').change(function () {
            event.preventDefault();
            var radioval = $(this).val();
            if (radioval == "arrival") {
                $('#arrivalChart').css('display', 'block');
                $('#departureChart').css('display', 'none');
            }
            else {
                $('#departureChart').css('display', 'block');
                $('#arrivalChart').css('display', 'none');
            }
        })
    })

    // 便実績テーブル表示
    function tableDisplay(page) {
        // 期間の開始、終了日付の取得
        var startOfPeriod = GetDayString(new Date($('#startOfPeriod').val()));
        var endOfPeriod = GetDayString(new Date($('#endOfPeriod').val()));

        // 選択された荷量範囲を取得
        var minLoadClass = parseInt($('[name=minLoadStatus]').val());
        var maxLoadClass = parseInt($('[name=maxLoadStatus]').val());

        let data = { models: arrayTrips, startOfPeriod: startOfPeriod, endOfPeriod: endOfPeriod, minLoadClass: minLoadClass, maxLoadClass: maxLoadClass };
        
        tableDisplayCommon(page, data)
    }

    // 画像一括出力ボタン押下
    function onExportAllImages(page) {
        event.preventDefault();
        DeleteErrorMessages();
        if (isWithin90Days()) {
            // 期間の開始、終了日付の取得
            var startOfPeriod = GetDayString(new Date($('#startOfPeriod').val()));
            var endOfPeriod = GetDayString(new Date($('#endOfPeriod').val()));

            // 選択された荷量範囲を取得
            var minLoadClass = parseInt($('[name=minLoadStatus]').val());
            var maxLoadClass = parseInt($('[name=maxLoadStatus]').val());

            // デポ情報取得
            var checkedDepos = getCheckedDepos();

            let data = {
                download: "download",
                startOfPeriod: startOfPeriod,
                endOfPeriod: endOfPeriod,
                "arrayTrips": arrayTrips,
                minLoadClass: minLoadClass,
                maxLoadClass: maxLoadClass,
                checkedDepos: checkedDepos
            };
            
            onExportAllImagesCommon(page, data);
        }
        else {
            var errorMessage = 'E1007: 検索できる期間は最長90日です。90日を超えないように選択してください。';
            $("#div-error-message").text(errorMessage);
        }
    }

    // Excel出力
    async function onExportFileTrips(page, gamenName) {
        DeleteErrorMessages();
        if (isWithin90Days()) {

            // チェックボックスの入力情報
            var checkBox = false;

            // 期間の開始、終了日付の取得
            var startOfPeriod = GetDayString(new Date($('#startOfPeriod').val()));
            var endOfPeriod = GetDayString(new Date($('#endOfPeriod').val()));

            // 選択された荷量範囲を取得
            var minLoadClass = parseInt($('[name=minLoadStatus]').val());
            var maxLoadClass = parseInt($('[name=maxLoadStatus]').val());

            // デポ情報取得
            var checkedDepos = getCheckedDepos();

            // フォーム情報取得
            let data = {
                "gamenName": gamenName,
                "startofPeriod": startOfPeriod,
                "endOfPeriod": endOfPeriod,
                "isOnlyHasAmountDefference": checkBox,
                "arrayTrips": arrayTrips,
                "minLoadClass": minLoadClass,
                "maxLoadClass": maxLoadClass,
                "checkedDepos": checkedDepos
            };
            // Excel出力共通処理
            onExportFileTripsCommon(page, data);
        }
        else {
            var errorMessage = 'E1007: 検索できる期間は最長90日です。90日を超えないように選択してください。';
            $("#div-error-message").text(errorMessage);
        }
    }

    const dropdownButton = document.getElementById('dropdownButton');
    const dropdownContainer = document.getElementById('dropdownContainer');
    const dropdownContent = document.getElementById('dropdownContent');

    // ドロップダウンの表示・非表示
    dropdownButton.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropdownContainer.classList.toggle('show');
    });

    // コンテンツ外をクリックした場合、プルダウンを閉じる
    document.addEventListener('click', (e) => {
        if (!dropdownContainer.contains(e.target)) {
            dropdownContainer.classList.remove('show');
        }
    });


    function allToggleOpen() {
        event.preventDefault();
        // 中項目のヘッダーをクリックで小項目を表示/非表示
        let mediumHeaders = dropdownContent.querySelectorAll('.medium-header');
        mediumHeaders.forEach(header => {
            const smallItems = header.nextElementSibling;
            const toggleIcon = header.querySelector('.toggle-icon');
            if (!smallItems.classList.contains('show')) {
                smallItems.classList.add('show');
                toggleIcon.classList.remove('collapsed');
            }
        });
    }

    function allToggleClose() {
        event.preventDefault();
        // 中項目のヘッダーをクリックで小項目を表示/非表示
        let mediumHeaders = dropdownContent.querySelectorAll('.medium-header');
        mediumHeaders.forEach(header => {
            const smallItems = header.nextElementSibling;
            const toggleIcon = header.querySelector('.toggle-icon');
            if (smallItems.classList.contains('show')) {
                smallItems.classList.remove('show');
                toggleIcon.classList.add('collapsed');
            }
        });
    }

    // 「すべて」チェックボックス押下時
    $('input[id=allDepo]').change(function () {
        pushAllCheckBox();
        periodChange('LoadDistribution')
    });

    // 各デポチェックボックス押下時
    $(function () {
        $('input[name="depos"]').change(function () {
            pushDepoCheckBox();
            periodChange('LoadDistribution')
        });
    })

</script>