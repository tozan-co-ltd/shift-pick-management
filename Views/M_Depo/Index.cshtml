@using mar_sumaken_web.Commons;
@model mar_sumaken_web.Models.M_DepoModel
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.CategoryTitle + " - " + Model.ViewTitle;
}
<style type="text/css">
    .btn-register {
        min-width: 130px !important;
    }
</style>

<div class="card shadow de-inspection masterInfo m-4">
    <div class="card-header text-gray-800">
        @ViewData["Title"]
    </div>
    <div class="card-body">
        @if (ViewData["ErrorMessage"] != null || ViewData["Message"] != null)
        {
            <div id="div-message" class="mb-3 ml-3 text-danger">
                <span class="text-danger-custom">@ViewData["ErrorMessage"] </span>
                <span class="text-success-custom">@ViewData["Message"] </span>
            </div>
        }
        <div class="mg-bot-20">
            <div class="col-12 d-flex xs-block justify-content-start align-items-center p-0">
                <div class="input-group-append mr-2">
                    <a class="btn btn-primary btn-icon-split btn-register" asp-controller="M_Depo" asp-action="Register">
                        <span class="icon text-white-50">
                            <i class="fas fa-plus"></i>
                        </span>
                        <span class="text">新規作成</span>
                    </a>
                </div>
                <div class="input-group-append">
                    <a href="#" class="btn btn-info btn-icon-split" onclick="onExportFile('M_Depo')">
                        <span class="icon text-white-50">
                            <i class="fas fa-file-export"></i>
                        </span>
                        <span class="text">出力</span>
                    </a>
                </div>
            </div>
        </div>
        <div class="mt-3">
            <table class="table table-sm stripe hover nowrap datatable-normal">
                <thead>
                    <tr>
                        <th width="40"></th>
                        <th class="font-weight-bold">ID</th>
                        <th class="font-weight-bold">倉庫コード</th>
                        <th class="font-weight-bold">倉庫名</th>
                        <th class="font-weight-bold">更新日時</th>
                        <th class="font-weight-bold">更新者</th>
                    </tr>
                </thead>
                <tbody>
                    @if (@Model.M_DepoList != null)
                    {
                        @foreach (var item in @Model.M_DepoList)
                        {
                            <tr>
                                <td>
                                    <a class="btn btn-success btn-icon-split ml-1 mr-1" asp-controller="M_Depo" asp-action="Edit" asp-route-id="@item.DepoID">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <button class="btn btn-danger btn-icon-split"
                                            onclick="OnDeleteClick('@item.DepoID')" data-id="@item.DepoID" data-toggle="modal" data-target="#DepoDeleteModal">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </td>
                                <td>@item.DepoID</td>
                                <td>@item.DepoCode</td>
                                <td>@item.DepoName</td>
                                <td>@item.UpdatedAt</td>
                                <td>@item.UpdatedBy</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!--  Delete Modal-->
<div class="modal fade" id="DepoDeleteModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="DepoDeleteModalLabel">削除</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="col-12 col-md-10">
                    <p id="import-res" class="mt-1"></p>
                </div>
                <div class="d-flex justify-content-center">
                    <div class="col-12 col-md-10">
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4 col-md-4">
                                <label>ID</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-7 mb-2">
                                <input class="form-control" id="deleteDepoId" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4 col-md-4">
                                <label>倉庫コード</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-7 mb-2">
                                <input class="form-control" id="deleteDepoCode" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4 col-md-4">
                                <label>倉庫名</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-7 mb-2">
                                <input class="form-control" id="deleteDepoName" type="text" disabled>
                            </div>
                        </div>
                    </div>
                </div>
                
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

    // 削除ボタン押下
    function OnDeleteClick(DepoID) {
        // M_DepoModel取得
        var DepoModel = @Html.Raw(Json.Serialize(Model));
        DepoModel.forEach(function (item) {
            // 倉庫IDが一致する情報のみ取得
            if (item.DepoID == DepoID) {
                $("#deleteDepoId").val(item.DepoID);
                $("#deleteDepoCode").val(item.DepoCode);
                $("#deleteDepoName").val(item.DepoName);
            }
        });
    }

    // 削除
    function OnExecuteDelete() {
        $('#div-error-message').text("");
        $('#import-res').text("");

        // POSTするデータ
        var DepoId = document.getElementById('deleteDepoId').value;
        formData = {
            "DepoId" : DepoId
        };
        
        // ajax
        $.ajax({
            url: window.location.origin + '@Url.Action("Delete", "M_Depo")',
            method: "POST",
            data: formData
        })
        .done(function (data) {
            // 完了モーダル表示
            $('#DepoDeleteModal').modal('hide');
            $('#DepoDeleteModal').hide();
            AlertMessage('', '完了', '削除が完了しました。', null, null);
        })
        .fail(function (xhr) {
            if (xhr.status === 404) {
                // データが見つからなかった場合
                var errorMessage = xhr.responseJSON.errorMessage;
                $("#div-error-message").hide();
                $("#import-res").show();
                $("#import-res").addClass('text-danger');
                $("#import-res").text("エラー: " + errorMessage);
            } else {
                // その他のエラーの場合
                $("#div-error-message").hide();
                $("#import-res").show();
                $("#import-res").addClass('text-danger');
                $("#import-res").text("削除が失敗しました。");
            }
        });
    }

</script>