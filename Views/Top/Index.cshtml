@using X.PagedList
@model mar_sumaken_web.Models.D_HandyErrorMessageModel

@{
    ViewData["Title"] = "トップ";
}
<style type="text/css">
    .menu-top .card-body {
        width: 100%;
    }

    .menu-top .pdf-list ul li {
        margin-right: 5px;
    }

    .menu-top .border-left-custom {
        border-right: none;
        border-left: none;
    }

    .menu-top .btn-info {
        color: white;
        background-color: gray;
        border-color: darkgray;
    }

    .menu-top .btn-info.btn-icon-split {
        /* min-width: 100px; */
        margin-right: 10px;
    }

    #handyErrorTbl th {
        white-space: nowrap;
    }
</style>
<div class="card shadow m-4">
    <div class="card-header text-gray-800">
        @ViewData["Title"]
    </div>

    <div class="chart-part p-2 col-12 d-flex">
        <div class="col-6 d-flex" id="donut-chart"></div>
        <div class="col-6 d-flex justify-content-center">
            <canvas id="myDoughnutChart" width="300" height="150"></canvas>
        </div>
    </div>

    <div class="handy-error-tbl card-body">
        <div class="row">
            <div class="col-lg-12">
                <div class="border-left-custom">
                    <div class="card-body">
                        <p>ハンディエラーメッセージ履歴(直近1週間)</p>
                        <div class="tableContent mt-10">
                            <table class="table table-sm row-border compact stripe hover nowrap order-column" id="handyErrorTbl">
                                <thead>
                                    <tr>
                                        <th width="5%"></th>
                                        <th width="10%" class="font-weight-bold">取込日時</th>
                                        <th width="20%" class="font-weight-bold">ハンディメニュー名</th>
                                        <th width="50%" class="font-weight-bold">エラーメッセージ</th>
                                        <th width="10%" class="font-weight-bold">登録者</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (@Model != null && @Model.D_HandyErrorMessageList != null && @Model.D_HandyErrorMessageList.Count > 0)
                                    {
                                        @foreach (var item in @Model.D_HandyErrorMessageList)
                                        {
                                            <tr>
                                                <td class="d-flex justify-content-center">
                                                    <button class="btn btn-secondary btn-icon-split" onclick="OnDetailErrorClick('@item.HandyErrorMessageID')">
                                                        <i class="fa-solid fa-list"></i>
                                                    </button>
                                                </td>
                                                <td>@item.ReadingTime</td>
                                                <td>@item.HandyMenuName</td>
                                                <td>@item.ErrorMessage</td>
                                                <td>@item.CreatedBy</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="system-manual p-2">
            <div id="pdf-list">
                <p>システムマニュアル</p>
                <ul>
                    <li>
                        <a href="javascript:void(0);" onclick="navigate('')">
                            <i class="fa-solid fa-file"></i> スマホDE検品ハンディアプリマニュアル.pdf
                        </a>
                    </li>
                    <li>
                        <a href="javascript:void(0);" onclick="navigate('')">
                            <i class="fa-solid fa-file"></i> スマホDE検品ハンディアプリマニュアル.pdf
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="~/lib/billboard/billboard.css">
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://d3js.org/d3.v6.min.js"></script>
<script src="~/lib/billboard/billboard.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

    document.addEventListener("DOMContentLoaded", function () {
        // billboard
        let chart = bb.generate({
            data: {
                columns: [
                    ["Blue", 60],
                    ["orange", 240],
                ],
                type: "donut"
            },
            title: {
                text: "出荷検品表"
            },
            size: {
                width: 300,
                height: 150
            },
            donut: {
                title: "70%",
                label: {
                    format: function (value, ratio, id) { return value; },
                    ratio: 1,
                }
            },
            legend: {
                position: "right",
            },
            bindto: "#donut-chart",
        });

        // chartjs
        var data = {
            labels: ["Label 1", "Label 2"],
            datasets: [{
                data: [240, 60],
                backgroundColor: ["orange", "Blue"]
            }]
        };
        const config = {
            type: 'doughnut',
            data: data,
            options: {
                responsive: false, 
                width: 300,       
                height: 150,  
                plugins: {
                    legend: {
                        position: 'right',
                    },
                    title: {
                        display: true,
                        text: '出荷検品表'
                    },
                    datalabels: {
                        color: '#000',
                        align: 'end',
                        anchor: 'end',
                        formatter: function (value, context) {
                            return context.chart.data.labels[context.dataIndex];
                        },
                        font: {
                            size: 16,
                            style: 'bold',
                        }
                    }
                },
            },
            plugins: [
                {
                    //afterDraw: function (chart) {
                    //    var width = chart.width,
                    //        height = chart.height,
                    //        ctx = chart.ctx;

                    //    var centerX = width / 2 - 52;
                    //    var centerY = height / 2 + 20;
                    //    var text = "100%";

                    //    ctx.font = "14px Arial";
                    //    ctx.fillStyle = "black";
                    //    ctx.textAlign = "center";
                    //    ctx.textBaseline = "middle";
                    //    ctx.fillText(text, centerX, centerY);
                    //}
                }
            ]
        };
        var ctx = document.getElementById("myDoughnutChart").getContext("2d");
        var myDoughnutChart = new Chart(ctx, config);

    });

    function OnDetailErrorClick(id) {
        alert(id);
    }

    function navigate(url) {
        window.location.href = url;
    }


</script>
