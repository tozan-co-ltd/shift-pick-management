@using ai_truck_load_measurement.Commons;
@model ai_truck_load_measurement.Models.TopModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = "トップ";
}
<style>
    /* カードレイアウト部分をラッピングし、
    Flexboxを指定"space-between"で各アイテムを均等に配置し、
    最初と最後のアイテムを端に寄せます。*/
    #cardlayout-wrap {
        position: relative;
        display: -webkit-box;
        display: -ms-flexbox;
        display: flex;
        -ms-flex-pack: justify;
        margin: 2em auto;
        width: 100%;
        -ms-flex-wrap: wrap;
        flex-wrap: wrap;
        -webkit-box-pack: justify;
        justify-content: space-between;
    }

    

    /* カードレイアウト内の画像を幅いっぱいに表示 */
    #cardlayout-wrap img {
        display: block;
        max-width: 100%;
        height: auto;
        margin: auto;
    }

    .card-figure {
        margin: 0 0 0;
        padding: 0.5em;
    }

    /* カードレイアウトのタイトル部分 */
    .card-title {
        margin: 0 0 0;
        color: #333;
        text-align: center;
        font-size: 3.0em;
        font-weight: bold;
    }

    /* カードレイアウトの説明文部分 */
    .created-at {
        margin: 0 0.5em 0;
        color: #493511;
        text-align: center;
    }

    .station-number{
        margin: 0;
        padding: 0.5em;
        color: #493511;
        font-size: 1.4em;
    }

    .truck-status{
        color: #493511;
        text-align: center;
        font-weight: bold;
        font-size: 1.5em;
    }

    .card-list {
        margin: 0.5em auto;
        padding: 0;
        width: calc(96% / 3); /* 96%幅を3で割るという指定 */
        background: #ffffff;
        box-shadow: 0 0 5px rgba(0, 0, 0, 0.5);
        border-radius: 10px;
    }

    .top-title {
        color: #493511;
        font-size: 1.8em;
    }

    .btn-update:not(:disabled):not(.disabled):active, .btn-update:not(:disabled):not(.disabled).active,
    .show > .btn-update.dropdown-toggle {
        background-color: #1CC88A !important; 
        border: #1CC88A !important;
        color: #ffffff !important;
    }

    .btn-update{
        background-color: #1CC88A;
        border: #1CC88A;
        color:#ffffff;
    }
    .btn-update:hover{
            background-color: #1CC88A;
            border: #1CC88A;
            color: #ffffff;
    }
</style>
<div class="card shadow de-inspection m-4">
    <div class="card-header">
        @ViewData["Title"]
    </div>

    <div class="card-body">
        @if (ViewData["ErrorMessage"] != null)
        {
            <span class="mt-1 text-danger">@ViewData["ErrorMessage"]</span>
        }
        <p class="mb-3 top-title" id="stationTitle"></p>
        <div class="col-16 d-flex justify-content-start align-items-center unset-pdl sp-cs-dpl">
            <div class="d-flex justify-content-start align-items-center mb-3 unset-pdl">
                <span class="warehouse-name-drs span-paragraph">デポ選択</span>
                <div>
                    <div id="selectDepos"></div>
                    <div class="col-12">
                        <select class="form-select" name="DepoID"  asp-items="@Model.MDepoList" id="selectDepo"></select>
                    </div>
                </div>
            </div>
        </div>
        <div class="mb-3">
            <button class="btn btn-update mr-2" onclick="onUpdateClick()" id="updateStation">更新</button>
            <label class="mb-2" id="updateAt">更新日時:@DateTime.Now.ToString("yyyy/MM/dd hh:mm:ss")</label>
        </div>
        <div>
            <button class="btn btn-secondary btn-icon-split" onclick="onUpdateClick()" id="figureButton" data-toggle="modal" data-target="#map-modal">
                <span class="icon text-white-50">
                    <i class="fa-solid fa-map"></i>
                </span>
                <span class="text">配置図</span>
            </button>
        </div>
        <div id="cardlayout-wrap">
            <!-- カードレイアウトをラッピング -->
        </div>
            <!-- カードレイアウトをラッピング -->
    </div>
</div>

<!--  map Modal-->
<div class="modal fade" id="map-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content trip-record-modal" style="width: 200%; left:-50%">
            <div class="modal-header">
                <h5 class="modal-title" id="detail-modal-label">カメラ配置図</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <figure class="mb-2 modal-img"><img src="" id="modalImage" /></figure>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        // モデル取得
        var top_model = @Html.Raw(Json.Serialize(Model));
        viewCards(top_model);
        window.setInterval(function () {
            onUpdateClick();
        }, 60000);
        $("#selectDepo").find("option[value='" + top_model.mainDepoID + "']").attr("selected", "selected");
        if(top_model.mainDepoName != ""){
            console.log($("#stationTitle"));
            $("#stationTitle")[0].innerText = getStationTitle(top_model.mainDepoName);
            $('#modalImage').attr("src", window.location.href + "/images/top/layout/depo" + top_model.mainDepoID + "layout.png");
        }
    });

    function viewCards(top_model) {
        var now = GetDateString(new Date());
        // 更新日時の更新
        $('#updateAt').text("更新日時:" + now + ':' + ('0' + new Date().getSeconds()).slice(-2));
        // カード要素の初期化
        $("#cardlayout-wrap")[0].innerHTML = "";
        for (var i = 1; i <= top_model.viewCardModelList.length; i++) {
            var cardModel = top_model.viewCardModelList.find(x => x.stationSeq == i);

            // カード要素生成
            $("#cardlayout-wrap")[0].innerHTML += 
                    "<section class=\"card-list\">"
                 +      "<p class=\"station-number\" > ステーション" + i + " </p>"
                 +      "<h2 class=\"card-title\" id = \"card-title" + i + "\" > </h2>"
                 +      "<p class=\"truck-status\" id = \"truck-status" + i + "\" > </p>"
                 +      "<figure class=\"card-figure\" > <img src=\"\" id = \"image" + i +"\" > </figure>"
                 +  "</section>";

            // カード要素設定
            if (cardModel.truckExist) {
                $('#card-title' + i).text("停車");
                $('#card-title' + i).css("color", "#000000");
            }
            else {
                $('#card-title' + i).text("空車");
                $('#card-title' + i).css("color", "#1CC88A");
            }

            $('#truck-status' + i).text(cardModel.truckStatus);
            
            $('#image' + i).attr("src", cardModel.imageBase64);
        }
    }

    function onUpdateClick(){
        DeleteErrorMessages();

        var depoID = $('select[id="selectDepo"]')[0].value;

        // フォーム情報取得
        let url = window.location.origin + '@Url.Action("GetTopModel", "Top")';
        let method = 'Get';
        let data = { depoID: depoID };

        // Ajax call
        $.ajax({
            url: url,
            method: method,
            data: data
        }).done(function (response) {
            viewCards(response);
        }).fail(function (jqXHR, textStatus, errorThrown) {
            if (jqXHR.status === 404) {
                var errorMessage = jqXHR.responseJSON.errorMessage;
                $("#edit-modal-error-message").text(errorMessage);
            } else {
                var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                $("#edit-modal-error-message").text(errorMessage);
            }
        });
    }

    // デポ選択時
    $(function () {
        $('select[id="selectDepo"]').change(function () {
            var depo = $('select[id="selectDepo"]')[0];
            var selectedDepoID = 0;
            for(var i=0; i < depo.length; i++){
                if(depo[i].selected){
                    $("#stationTitle")[0].innerText = getStationTitle(depo[i].innerText);
                    selectedDepoID = depo[i].value;
                    $('#modalImage').attr("src", "/images/top/layout/depo" + depo[i].value + "layout.png");
                }
            }
            onUpdateClick();

        });
    })

    function getStationTitle(depoName){
        if(depoName == null){
            return "ステーション状況";
        }
        else{
            return depoName + "　ステーション状況";
        }
    }

</script>

