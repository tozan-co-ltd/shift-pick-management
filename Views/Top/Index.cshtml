@using mar_sumaken_web.Commons;
@model mar_sumaken_web.Models.D_HandyErrorMessageModel.D_HandyErrorMessage
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.ViewTitle;
}
<style>
    .bb-chart-arcs-title {
        font-size: 1.7em !important;
        font-weight: bold;
    }
</style>
<div class="card shadow de-inspection m-4">
    <div class="card-header text-gray-800">
        @ViewData["Title"]
    </div>

    <div class="card-body">
        <p>作業進捗(2023-01-01)</p>
        <div class="chart-part p-2 col-12 d-flex">
            <div class="col-6 d-flex" id="donut-chart"></div>
        </div>

        <div class="p-0">
            <div class="row col-lg-12">
                <div class="card-body pb-0">
                    <p>ハンディエラーメッセージ履歴(直近1週間)</p>
                    <div class="mt-10">
                        <table class="table table-sm stripe hover nowrap datatable-normal">
                            <thead>
                                <tr>
                                    <th width="5%"></th>
                                    <th width="10%" class="font-weight-bold">読取日時</th>
                                    <th width="20%" class="font-weight-bold">ハンディメニュー名</th>
                                    <th width="50%" class="font-weight-bold">エラーメッセージ</th>
                                    <th width="10%" class="font-weight-bold">登録者</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (@Model != null && @Model.D_HandyErrorMessageList != null && @Model.D_HandyErrorMessageList.Count > 0)
                                {
                                    @foreach (var item in @Model.D_HandyErrorMessageList)
                                    {
                                        <tr>
                                            <td class="d-flex justify-content-center">
                                                <button class="btn btn-secondary btn-icon-split" onclick="OnDetailClick('@item.HandyErrorMessageID')">
                                                    <i class="fa-solid fa-list"></i>
                                                </button>
                                            </td>
                                            <td>@item.CreatedAt</td>
                                            <td>@item.HandyMenuName</td>
                                            <td>@item.ErrorMessage</td>
                                            <td>@item.CreatedBy</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card-body pt-0">
                <div id="pdf-list">
                    <p>システムマニュアル</p>
                    <ul>
                        <li>
                            <a href="javascript:void(0);" onclick="navigate('')">
                                <i class="fa-solid fa-file"></i> スマホDE検品ハンディアプリマニュアル.pdf
                            </a>
                        </li>
                        <li>
                            <a href="javascript:void(0);" onclick="navigate('')">
                                <i class="fa-solid fa-file"></i> スマホDE検品ハンディアプリマニュアル.pdf
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="~/lib/billboard/billboard.css">
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://d3js.org/d3.v6.min.js"></script>
<script src="~/lib/billboard/billboard.js"></script>

<script>

    document.addEventListener("DOMContentLoaded", function () {
        // 作業進捗表示
        let shipmentList = [
            ["検品済数", 60],
            ["未検品数", 240],
        ];

        let percentage = 240 / (60 + 240) * 100;
        let donutTitle = percentage + "%";

        let chart = bb.generate({
            data: {
                columns: shipmentList,
                type: "donut"
            },
            title: {
                text: "出荷検品数"
            },
            size: {
                width: 300,
                height: 180
            },
            donut: {
                title: donutTitle,
                label: {
                    format: function (value, ratio, id) { return value; },
                    ratio: 1,
                }
            },
            legend: {
                position: "right",
            },
            bindto: "#donut-chart",
        });

        var ctx = document.getElementById("myDoughnutChart").getContext("2d");
        var myDoughnutChart = new Chart(ctx, config);
    });

    function OnDetailClick(id) {
        alert(id);
    }

    function navigate(url) {
        window.location.href = url;
    }


</script>
