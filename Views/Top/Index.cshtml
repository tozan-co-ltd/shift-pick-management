@using mar_sumaken_web.Commons;
@model mar_sumaken_web.Models.TopModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.ViewTitle;
}
<style>
    .bb-chart-arcs-title {
        font-size: 1.7em !important;
        font-weight: bold;
    }

    .manual-icon{
        padding-right:2px;
        color: var(--base-color-main);
    }

    a.manual-link {
        text-decoration: none;
        color: var(--fontcolor);
    }

    a.manual-link:hover {
            color: var(--base-color-main);
    }
</style>
<div class="card shadow de-inspection m-4">
    <div class="card-header text-gray-800">
        @ViewData["Title"]
    </div>

    <div class="card-body">
        @if (ViewData["ErrorMessage"] != null)
        {
            <span class="mt-1 text-danger">@ViewData["ErrorMessage"]</span>
        }
        <p class="mb-0">出荷作業進捗(@Model.DepoName)</p>
        <div class="chart-part p-2 col-12 d-flex">
            <div class="col-6 d-flex" id="donut-chart"></div>
        </div>
        <hr />
        <p>ハンディエラーメッセージ履歴(直近1週間)</p>
        <div class="row col-lg-12">
            <div class="mt-10">
                <table class="table table-sm stripe hover nowrap datatable-handyErrorMessage">
                    <thead>
                        <tr>
                            <th width="5%"></th>
                            <th width="10%" class="font-weight-bold">読取日時</th>
                            <th width="20%" class="font-weight-bold">ハンディメニュー名</th>
                            <th width="50%" class="font-weight-bold">エラーメッセージ</th>
                            <th width="10%" class="font-weight-bold">登録者</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (@Model != null && @Model.D_HandyErrorMessageList != null)
                        {
                            @foreach (var item in @Model.D_HandyErrorMessageList)
                            {
                                <tr>
                                    <td>
                                        <button class="btn btn-secondary btn-icon-split" title="詳細"
                                                onclick="OnDetailClick('@item.HandyErrorMessageID')" data-id="@item.UserID" data-toggle="modal" data-target="#detail-modal">
                                            <i class="fa-solid fa-list"></i>
                                        </button>
                                    </td>
                                    <td>@item.CreatedAt</td>
                                    <td>@item.HandyMenuName</td>
                                    <td>@item.ErrorMessage</td>
                                    <td>@item.CreatedBy</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <hr />
        <div id="pdf-list">
            <p>システムマニュアル</p>
            <ul>
                <li>
                    <a class="manual-link" target="_blank" href="~/manual/在庫管理システム_操作マニュアル(はじめにお読みください)_ver1.0.pdf">
                        <i class="fa-solid fa-file manual-icon"></i> スマホDE検品ハンディアプリマニュアル.pdf
                    </a>
                </li>
                <li>
                    <a class="manual-link" target="_blank" href="~/manual/在庫管理システム_操作マニュアル(はじめにお読みください)_ver1.0.pdf">
                        <i class="fa-solid fa-file manual-icon"></i> スマホDE検品ハンディアプリマニュアル.pdf
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>

<!-- Detail Modal-->
<div class="modal fade" id="detail-modal" tabindex="-1" role="dialog" aria-labelledby="detail-modal-label" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detail-modal-label">ハンディエラーメッセージ詳細</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="col-12">
                    <p>倉庫名：<span id="detailDepoName"></span></p>
                    <p>読取日時：<span id="detailCreatedAt"></span></p>
                    <p>ハンディメニュー名：<span id="detailHandyMenuName"></span></p>
                    <p>エラーメッセージ：<span id="detailErrorMessage"></span></p>
                    <p>読取内容(1回目)：<br><span class="text-break" id="detailFirstScanedString"></span></p>
                    <p>読取内容(2回目)：<br><span class="text-break" id="detailSecondScanedString"></span></p>
                    <p>登録者：<span id="detailCreatedBy"></span></p>
                    <p>解除者：<span id="detailUnlockedBy"></span></p>
                </div>
            </div>
        </div>
    </div>
</div>

@* ドーナツグラフ *@
<link rel="stylesheet" href="~/lib/billboard/billboard.css">
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://d3js.org/d3.v6.min.js"></script>
<script src="~/lib/billboard/billboard.js"></script>

<script>

    document.addEventListener("DOMContentLoaded", function () {
        var total = @Model.ShipmentScheduleTotal;
        var process = @Model.StoreOutTotal;

        var data = @Html.Raw(Json.Serialize(Model));
        LoadGraph(process, total - process, data.graphTitle);
    });

    function LoadGraph(checked, uncheck, title) {
        // 作業進捗表示
        var shipmentList = [
            ["検品済数", checked],
            ["未検品数", uncheck],
        ];

        var percentage = 0;
        var total = checked + uncheck;
        if (total > 0) {
            percentage = Math.round(checked / (checked + uncheck) * 100);
        }

        var donutTitle = percentage + "%";
        if (percentage == 0) {
            donutTitle = "データが\nありません";
        }

        var chart = bb.generate({
            data: {
                columns: shipmentList,
                type: "donut"
            },
            title: {
                text: title
            },
            size: {
                width: 400,
                height: 150
            },
            donut: {
                title: donutTitle,
                label: {
                    format: function (value, ratio, id) { return value; },
                    ratio: 1,
                }
            },
            legend: {
                position: "right",
            },
            bindto: "#donut-chart",
        });

        var ctx = document.getElementById("donut-chart").getContext("2d");
        var myDoughnutChart = new Chart(ctx, config);
    }

    // 詳細ボタン押下
    function OnDetailClick(handyErrorMessageID) {
        // D_HandyErrorMessageModel取得
        var data = @Html.Raw(Json.Serialize(Model));
        var handyErrorMessageModel = data.d_HandyErrorMessageList;

        handyErrorMessageModel.forEach(function (item) {
            if (item.handyErrorMessageID == handyErrorMessageID) {
                $("#detailDepoName").text(item.depoName);
                $("#detailCreatedAt").text(item.createdAt);
                $("#detailHandyMenuName").text(item.handyMenuName);
                $("#detailErrorMessage").text(item.errorMessage);
                $("#detailFirstScanedString").text(item.firstScanedString);
                $("#detailSecondScanedString").text(item.secondScanedString);
                $("#detailCreatedBy").text(item.createdBy);
                $("#detailUnlockedBy").text(item.unlockedBy);
            }
        });
    }

    // マニュアルボタン押下
    function navigate(url) {
        window.location.href = url;
    }
</script>
