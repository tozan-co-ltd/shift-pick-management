@using ai_truck_load_measurement.Commons;
@model ai_truck_load_measurement.Models.TopModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = "トップ";
}
<style>
    /* カードレイアウト部分をラッピングし、
    Flexboxを指定"space-between"で各アイテムを均等に配置し、
    最初と最後のアイテムを端に寄せます。*/
    #cardlayout-wrap {
        position: relative;
        display: -webkit-box;
        display: -ms-flexbox;
        display: flex;
        -ms-flex-pack: justify;
        margin: 2em auto;
        width: 100%;
        -ms-flex-wrap: wrap;
        flex-wrap: wrap;
        -webkit-box-pack: justify;
        justify-content: space-between;
    }

    

    /* カードレイアウト内の画像を幅いっぱいに表示 */
    #cardlayout-wrap img {
        display: block;
        max-width: 100%;
        height: auto;
    }

    .card-figure {
        margin: 0 0 0;
        padding: 0.5em;
    }

    /* カードレイアウトのタイトル部分 */
    .card-title {
        margin: 0 0 0;
        color: #333;
        text-align: center;
        font-size: 2.5em;
    }

    /* カードレイアウトの説明文部分 */
    .created-at {
        margin: 0 0.5em 0;
        color: #493511;
    }

    .station-number{
        margin: 0;
        padding: 0.5em;
        color: #493511;
    }

    .truck-status{
        color: #493511;
        text-align: center;
    }

    .card-list {
        margin: 0.5em auto;
        padding: 0;
        width: calc(96% / 3); /* 96%幅を3で割るという指定 */
        background: #ffffff;
        box-shadow: 0 0 5px rgba(0, 0, 0, 0.5);
        border-radius: 10px;
    }

    .top-title {
        color: #493511;
        font-size: 1.8em;
    }

    .update-button {
        background: #1CC88A;
        border: #1CC88A;
    }

    .update-button:hover{
            background: #1CC88A;
            border: #1CC88A;
    }
</style>
<div class="card shadow de-inspection m-4">
    <div class="card-header">
        @ViewData["Title"]
    </div>

    <div class="card-body">
        @if (ViewData["ErrorMessage"] != null)
        {
            <span class="mt-1 text-danger">@ViewData["ErrorMessage"]</span>
        }
        <p class="mb-2 top-title">SyncBase ステーション状況</p>
        <button class="btn btn-primary update-button" onclick="onUpdateClick()" id="updateStation">更新</button>

        <div id="cardlayout-wrap">
            <!-- カードレイアウトをラッピング -->
            <section class="card-list">
                <p class="station-number">ステーション1</p>
                <h2 class="card-title" id="card-title1">停車</h2>
                <p class="truck-status" id="truck-status1">11~20%</p>
                <figure class="card-figure"><img src="" id="image1"></figure>
                <p class="created-at mb-3" id="created-at1">登録日時：</p>
            </section>
            <section class="card-list">
                <p class="station-number">ステーション2</p>
                <h2 class="card-title" id="card-title2">停車</h2>
                <p class="truck-status" id="truck-status2">11~20%</p>
                <figure class="card-figure"><img src="" id="image2"></figure>
                <p class="created-at mb-3" id="created-at2">登録日時：</p>
            </section>
            <section class="card-list">
                <p class="station-number">ステーション3</p>
                <h2 class="card-title" id="card-title3">停車</h2>
                <p class="truck-status" id="truck-status3">11~20%</p>
                <figure class="card-figure"><img src="" id="image3"></figure>
                <p class="created-at mb-3" id="created-at3">登録日時：</p>
            </section>
        </div>
            <!-- カードレイアウトをラッピング -->
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        // モデル取得
        var top_model = @Html.Raw(Json.Serialize(Model));
        viewCards(top_model)
    });

    function viewCards(top_model) {
        for (var i = 1; i <= 3; i++) {
            var cardModel = top_model.topModelList.find(x => x.stationID == i);
            if (cardModel.truckExist) {
                $('#card-title' + i).text("停車");
            }
            else {
                $('#card-title' + i).text("空車");
                $('#card-title' + i).css("color", "#1CC88A");
            }

            $('#truck-status' + i).text(cardModel.truckStatus);
            
            $('#image' + i).attr("src", "data:image/jpeg;base64," + cardModel.imagePath);

            var createdAt = GetDateString(new Date(cardModel.createdAt));
            $('#created-at' + i).text("取得日時：" + createdAt);
        }
    }

    function onUpdateClick(){
        // フォーム情報取得
        let url = window.location.origin + '@Url.Action("GetTopModel", "Top")';
        let method = 'Get';

        // Ajax call
        $.ajax({
            url: url,
            method: method
        }).done(function (response) {
            console.log(response);
            viewCards(response);
        }).fail(function (jqXHR, textStatus, errorThrown) {
            if (jqXHR.status === 404) {
                var errorMessage = jqXHR.responseJSON.errorMessage;
                $("#edit-modal-error-message").text(errorMessage);
            } else {
                var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                $("#edit-modal-error-message").text(errorMessage);
            }
        });
    }

    // 時刻の表示形式変換(HH:mm)
    function GetTimeString(date) {
        var hour = date.getHours();
        if (hour < 10) {
            hour = "0" + hour;
        }
        var minute = date.getMinutes();
        if (minute < 10) {
            minute = "0" + minute;
        }
        return hour + ":" + minute;
    }

    // 日付の表示形式変換(yyyy/MM/dd hh:mm)
    function GetDateString(date) {
        var day = date.toLocaleDateString("ja-JP", {
            year: "numeric", month: "2-digit",
            day: "2-digit"
        });
        var time = GetTimeString(date);
        return day + " " + time;
    }
</script>

