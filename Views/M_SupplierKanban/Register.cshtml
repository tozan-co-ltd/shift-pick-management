@using mar_sumaken_web.Commons;
@model mar_sumaken_web.Models.M_SupplierKanbanModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.CategoryTitle + " - " + Model.ViewTitle + " - " + "登録";
}

<div class="card shadow masterInfo m-4">

    <div class="card-header text-gray-800">
        @ViewData["Title"]
    </div>

    <div class="card-body">
        <div class="col-md-12 pb-3">
            <form method="get" asp-controller="M_SupplierKanban" asp-action="Index">
                <button type="submit" class="btn btn-secondary btn-icon-split">
                    <span class="icon text-white-50">
                        <i class="fas fa-arrow-left-long"></i>
                    </span>
                    <span class="text">戻る</span>
                </button>
            </form>
        </div>

        <div class="form-group col-sm-12 pl-3">
            <p id="div-error-message" class="mt-1 text-danger"></p>

            @if (ViewData["ErrorMessage"] != null)
            {
                <span class="mt-1 text-danger">@ViewData["ErrorMessage"]</span>
            }
        </div>

        <div class="mg-bot-20">
            <div class="col-16 sp-tablet mb-3">
                <form class="col-md-12" id="mSupplierKanbanForm">
                    <div class="col-12 input-group div-input-group">
                        <div class="col-12 col-sm-4 col-md-2 column-1st">
                            <label>@Html.DisplayNameFor(model => model.DepoName)<span style="color:red">*</span></label>
                        </div>
                        <div class="col-12 col-sm-8 col-md-5 column-2nd">
                            <select class="form-select" name="SelectedDepoID" asp-for="SelectedDepoID" asp-items="@Model.SearchDepoList"></select>
                            <span class="text-danger w-100" asp-validation-for="SelectedDepoID"></span>
                        </div>
                    </div>
                    <div class="col-12 input-group div-input-group">
                        <div class="col-12 col-sm-4 col-md-2 column-1st">
                            <label>@Html.DisplayName("SupplierName")<span style="color:red">*</span></label>
                        </div>
                        <div class="col-12 col-sm-8 col-md-5 column-2nd">
                            <select class="form-select" asp-for="SelectedSupplierID" required>
                                @for (var i = 0; i < Model.SuplierSelectList.Count; i++)
                                {
                                    <option value="@Model.SuplierSelectList[i].Value">@Model.SuplierSelectList[i].Text</option>
                                }
                            </select>
                            <span class="text-danger w-100" asp-validation-for="SelectedSupplierID"></span>
                        </div>
                    </div>
                    <div class="col-12 input-group div-input-group">
                        <div class="col-12 col-sm-4 col-md-2 column-1st">
                            <span>@Html.DisplayNameFor(model => model.SupplierKanbanName)<span style="color:red">*</span></span>
                        </div>
                        <div class="col-12 col-sm-8 col-md-5 column-2nd">
                            <input type="text" asp-for="SupplierKanbanName" class="form-control">
                            <span class="text-danger w-100" asp-validation-for="SupplierKanbanName"></span>
                        </div>
                    </div>
                    <div class="col-12 input-group div-input-group">
                        <div class="col-12 col-md-6 d-flex flex-wrap pl-0">
                            <div class="col-12 col-sm-4 column-1st">
                                <label>@Html.DisplayNameFor(model => model.AllowedDuplicatesFlag)<span style="color:red">*</span></label>
                            </div>
                            <div class="col-12 col-sm-8 column-2nd">
                                <div class="form-check">
                                    <input type="radio" asp-for="AllowedDuplicatesFlag" name="AllowedDuplicatesFlag" value="0" id="flexRadioDefault1" class="form-check-input" checked>
                                    <label class="form-check-label" for="flexRadioDefault1">
                                        0(なし)
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input type="radio" asp-for="AllowedDuplicatesFlag" name="AllowedDuplicatesFlag" value="1" id="flexRadioDefault2" class="form-check-input">
                                    <label class="form-check-label" for="flexRadioDefault2">
                                        1(あり)
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 input-group div-input-group pl-0">
                            <div class="col-12 col-sm-4 column-1st">
                                <label>使用ハンディメニュー名</label>
                            </div>
                            <div class="col-12 col-sm-8 column-2nd">
                                @for (var i = 0; i < Model.HandyMenuSelectList.Count; i++)
                                {
                                    <div class="form-check">
                                        <input type="hidden" asp-for="HandyMenuSelectList[i].Value" value="@Model.HandyMenuSelectList[i].Value" />
                                        <input type="hidden" asp-for="HandyMenuSelectList[i].Text" value="@Model.HandyMenuSelectList[i].Text" />
                                        <input class="form-check-input" asp-for="HandyMenuSelectList[i].Selected" type="checkbox">
                                        <label class="form-check-label" asp-for="HandyMenuSelectList[i].Selected">@Model.HandyMenuSelectList[i].Text</label>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <hr>
                    <table class="table table-responsive table-sm" style="width:100%">
                        <thead>
                            <tr>
                                <th class="border-top-0">項目名</th>
                                <th class="border-top-0">桁数</th>
                                <th class="border-top-0">開始位置</th>
                                <th class="border-top-0">識別文字</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    識別文字<span style="color:red">*</span>
                                </td>
                                <td></td>
                                <td>
                                    <input class="form-control" type="number" asp-for="IdentifyStringStartIndex" value="" required>
                                    <span class="text-danger w-100" asp-validation-for="IdentifyStringStartIndex"></span>
                                </td>
                                <td>
                                    <input class="form-control" type="text" asp-for="IdentifyString" value="" required>
                                    <span class="text-danger w-100" asp-validation-for="IdentifyString"></span>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    品番<span style="color:red">*</span>
                                </td>
                                <td>
                                    <input class="form-control" type="number" asp-for="ProductNumberStartIndex" value="" required>
                                    <span class="text-danger w-100" asp-validation-for="ProductNumberStartIndex"></span>
                                </td>
                                <td>
                                    <input class="form-control" type="number" asp-for="ProductNumberLength" value="" required>
                                    <span class="text-danger w-100" asp-validation-for="ProductNumberLength"></span>
                                </td>
                                <td></td>
                            </tr>
                            <tr>
                                <td>
                                    数量
                                </td>
                                <td>
                                    <input type="number" class="form-control" id="" value="@Model.QuantityLength" name="" />
                                </td>
                                <td>
                                    <input type="number" class="form-control" id="" value="@Model.QuantityStartIndex" name="" />
                                </td>
                                <td></td>
                            </tr>
                            <tr>
                                <td>
                                    ロット番号
                                </td>
                                <td>
                                    <input type="number" class="form-control" id="" value="@Model.LotLength" name="" />
                                </td>
                                <td>
                                    <input type="number" class="form-control" id="" value="@Model.LotStartIndex" name="" />
                                </td>
                                <td></td>
                            </tr>
                            <tr>
                                <td>
                                    メインキー
                                </td>
                                <td>
                                    <input type="number" class="form-control" id="" value="@Model.MainProductKeyLength" name="" />
                                </td>
                                <td>
                                    <input type="number" class="form-control" id="" value="@Model.MainProductKeyStartIndex" name="" />
                                </td>
                                <td></td>
                            </tr>
                            <tr>
                                <td>
                                    サブキー1
                                </td>
                                <td>
                                    <input type="number" class="form-control" id="" value="@Model.FirstSubProductKeyLength" name="" />
                                </td>
                                <td>
                                    <input type="number" class="form-control" id="" value="@Model.FirstSubProductKeyStartIndex" name="" />
                                </td>
                                <td></td>
                            </tr>
                            <tr>
                                <td>
                                    サブキー2
                                </td>
                                <td>
                                    <input type="number" class="form-control" id="" value="@Model.SecondSubProductKeyLength" name="" />
                                </td>
                                <td>
                                    <input type="number" class="form-control" id="" value="@Model.SecondSubProductKeyStartIndex" name="" />
                                </td>
                                <td></td>
                            </tr>
                            <tr>
                                <td>
                                    枝番
                                </td>
                                <td>
                                    <input type="number" class="form-control" id="" value="@Model.ProductBranchNumberLength" name="" />
                                </td>
                                <td>
                                    <input type="number" class="form-control" id="" value="@Model.ProductBranchNumberStartIndex" name="" />
                                </td>
                                <td></td>
                            </tr>
                            <tr>
                                <td>
                                    注文番号
                                </td>
                                <td>
                                    <input type="number" class="form-control" id="" value="@Model.OrderNumberLength" name="" />
                                </td>
                                <td>
                                    <input type="number" class="form-control" id="" value="@Model.OrderNumberStartIndex" name="" />
                                </td>
                                <td></td>
                            </tr>
                            @* @{
                                var i = 0;
                                foreach (var item in Model.RegisterList)
                                {
                                    {
                                        <tr>
                                            <td>
                                                <input type="text" class="form-control" id="RegisterList[@i].SupplierProductNumber" value="@item.SupplierProductNumber" name="RegisterList[@i].SupplierProductNumber" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control" value="@item.LotNumber" name="RegisterList[@i].LotNumber" />
                                            </td>
                                            <td>
                                                <input type="number" class="form-control" value="@item.Quantity" name="RegisterList[@i].Quantity" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control" value="@item.MainProductKey" name="RegisterList[@i].MainProductKey" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control" value="@item.FirstSubProductKey" name="RegisterList[@i].FirstSubProductKey" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control" value="@item.SecondSubProductKey" name="RegisterList[@i].SecondSubProductKey" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control" value="@item.Remarks" name="RegisterList[@i].Remarks" />
                                            </td>
                                        </tr>
                                    }
                                    ++i;
                                }
                            } *@
                        </tbody>
                    </table>
                    <button class="btn btn-primary btn-icon-split" id="register-btn" style="min-width: 80px" onclick="OnRegister()">
                        <span class="text">登録</span>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    // 登録ボタン押下
    function OnRegister() {
        $('#mSupplierKanbanForm').submit(function (event) {
            $("#div-error-message").text("");

            // ページの更新を禁止する
            event.preventDefault();

            // 送信イベントが他のハンドラーに伝播するのを防ぐ
            event.stopImmediatePropagation();

            // フォーム情報取得
            let url = window.location.origin + '@Url.Action("Register", "M_SupplierKanban")';
            let method = 'POST';
            let formId = 'mSupplierKanbanForm';
            let data = $('#' + formId).serializeArray();

            // Ajax call
            $.ajax({
                url: url,
                method: method,
                data: data
            }).done(function (response) {
                $('#' + formId)[0].reset();
                // 完了モーダル表示
                AlertMessage('', '完了', '登録が完了しました。', null, null);
            }).fail(function (jqXHR, textStatus, errorThrown) {
                if (jqXHR.status === 404) {
                    // データが見つからなかった場合
                    var errorMessage = jqXHR.responseJSON.errorMessage;
                    $("#div-error-message").text(errorMessage);
                } else {
                    // その他のエラーの場合
                    var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                    $("#div-error-message").text(errorMessage);
                }
            });
        });
    }

</script>

