@using mar_sumaken_web.Commons;
@model mar_sumaken_web.Models.M_SupplierKanbanModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.CategoryTitle + " - " + Model.ViewTitle + " - " + "修正";
}

<div class="card shadow masterInfo m-4">

    <div class="card-header">
        @ViewData["Title"]
    </div>

    <div class="card-body">
        <div class="col-md-12 pb-3">
            <form method="get" asp-controller="M_SupplierKanban" asp-action="Index">
                <button type="submit" class="btn btn-secondary btn-icon-split">
                    <span class="icon text-white-50">
                        <i class="fas fa-arrow-left-long"></i>
                    </span>
                    <span class="text">戻る</span>
                </button>
            </form>
        </div>

        <div class="form-group col-sm-12 pl-3 error-wrapper">
            <p id="div-error-message" class="mt-1 mb-1 text-danger"></p>
            <p id="duplicate-error-message" class="mt-1 text-danger"></p>

            @if (ViewData["ErrorMessage"] != null)
            {
                <span class="mt-1 text-danger">@ViewData["ErrorMessage"]</span>
            }
        </div>

        <div class="mg-bot-20">
            <div class="col-16 sp-tablet mb-3">
                <form class="col-md-12" id="mSupplierKanbanForm">
                    <input type="hidden" asp-for="SupplierKanbanID" value="@Model.SupplierKanbanID" />
                    <div class="d-flex flex-row">
                        <div class="col-7">
                            <div class="col-12 input-group div-input-group">
                                <div class="col-12 col-sm-4 column-1st">
                                    <label>@Html.DisplayNameFor(model => model.DepoName)<span style="color:red">*</span></label>
                                </div>
                                <div class="col-12 col-sm-8 column-2nd">
                                    <input type="hidden" asp-for="DepoName" />
                                    <select class="form-select" name="SelectedDepoID" asp-for="SelectedDepoID" asp-items="@Model.SearchDepoList" 
                                        onchange="UpdateSelectedValue(this, 'DepoName')"></select>
                                    <span class="text-danger w-100" asp-validation-for="SelectedDepoID"></span>
                                </div>
                            </div>
                            <div class="col-12 input-group div-input-group">
                                <div class="col-12 col-sm-4 column-1st">
                                    <label>@Html.DisplayName("SupplierName")<span style="color:red">*</span></label>
                                </div>
                                <div class="col-12 col-sm-8 column-2nd">
                                    <input type="hidden" asp-for="SupplierName" />
                                    <select class="form-select" asp-for="SelectedSupplierID" onchange="UpdateSelectedValue(this, 'SupplierName')" required>
                                        @for (var i = 0; i < Model.SuplierSelectList.Count; i++)
                                        {
                                            <option value="@Model.SuplierSelectList[i].Value">@Model.SuplierSelectList[i].Text</option>
                                        }
                                    </select>
                                    <span class="text-danger w-100" asp-validation-for="SelectedSupplierID"></span>
                                </div>
                            </div>
                            <div class="col-12 input-group div-input-group">
                                <div class="col-12 col-sm-4 column-1st">
                                    <span>@Html.DisplayNameFor(model => model.SupplierKanbanName)<span style="color:red">*</span></span>
                                </div>
                                <div class="col-12 col-sm-8 column-2nd">
                                    <input type="text" asp-for="SupplierKanbanName" class="form-control">
                                    <span class="text-danger w-100" asp-validation-for="SupplierKanbanName"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-5 input-group div-input-group">
                            <div class="col-12 d-flex flex-wrap pl-0">
                                <div class="col-12 col-sm-5 column-1st">
                                    <label>@Html.DisplayNameFor(model => model.AllowedDuplicatesFlag)<span style="color:red">*</span></label>
                                </div>
                                <div class="col-12 col-sm-7 column-2nd d-md-flex flex-row">
                                    <div class="form-check col-md-6">
                                        <input type="radio" asp-for="AllowedDuplicatesFlag" name="AllowedDuplicatesFlag" value="0" id="flexRadioDefault1" class="form-check-input" checked>
                                        <label class="form-check-label" for="flexRadioDefault1">
                                            0(なし)
                                        </label>
                                    </div>
                                    <div class="form-check col-md-6">
                                        <input type="radio" asp-for="AllowedDuplicatesFlag" name="AllowedDuplicatesFlag" value="1" id="flexRadioDefault2" class="form-check-input">
                                        <label class="form-check-label" for="flexRadioDefault2">
                                            1(あり)
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 input-group div-input-group pl-0">
                                <div class="col-12 col-sm-5 column-1st">
                                    <label>使用ハンディメニュー名</label>
                                </div>
                                <div class="col-12 col-sm-7 column-2nd">
                                    @for (var i = 0; i < Model.HandyMenuSelectList.Count; i++)
                                    {
                                        <div class="form-check checkboxHandyMenu">
                                            <input type="hidden" asp-for="HandyMenuSelectList[i].Value" value="@Model.HandyMenuSelectList[i].Value" />
                                            <input type="hidden" asp-for="HandyMenuSelectList[i].Text" value="@Model.HandyMenuSelectList[i].Text" />
                                            <input class="form-check-input HandyMenuNames" asp-for="HandyMenuSelectList[i].Selected" type="checkbox">
                                            <label class="form-check-label" asp-for="HandyMenuSelectList[i].Selected">@Model.HandyMenuSelectList[i].Text</label>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr>
                    <table class="table table-responsive table-sm" style="width:100%">
                        <thead>
                            <tr>
                                <th class="border-top-0" style="min-width: 110px;">項目名</th>
                                <th class="border-top-0">桁数</th>
                                <th class="border-top-0">開始位置</th>
                                <th class="border-top-0">識別文字</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    識別文字<span style="color:red">*</span>
                                </td>
                                <td></td>
                                <td>
                                    <input class="form-control" type="number" asp-for="IdentifyStringStartIndex" value="@Model.IdentifyStringStartIndex" required>
                                    <span class="text-danger w-100" asp-validation-for="IdentifyStringStartIndex"></span>
                                </td>
                                <td>
                                    <input class="form-control" type="text" asp-for="IdentifyString" value="@Model.IdentifyString" required>
                                    <span class="text-danger w-100" asp-validation-for="IdentifyString"></span>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    品番<span style="color:red">*</span>
                                </td>
                                <td>
                                    <input class="form-control" type="number" asp-for="ProductNumberLength" value="@Model.ProductNumberLength" required>
                                    <span class="text-danger w-100" asp-validation-for="ProductNumberLength"></span>
                                </td>
                                <td>
                                    <input class="form-control" type="number" asp-for="ProductNumberStartIndex" value="@Model.ProductNumberStartIndex" required>
                                    <span class="text-danger w-100" asp-validation-for="ProductNumberStartIndex"></span>
                                </td>
                                <td></td>
                            </tr>
                            <tr>
                                <td>
                                    数量
                                </td>
                                <td>
                                    <input type="number" class="form-control" asp-for="QuantityLength" value="@Model.QuantityLength" />
                                </td>
                                <td>
                                    <input type="number" class="form-control" asp-for="QuantityStartIndex" value="@Model.QuantityStartIndex" />
                                </td>
                                <td></td>
                            </tr>
                            <tr>
                                <td>
                                    ロット番号
                                </td>
                                <td>
                                    <input type="number" class="form-control" asp-for="LotLength" value="@Model.LotLength" />
                                </td>
                                <td>
                                    <input type="number" class="form-control" asp-for="LotStartIndex" value="@Model.LotStartIndex" />
                                </td>
                                <td></td>
                            </tr>
                            <tr>
                                <td>
                                    メインキー
                                </td>
                                <td>
                                    <input type="number" class="form-control" asp-for="MainProductKeyLength" value="@Model.MainProductKeyLength" />
                                    <span class="text-danger w-100 MainProductKey" asp-validation-for="MainProductKeyLength"></span>
                                </td>
                                <td>
                                    <input type="number" class="form-control" asp-for="MainProductKeyStartIndex" value="@Model.MainProductKeyStartIndex" />
                                    <span class="text-danger w-100 MainProductKey" asp-validation-for="MainProductKeyStartIndex"></span>
                                </td>
                                <td></td>
                            </tr>
                            <tr>
                                <td>
                                    サブキー1
                                </td>
                                <td>
                                    <input type="number" class="form-control" asp-for="FirstSubProductKeyLength" value="@Model.FirstSubProductKeyLength" />
                                </td>
                                <td>
                                    <input type="number" class="form-control" asp-for="FirstSubProductKeyStartIndex" value="@Model.FirstSubProductKeyStartIndex" />
                                </td>
                                <td></td>
                            </tr>
                            <tr>
                                <td>
                                    サブキー2
                                </td>
                                <td>
                                    <input type="number" class="form-control" asp-for="SecondSubProductKeyLength" value="@Model.SecondSubProductKeyLength" />
                                </td>
                                <td>
                                    <input type="number" class="form-control" asp-for="SecondSubProductKeyStartIndex" value="@Model.SecondSubProductKeyStartIndex" />
                                </td>
                                <td></td>
                            </tr>
                            <tr>
                                <td>
                                    枝番
                                </td>
                                <td>
                                    <input type="number" class="form-control" asp-for="ProductBranchNumberLength" value="@Model.ProductBranchNumberLength" />
                                </td>
                                <td>
                                    <input type="number" class="form-control" asp-for="ProductBranchNumberStartIndex" value="@Model.ProductBranchNumberStartIndex" />
                                </td>
                                <td></td>
                            </tr>
                            <tr>
                                <td>
                                    注文番号
                                </td>
                                <td>
                                    <input type="number" class="form-control" asp-for="OrderNumberLength" value="@Model.OrderNumberLength" />
                                </td>
                                <td>
                                    <input type="number" class="form-control" asp-for="OrderNumberStartIndex" value="@Model.OrderNumberStartIndex" />
                                </td>
                                <td></td>
                            </tr>
                        </tbody>
                    </table>
                    <button class="btn btn-success btn-icon-split" id="edit-btn" style="min-width: 80px">
                        <span class="text">更新</span>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

    // 重複許容フラグ0の場合はメインキー必須
    $('input[type="radio"]').change(function () {
        var groupName = $(this).attr('name');
        var radioValue = $(this).val();
        var allowedDuplicatesFlag = false;

        if (groupName === 'AllowedDuplicatesFlag') {
            if (radioValue === '0') {
                $('#MainProductKeyLength').prop('required', true);
            } else {
                // 重複許容
                allowedDuplicatesFlag = true;
                $('#MainProductKeyLength').prop('required', false);
            }
        }
    });

    // 倉庫名反映
    function UpdateSelectedValue(select, itemId) {
        var selectedIndex = select.selectedIndex;
        var selectedDepoText = select.options[selectedIndex].text;
        document.getElementById(itemId).value = selectedDepoText;
    }

    // 更新ボタン押下
    $("#edit-btn").on("click", function () {
        // ページの更新を禁止する
        event.preventDefault();

        // 送信イベントが他のハンドラーに伝播するのを防ぐ
        event.stopImmediatePropagation();

        // 入力値チェック
        let isCheckInput = checkInput();
        if (isCheckInput == false) return false;

        // フォーム情報取得
        let url = window.location.origin + '@Url.Action("Edit", "M_SupplierKanban")';
        let method = 'POST';
        let formId = 'mSupplierKanbanForm';
        let data = $('#' + formId).serializeArray();

        // Ajax call
        $.ajax({
            url: url,
            method: method,
            data: data
        }).done(function (response) {
            $('#' + formId)[0].reset();
            // 完了モーダル表示
            AlertMessage('', '完了', '登録が完了しました。', null, null);
        }).fail(function (jqXHR, textStatus, errorThrown) {
            if (jqXHR.status === 404) {
                // データが見つからなかった場合
                var errorMessage = jqXHR.responseJSON.errorMessage;
                $("#div-error-message").text(errorMessage);
            } else {
                // その他のエラーの場合
                var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                $("#div-error-message").text(errorMessage);
            }
        });
    });

    // 入力値チェック
    function checkInput() {

        // エラーメッセージ削除
        DeleteErrorMessages();

        // 重複許容フラグ
        var selectedAllowedDuplicatesFlagValue = $('input[name="AllowedDuplicatesFlag"]:checked').val();
        var requiredCheck = false;
        if (selectedAllowedDuplicatesFlagValue == '0') {
            requiredCheck = true;
        }

        var handyErrorMessage = null;
        // 使用ハンディメニューチェック
        $(".checkboxHandyMenu").children("input:checked").each(function () {
            let checkboxLabel = $(this).next('label').text();

            if (requiredCheck) {
                // 重複許容フラグ=0の場合「まとめ入庫」は選択不可
                if (checkboxLabel == "まとめ入庫") {
                    //$("#div-error-message").text("E1025: 重複許容フラグが0の場合、「まとめ入庫」は選択できません。");
                    handyErrorMessage = "E1025: 重複許容フラグが0の場合、「まとめ入庫」は選択できません。";
                }
            } else {
                // 重複許容フラグ=1の場合「入庫」は選択不可
                if (checkboxLabel == "入庫") {
                    //$("#div-error-message").text("E1026: 重複許容フラグが1の場合、「入庫」は選択できません。");
                    handyErrorMessage = "E1026: 重複許容フラグが1の場合、「入庫」は選択できません。";
                }
            }
        });
        if (handyErrorMessage != null) {
            $("#div-error-message").text(handyErrorMessage);
            return false;
        }

        // バリデーションチェック
        var validationCheck = CheckValidationMSupplierKanban();

        var inputNumnerCheck = true;
        // 小数点とMaxLengthチェック
        $('input[type="number"]').each(function () {
            var value = $(this).val();
            // 小数点
            if (!Number.isInteger(Number(value)) || Number(value) < 0) {
                $(this).addClass('input-validation-error');
                inputNumnerCheck = false;
            }
            // MaxLength
            if (value.length > 10 || isNaN(value)) {
                $(this).addClass('input-validation-error');
                inputNumnerCheck = false;
            }
        });

        return validationCheck && inputNumnerCheck;
    }

    // エラーメッセージ削除
    function DeleteErrorMessages() {
        $('#div-error-message').text('');
        $('.text-danger').text('');
        $('input').removeClass('input-validation-error');
    }
</script>

