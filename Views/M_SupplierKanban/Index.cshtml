@using mar_sumaken_web.Commons;
@model mar_sumaken_web.Models.M_SupplierKanbanModel
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.CategoryTitle + " - " + Model.ViewTitle;
}
<style type="text/css">
    .btn-register {
        min-width: 130px !important;
    }
</style>

<div class="card shadow de-inspection masterInfo m-4">
    <div class="card-header text-gray-800">
        @ViewData["Title"]
    </div>
    <div class="card-body">

        <div class="form-group col-sm-12 pl-3">
            <p id="div-error-message" class="mt-1 text-danger"></p>

            @if (ViewData["ErrorMessage"] != null)
            {
                <span class="mt-1 text-danger">@ViewData["ErrorMessage"]</span>
            }
        </div>

        <div class="mg-bot-20">
            <div class="col-12 d-flex xs-block justify-content-start align-items-center p-0">
                <div class="input-group-append mr-2">
                    <a class="btn btn-primary btn-icon-split btn-register" asp-controller="M_SupplierKanban" asp-action="Register">
                        <span class="icon text-white-50">
                            <i class="fas fa-plus"></i>
                        </span>
                        <span class="text">新規作成</span>
                    </a>
                </div>
                <div class="input-group-append">
                    <a href="#" class="btn btn-info btn-icon-split" onclick="onExportFile('M_SupplierKanban')">
                        <span class="icon text-white-50">
                            <i class="fas fa-file-export"></i>
                        </span>
                        <span class="text">出力</span>
                    </a>
                </div>
                <div class="input-group-append mr-2">
                    <a class="btn btn-secondary btn-icon-split btn-register" asp-controller="M_SupplierKanban" asp-action="Preview">
                        <span class="icon text-white-50">
                            <i class="fas fa-qrcode"></i>
                        </span>
                        <span class="text">プレビュー</span>
                    </a>
                </div>
            </div>
        </div>
        <div class="mt-3">
            <table class="table table-sm stripe hover nowrap datatable-normal">
                <thead>
                    <tr>
                        <th width="40"></th>
                        <th class="font-weight-bold">ID</th>
                        <th class="font-weight-bold">倉庫名</th>
                        <th class="font-weight-bold">仕入先名</th>
                        <th class="font-weight-bold">仕入先かんばん名</th>
                        <th class="font-weight-bold">重複許容フラグ</th>
                        <th class="font-weight-bold">識別文字</th>
                        <th class="font-weight-bold">識別文字開始位置</th>
                        <th class="font-weight-bold">品番桁数</th>
                        <th class="font-weight-bold">品番開始位置</th>
                        <th class="font-weight-bold">数量桁数</th>
                        <th class="font-weight-bold">数量開始位置</th>
                        <th class="font-weight-bold">ロット番号桁数</th>
                        <th class="font-weight-bold">ロット番号開始位置</th>
                        <th class="font-weight-bold">メインキー桁数</th>
                        <th class="font-weight-bold">メインキー開始位置</th>
                        <th class="font-weight-bold">サブキー1桁数</th>
                        <th class="font-weight-bold">サブキー1開始位置</th>
                        <th class="font-weight-bold">サブキー2桁数</th>
                        <th class="font-weight-bold">サブキー2開始位置</th>
                        <th class="font-weight-bold">枝番桁数</th>
                        <th class="font-weight-bold">枝番開始位置</th>
                        <th class="font-weight-bold">注文番号桁数</th>
                        <th class="font-weight-bold">注文番号開始位置</th>
                        <th class="font-weight-bold">更新日時</th>
                        <th class="font-weight-bold">更新者</th>
                    </tr>
                </thead>
                <tbody>
                    @if (@Model.M_SupplierKanbanList != null)
                    {
                        @foreach (var item in @Model.M_SupplierKanbanList)
                        {
                            <tr>
                                <td>
                                    <button class="btn btn-secondary btn-icon-split" title="詳細"
                                            onclick="OnDetailClick('@item.SupplierKanbanID')" data-id="@item.SupplierKanbanID" data-toggle="modal" data-target="#detail-modal">
                                        <i class="fa-solid fa-list"></i>
                                    </button>
                                    <a class="btn btn-success btn-icon-split ml-1 mr-1"
                                       onclick="OnEditClick('@item.SupplierKanbanID')" data-id="@item.SupplierKanbanID" data-toggle="modal" data-target="#edit-modal">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <button class="btn btn-danger btn-icon-split"
                                            onclick="OnDeleteClick('@item.SupplierKanbanID')" data-id="@item.SupplierKanbanID" data-toggle="modal" data-target="#delete-modal">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </td>
                                <td>@item.SupplierKanbanID</td>
                                <td>@item.DepoName</td>
                                <td>@item.SupplierName</td>
                                <td>@item.SupplierKanbanName</td>
                                <td>@item.AllowedDuplicatesFlag</td>
                                <td>@item.IdentifyString</td>
                                <td>@item.IdentifyStringStartIndex</td>
                                <td>@item.ProductNumberLength</td>
                                <td>@item.ProductNumberStartIndex</td>
                                <td>@item.QuantityLength</td>
                                <td>@item.QuantityStartIndex</td>
                                <td>@item.LotLength</td>
                                <td>@item.LotStartIndex</td>
                                <td>@item.MainProductKeyLength</td>
                                <td>@item.MainProductKeyStartIndex</td>
                                <td>@item.FirstSubProductKeyLength</td>
                                <td>@item.FirstSubProductKeyStartIndex</td>
                                <td>@item.SecondSubProductKeyLength</td>
                                <td>@item.SecondSubProductKeyStartIndex</td>
                                <td>@item.ProductBranchNumberLength</td>
                                <td>@item.ProductBranchNumberStartIndex</td>
                                <td>@item.OrderNumberLength</td>
                                <td>@item.OrderNumberStartIndex</td>
                                <td>@item.UpdatedAt</td>
                                <td>@item.UpdatedBy</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Detail Modal-->
<div class="modal fade" id="detail-modal" tabindex="-1" role="dialog" aria-labelledby="detail-modal-label" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detail-modal-label">仕入先かんばんマスター詳細</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="col-12">
                    <p class="mb-1">仕入先かんばん名：<span id="detailSupplierKanbanName"></span></p>
                    <p>重複許容フラグ：<span id="detailAllowedDuplicatesFlag"></span></p>

                    <table class="table table-sm table-striped p-2">
                        <thead>
                            <tr>
                                <th class="text-left border-top-0 font-weight-bold" scope="col">項目名</th>
                                <th class="text-left border-top-0 font-weight-bold" scope="col">桁数</th>
                                <th class="text-left border-top-0 font-weight-bold" scope="col">開始位置</th>
                            </tr>
                        </thead>
                        <tbody id="supplierKanban-contatiner">
                        </tbody>
                    </table>

                    <p class="mb-1">使用ハンディメニュー名</p>
                    <table class="col-6 table table-sm table-striped p-2">
                        <thead>
                            <tr>
                                <th class="text-left border-top-0 font-weight-bold" scope="col">ハンディメニュー名</th>
                            </tr>
                        </thead>
                        <tbody id="menu-contatiner">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!--  Delete Modal-->
<div class="modal fade" id="delete-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="delete-modal-label">削除</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="col-12 col-md-10">
                    <p id="delete-modal-error-message" class="mt-1 text-danger"></p>
                </div>
                <div class="d-flex justify-content-center">
                    <div class="col-12 col-md-10">
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4 col-md-4">
                                <label>ID</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-7 mb-2">
                                <input class="form-control" id="deleteSupplierKanbanID" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4 col-md-4">
                                <label>仕入先名</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-7 mb-2">
                                <input class="form-control" id="deleteSupplierName" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap">
                            <div class="col-12 col-sm-4 col-md-4">
                                <label>仕入先かんばん名</label>
                            </div>
                            <div class="col-12 col-sm-8 col-md-7 mb-2">
                                <input class="form-control" id="deleteSupplierKanbanName" type="text" disabled>
                            </div>
                        </div>
                        <div class="col-12 d-flex flex-wrap justify-content-center p-2 p-md-3">
                            <button class="btn btn-danger btn-icon-split mb-2 mr-0 mr-sm-5" onclick="OnExecuteDelete()">
                                <span class="text" style="min-width:84px">削除</span>
                            </button>
                            <button class="btn btn-secondary btn-icon-split mb-2" data-dismiss="modal" aria-label="Close">
                                <span class="text">キャンセル</span>
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

    // 詳細ボタン押下
    function OnDetailClick(supplierKanbanID) {
        // M_supplierKanbanModel取得
        var data = @Html.Raw(Json.Serialize(Model));
        var supplierKanbanModel = data.m_SupplierKanbanList;

        supplierKanbanModel.forEach(function (item) {
            if (item.supplierKanbanID == supplierKanbanID) {
                $("#detailSupplierKanbanName").text(item.supplierKanbanName);
                $("#detailAllowedDuplicatesFlag").text(item.allowedDuplicatesFlag);

                // 桁数・開始位置
                var container = $("#supplierKanban-contatiner");
                container.empty();
                let tr = "<tr>"
                    + "<td>識別文字</td>"
                    + "<td>" + item.identifyString.length + "</td>"
                    + "<td>" + item.identifyStringStartIndex + "</td>"
                    + "</tr><tr>"
                    + "<td>品番</td>"
                    + "<td>" + item.productNumberLength + "</td>"
                    + "<td>" + item.productNumberStartIndex + "</td>"
                    + "</tr><tr>"
                    + "<td>数量</td>"
                    + "<td>" + item.quantityLength + "</td>"
                    + "<td>" + item.quantityStartIndex + "</td>"
                    + "</tr><tr>"
                    + "<td>ロット番号</td>"
                    + "<td>" + item.lotLength + "</td>"
                    + "<td>" + item.lotStartIndex + "</td>"
                    + "</tr><tr>"
                    + "<td>メインキー</td>"
                    + "<td>" + item.mainProductKeyLength + "</td>"
                    + "<td>" + item.mainProductKeyStartIndex + "</td>"
                    + "</tr><tr>"
                    + "<td>サブキー1</td>"
                    + "<td>" + item.firstSubProductKeyLength + "</td>"
                    + "<td>" + item.firstSubProductKeyStartIndex + "</td>"
                    + "</tr><tr>"
                    + "<td>サブキー2</td>"
                    + "<td>" + item.secondSubProductKeyLength + "</td>"
                    + "<td>" + item.secondSubProductKeyStartIndex + "</td>"
                    + "</tr><tr>"
                    + "<td>枝番</td>"
                    + "<td>" + item.productBranchNumberLength + "</td>"
                    + "<td>" + item.productBranchNumberStartIndex + "</td>"
                    + "</tr><tr>"
                    + "<td>注文番号</td>"
                    + "<td>" + item.orderNumberLength + "</td>"
                    + "<td>" + item.orderNumberStartIndex + "</td>"
                    + "</tr>";
                container.append(tr);

                // 使用ハンディメニュー
                var menuList = item.m_HandyMenuList;
                var menuContainer = $("#menu-contatiner");
                menuContainer.empty();
                if (menuList != null) {
                    menuList.forEach(function (menu) {
                        menuContainer.append("<tr><td>" + menu.handyMenuName + "</td></tr>");
                    });
                }
            }
        });
    }

    // 削除ボタン押下
    function OnDeleteClick(supplierKanbanID) {
        // M_SupplierKanbanModel取得
        var data = @Html.Raw(Json.Serialize(Model));
        var supplierKanbanModel = data.m_SupplierKanbanList;

        supplierKanbanModel.forEach(function (item) {
            if (item.supplierKanbanID == supplierKanbanID) {
                $("#deleteSupplierKanbanID").val(item.supplierKanbanID);
                $("#deleteSupplierName").val(item.supplierName);
                $("#deleteSupplierKanbanName").val(item.supplierKanbanName);
            }
        });
    }

    // 削除
    function OnExecuteDelete() {
        DeleteErrorMessages();

        // フォーム情報取得
        let url = window.location.origin + '@Url.Action("Delete", "M_SupplierKanban")';
        let method = 'POST';
        let data = { "SupplierKanbanID": $('#deleteSupplierKanbanID').val() };

        // Ajax call
        $.ajax({
            url: url,
            method: method,
            data: data
        }).done(function (response) {
            $('#delete-modal').hide();
            // 完了モーダル表示
            AlertMessage('', '完了', '登録が完了しました。', null, null);
        }).fail(function (jqXHR, textStatus, errorThrown) {
            if (jqXHR.status === 404) {
                var errorMessage = jqXHR.responseJSON.errorMessage;
                $("#delete-modal-error-message").text(errorMessage);
            } else {
                var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                $("#delete-modal-error-message").text(errorMessage);
            }
        });
    }

    // エラーメッセージ削除
    function DeleteErrorMessages() {
        $('#div-error-message').text('');
        $('#edit-modal-error-message').text('');
        $('#delete-modal-error-message').text('');
        $('.text-danger').text('');
        $('input').removeClass('input-validation-error');
    }
</script>