<script type="text/javascript">
    // プレビューボタン押下
    function OnPreview() {
        $('#mSupplierKanbanForm').submit(function (event) {
            $("#div-error-message").text("");

            // ページの更新を禁止する
            event.preventDefault();

            // 送信イベントが他のハンドラーに伝播するのを防ぐ
            event.stopImmediatePropagation();

            // フォーム情報取得
            let url = window.location.origin + '@Url.Action("PreviewResult", "M_SupplierKanban")';
            let method = 'POST';
            let formId = 'mSupplierKanbanForm';
            let data = $('#' + formId).serializeArray();

            // Ajax call
            $.ajax({
                url: url,
                method: method,
                data: data
            }).done(function (response) {
                // tableリセット

                // QRコード文字列をトリム
                // 開始,終了
                let productNumber = response.qRCodeString.slice(response.productNumberStartIndex, response.productNumberLength.length())

                console.log('productNumber', productNumber)
                // 結果表示
                // 識別文字の桁数欄はLength
                console.log('response', response)
                if (response.identifyString != null) {
                    $("#div-preview-result").show();
                    $("#resultSupplierKanbanName").text(response.supplierKanbanName);
                    $("#resultAllowedDuplicatesFlag").text(response.allowedDuplicatesFlag);
                    $("#resultQrProductNumber").text(productNumber);
                }
            }).fail(function (jqXHR, textStatus, errorThrown) {
                if (jqXHR.status === 404) {
                    // データが見つからなかった場合
                    var errorMessage = jqXHR.responseJSON.errorMessage;
                    $("#div-error-message").text(errorMessage);
                } else {
                    // その他のエラーの場合
                    var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                    $("#div-error-message").text(errorMessage);
                }
            });
        });
    }

</script>

