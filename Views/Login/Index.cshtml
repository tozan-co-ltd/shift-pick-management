@model ai_truck_load_measurement.Models.LoginModel
@{
    ViewData["Title"] = "ログイン";
    Layout = "_LayoutLogin";
}

<style>
    body {
        background-color: #F9C8E0;
    }

    .system-logo img {
        max-width: 150px;
        max-height: 150px;
        background: #ffffff;
    }

    .system-title {
        font-size: large;
        font-weight: bolder;
        margin-bottom: 15px;
        color: var(--base-color-main);
    }

    .login-img {
        margin: 20px;
        margin-bottom: 0px;
    }

    .login-area {
        width: 280px;
        margin: 0;
        padding: 15px;
        color: #424242;
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
        text-align: center;
        border: none;
    }

    .login-form {
        font-size: smaller;
        padding: 10px;
    }

    .login-text {
        width: 100%;
        height: 40px;
        border: 1px solid #9E9E9E;
        border-radius: 15px;
        font-size: 14px;
        margin-bottom: 5px;
        -moz-box-sizing: border-box;
        -webkit-box-sizing: border-box;
        box-sizing: border-box;
    }

    .login-btn {
        width: 70%;
        height: 40px;
        border-radius: 40px;
        border: none;
        font-size: large;
        color: #ffffff;
        background-color: var(--base-color-accent);
        margin: 15px 0;
        cursor: pointer;
    }

    .input-icon-with {
        position: relative;
    }

    .input-icon-with input {
        margin: 8px 0;
        padding: 0.3em;
        transition: 0.3s;
        outline: none;
        }

    .input-icon-with input:focus {
        border-color: var(--base-color-main);
    }

    .input-icon-with input {
        padding-left: 40px;
    }

    .input-icon-with span {
        position: absolute;
        top: 8px;
        left: 0;
        padding: 9px 8px;
        transition: 0.3s;
        color: #aaaaaa;
    }

    .input-icon-with input:focus + span {
        color: var(--base-color-main);
    }

    .login-footer {
        background-color: white;
        font-size: xx-small;
        padding: 10px;
    }

    @@media screen and (max-width: 480px) {
        .main-content {
            flex-wrap: wrap;
            margin-top: 0;
            width: 100%;
            color: #424242;
            background-color: #ffffff;
            box-shadow: none;
            border-radius: 0;
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
        }

        .login-area {
            width: 100%;
        }
    }
</style>


<div class="main-content">
    <div class="card text-center col-10 login-area">
        <div class="card-body">
            <div class="system-logo">
                <img class="login-img card-img-top" src="~/images/webicon.png" />
            </div>
            <div class="system-title">
                <span>AI荷量把握</span>
            </div>
            <div class="system-version">
                <span>Ver. @Model.SystemVersion</span>
            </div>
            <div class="login-form">
                <form method="post">
                    @if (!(ViewData["ErrorMessage"] is null))
                    {
                        <span class="text-danger">@Html.Raw(ViewData["ErrorMessage"])</span>
                    }
                    <div class="input-icon-with">
                        <input class="login-text" type="text" placeholder="ログインID" asp-for="LoginId">
                        <span class="material-icons">person</span>
                    </div>
                    <div class="input-icon-with input-password">
                        <input class="login-text" type="password" placeholder="パスワード" asp-for="Password">
                        <span class="material-icons">lock</span>
                    </div>
                    <button type="submit" class="login-btn btn-imagecolor">ログイン</button>
                </form>
            </div>
        </div>
        <div class="card-footer text-center login-footer">
            Copyright &copy; TOZAN Co., Ltd. All Rights Reserved.
        </div>
    </div>
</div>

<!-- ▼JSファイル読み込み -->
<!-- jquery -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<!-- Bootstrap core JavaScript -->
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<!-- sb-admin-2 -->
<script src="~/js/sb-admin-2.js"></script>