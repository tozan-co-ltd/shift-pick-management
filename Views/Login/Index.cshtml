@model mar_sumaken_web.Models.LoginModel
@{
    ViewData["Title"] = "ログイン";
    Layout = "_LayoutLogin";
}

<style>
    body {
        background-color: #e2eec3;
    }
    .login-img {
        margin: 20px;
        margin-bottom: 0px;
    }
</style>

<div class="main-content">
    <div class="login-area col-10">
        <div class="inner">
            <div class="system_logo">
                <img class="login-img" src="~/images/icon_app.png" />
            </div>
            <div class="system_title">
                <span>スマホDE検品<br/>WEBアプリ</span>
            </div>
            <div class="login-form">
                <form method="post" action="Login/Login">
                    @if (!(ViewData["ErrorMessage"] is null))
                    {
                        <span class="text-danger">@Html.Raw(ViewData["ErrorMessage"])</span>
                    }

                    <div class="input-icon-with">
                        <input class="login-text" type="text" placeholder="ログインID" asp-for="LoginId">
                        <span class="material-icons">person</span>
                    </div>
                    <div class="input-icon-with input-password">
                        <input class="login-text" type="password" placeholder="パスワード" asp-for="Password">
                        <span class="material-icons">lock</span>
                    </div>

                    <button type="submit" class="login-btn btn-imagecolor">ログイン</button>
                </form>
            </div>
        </div>
    </div>
</div>


<!-- ▼JSファイル読み込み -->
<!-- jquery -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<!-- Bootstrap core JavaScript -->
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<!-- sb-admin-2 -->
<script src="~/js/sb-admin-2.js"></script>

