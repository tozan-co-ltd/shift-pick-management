@using ai_truck_load_measurement.Commons;
@model ai_truck_load_measurement.Models.M_NotificationViewModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.CategoryTitle + " - " + Model.ViewTitle;
}
<div class="card shadow de-inspection masterInfo m-4">
    <div class="card-header">
        @ViewData["Title"]
    </div>
    <div class="card-body">

        <div class="form-group col-sm-12 pl-3">
            <p id="div-error-message" class="mt-1 text-danger"></p>

            @if (ViewData["ErrorMessage"] != null)
            {
                <span class="mt-1 text-danger">@ViewData["ErrorMessage"]</span>
            }
        </div>

        <div class="row mb-3">
            <div class="col-lg-10">
                <div class="card border-left-custom">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li>通知期間内の便が初期表示されます。</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-16 d-flex justify-content-start align-items-center unset-pdl sp-cs-dpl">
            <div class="d-flex justify-content-start align-items-center mb-3 unset-pdl">
                <span class="warehouse-name-drs span-paragraph">デポ</span>
                <div>
                    <label class="mr-2"><input type="checkbox" class=" mr-2" id="allDepo" />すべて  [</label>
                    <label id="selectDepos"></label>]
                </div>
            </div>
        </div>

        <div class="col-16 d-flex justify-content-start align-items-center unset-pdl sp-cs-dpl">
            <div class="d-flex justify-content-start align-items-center mb-3 unset-pdl">
                <span class="warehouse-name-drs span-paragraph">オプション</span>
                <div>
                    <label><input type="checkbox" id="isBeforeApplicablePeriod" /> 通知終了日時を過ぎた便も表示</label>
                </div>
            </div>
        </div>

        <div class="mg-bot-20">
            <div class="col-12 d-flex xs-block justify-content-start align-items-center p-0">
                <div class="input-group-append mr-2">
                    <a class="btn btn-primary btn-icon-split btn-register" asp-controller="M_Notification" asp-action="Register">
                        <span class="icon text-white-50">
                            <i class="fas fa-plus"></i>
                        </span>
                        <span class="text">新規作成</span>
                    </a>
                </div>
                <div class="input-group-append">
                    <a href="#" class="btn btn-info btn-icon-split" onclick="onExportFile('M_Notification', '@Model.ViewTitle')">
                        <span class="icon text-white-50">
                            <i class="fas fa-file-export"></i>
                        </span>
                        <span class="text">Excel出力</span>
                    </a>
                </div>
            </div>
        </div>
        <div class="mt-3">
            <table class="table table-sm stripe hover nowrap datatable-normal table-center">
                <thead>
                    <tr align="center">
                        <th width="40"></th>
                        <th class="font-weight-bold">通知ID</th>
                        <th class="font-weight-bold">便名称</th>
                        <th class="font-weight-bold">便枝番</th>
                        <th class="font-weight-bold">デポ名</th>
                        <th class="font-weight-bold">到着荷量下限</th>
                        <th class="font-weight-bold">出発荷量下限</th>
                        <th class="font-weight-bold">通知開始日時</th>
                        <th class="font-weight-bold">通知終了日時</th>
                        <th class="font-weight-bold">メール<br />受信者</th>
                        <th class="font-weight-bold">更新者</th>
                        <th class="font-weight-bold">更新日時</th>
                    </tr>
                </thead>
                <tbody>
                    @if (@Model.M_NotificationList != null)
                    {
                        @foreach (var item in @Model.M_NotificationList)
                        {
                            <tr>
                                <td>
                                    <a class="btn btn-success btn-icon-split ml-1 mr-1"
                                       onclick="OnEditClick('@item.NotificationID')" data-id="@item.NotificationID" data-toggle="modal" data-target="#edit-modal">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <button class="btn btn-danger btn-icon-split"
                                            onclick="OnDeleteClick('@item.NotificationID')" data-id="@item.NotificationID" data-toggle="modal" data-target="#delete-modal">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </td>
                                <td>@item.NotificationID</td>
                                <td>@item.TripName</td>
                                <td>@item.TripBranchSeq</td>
                                <td>@item.DepoName</td>
                                <td>@item.TripName</td>
                                <td>@item.ArrivalLowerLoadStatus</td>
                                <td>@item.DepartureLowerLoadClass</td>
                                <td>
                                    @for(int i=0; i<item.NotificationUsers.Count; i++)
                                    {
                                        @if(i != 0)
                                        {
                                           <br /> 
                                        }
                                        @item.NotificationUsers[i]
                                    }
                                </td>
                                <td>@item.UpdatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                <td>@item.UpdatedBy</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    <script type="text/javascript">
        $(document).ready(function () {
            model = @Html.Raw(Json.Serialize(Model));
            addDepos(model);
            depoCheckDisplay(model);
        })
    </script>