@using ai_truck_load_measurement.Commons;
@model ai_truck_load_measurement.Models.M_NotificationRegisterViewModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.CategoryTitle + " - " + Model.ViewTitle + " - " + "登録";
}

<div class="card shadow masterInfo m-4">

    <div class="card-header">
        @ViewData["Title"]
    </div>

    <div class="card-body">
        <div class="form-group col-sm-12 pl-3">
            <p id="div-error-message" class="mt-1 text-danger"></p>

            @if (ViewData["ErrorMessage"] != null)
            {
                <span class="mt-1 text-danger">@ViewData["ErrorMessage"]</span>
            }
        </div>

        <div class="mg-bot-20">
            <div class="col-16 sp-tablet mb-3">
                <form class="col-md-12" method="post" enctype="multipart/form-data" name="form" id="mNotificationForm">
                    <div class="col-12 input-group div-input-group">
                        <div class="col-12 col-sm-4 col-md-2 column-1st">
                            <label>@Html.DisplayName("DepoSelectList")<span style="color:red">*</span></label>
                        </div>
                        <div class="col-12 col-sm-8 col-md-5 column-2nd">
                            <select class="form-select" name="DepoID" asp-for="DepoID" asp-items="@Model.DepoSelectList" id="DepoID" required></select>
                            <span class="text-danger w-100" asp-validation-for="DepoID"></span>
                        </div>
                    </div>
                    <div class="col-12 input-group div-input-group">
                        <div class="col-12 col-sm-4 col-md-2 column-1st">
                            <label>@Html.DisplayName("TripNameSelectList")<span style="color:red">*</span></label>
                        </div>
                        <div class="col-12 col-sm-8 col-md-5 column-2nd">
                            <select class="form-select" name="TripID" asp-for="TripID" asp-items="@Model.TripNameSelectList" id="TripID" required>
                                <option value="0" selected disabled>選択してください</option>
                            </select>
                            <span class="text-danger w-100" asp-validation-for="TripID"></span>
                        </div>
                    </div>
                    <div class="col-12 input-group div-input-group">
                        <div class="col-12 col-sm-4 col-md-2 column-1st">
                            <label>@Html.DisplayName("TripBranchSeqSelectList")<span style="color:red">*</span></label>
                        </div>
                        <div class="col-12 col-sm-8 col-md-5 column-2nd">
                            <select class="form-select" name="TripBranchIDAndSeq" asp-for="TripBranchIDAndSeq" asp-items="@Model.TripBranchSeqSelectList" id="TripBranchIDAndSeq" required>
                                <option value="0" selected disabled>選択してください</option>
                            </select>
                            <span class="text-danger w-100" asp-validation-for="TripBranchIDAndSeq"></span>
                        </div>
                    </div>
                    <div class="col-12 input-group div-input-group">
                        <div class="col-12 col-sm-4 col-md-2 column-1st">
                        </div>
                        <div class="col-lg-5 column-2nd">
                            <div class="card">
                                <div class="card-header">
                                    <label>便枝番詳細情報</label>
                                </div>
                                <div class="card-body">
                                    <ul class="mb-0">
                                        <li id="ArrivalScheduledTime">到着予定時間：</li>
                                        <li id="DepartureScheduledTime">出発予定時間：</li>
                                        <li id="ApplicableStartDateTime">適用開始日時：</li>
                                        <li id="ApplicableEndDateTime">適用終了日時：</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 input-group div-input-group">
                        <div class="col-12 col-sm-4 col-md-2 column-1st">
                            <label>@Html.DisplayName("ArrivalLowerLoadClass")</label>
                        </div>
                        <div class="col-12 col-sm-8 col-md-5 column-2nd">
                            <select class="form-select" name="ArrivalLowerLoadClass" asp-for="ArrivalLowerLoadClass" required>
                                <option value="2" selected>設定無し</option>
                                <option value="3">1～10%</option>
                                <option value="4">11～20%</option>
                                <option value="5">21～30%</option>
                                <option value="6">31～40%</option>
                                <option value="7">41～50%</option>
                                <option value="8">51～60%</option>
                                <option value="9">61～70%</option>
                                <option value="10">71～80%</option>
                                <option value="11">81～90%</option>
                                <option value="12">91～100%</option>
                            </select>
                            <span class="text-danger w-100" asp-validation-for="ArrivalLowerLoadClass"></span>
                        </div>
                    </div>
                    <div class="col-12 input-group div-input-group">
                        <div class="col-12 col-sm-4 col-md-2 column-1st">
                            <label>@Html.DisplayName("DepartureLowerLoadClass")</label>
                        </div>
                        <div class="col-12 col-sm-8 col-md-5 column-2nd">
                            <select class="form-select" name="DepartureLowerLoadClass" asp-for="DepartureLowerLoadClass" required>
                                <option value="2" selected>設定無し</option>
                                <option value="3">1～10%</option>
                                <option value="4">11～20%</option>
                                <option value="5">21～30%</option>
                                <option value="6">31～40%</option>
                                <option value="7">41～50%</option>
                                <option value="8">51～60%</option>
                                <option value="9">61～70%</option>
                                <option value="10">71～80%</option>
                                <option value="11">81～90%</option>
                                <option value="12">91～100%</option>
                            </select>
                            <span class="text-danger w-100" asp-validation-for="DepartureLowerLoadClass"></span>
                        </div>
                    </div>
                    <div class="col-12 input-group div-input-group">
                        <div class="col-12 col-sm-4 col-md-2 column-1st">
                            <label>@Html.DisplayName("NotificationStartDateTime")<span style="color:red">*</span></label>
                        </div>
                        <div class="col-12 col-sm-8 col-md-5 column-2nd">
                            <input class="form-control" type="datetime-local" asp-for="NotificationStartDateTime" autocomplete="off" id="NotificationStartDateTime" required>
                            <small class="form-text text-muted w-100 p-1">YYYY/MM/DD hh:mmで入力してください</small>
                            <span class="text-danger w-100" asp-validation-for="NotificationStartDateTime"></span>
                        </div>
                    </div>
                    <div class="col-12 input-group div-input-group">
                        <div class="col-12 col-sm-4 col-md-2 column-1st">
                            <label>@Html.DisplayName("NotificationEndDateTime")<span style="color:red">*</span></label>
                        </div>
                        <div class="col-12 col-sm-8 col-md-5 column-2nd">
                            <input class="form-control" type="datetime-local" asp-for="NotificationEndDateTime" autocomplete="off" id="NotificationEndDateTime" required>
                            <small class="form-text text-muted w-100 p-1">YYYY/MM/DD hh:mmで入力してください</small>
                            <span class="text-danger w-100" asp-validation-for="NotificationEndDateTime"></span>
                        </div>
                    </div>
                    <div class="col-12 input-group div-input-group">
                        <div class="col-12 col-sm-4 col-md-2 column-1st">
                            <label>メール受信者</label>
                        </div>
                        <div class="col-12 col-sm-8 col-md-5 column-2nd">
                            <div class="dropdown-container  mr-3" id="dropdownContainer">
                                <button class="dropdown-button btn btn-primary btn-icon-split btn-register" type="button" id="dropdownButton">
                                    <span class="icon text-white-50">
                                        <i class="fas fa-plus"></i>
                                    </span>
                                    <span class="text">追加　　　</span>
                                </button>
                                <div class="dropdown-content" id="dropdownContent">
                                    <div id="createToggleCheckBox">ユーザーマスターにユーザーが存在しません</div>
                                </div>
                            </div>
                            <a href="#" class="btn btn-danger btn-icon-split btn-register mr-3" onclick="clearUsers()">
                                <span class="icon text-white-50">
                                    <i class="fas fa-trash"></i>
                                </span>
                                <span class="text">一括クリア</span>
                            </a>
                        </div>
                    </div>
                    <div class="col-12 input-group div-input-group">
                        <div class="col-12 col-sm-4 col-md-2 column-1st" id="selectedUsers">
                        </div>
                        <div class="col-12 col-sm-8 col-md-5 column-2nd" id="selectedUsersChild"></div>
                    </div>
                    
                    <div class="col-12 d-flex xs-block justify-content-start align-items-center p-0">
                        <div class="input-group-append mr-4">
                            <a class="btn btn-secondary btn-icon-split" asp-controller="M_Notification" asp-action="Index">
                                <span class="icon text-white-50">
                                    <i class="fas fa-arrow-left-long"></i>
                                </span>
                                <span class="text">戻る</span>
                            </a>
                        </div>
                        <div class="input-group-append">
                            <button class="btn btn-primary btn-icon-split" style="min-width: 80px" onclick="OnRegister()">
                                <span class="text">登録</span>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    // ロード時の処理
    $(document).ready(function () {
        // 今日の日付を取得
        var today = new Date();
        today.setDate(today.getDate());
        var yyyy = today.getFullYear();
        var MM = ("0" + (today.getMonth() + 1)).slice(-2);
        var dd = ("0" + today.getDate()).slice(-2);
        var hh = ("0" + today.getHours()).slice(-2);
        var mm = ("0" + today.getMinutes()).slice(-2);;

        $('#NotificationStartDateTime').val(yyyy + '-' + MM + '-' + dd + "T" + hh + ":" + mm);
        $('#NotificationEndDateTime').val(yyyy + '-' + MM + '-' + dd + "T" + hh + ":" + mm);

        // ユーザーのセレクトリスト作成
        createToggleUserSelectCheckBox("/Register");
    });


    // 便枝番取得
    function GetTripBranchSeqs() {
        var tripID = $('[name=TripID]').val();

        // フォーム情報取得
        let url = window.location.origin + '@Url.Action("GetTripBranchSeqs", "M_Notification")';
        let method = 'POST';
        let data = { tripID: tripID };

        // Ajax call
        $.ajax({
            url: url,
            method: method,
            data: data,
            async: false,
        }).done(function (response) {
            // 便枝番セレクトリストの更新
            AddOptionToSelectList(response, "TripBranchIDAndSeq");
            console.log("start");
        }).fail(function (jqXHR, textStatus, errorThrown) {
            if (jqXHR.status === 404) {
                var errorMessage = jqXHR.responseJSON.errorMessage;
                $("#edit-modal-error-message").text(errorMessage);
            } else {
                var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                $("#edit-modal-error-message").text(errorMessage);
            }
        });
    }

    // 便枝番選択時の処理
    $('[name=TripBranchIDAndSeq]').change(function () {
        var tripID = $('[name=TripID]').val();
        var tripBranchNumberID = $('[name=TripBranchIDAndSeq]').val().split("_")[0];

        // フォーム情報取得
        let url = window.location.origin + '@Url.Action("GetTripBranchSeqData", "M_Notification")';
        let method = 'POST';
        let data = { tripID: tripID, tripBranchNumberID: tripBranchNumberID };

        // Ajax call
        $.ajax({
            url: url,
            method: method,
            data: data
        }).done(function (response) {
            SetTripBranchSeqData(response);
        }).fail(function (jqXHR, textStatus, errorThrown) {
            if (jqXHR.status === 404) {
                var errorMessage = jqXHR.responseJSON.errorMessage;
                $("#edit-modal-error-message").text(errorMessage);
            } else {
                var errorMessage = 'E3002: サーバーに接続できませんでした。' + ' HttpRequest : ' + jqXHR.status + ' textStatus : ' + textStatus;
                $("#edit-modal-error-message").text(errorMessage);
            }
        });
    });

    function SetTripBranchSeqData(tripBranchNumberModel){
        $("#ArrivalScheduledTime")[0].innerText = "到着予定時間：" + GetTimeString(new Date(tripBranchNumberModel.arrivalScheduledTime));
        $("#DepartureScheduledTime")[0].innerText = "出発予定時間：" + GetTimeString(new Date(tripBranchNumberModel.departureScheduledTime));
        $("#ApplicableStartDateTime")[0].innerText = "適用開始日時：" + GetDateString(new Date(tripBranchNumberModel.applicableStartDateTime));
        $("#ApplicableEndDateTime")[0].innerText = "適用終了日時：" + GetDateString(new Date(tripBranchNumberModel.applicableEndDateTime));
        $("#NotificationEndDateTime").val(tripBranchNumberModel.applicableEndDateTime);
    }

    // ドロップダウンの表示・非表示
    dropdownButton.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropdownContainer.classList.toggle('show');
    });

    // コンテンツ外をクリックした場合、プルダウンを閉じる
    document.addEventListener('click', (e) => {
        if (!dropdownContainer.contains(e.target)) {
            dropdownContainer.classList.remove('show');
        }
    });

    function allToggleOpen() {
        event.preventDefault();
        // 中項目のヘッダーをクリックで小項目を表示/非表示
        let mediumHeaders = dropdownContent.querySelectorAll('.medium-header');
        mediumHeaders.forEach(header => {
            const smallItems = header.nextElementSibling;
            const toggleIcon = header.querySelector('.toggle-icon');
            if (!smallItems.classList.contains('show')) {
                smallItems.classList.add('show');
                toggleIcon.classList.remove('collapsed');
            }
        });
    }

    function allToggleClose() {
        event.preventDefault();
        // 中項目のヘッダーをクリックで小項目を表示/非表示
        let mediumHeaders = dropdownContent.querySelectorAll('.medium-header');
        mediumHeaders.forEach(header => {
            const smallItems = header.nextElementSibling;
            const toggleIcon = header.querySelector('.toggle-icon');
            if (smallItems.classList.contains('show')) {
                smallItems.classList.remove('show');
                toggleIcon.classList.add('collapsed');
            }
        });
    }

    // 登録ボタン押下
    function OnRegister() {

        var form = $("#mNotificationForm");



        form.submit(function (event) {

            $("#div-error-message").text("");

            // ページの更新を禁止する
            event.preventDefault();

            // 送信イベントが他のハンドラーに伝播するのを防ぐ
            event.stopImmediatePropagation();

            // フォーム情報取得
            let url = window.location.origin + '@Url.Action("Register", "M_Notification")';
            let method = 'POST';
            let formId = 'mNotificationForm';
            let data = form.serializeArray();
            data.push({ NotificationUsers: arrayUsers });

            // Ajax call
            $.ajax({
                url: url,
                method: method,
                data: data
            }).done(function (response) {
                $('#' + formId)[0].reset();
                // 完了モーダル表示
                AlertMessage('', '完了', '登録が完了しました。', null, null);
            }).fail(function (jqXHR, textStatus, errorThrown) {
                var errorMessage = jqXHR.responseJSON.errorMessage;
                $("#div-error-message").text(errorMessage);
            });
        });
    }
</script>
