@model mar_sumaken_web.Models.D_FileImportModel
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.ViewTitle;
}

<div class="card shadow de-inspection receive-schedule m-4">
    <div class="card-header text-gray-800">
        @ViewData["Title"]
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-lg-8">
                <div class="card border-left-custom">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li>「フォーマット出力」ボタンから取込フォーマットダウンロードしてください。</li>
                            <li>ファイル形式が「.csv」のみ取込できます。</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group col-sm-12">
            <p id="div-error-message" class="mt-1 text-danger"></p>
        </div>

        @if (ViewData["ErrorMessage"] != null)
        {
            <span class="mt-1 text-danger">@ViewData["ErrorMessage"]</span>
        }

        <div class="mg-bot-20">
                <form id="import-receive-schedule-upload-form" method="post" enctype="multipart/form-data" name="form" onsubmit="return false;">
                    <div class="col-16 d-flex justify-content-start align-items-center mb-3">
                        <span class="warehouse-name">倉庫名</span>
                        <div class="selectItem unset-pdl">
                            <select class="form-select" name="DepoID" asp-for="SelectedDepoID" asp-items="@Model.SearchDepoList"></select>
                        </div>
                    </div>
                    <div class="col-16 d-flex justify-content-start align-items-center sp-tablet mb-3">
                    <button class="btn btn-info btn-icon-split sp-mg-bt-10" onclick="onExportFile('ImportReceiveSchedule')">
                            <span class="icon text-white-50">
                                <i class="fa-solid fa-file-export"></i>
                            </span>
                            <span class="text">フォーマット出力</span>
                        </button>
                        <div class="d-flex justify-content-start align-items-center upload-part sp-tablet">
                            <div class="col-12 mg-right-20 file-input pd-0-sp sp-mg-bt-10">
                                <div class="input-group">
                                    <label class="input-group-btn my-0">
                                        <span class="btn btn-secondary btn-icon-split btn-pd20" id="browse">
                                            ファイル選択
                                        <input class="excel-input" id="FileUpload" name="FileUpload" type="file" accept=".csv" multiple>
                                        </span>
                                    </label>
                                    <input type="text" class="form-control rounded-0" readonly placeholder="CSVファイルを選択してください">
                                </div>
                            </div>
                            <div class="input-group-append sp-mg-bt-10">
                                <button id="file-upload" class="btn btn-primary btn-icon-split" onclick="onUploadFile('import-receive-schedule-upload-form')">
                                    <span class="icon text-white-50">
                                        <i class="fa-solid fa-file-export"></i>
                                    </span>
                                    <span class="text">取込</span>
                                </button>
                            </div>
                        </div>
                     </div>
                <input type="hidden" name="GamenName" value="@Model.ViewTitle">
                </form>
        </div>
        <p>
            取込履歴(直近1ヶ月)
        </p>
        <div class="mt-3">
            <table class="table table-sm stripe hover nowrap datatable-normal">
                <thead>
                    <tr>
                        <th>取込日時</th>
                        <th>取込ファイル名</th>
                        <th>登録者</th>
                    </tr>
                </thead>
                <tbody>
                    @if (@Model.D_FileImportList != null)
                    {
                        @foreach (var item in @Model.D_FileImportList)
                        {
                            <tr>
                                <td>@item.CreatedAt.ToString("yyyy/MM/dd HH:mm:ss")</td>
                                <td>@item.ImportFileName</td>
                                <td>@item.CreatedBy</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<input id="import_action_url" type="hidden" value="@Url.Action("ImportCsv", "ImportReceiveSchedule")" />