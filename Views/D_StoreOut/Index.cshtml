@using mar_sumaken_web.Commons;
@model mar_sumaken_web.Models.D_StoreOutModel;
@{
    Model.GetBaseView(User, ViewContext);
    ViewData["Title"] = Model.CategoryTitle + " - " + Model.ViewTitle;
}

<div class="card shadow de-inspection d-store-out m-4">
    <div class="card-header text-gray-800">
        @ViewData["Title"]
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-lg-8">
                <div class="card border-left-custom">
                    <div class="card-body">
                        <ul class="mb-0">
                            <li>メッセージ内容</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group col-sm-12">
            <p id="import-res" class="mt-1"></p>
        </div>

        @* <div id="ErrorBlock" class="mb-3 ml-3 text-error text-danger">@Model.Message</div> *@


        <div id="FailMsg" class="mb-2 ml-3 text-danger">@Model.Message</div>

        <div class="mg-bot-20">
            <div class="col-16 sp-tablet mb-3">
                <div class="row mt-10">
                    <div class="col-lg-12">
                        <form method="post" enctype="multipart/form-data" name="form" id="D_StoreOut">
                            <div class="col-16 d-flex justify-content-start align-items-center mb-3 unset-pdl">
                                <span class="warehouse-name-drs">倉庫名</span>
                                <div class="selectItem unset-pdl">
                                    <select class="form-select" name="SelectedDepoID" asp-for="SelectedDepoID" asp-items="@Model.SearchDepoList"></select>
                                </div>
                            </div>
                            <div class="col-16 d-flex justify-content-start align-items-center mb-3 unset-pdl">
                                <span class="warehouse-name-drs">仕入先名</span>
                                <div class="selectItem unset-pdl">
                                    <select class="form-select" name="SelectedCompanyID" asp-for="SelectedCompanyID" asp-items="@Model.SearchCompanyList"></select>
                                </div>
                            </div>
                            <div class="col-16 d-flex justify-content-start align-items-center mb-3 unset-pdl sp-cs-dpl">
                                <div class="d-flex justify-content-start align-items-center mb-3 unset-pdl">
                                    <span class="warehouse-name-drs">@Html.DisplayNameFor(Model => Model.DateSearchStart)</span>
                                    <input id="startDate" type="text" asp-for="DateSearchStart" class="form-control pickerDate"> <lable class="m-1">～</lable> <input id="endDate" type="text" asp-for="DateSearchEnd" class="form-control pickerDate">
                                </div>
                                <div class="col-16 d-flex justify-content-start align-items-center mb-3 unset-pdl">
                                    <button type="submit" class="btn btn-secondary btn-icon-split ml-3 sp-mg-top-10 sp-mg-left-0 searchDStoreOut">
                                        <span class="icon text-white-50">
                                            <i class="fa-solid fa-magnifying-glass"></i>
                                        </span>
                                        <span class="text">検索</span>
                                    </button>
                                    <button class="btn btn-primary btn-icon-split ml-3">
                                        <span class="icon text-white-50">
                                            <i class="fas fa-plus"></i>
                                        </span>
                                        <span class="text">新規作成</span>
                                    </button>
                                    <button class="btn btn-info btn-icon-split sp-mg-bt-10 ml-3">
                                        <span class="icon text-white-50">
                                            <i class="fa-solid fa-file-export"></i>
                                        </span>
                                        <span class="text">出力</span>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="tableContent mt-3">
            <table class="table table-sm stripe hover nowrap" id="dstoreTbl" style="display: none;">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>仕入先名</th>
                        <th>入荷日</th>
                        <th>仕入先品番</th>
                        <th>キー</th>
                        <th>箱数</th>
                        <th>数量</th>
                        <th>登録日時</th>
                        <th>読取日時</th>
                        <th>登録者</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>
@* <input id="import_action_url" type="hidden" value="@Url.Action("ImportExcel", "ScheduledArrivalImport")" /> *@
<script>
    $(document).ready(function () {
        $("#dstoreTbl").hide();
        $('#D_StoreOut').submit(function (e) {
            $('#dstoreTbl').DataTable().destroy();
            e.preventDefault(); 
            var formData = $(this).serialize(); 
            $.ajax({
                type: "POST",
                url: '@Url.Action("SearchData", "D_StoreOut")',
                data: formData,
                success: function (result) {
                    $("#dstoreTbl").show();
                    $("#dstoreTbl tbody").html(result);
                    $("#dstoreTbl").DataTable({
                        "language": {           // 日本語表示
                            "url": "https://cdn.datatables.net/plug-ins/1.11.5/i18n/ja.json"
                        },
                        info: false,            // 総件数
                    });
                },
                error: function (xhr, status, error) {
                    console.error(xhr.responseText);
                }
            });
        });
    });
   
</script>